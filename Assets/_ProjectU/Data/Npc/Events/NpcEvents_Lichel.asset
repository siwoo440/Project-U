  m_Script: {fileID: 11500000, guid: c705680e20332f5478f3a6911a134984, type: 3}
  m_Name: NpcEvents_Lichel
  m_EditorClassIdentifier: Assembly-CSharp::NpcEventBook
  ownerId: char_lichel
  events:
  - eventId: event_lichel_curious
    title: "\uB5A0\uB3CC\uC774\uC758 \uC7A5\uBD80"
    requiredStage: 1
    locationId: loc_market_stall
    fromHour: 6
    toHour: 20
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uD765, \uBB58 \uBD10? \uC774\uAC74 \uB0B4 \uC7A5\uBD80\uC57C. \uC190\uB2D8\uB4E4
        \uCDE8\uD5A5\uC774 \uB2E4 \uC801\uD600 \uC788\uC9C0."
    - fromPlayer: 0
      text: "\uB108\uB294\u2026 \"\uC2FC \uAC70 \uC88B\uC544\uD568\"\uC774\uB77C\uACE0
        \uC801\uC5B4 \uB480\uC5B4."
    choices:
    - label: "\uC88B\uC740 \uBB3C\uAC74\uC744 \uC88B\uC544\uD55C\uB2E4\uACE0 \uACE0\uCCD0
        \uC918."
      reply: "\uD765, \uADF8\uB7FC \uC88B\uC740 \uBB3C\uAC74 \uC0AC \uAC00\uB294
        \uAC70 \uBCF4\uC5EC \uC918."
      affinity: 5
    - label: "\uB9DE\uB294 \uB9D0\uC774\uB124."
      reply: "\uBB50\uC57C, \uC778\uC815\uD558\uB294 \uAC70\uC57C? \u2026\uADF8\uB7F0
        \uC194\uC9C1\uD568\uC740 \uC880 \uC88B\uB124."
      affinity: 3
    afterLines:
    - fromPlayer: 0
      text: "\uB2E8\uACE8 \uC190\uB2D8\uC740 \uC7A5\uBD80 \uB9E8 \uC55E\uC5D0 \uC801\uB294
        \uAC70\uC57C. \uAE30\uC5B5\uD574 \uB46C."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_lichel_trust
    title: "\uBC24\uC758 \uC18C\uBB38"
    requiredStage: 2
    locationId: loc_village_square
    fromHour: 20
    toHour: 22
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC61B\uB0A0\uC5D4 \uBA39\uC744 \uAC78 \uD6D4\uCE58\uB2E4\uAC00 \uB9C8\uC744\uC5D0\uC11C
        \uCAD3\uACA8\uB0AC\uC5B4."
    - fromPlayer: 0
      text: "\uC9C0\uAE08\uC740 \uD30C\uB294 \uCABD\uC774 \uB410\uB124. \uC6C3\uAE30\uC9C0?"
    choices:
    - label: "\uC804\uD600 \uC548 \uC6C3\uACA8. \uB300\uB2E8\uD574."
      reply: "\u2026\uD765. \uADF8\uB7F0 \uB9D0 \uB4E4\uC73C\uB824\uACE0 \uD55C \uC598\uAE30
        \uC544\uB2C8\uC57C. \uADF8\uB798\uB3C4\u2026 \uACE0\uB9C8\uC6CC."
      affinity: 8
    - label: "\uC870\uAE08 \uC6C3\uAE30\uAE34 \uD558\uB124."
      reply: "\uADF8\uCE58? \uB098\uB3C4 \uAC00\uB054 \uC6C3\uACA8."
      affinity: 1
    afterLines:
    - fromPlayer: 0
      text: "\uC774 \uC598\uAE30 \uB2E4\uB978 \uB370 \uAC00\uC11C \uD558\uBA74 \uAC00\uACA9
        \uC62C\uB9B0\uB2E4?"
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_lichel_affection
    title: "\uBE44 \uC624\uB294 \uB0A0\uC758 \uAC00\uD310\uB300"
    requiredStage: 3
    locationId: loc_market_stall
    fromHour: 6
    toHour: 20
    weather: 2
    lines:
    - fromPlayer: 0
      text: "\uBE44 \uC624\uB294 \uB0A0\uC5D4 \uC190\uB2D8\uC774 \uC5C6\uC5B4. \u2026\uB108
        \uBE7C\uACE0."
    - fromPlayer: 0
      text: "\uACC4\uC18D \uB5A0\uB3CC\uC544\uB2E4\uB2D0 \uC0DD\uAC01\uC774\uC5C8\uB294\uB370,
        \uC5EC\uAE30 \uC880 \uB354 \uC788\uC5B4 \uBCFC\uAE4C \uC2F6\uC5B4."
    choices:
    - label: "\uACC4\uC18D \uC788\uC5B4 \uC918."
      reply: "\uD765, \uB124\uAC00 \uADF8\uB807\uAC8C\uAE4C\uC9C0 \uBD80\uD0C1\uD558\uBA74\u2026
        \uC788\uC5B4 \uC904\uAC8C."
      affinity: 10
    - label: "\uB124 \uB9C8\uC74C\uB300\uB85C \uD574."
      reply: "\u2026\uADF8\uB798. \uB0B4 \uB9C8\uC74C\uB300\uB85C \uD560 \uAC70\uC57C."
      affinity: 2
    afterLines:
    - fromPlayer: 0
      text: "\uC774\uAC70, \uBE44 \uB9DE\uC9C0 \uB9D0\uB77C\uACE0 \uC8FC\uB294 \uAC70\uC57C.
        \uCC29\uAC01\uD558\uC9C0 \uB9C8."
    rewardItem: {fileID: 11400000, guid: ced6962cfb3b9a249aadbf41f4f53d78, type: 2}
    rewardItemAmount: 1
