  ownerId: char_seira
  events:
  - eventId: event_seira_curious
    title: "\uD587\uBCD5\uACFC \uBE44\uB298"
    requiredStage: 1
    locationId: loc_ruins_plaza
    fromHour: 10
    toHour: 13
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\u2026\uB180\uB790\uC5B4\uC694? \uBE44\uB298\uC744 \uB370\uC6B0\uB294
        \uC911\uC774\uC5D0\uC694."
    - fromPlayer: 0
      text: "\uCC28\uAC00\uC6B0\uBA74 \uBAB8\uC774 \uAD73\uC5B4\uC11C \uC5F0\uAD6C\uB97C
        \uBABB \uD558\uAC70\uB4E0\uC694."
    choices:
    - label: "\uBE44\uB298\uC774 \uC608\uC058\uAC8C \uBE5B\uB098."
      reply: "\uC608\uC058\uB2E4\uB294 \uB9D0\uC740\u2026 \uCC98\uC74C \uB4E4\uC5B4\uC694.
        \uAE30\uB85D\uD574 \uB458\uAC8C\uC694."
      affinity: 5
    - label: "\uAC19\uC774 \uD587\uBCD5 \uCB18\uAE4C?"
      reply: "\u2026\uC870\uC6A9\uD788\uB9CC \uC788\uC5B4 \uC900\uB2E4\uBA74\uC694."
      affinity: 4
    afterLines:
    - fromPlayer: 0
      text: "\uB2E4\uC74C\uC5D0\uB3C4 \uC5EC\uAE30\uC11C \uB9CC\uB098\uBA74 \uC778\uC0AC\uD574
        \uC918\uC694."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_seira_trust
    title: "\uB3C5\uACFC \uD574\uB3C5\uC81C"
    requiredStage: 2
    locationId: loc_ruins_library
    fromHour: 16
    toHour: 20
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC81C \uB3C5\uC740 \uC0AC\uB78C\uC744 \uB2E4\uCE58\uAC8C \uD574\uC694.
        \uADF8\uB798\uC11C \uD574\uB3C5\uC81C\uB97C \uB9CC\uB4E4\uAE30 \uC2DC\uC791\uD588\uC5B4\uC694."
    - fromPlayer: 0
      text: "\uB204\uAD70\uAC00\uB97C \uB2E4\uCE58\uAC8C \uD558\uAE30 \uC804\uC5D0\u2026
        \uACE0\uCE60 \uBC29\uBC95\uBD80\uD130 \uC54C\uACE0 \uC2F6\uC5B4\uC11C."
    choices:
    - label: "\uB108\uB294 \uC0AC\uB78C\uC744 \uC9C0\uD0A4\uB294 \uCABD\uC774\uC57C."
      reply: "\u2026\uADF8\uB807\uAC8C \uB9D0\uD574 \uC8FC\uB294 \uC0AC\uB78C\uC774
        \uC788\uC73C\uBA74, \uB3C5\uB3C4 \uB35C \uBB34\uC11C\uC6CC\uC694."
      affinity: 8
    - label: "\uC5F0\uAD6C \uB3C4\uC640\uC904\uAC8C."
      reply: "\uADF8\uB7FC \uC870\uC218\uB85C \uAE30\uB85D\uD574 \uB458\uAC8C\uC694.
        \uCCAB \uC870\uC218\uC608\uC694."
      affinity: 5
    afterLines:
    - fromPlayer: 0
      text: "\uC624\uB298 \uAE30\uB85D\uC740\u2026 \uC5F0\uAD6C\uAC00 \uC544\uB2C8\uB77C
        \uC77C\uAE30\uAC00 \uB410\uB124\uC694."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_seira_affection
    title: "\uAF43\uC774 \uC544\uB2CC \uB3C5\uCD08"
    requiredStage: 3
    locationId: loc_forest_edge
    fromHour: 13
    toHour: 16
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uAF43\uC744 \uC8FC\uACE0 \uC2F6\uC5C8\uB294\uB370\u2026 \uC81C\uAC00
        \uC544\uB294 \uAC74 \uB3C5\uCD08\uBFD0\uC774\uB77C\uC11C."
    - fromPlayer: 0
      text: "\uADF8\uB798\uC11C \uD574\uB3C5\uC81C\uB97C \uB9CC\uB4E4\uC5C8\uC5B4\uC694.
        \uB2F9\uC2E0\uC774 \uB2E4\uCE58\uC9C0 \uC54A\uAC8C."
    choices:
    - label: "\uC81C\uC77C \uC88B\uC740 \uC120\uBB3C\uC774\uC57C."
      reply: "\u2026\uB2E4\uD589\uC774\uC5D0\uC694. \uB3C5\uCD08 \uB9D0\uACE0 \uAF43\uB3C4
        \uACF5\uBD80\uD574 \uBCFC\uAC8C\uC694."
      affinity: 10
    - label: "\uB2E4\uC74C\uC5D4 \uAC19\uC774 \uAF43 \uCC3E\uC790."
      reply: "\uAC19\uC774\uB77C\uBA74\u2026 \uB3C5\uCD08 \uC606\uC5D0\uC11C\uB3C4
        \uAF43\uC744 \uCC3E\uC744 \uC218 \uC788\uC744 \uAC83 \uAC19\uC544\uC694."
      affinity: 8
    afterLines:
    - fromPlayer: 0
      text: "\uBC1B\uC544\uC694. \uC81C\uC77C \uC798 \uB9CC\uB4E0 \uD574\uB3C5\uC81C\uC608\uC694."
    rewardItem: {fileID: 11400000, guid: 46d53aca2110e46489ca54e6892f7daa, type: 2}
    rewardItemAmount: 2
