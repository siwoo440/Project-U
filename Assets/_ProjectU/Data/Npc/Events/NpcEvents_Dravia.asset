  ownerId: char_dravia
  events:
  - eventId: event_dravia_curious
    title: "\uBAA8\uB8E8 \uC55E\uC5D0\uC11C"
    requiredStage: 1
    locationId: loc_smithy_anvil
    fromHour: 9
    toHour: 13
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uBD88 \uC55E\uC5D0 \uC11C \uBD10. \uB3C4\uB9DD\uAC00\uC9C0 \uC54A\uB294\uB2E4\uBA74."
    - fromPlayer: 0
      text: "\u2026\uBC84\uD2F0\uB294\uAD70. \uB300\uC7A5\uAC04 \uC5F4\uAE30\uC5D0
        \uBC84\uD2F0\uB294 \uB188\uC740 \uB4DC\uBB3C\uC5B4."
    choices:
    - label: "\uC1E0 \uB450\uB4DC\uB9AC\uB294 \uAC70 \uBC30\uC6B0\uACE0 \uC2F6\uC5B4."
      reply: "\uD765. \uB9DD\uCE58\uB294 \uBB34\uAC70\uC6CC. \uADF8\uB798\uB3C4 \uD558\uACA0\uB2E4\uBA74
        \uAC00\uB974\uCCD0 \uC8FC\uC9C0."
      affinity: 5
    - label: "\uB354\uC6CC\uC11C \uC8FD\uACA0\uC5B4."
      reply: "\uADF8\uB7FC \uB098\uAC00. \uBD88\uC740 \uC57D\uD55C \uB188\uC744 \uAE30\uB2E4\uB824
        \uC8FC\uC9C0 \uC54A\uC544."
      affinity: 1
    afterLines:
    - fromPlayer: 0
      text: "\uB2E4\uC74C\uC5D0 \uC624\uBA74 \uB9DD\uCE58 \uC950\uB294 \uBC95\uBD80\uD130
        \uC54C\uB824 \uC8FC\uC9C0."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_dravia_trust
    title: "\uB9E4\uC6B4 \uC810\uC2EC"
    requiredStage: 2
    locationId: loc_cafe
    fromHour: 13
    toHour: 14
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\u2026\uB0B4 \uBD88\uC740 \uD55C\uBC88 \uACE0\uD5A5\uC744 \uD0DC\uC6E0\uB2E4."
    - fromPlayer: 0
      text: "\uADF8\uB798\uC11C \uB9E4\uC77C \uB450\uB4DC\uB824. \uC774\uBC88\uC5D4
        \uB9CC\uB4DC\uB294 \uB370 \uC4F0\uB824\uACE0."
    choices:
    - label: "\uB124 \uBD88\uC740 \uC774\uC81C \uC0AC\uB78C\uC744 \uC9C0\uCF1C."
      reply: "\u2026\uADF8\uB7F0 \uB9D0\uC740 \uCC98\uC74C \uB4E3\uB294\uAD70. \uB098\uC058\uC9C0
        \uC54A\uC544."
      affinity: 8
    - label: "\uBD88 \uC870\uC2EC\uD574\uC57C\uACA0\uB124."
      reply: "\uC54C\uACE0 \uC788\uC5B4. \uB204\uAD6C\uBCF4\uB2E4 \uC798."
      affinity: -2
    afterLines:
    - fromPlayer: 0
      text: "\uC774 \uC598\uAE30, \uB5A0\uBC8C\uB9AC\uC9C0 \uB9C8\uB77C."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_dravia_affection
    title: "\uBCC4 \uC544\uB798\uC758 \uC57D\uC18D"
    requiredStage: 3
    locationId: loc_village_square
    fromHour: 18
    toHour: 21
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC800\uB141 \uACF5\uAE30\uB294 \uCC28\uAC11\uAD70. \uB108 \uC606\uC740
        \uADF8\uB807\uC9C0\uB3C4 \uC54A\uC9C0\uB9CC."
    - fromPlayer: 0
      text: "\uB124 \uB3C4\uAD6C\uAC00 \uBD80\uB7EC\uC9C0\uBA74 \uC5B8\uC81C\uB4E0
        \uAC00\uC838\uC640. \uD3C9\uC0DD \uACE0\uCCD0 \uC8FC\uC9C0."
    choices:
    - label: "\uD3C9\uC0DD\uC774\uB77C\uB2C8, \uC57D\uC18D\uC774\uC57C."
      reply: "\uB4DC\uB798\uACE4\uC740 \uC57D\uC18D\uC744 \uC5B4\uAE30\uC9C0 \uC54A\uC544.
        \uAE30\uC5B5\uD574."
      affinity: 10
    - label: "\uB3C4\uAD6C\uBCF4\uB2E4 \uB108\uB97C \uBCF4\uB7EC \uC62C\uAC8C."
      reply: "\u2026\uB9D0\uC740 \uC798\uD558\uB294\uAD70. \uC5BC\uAD74\uC774 \uB728\uAC70\uC6B4
        \uAC74 \uD654\uB85C \uB54C\uBB38\uC774\uB2E4."
      affinity: 8
    afterLines:
    - fromPlayer: 0
      text: "\uC774\uAC74 \uC88B\uC740 \uAD11\uC11D\uC774\uB2E4. \uB124\uAC00 \uC4F8
        \uB3C4\uAD6C\uC5D0 \uB123\uC5B4."
    rewardItem: {fileID: 11400000, guid: c593f671b9ae9d24e96e6cd5ee7b2a1c, type: 2}
    rewardItemAmount: 5
