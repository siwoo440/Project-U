  m_Script: {fileID: 11500000, guid: c705680e20332f5478f3a6911a134984, type: 3}
  m_Name: NpcEvents_Ravenna
  m_EditorClassIdentifier: Assembly-CSharp::NpcEventBook
  ownerId: char_ravenna
  events:
  - eventId: event_ravenna_curious
    title: "\uB9C8\uC744 \uACBD\uBE44 \uC778\uC0AC"
    requiredStage: 1
    locationId: loc_village_square
    fromHour: 14
    toHour: 17
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uACBD\uBE44 \uC778\uC0AC \uB4DC\uB9BD\uB2C8\uB2E4. \uC624\uB298\uB3C4
        \uB9C8\uC744\uC740 \uD3C9\uC628\uD569\uB2C8\uB2E4."
    - fromPlayer: 0
      text: "\u2026\uBA38\uB9AC\uB97C \uD488\uC5D0 \uC548\uACE0 \uC788\uC73C\uBA74
        \uC0AC\uB78C\uB4E4\uC774 \uB180\uB77C\uB354\uAD70\uC694. \uB2F9\uC2E0\uC740
        \uB180\uB77C\uC9C0 \uC54A\uB294\uAD70\uC694."
    choices:
    - label: "\uBA4B\uC788\uB294\uB370?"
      reply: "\uBA4B\uC788\uB2E4\u2026 \uAE30\uC0AC\uB85C\uC11C \uAC00\uC7A5 \uC601\uAD11\uC2A4\uB7EC\uC6B4
        \uCE6D\uCC2C\uC785\uB2C8\uB2E4."
      affinity: 5
    - label: "\uBB34\uAC81\uC9C0 \uC54A\uC544?"
      reply: "\uAC00\uB054\uC740 \uBB34\uAC81\uC2B5\uB2C8\uB2E4. \uD2B9\uD788 \uBE44
        \uC624\uB294 \uB0A0\uC740\uC694."
      affinity: 4
    afterLines:
    - fromPlayer: 0
      text: "\uC21C\uCC30 \uC911\uC5D0 \uB2F9\uC2E0 \uC9D1 \uC55E\uB3C4 \uC0B4\uD53C\uACA0\uC2B5\uB2C8\uB2E4."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_ravenna_trust
    title: "\uD568\uB77D\uB41C \uBC24"
    requiredStage: 2
    locationId: loc_ruins_library
    fromHour: 11
    toHour: 14
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC81C\uAC00 \uC9C0\uD0A4\uB358 \uC131\uC740 \uC5B4\uB290 \uBC24 \uD568\uB77D\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
        \uB05D\uAE4C\uC9C0 \uC2F8\uC6E0\uC9C0\uB9CC\u2026 \uC774\uB807\uAC8C \uB418\uC5C8\uC9C0\uC694."
    - fromPlayer: 0
      text: "\uBA38\uB9AC\uB97C \uC783\uC740 \uB4A4\uC5D0\uB3C4 \uB9F9\uC138\uB9CC\uC740
        \uB0A8\uC558\uC2B5\uB2C8\uB2E4. \uC9C0\uD0AC \uB300\uC0C1\uC740 \uC783\uC5C8\uB294\uB370\uB3C4\uC694."
    choices:
    - label: "\uC774\uC81C \uC774 \uC12C\uC744 \uC9C0\uCF1C \uC918."
      reply: "\u2026\uC0C8\uB85C\uC6B4 \uB9F9\uC138\uB97C \uD5C8\uB77D\uD574 \uC8FC\uC2DC\uB294
        \uAC81\uB2C8\uAE4C. \uBAA9\uC228\u2026 \uC544\uB2C8, \uC601\uD63C\uC744 \uAC78\uACA0\uC2B5\uB2C8\uB2E4."
      affinity: 8
    - label: "\uADF8\uB3D9\uC548 \uC678\uB85C\uC6E0\uACA0\uB2E4."
      reply: "\u2026\uC678\uB85C\uC6E0\uC2B5\uB2C8\uB2E4. \uAE30\uC0AC\uB294 \uADF8\uB7F0
        \uB9D0\uC744 \uD558\uBA74 \uC548 \uB418\uC9C0\uB9CC\uC694."
      affinity: 6
    afterLines:
    - fromPlayer: 0
      text: "\uC624\uB298 \uB3C4\uC11C\uAD00\uC758 \uBA3C\uC9C0\uAC00 \uB35C \uBB34\uAC81\uAC8C
        \uB290\uAEF4\uC9D1\uB2C8\uB2E4."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_ravenna_affection
    title: "\uAE30\uC0AC\uC758 \uB9F9\uC138"
    requiredStage: 3
    locationId: loc_ruins_gate
    fromHour: 17
    toHour: 21
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uB178\uC744\uC774 \uC720\uC801\uC744 \uBD89\uAC8C \uBB3C\uB4E4\uC774\uB294\uAD70\uC694.
        \uC81C\uAC00 \uAC00\uC7A5 \uC88B\uC544\uD558\uB294 \uC2DC\uAC04\uC785\uB2C8\uB2E4."
    - fromPlayer: 0
      text: "\uB2F9\uC2E0 \uC55E\uC5D0 \uBB34\uB98E\uC744 \uAFC7\uACA0\uC2B5\uB2C8\uB2E4.
        \uC774\uBC88 \uB9F9\uC138\uB294\u2026 \uC131\uC774 \uC544\uB2C8\uB77C \uB2F9\uC2E0\uC5D0\uAC8C
        \uBC14\uCE69\uB2C8\uB2E4."
    choices:
    - label: "\uB9F9\uC138\uB97C \uBC1B\uC544\uB4E4\uC77C\uAC8C."
      reply: "\uAC10\uC0AC\uD569\uB2C8\uB2E4. \uC774 \uC601\uD63C\uC774 \uB2E4\uD560
        \uB54C\uAE4C\uC9C0, \uB2F9\uC2E0\uC758 \uAE30\uC0AC\uAC00 \uB418\uACA0\uC2B5\uB2C8\uB2E4."
      affinity: 10
    - label: "\uC77C\uC5B4\uB098, \uCE5C\uAD6C\uB85C \uCDA9\uBD84\uD574."
      reply: "\u2026\uCE5C\uAD6C. \uAE30\uC0AC\uC5D0\uAC8C \uACFC\uBD84\uD55C \uB9D0\uC774\uAD70\uC694.
        \uADF8\uB798\uB3C4 \uAE30\uC069\uB2C8\uB2E4."
      affinity: 8
    afterLines:
    - fromPlayer: 0
      text: "\uAE30\uC0AC\uB2E8\uC758 \uB3C4\uB07C\uC785\uB2C8\uB2E4. \uB2F9\uC2E0\uC774\uB77C\uBA74
        \uC62C\uBC14\uB974\uAC8C \uC4F0\uC2E4 \uAC81\uB2C8\uB2E4."
    rewardItem: {fileID: 11400000, guid: cc96d25a17a973747bb1d11fe6839e7b, type: 2}
    rewardItemAmount: 1
