  m_Script: {fileID: 11500000, guid: c705680e20332f5478f3a6911a134984, type: 3}
  m_Name: NpcEvents_Octavia
  m_EditorClassIdentifier: Assembly-CSharp::NpcEventBook
  ownerId: char_octavia
  events:
  - eventId: event_octavia_curious
    title: "\uBBFC\uBB3C \uAE30\uB85D"
    requiredStage: 1
    locationId: loc_pond_dock
    fromHour: 13
    toHour: 17
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC5B4\uBA38, \uB9C8\uCE68 \uC798 \uC624\uC168\uC5B4\uC694. \uC774 \uC5F0\uBABB\uC758
        \uBBFC\uBB3C\uACE0\uAE30\uB294 \uCC98\uC74C \uBCF4\uB294 \uAC83\uB4E4\uC774\uC5D0\uC694."
    - fromPlayer: 0
      text: "\uB2F9\uC2E0 \uC774\uC57C\uAE30\uB3C4 \uD55C \uC904 \uC801\uC5B4 \uB458\uAC8C\uC694.
        \uCCAB \uC904\uC740\u2026 '\uC5F0\uBABB\uAC00\uC5D0\uC11C \uB9CC\uB09C \uC0AC\uB78C'."
    choices:
    - label: "\uC608\uC058\uAC8C \uC801\uC5B4 \uC918."
      reply: "\uD6C4\uD6C4, \uAC00\uC7A5 \uACE0\uC6B4 \uBA39\uBB3C\uB85C \uC801\uC744\uAC8C\uC694."
      affinity: 5
    - label: "\uBB50\uB77C\uACE0 \uC801\uC5C8\uB294\uC9C0 \uAD81\uAE08\uD574."
      reply: "\uBE44\uBC00\uC774\uC5D0\uC694. \uAE30\uB85D\uAC00\uB294 \uB2E4 \uBCF4\uC5EC
        \uC8FC\uC9C0 \uC54A\uAC70\uB4E0\uC694."
      affinity: 3
    afterLines:
    - fromPlayer: 0
      text: "\uC624\uB298 \uAE30\uB85D\uC740 \uC720\uB09C\uD788 \uBC1D\uC740 \uC0C9\uC774\uC5D0\uC694."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_octavia_trust
    title: "\uC2EC\uD574\uC758 \uAD70\uCCB4"
    requiredStage: 2
    locationId: loc_coast_rocks
    fromHour: 9
    toHour: 13
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC2EC\uD574\uC5D0\uB294 \uC81C \uAD70\uCCB4\uAC00 \uC788\uC5C8\uC5B4\uC694.
        \uBAA8\uB450 \uC0AC\uB77C\uC9C0\uACE0\u2026 \uC800\uB9CC \uB0A8\uC558\uC5B4\uC694."
    - fromPlayer: 0
      text: "\uADF8\uB798\uC11C \uAE30\uB85D\uC744 \uBA48\uCD9C \uC218\uAC00 \uC5C6\uC5B4\uC694.
        \uC78A\uD788\uBA74 \uC815\uB9D0\uB85C \uC5C6\uC5B4\uC9C0\uB2C8\uAE4C\uC694."
    choices:
    - label: "\uB0B4\uAC00 \uAC19\uC774 \uAE30\uC5B5\uD560\uAC8C."
      reply: "\u2026\uB458\uC774 \uAE30\uC5B5\uD558\uBA74, \uB450 \uBC30\uB85C \uC624\uB798
        \uB0A8\uACA0\uB124\uC694. \uACE0\uB9C8\uC6CC\uC694."
      affinity: 8
    - label: "\uAE30\uB85D\uC744 \uBCF4\uC5EC \uC904\uB798?"
      reply: "\uCC98\uC74C\uC73C\uB85C \uB204\uAD70\uAC00\uC5D0\uAC8C \uBCF4\uC5EC
        \uC8FC\uB294 \uAC70\uC608\uC694. \u2026\uCC9C\uCC9C\uD788 \uC77D\uC5B4 \uC8FC\uC138\uC694."
      affinity: 6
    afterLines:
    - fromPlayer: 0
      text: "\uD30C\uB3C4 \uC18C\uB9AC\uAC00 \uC624\uB298\uC740 \uC790\uC7A5\uAC00
        \uAC19\uC544\uC694."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_octavia_affection
    title: "\uB178\uC744 \uAE30\uB85D"
    requiredStage: 3
    locationId: loc_coast_dock
    fromHour: 17
    toHour: 21
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uB178\uC744 \uC9C4 \uBC14\uB2E4\uB294 \uBA39\uBB3C\uB85C \uB2F4\uC744
        \uC218 \uC5C6\uC5B4\uC694. \uADF8\uB798\uC11C \uC624\uB298\uC740 \uADF8\uB0E5
        \uBCF4\uB824\uACE0\uC694."
    - fromPlayer: 0
      text: "\u2026\uB2F9\uC2E0 \uC606\uC5D0\uC11C \uBCF4\uB294 \uB178\uC744\uC740,
        \uAE30\uB85D\uD558\uC9C0 \uC54A\uC544\uB3C4 \uC78A\uD788\uC9C0 \uC54A\uC744
        \uAC83 \uAC19\uC544\uC694."
    choices:
    - label: "\uB098\uB3C4 \uC78A\uC9C0 \uC54A\uC744\uAC8C."
      reply: "\uD6C4\uD6C4\u2026 \uADF8\uB7FC \uC774 \uB178\uC744\uC740 \uC6B0\uB9AC
        \uB458\uC758 \uAE30\uB85D\uC774\uC5D0\uC694."
      affinity: 10
    - label: "\uADF8\uB798\uB3C4 \uD55C \uC7A5\uB9CC \uC801\uC5B4 \uC918."
      reply: "\uADF8\uB7FC \uD55C \uC7A5\uB9CC. \uC81C\uBAA9\uC740 '\uD568\uAED8
        \uBCF8 \uB178\uC744'\uC774\uC5D0\uC694."
      affinity: 8
    afterLines:
    - fromPlayer: 0
      text: "\uC2EC\uD574\uC5D0\uC11C \uAC00\uC838\uC628 \uC9C4\uC8FC\uC608\uC694.
        \uB2F9\uC2E0\uC5D0\uAC8C \uAE30\uB85D\uCC98\uB7FC \uB0A8\uAE30\uACE0 \uC2F6\uC5B4\uC694."
    rewardItem: {fileID: 11400000, guid: 2f1df630320255844a0117b89edfaaae, type: 2}
    rewardItemAmount: 2
