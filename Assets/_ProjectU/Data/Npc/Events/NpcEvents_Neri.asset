  m_Name: NpcEvents_Neri
  m_EditorClassIdentifier: Assembly-CSharp::NpcEventBook
  ownerId: char_neri
  events:
  - eventId: event_neri_curious
    title: "\uC624\uB298\uC758 \uB0A0\uC528 \uC608\uBCF4"
    requiredStage: 1
    locationId: loc_village_square
    fromHour: 8
    toHour: 13
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uAC1C\uAD74! \uC624\uB298 \uB0A0\uC528 \uC608\uBCF4 \uB4E4\uC5B4 \uBCFC\uB798?
        \uAD6C\uB984 \uBAA8\uC591\uC774 \uD1A0\uB07C\uC57C!"
    - fromPlayer: 0
      text: "\uD1A0\uB07C \uAD6C\uB984\uC774 \uB728\uBA74\u2026 \uC74C\u2026 \uB0B4\uC77C
        \uBE44\uAC00 \uC62C \uD655\uB960\uC774 \uC870\uAE08 \uC788\uC5B4!"
    choices:
    - label: "\uB124 \uC608\uBCF4\uB294 \uBBFF\uC744 \uB9CC\uD574."
      reply: "\uAC1C\uAD74! \uC9C4\uC9DC?! \uADF8\uB7FC \uB0B4\uC77C\uB3C4 \uC81C\uC77C
        \uBA3C\uC800 \uC54C\uB824 \uC904\uAC8C!"
      affinity: 5
    - label: "\uC870\uAE08\uC774 \uBA87 \uD37C\uC13C\uD2B8\uC57C?"
      reply: "\uC74C\u2026 \uAC1C\uAD74\u2026 \uBE44\uBC00 \uACC4\uC0B0\uC774\uC57C!
        \uB300\uCDA9 \uBC18!"
      affinity: 3
    afterLines:
    - fromPlayer: 0
      text: "\uB0B4\uC77C \uBE44 \uC624\uBA74 \uC6B0\uB9AC \uB458\uC774 \uB9DE\uD78C
        \uAC70\uC57C!"
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_neri_trust
    title: "\uB9C8\uB978 \uC2B5\uC9C0\uC758 \uAE30\uC5B5"
    requiredStage: 2
    locationId: loc_pond_dock
    fromHour: 13
    toHour: 16
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uAC00\uBB44 \uB54C \uC2B5\uC9C0\uAC00 \uB2E4 \uB9D0\uB77C\uC11C\u2026
        \uAC00\uC871\uB4E4\uC774 \uBB3C\uC744 \uCC3E\uC544 \uB5A0\uB0AC\uC5B4. \uB098\uB9CC
        \uB0A8\uC558\uC5B4."
    - fromPlayer: 0
      text: "\uADF8\uB798\uC11C \uB0A0\uC528\uB97C \uBCF4\uB294 \uAC70\uC57C. \uB2E4\uC74C
        \uAC00\uBB44\uC740 \uBBF8\uB9AC \uC54C\uACE0 \uC2F6\uC5B4\uC11C."
    choices:
    - label: "\uAC00\uC871\uB4E4 \uAF2D \uB2E4\uC2DC \uB9CC\uB0A0 \uAC70\uC57C."
      reply: "\u2026\uAC1C\uAD74. \uBE44 \uC624\uB294 \uB0A0\uB9C8\uB2E4 \uADF8\uB807\uAC8C
        \uBE4C\uC5C8\uC5B4. \uB124\uAC00 \uB9D0\uD574 \uC8FC\uB2C8\uAE4C \uC9C4\uC9DC
        \uB420 \uAC83 \uAC19\uC544."
      affinity: 8
    - label: "\uC774\uC81C \uB0B4\uAC00 \uB124 \uAC00\uC871\uC774\uC57C."
      reply: "\uAC1C, \uAC1C\uAD74?! \u2026\uADF8 \uB9D0, \uAD00\uCE21 \uC77C\uC9C0\uC5D0
        \uC801\uC5B4 \uB458 \uAC70\uC57C!"
      affinity: 5
    afterLines:
    - fromPlayer: 0
      text: "\uC624\uB298 \uC5F0\uBABB \uBB3C\uC774 \uC720\uB09C\uD788 \uBC18\uC9DD\uC5EC."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_neri_affection
    title: "\uBE57\uC18D \uAC1C\uACE8 \uD569\uCC3D"
    requiredStage: 3
    locationId: loc_swamp_boardwalk
    fromHour: 5
    toHour: 8
    weather: 2
    lines:
    - fromPlayer: 0
      text: "\uBE44\uB2E4! \uBE44 \uC624\uB294 \uC0C8\uBCBD\uC5D4 \uC2B5\uC9C0 \uAC1C\uAD6C\uB9AC\uB4E4\uC774
        \uB2E4 \uAC19\uC774 \uB178\uB798\uD574!"
    - fromPlayer: 0
      text: "\uC624\uB298\uC740 \uB108\uB3C4 \uAC19\uC774 \uBD88\uB7EC \uC918! \uAC1C\uACE8\uAC1C\uACE8!"
    choices:
    - label: "\uAC1C\uACE8\uAC1C\uACE8!"
      reply: "\uC640! \uC81C\uC77C \uD070 \uBAA9\uC18C\uB9AC\uC57C! \uAC1C\uAD6C\uB9AC\uB4E4\uC774
        \uB2E4 \uB180\uB790\uC5B4!"
      affinity: 10
    - label: "\uB098\uB294 \uBC15\uC790\uB9CC \uB9DE\uCD9C\uAC8C."
      reply: "\uC88B\uC544! \uBC15\uC790 \uB2F4\uB2F9! \uAC1C\uAD74, \uAC1C\uAD74!"
      affinity: 8
    afterLines:
    - fromPlayer: 0
      text: "\uB0B4 \uBCF4\uBB3C \uC9C0\uB801\uC774\uC57C! \uB108\uD55C\uD14C\uB9CC
        \uC8FC\uB294 \uAC70\uC57C!"
    rewardItem: {fileID: 11400000, guid: f82cfee3161243747ad3a92e8c7418ba, type: 2}
    rewardItemAmount: 10
