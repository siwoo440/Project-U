  m_Script: {fileID: 11500000, guid: c705680e20332f5478f3a6911a134984, type: 3}
  m_Name: NpcEvents_Lunette
  m_EditorClassIdentifier: Assembly-CSharp::NpcEventBook
  ownerId: char_lunette
  events:
  - eventId: event_lunette_curious
    title: "\uC232 \uAC00\uC7A5\uC790\uB9AC\uC758 \uC57D\uCD08"
    requiredStage: 1
    locationId: loc_forest_edge
    fromHour: 8
    toHour: 12
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC544, \uC624\uC168\uC5B4\uC694\u2026? \uC9C0\uAE08 \uC78E \uB4A4\uC5D0
        \uC740\uBE5B \uD138\uC774 \uC788\uB294 \uD480\uC744 \uCC3E\uACE0 \uC788\uC5C8\uC5B4\uC694."
    - fromPlayer: 0
      text: "\uBE44\uC2B7\uD558\uAC8C \uC0DD\uAE34 \uB3C5\uCD08\uAC00 \uC788\uC5B4\uC11C\u2026
        \uD63C\uC790 \uCC3E\uC73C\uBA74 \uC870\uAE08 \uBB34\uC11C\uC6CC\uC694."
    choices:
    - label: "\uAC19\uC774 \uCC3E\uC544 \uC904\uAC8C."
      reply: "\uC815\uB9D0\uC694\u2026? \uADF8\uB7FC\u2026 \uC81C \uC606\uC5D0 \uC788\uC5B4
        \uC8FC\uC138\uC694. \uC870\uAE08\uB9CC\uC694."
      affinity: 5
    - label: "\uD63C\uC790\uC11C\uB3C4 \uC798\uD560 \uAC70\uC57C."
      reply: "\uC544\u2026 \uB124. \uADF8\uB807\uC8E0. \uD798\uB0B4 \uBCFC\uAC8C\uC694."
      affinity: 1
    afterLines:
    - fromPlayer: 0
      text: "\uC774 \uD480\uC740 \uB9D0\uB824\uC11C \uCC28\uC5D0 \uB123\uC73C\uBA74
        \uC7A0\uC774 \uC798 \uC640\uC694. \uB2E4\uC74C\uC5D0 \uB4DC\uB9B4\uAC8C\uC694."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_lunette_trust
    title: "\uD574 \uC9C8 \uB158 \uAD11\uC7A5"
    requiredStage: 2
    locationId: loc_village_square
    fromHour: 17
    toHour: 20
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uD574\uAC00 \uC9C0\uBA74\u2026 \uC544\uC9C1\uB3C4 \uAC00\uC2B4\uC774
        \uB450\uADFC\uAC70\uB824\uC694."
    - fromPlayer: 0
      text: "\uC608\uC804\uC5D0 \uC0B4\uB358 \uC232\uC774 \uBD88\uC5D0 \uD0D4\uB358
        \uBC24\uC774 \uC0DD\uAC01\uB098\uC11C\uC694."
    - fromPlayer: 1
      text: "\uADF8\uB0A0 \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uC5B4?"
    - fromPlayer: 0
      text: "\uBAA8\uB450 \uD769\uC5B4\uC84C\uC5B4\uC694. \uC800\uB294 \uD480\uC232\uC5D0
        \uC228\uC5B4\uC11C \uC18C\uB9AC\uB9CC \uB4E3\uACE0 \uC788\uC5C8\uC5B4\uC694."
    choices:
    - label: "\uC774\uC81C\uB294 \uD63C\uC790\uAC00 \uC544\uB2C8\uC57C."
      reply: "\u2026\uB124. \uADF8 \uB9D0, \uC624\uB798 \uAE30\uC5B5\uD560\uAC8C\uC694."
      affinity: 8
    - label: "\uADF8\uB9CC \uC78A\uB294 \uAC8C \uC88B\uC544."
      reply: "\uC78A\uC73C\uB824\uACE0 \uD574\uB3C4\u2026 \uC27D\uC9C0 \uC54A\uC544\uC694."
      affinity: -2
    afterLines:
    - fromPlayer: 0
      text: "\uB4E4\uC5B4 \uC8FC\uC154\uC11C \uACE0\uB9C8\uC6CC\uC694. \uC870\uAE08
        \uAC00\uBCBC\uC6CC\uC84C\uC5B4\uC694."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_lunette_affection
    title: "\uCC3D\uAC00\uC758 \uC57D\uCD08\uCC28"
    requiredStage: 3
    locationId: loc_cafe
    fromHour: 12
    toHour: 14
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC774\uAC70\u2026 \uC81C\uAC00 \uC9C1\uC811 \uC11E\uC740 \uC57D\uCD08\uCC28\uC608\uC694.
        \uB2F9\uC2E0 \uAC70\uC608\uC694."
    - fromPlayer: 0
      text: "\uBC24\uC5D0 \uC7A0\uC774 \uC548 \uC62C \uB54C \uB9C8\uC2DC\uBA74\u2026
        \uC81C\uAC00 \uC606\uC5D0 \uC788\uB294 \uAC83 \uAC19\uC744 \uAC70\uC608\uC694."
    choices:
    - label: "\uB9E4\uC77C \uBC24 \uB9C8\uC2E4\uAC8C."
      reply: "\uB9E4, \uB9E4\uC77C\uC774\uC694\u2026? \uADF8\uB7FC \uB354 \uB9CE\uC774
        \uB9CC\uB4E4\uC5B4\uC57C\uACA0\uB124\uC694\u2026!"
      affinity: 8
    - label: "\uCC28\uBCF4\uB2E4 \uB124\uAC00 \uC88B\uC544."
      reply: "\uC5D0\u2026?! \uADF8, \uADF8\uB7F0 \uB9D0\uC740\u2026 \uADC0\uAC00
        \uB728\uAC70\uC6CC\uC838\uC694\u2026"
      affinity: 10
    afterLines:
    - fromPlayer: 0
      text: "\uC55E\uC73C\uB85C\uB3C4\u2026 \uAC00\uB054 \uC774\uB807\uAC8C \uAC19\uC774
        \uC788\uC5B4 \uC8FC\uC138\uC694."
    rewardItem: {fileID: 11400000, guid: 361f6079362891a468aae059667ddd1c, type: 2}
    rewardItemAmount: 2
