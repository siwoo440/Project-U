  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c705680e20332f5478f3a6911a134984, type: 3}
  m_Name: NpcEvents_LanHua
  m_EditorClassIdentifier: Assembly-CSharp::NpcEventBook
  ownerId: char_lanhua
  events:
  - eventId: event_lanhua_curious
    title: "\uC544\uC774\uB4E4 \uBB34\uC220 \uC9C0\uB3C4"
    requiredStage: 1
    locationId: loc_village_square
    fromHour: 12
    toHour: 16
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC790\uC138\uB97C \uB0AE\uCDB0\uB77C. \uADF8\uB807\uC9C0. \u2026\uC790\uB124\uB3C4
        \uD574 \uBCF4\uACA0\uB098?"
    - fromPlayer: 0
      text: "\uC544\uC774\uB4E4\uBCF4\uB2E4 \uADE0\uD615\uC774 \uB098\uC058\uAD70.
        \uD558\uC9C0\uB9CC \uB208\uBE5B\uC740 \uC88B\uB2E4."
    choices:
    - label: "\uAC00\uB974\uCCD0 \uC918."
      reply: "\uC88B\uB2E4. \uCCAB \uC218\uC5C5\uC740 \uC778\uC0AC\uBD80\uD130\uB2E4.
        \uBB34\uC778\uC740 \uC608\uC758\uB85C \uC2DC\uC791\uD55C\uB2E4."
      affinity: 5
    - label: "\uB098\uB294 \uAD6C\uACBD\uB9CC \uD560\uAC8C."
      reply: "\uAD6C\uACBD\uB3C4 \uC218\uB828\uC774\uB2E4. \uC798 \uBCF4\uAC8C."
      affinity: 3
    afterLines:
    - fromPlayer: 0
      text: "\uB0B4\uC77C\uB3C4 \uC774 \uC2DC\uAC04\uC5D0 \uC218\uC5C5\uC774 \uC788\uB2E4."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_lanhua_trust
    title: "\uC783\uC740 \uC81C\uC790"
    requiredStage: 2
    locationId: loc_snow_shrine
    fromHour: 9
    toHour: 12
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC804\uC7C1 \uC911\uC5D0 \uB3C4\uC7A5\uC744 \uC9C0\uD0A4\uB824\uB2E4
        \uC81C\uC790\uB97C \uC783\uC5C8\uB2E4. \uD798\uC740 \uBC18\uB4DC\uC2DC \uB204\uAD70\uAC00\uB97C
        \uB2E4\uCE58\uAC8C \uD55C\uB2E4\uACE0 \uBBFF\uAC8C \uB410\uC9C0."
    - fromPlayer: 0
      text: "\uADF8\uB798\uC11C \uD63C\uC790\uC11C\uB9CC \uC218\uB828\uD588\uB2E4.
        \uAC00\uB974\uCE58\uBA74 \uB610 \uC783\uC744 \uD14C\uB2C8\uAE4C."
    choices:
    - label: "\uC9C0\uD0A4\uB294 \uD798\uB3C4 \uC788\uC5B4."
      reply: "\u2026\uADF8\uB798. \uADF8\uAC78 \uB2E4\uC2DC \uBBFF\uACE0 \uC2F6\uC5C8\uB2E4.
        \uC790\uB124 \uB355\uBD84\uC5D0."
      affinity: 8
    - label: "\uADF8 \uC81C\uC790\uB3C4 \uB124 \uC218\uB828\uC744 \uBC14\uB784 \uAC70\uC57C."
      reply: "\u2026\uADF8\uB807\uACA0\uC9C0. \uADF8 \uB140\uC11D\uC740 \uB298 \uB0B4
        \uC218\uB828\uC744 \uB530\uB77C \uD588\uC73C\uB2C8."
      affinity: 6
    afterLines:
    - fromPlayer: 0
      text: "\uC624\uB298 \uBA85\uC0C1\uC740 \uC870\uAE08 \uB35C \uBB34\uAC81\uAD70."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_lanhua_affection
    title: "\uC800\uB141 \uBA85\uC0C1"
    requiredStage: 3
    locationId: loc_home_lanhua
    fromHour: 18
    toHour: 21
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uD574 \uC9C8 \uB158 \uC218\uB828\uC7A5\uC774\uB2E4. \uAC19\uC774 \uC549\uC544\uB77C.
        \uC228\uC744 \uAE38\uAC8C, \uCC9C\uCC9C\uD788."
    - fromPlayer: 0
      text: "\u2026\uC790\uB124\uC640 \uC788\uC73C\uBA74 \uC2F8\uC6C0\uC774 \uC544\uB2C8\uB77C
        \uC9C0\uD0A4\uB294 \uBC95\uC744 \uC0DD\uAC01\uD558\uAC8C \uB41C\uB2E4."
    choices:
    - label: "\uB098\uB3C4 \uB110 \uC9C0\uD0AC\uAC8C."
      reply: "\u2026\uD558. \uC81C\uC790\uAC00 \uC2A4\uC2B9\uC744 \uC9C0\uD0A8\uB2E4\uB2C8.
        \uC88B\uC740 \uC81C\uC790\uB97C \uB450\uC5C8\uAD70."
      affinity: 10
    - label: "\uB2E4\uB9AC\uAC00 \uC800\uB824\u2026"
      reply: "\uD558\uD558. \uADF8\uAC83\uB3C4 \uC218\uB828\uC774\uB2E4. \u2026\uC624\uB298\uC740
        \uC5EC\uAE30\uAE4C\uC9C0 \uD558\uC9C0."
      affinity: 8
    afterLines:
    - fromPlayer: 0
      text: "\uC218\uB828 \uB4A4\uC5D0 \uB9C8\uC2DC\uB294 \uCC28\uB2E4. \uAC00\uC838\uAC00\uAC8C."
    rewardItem: {fileID: 11400000, guid: 361f6079362891a468aae059667ddd1c, type: 2}
    rewardItemAmount: 3
