  m_Script: {fileID: 11500000, guid: c705680e20332f5478f3a6911a134984, type: 3}
  m_Name: NpcEvents_Liriel
  m_EditorClassIdentifier: Assembly-CSharp::NpcEventBook
  ownerId: char_liriel
  events:
  - eventId: event_liriel_curious
    title: "\uBC84\uC12F \uACE0\uB9AC \uBB34\uB3C4\uD68C"
    requiredStage: 1
    locationId: loc_forest_fairy_ring
    fromHour: 6
    toHour: 10
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC27F! \uC9C0\uAE08 \uBC84\uC12F \uACE0\uB9AC\uC5D0\uC11C \uBB34\uB3C4\uD68C
        \uC5F0\uC2B5 \uC911\uC774\uC57C!"
    - fromPlayer: 0
      text: "\uC778\uAC04\uC740 \uC6D0\uB798 \uBABB \uB4E4\uC5B4\uC624\uB294\uB370\u2026
        \uB108\uB294 \uD2B9\uBCC4\uD788 \uBD10\uC904\uAC8C!"
    choices:
    - label: "\uAC19\uC774 \uCDA4\uCD9C\uB798?"
      reply: "\uC9C4\uC9DC?! \uBC1C \uBC1F\uC73C\uBA74 \uAC04\uC9C0\uB7FC \uBC8C\uC774\uC57C!
        \uD558\uB098, \uB458!"
      affinity: 5
    - label: "\uAD6C\uACBD\uB9CC \uD560\uAC8C."
      reply: "\uC5D0\uC774, \uC7AC\uBBF8\uC5C6\uC5B4! \uADF8\uB798\uB3C4 \uBC15\uC218\uB294
        \uCCD0 \uC918\uC57C \uD574!"
      affinity: 3
    afterLines:
    - fromPlayer: 0
      text: "\uB2E4\uC74C \uBB34\uB3C4\uD68C\uC5D0\uB3C4 \uCD08\uB300\uD560 \uAC70\uC57C!
        \uAF2D \uC640!"
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_liriel_trust
    title: "\uC783\uC5B4\uBC84\uB9B0 \uC694\uC815\uB4E4"
    requiredStage: 2
    locationId: loc_forest_edge
    fromHour: 13
    toHour: 17
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC608\uC804\uC5D4 \uC774 \uC232\uC5D0 \uC694\uC815\uC774 \uBC31 \uBA85\uB3C4
        \uB118\uC5C8\uC5B4. \uB098\uBB34\uAC00 \uBCA0\uC77C \uB54C\uB9C8\uB2E4\u2026
        \uD55C \uBA85\uC529 \uC0AC\uB77C\uC84C\uC9C0."
    - fromPlayer: 0
      text: "\uADF8\uB798\uC11C \uB098, \uC232 \uC785\uAD6C\uB97C \uC9C0\uD0A4\uB294
        \uAC70\uC57C. \uB354\uB294 \uC783\uACE0 \uC2F6\uC9C0 \uC54A\uC73C\uB2C8\uAE4C."
    choices:
    - label: "\uB098\uB3C4 \uC232\uC744 \uC9C0\uD0AC\uAC8C."
      reply: "\uC57D\uC18D\uD55C \uAC70\uC57C! \uC694\uC815 \uC57D\uC18D\uC740 \uC808\uB300
        \uBABB \uAE68! \u2026\uACE0\uB9C8\uC6CC."
      affinity: 8
    - label: "\uB098\uBB34\uB294 \uAF2D \uD544\uC694\uD55C \uB9CC\uD07C\uB9CC \uBCA8\uAC8C."
      reply: "\uC751\u2026 \uADF8 \uB9D0, \uC232\uC774 \uB4E4\uC5C8\uC744 \uAC70\uC57C."
      affinity: 5
    afterLines:
    - fromPlayer: 0
      text: "\uC624\uB298 \uC232 \uC785\uAD6C\uAC00 \uC870\uAE08 \uB354 \uBC1D\uC544
        \uBCF4\uC5EC!"
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_liriel_affection
    title: "\uBE5B\uC758 \uC120\uBB3C"
    requiredStage: 3
    locationId: loc_forest_flower_garden
    fromHour: 10
    toHour: 13
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uB0B4 \uB0A0\uAC1C \uBE5B\uC744 \uC870\uAE08 \uB5BC\uC5B4\uC11C \uC528\uC557\uC5D0
        \uB123\uC5C8\uC5B4! \uC694\uC815 \uCD5C\uACE0\uC758 \uC120\uBB3C\uC774\uC57C!"
    - fromPlayer: 0
      text: "\uC2EC\uC73C\uBA74 \uB124 \uBC2D\uC774 \uBC18\uC9DD\uBC18\uC9DD\uD574\uC9C8
        \uAC70\uC57C. \uB098\uB3C4 \uB9E4\uC77C \uBCF4\uB7EC \uAC08 \uAC70\uACE0!"
    choices:
    - label: "\uB9E4\uC77C \uC640 \uC918."
      reply: "\uB2F9\uC5F0\uD558\uC9C0! \uB124 \uBC2D\uC740 \uC774\uC81C \uB0B4 \uAD6C\uC5ED\uC774\uC57C!"
      affinity: 10
    - label: "\uB0A0\uAC1C \uC544\uD504\uC9C0 \uC54A\uC544?"
      reply: "\uC870\uAE08! \uADFC\uB370 \uB108\uD55C\uD14C \uC8FC\uB294 \uAC70\uB2C8\uAE4C
        \uAD1C\uCC2E\uC544!"
      affinity: 8
    afterLines:
    - fromPlayer: 0
      text: "\uC5EC\uAE30 \uC528\uC557! \uC798 \uD0A4\uC6CC\uC57C \uD574, \uC57D\uC18D!"
    rewardItem: {fileID: 11400000, guid: aaca232007164504cbd41b9a9b8cbefb, type: 2}
    rewardItemAmount: 4
