  ownerId: char_safira
  events:
  - eventId: event_safira_curious
    title: "\uAE38 \uC548\uB0B4"
    requiredStage: 1
    locationId: loc_village_square
    fromHour: 12
    toHour: 16
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\u2026\uC0AC\uB9C9 \uAE38 \uC54C\uACE0 \uC2F6\uB098."
    - fromPlayer: 0
      text: "\uBAA8\uB974\uBA74 \uC8FD\uB294\uB2E4. \uC54C\uBA74 \uC0B0\uB2E4. \uAC04\uB2E8\uD558\uB2E4."
    choices:
    - label: "\uC54C\uB824 \uC918."
      reply: "\u2026\uC88B\uB2E4. \uBAA8\uB798 \uBB34\uB2AC\uB97C \uBD10\uB77C. \uBC14\uB78C\uC774
        \uAE38\uC744 \uC54C\uB824 \uC900\uB2E4."
      affinity: 5
    - label: "\uAC19\uC774 \uAC00 \uC918."
      reply: "\u2026\uADC0\uCC2E\uB2E4. \uD558\uC9C0\uB9CC \uAC00 \uC8FC\uACA0\uB2E4."
      affinity: 4
    afterLines:
    - fromPlayer: 0
      text: "\uB2E4\uC74C\uC5D4 \uC624\uC544\uC2DC\uC2A4\uAE4C\uC9C0 \uD63C\uC790
        \uC640 \uBD10\uB77C."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_safira_trust
    title: "\uBAA8\uB798 \uC704\uC758 \uBCC4\uC790\uB9AC"
    requiredStage: 2
    locationId: loc_desert_oasis
    fromHour: 19
    toHour: 21
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC800 \uBCC4 \uC14B\uC774 \uC804\uAC08\uC790\uB9AC\uB2E4. \uB098\uB294
        \uC800 \uAF2C\uB9AC \uBCC4\uC5D0\uC11C \uD0DC\uC5B4\uB0AC\uB2E4\uACE0 \uB4E4\uC5C8\uB2E4."
    - fromPlayer: 0
      text: "\u2026\uAF2C\uB9AC\uC5D0 \uB3C5\uC774 \uC788\uC5B4\uC11C, \uB2E4\uB4E4
        \uD53C\uD55C\uB2E4. \uB098\uB3C4 \uBCC4\uB3C4."
    choices:
    - label: "\uB3C5\uC774 \uC788\uC5B4\uB3C4 \uBCC4\uC740 \uBE5B\uB098."
      reply: "\u2026\uADF8\uB807\uAD70. \uC624\uB298\uC740 \uBCC4\uC774 \uAC00\uAE5D\uB2E4."
      affinity: 8
    - label: "\uB098\uB294 \uC548 \uD53C\uD560\uAC8C."
      reply: "\u2026\uB9D0\uC740 \uC27D\uB2E4. \uD558\uC9C0\uB9CC, \uBBFF\uACA0\uB2E4."
      affinity: 5
    afterLines:
    - fromPlayer: 0
      text: "\uB0B4\uC77C \uBC24\uB3C4 \uBCC4\uC774 \uB9D1\uC744 \uAC70\uB2E4. \u2026\uAC19\uC774
        \uBD10\uB3C4 \uB41C\uB2E4."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_safira_affection
    title: "\uB3C5 \uC5C6\uB294 \uC804\uAC08"
    requiredStage: 3
    locationId: loc_desert_camp
    fromHour: 9
    toHour: 12
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uB108\uD55C\uD14C\uB294 \uAF2C\uB9AC\uB97C \uC138\uC6B0\uC9C0 \uC54A\uAC8C
        \uB410\uB2E4."
    - fromPlayer: 0
      text: "\uC774\uC0C1\uD558\uB2E4. \uB3C5\uC774 \uD544\uC694 \uC5C6\uB294 \uC0AC\uB78C\uC740
        \uCC98\uC74C\uC774\uB2E4."
    choices:
    - label: "\uC0AC\uD53C\uB77C \uACC1\uC774 \uD3B8\uD574."
      reply: "\u2026\uB098\uB3C4. \uC774 \uB9D0\uC740 \uD55C \uBC88\uB9CC \uD55C\uB2E4."
      affinity: 10
    - label: "\uAF2C\uB9AC \uB9CC\uC838 \uBD10\uB3C4 \uB3FC?"
      reply: "\u2026\uC870\uC2EC\uD574\uB77C. \uB108\uB2C8\uAE4C \uD5C8\uB77D\uD55C\uB2E4."
      affinity: 7
    afterLines:
    - fromPlayer: 0
      text: "\uC5F0\uACE0\uB2E4. \uC0C1\uCC98 \uB098\uBA74 \uBC1C\uB77C\uB77C. \uB2E4\uCE58\uC9C0
        \uB9C8\uB77C."
    rewardItem: {fileID: 11400000, guid: 2fbbf00934b2d404d946399b07a29fec, type: 2}
    rewardItemAmount: 2
