  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c705680e20332f5478f3a6911a134984, type: 3}
  m_Name: NpcEvents_Beatrice
  m_EditorClassIdentifier: Assembly-CSharp::NpcEventBook
  ownerId: char_beatrice
  events:
  - eventId: event_beatrice_curious
    title: "\uBC2D \uAF43\uAC00\uB8E8 \uC815\uCC30"
    requiredStage: 1
    locationId: loc_farm_fields
    fromHour: 11
    toHour: 15
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC815\uCC30 \uBCF4\uACE0. \uBC2D\uC758 \uAF43\uAC00\uB8E8 \uC0C1\uD0DC
        \uC591\uD638. \u2026\uC544, \uB2F9\uC2E0\uC774\uAD70\uC694."
    - fromPlayer: 0
      text: "\uBC8C\uB4E4\uC774 \uB2F9\uC2E0 \uC8FC\uC704\uB97C \uB9F4\uB3CC\uC544\uC694.
        \uC88B\uC740 \uB0C4\uC0C8\uAC00 \uB09C\uB2E4\uB294 \uC2E0\uD638\uC608\uC694."
    choices:
    - label: "\uBC8C\uB4E4\uC774 \uADC0\uC5FD\uB124."
      reply: "\u2026\uADC0\uC5FD\uB2E4\uACE0 \uD55C \uC0AC\uB78C\uC740 \uCC98\uC74C\uC774\uC5D0\uC694.
        \uBC8C\uB4E4\uB3C4 \uC88B\uC544\uD574\uC694."
      affinity: 5
    - label: "\uC3D8\uC774\uC9C4 \uC54A\uACA0\uC9C0?"
      reply: "\uC548 \uC3F4\uC694. \uC81C\uAC00 \uBA85\uB839\uD574 \uB480\uC5B4\uC694.
        \uB2F9\uC2E0\uC740 \uB3D9\uB8CC\uB77C\uACE0."
      affinity: 4
    afterLines:
    - fromPlayer: 0
      text: "\uB2E4\uC74C \uC815\uCC30\uC5D0 \uB3D9\uD589\uD574\uB3C4 \uC88B\uC544\uC694."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_beatrice_trust
    title: "\uBB34\uB108\uC9C4 \uAD70\uCCB4"
    requiredStage: 2
    locationId: loc_desert_oasis
    fromHour: 18
    toHour: 21
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uADFC\uC704\uB300\uC7A5\uC774\uC5C8\uC744 \uB54C, \uBC18\uB780\uC774
        \uC77C\uC5B4\uB0AC\uC5B4\uC694. \uC5EC\uC655\uB3C4 \uB3D9\uB8CC\uB3C4\u2026
        \uC9C0\uD0A4\uC9C0 \uBABB\uD588\uC5B4\uC694."
    - fromPlayer: 0
      text: "\uADF8 \uB4A4\uB85C\uB294 \uD63C\uC790\uC11C\uB3C4 \uC77C\uD574\uC57C
        \uD55C\uB2E4\uACE0 \uC0DD\uAC01\uD588\uC5B4\uC694. \uAE30\uB300\uBA74 \uB610
        \uC783\uC744 \uD14C\uB2C8\uAE4C."
    choices:
    - label: "\uC774\uC81C \uB098\uD55C\uD14C \uAE30\uB300\uB3C4 \uB3FC."
      reply: "\u2026\uAE30\uB300\uB3C4 \uB41C\uB2E4\uB2C8. \uC784\uBB34 \uBAA9\uB85D\uC5D0
        \uC5C6\uB358 \uB9D0\uC774\uC5D0\uC694. \uBC1B\uC544\uB4E4\uC77C\uAC8C\uC694."
      affinity: 8
    - label: "\uD63C\uC790\uC11C\uB3C4 \uC798\uD574 \uC654\uC796\uC544."
      reply: "\u2026\uB124. \uADF8\uB798\uB3C4 \uC774\uC81C \uC870\uAE08\uC740 \uC9C0\uCCE4\uC5B4\uC694."
      affinity: 5
    afterLines:
    - fromPlayer: 0
      text: "\uC624\uB298 \uBC24 \uBC8C\uB4E4\uC774 \uC720\uB09C\uD788 \uC870\uC6A9\uD574\uC694.
        \uB2F9\uC2E0 \uB355\uBD84\uC774\uC5D0\uC694."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_beatrice_affection
    title: "\uC0C8 \uAD70\uCCB4\uC758 \uCCAB \uBE44\uD589"
    requiredStage: 3
    locationId: loc_home_beatrice
    fromHour: 8
    toHour: 11
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC0C8 \uBC8C\uD1B5\uC758 \uBC8C\uB4E4\uC774 \uCC98\uC74C\uC73C\uB85C
        \uB0A0\uC544\uC694. \uAC19\uC774 \uBD10 \uC904\uB798\uC694?"
    - fromPlayer: 0
      text: "\u2026\uAD70\uCCB4\uAC00 \uB2E4\uC2DC \uC0DD\uACBC\uC5B4\uC694. \uADF8\uB9AC\uACE0
        \uADF8 \uC548\uC5D0 \uB2F9\uC2E0\uC774 \uC788\uC5B4\uC694."
    choices:
    - label: "\uB098\uB3C4 \uAD70\uCCB4\uC758 \uC77C\uC6D0\uC774\uC57C."
      reply: "\uC784\uBB34 \uBCF4\uACE0 : \uC0C8 \uAD70\uCCB4 \uC644\uC131. \uAD6C\uC131\uC6D0\u2026
        \uB2F9\uC2E0 \uD3EC\uD568. \u2026\uACE0\uB9C8\uC6CC\uC694."
      affinity: 10
    - label: "\uBC8C\uB4E4\uC774 \uBC18\uC9DD\uC5EC."
      reply: "\uD587\uC0B4\uC5D0 \uB0A0\uAC1C\uAC00 \uBE5B\uB098\uC694. \uB2F9\uC2E0
        \uB208\uC5D0\uB3C4 \uC608\uC058\uAC8C \uBCF4\uC5EC\uC11C \uAE30\uBED0\uC694."
      affinity: 8
    afterLines:
    - fromPlayer: 0
      text: "\uB538\uAE30 \uC528\uC557\uC774\uC5D0\uC694. \uAF43\uC774 \uD53C\uBA74
        \uBC8C\uB4E4\uC774 \uCC3E\uC544\uAC08 \uAC70\uC608\uC694."
    rewardItem: {fileID: 11400000, guid: aaca232007164504cbd41b9a9b8cbefb, type: 2}
    rewardItemAmount: 6
