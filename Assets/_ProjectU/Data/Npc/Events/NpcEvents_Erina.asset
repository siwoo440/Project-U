  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c705680e20332f5478f3a6911a134984, type: 3}
  m_Name: NpcEvents_Erina
  m_EditorClassIdentifier: Assembly-CSharp::NpcEventBook
  ownerId: char_erina
  events:
  - eventId: event_erina_curious
    title: "\uC232\uC758 \uC18C\uB9AC"
    requiredStage: 1
    locationId: loc_forest_fairy_ring
    fromHour: 7
    toHour: 11
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\u2026\uC870\uC6A9\uD788. \uB4E4\uB9AC\uB098? \uBC14\uB78C\uC774 \uBC84\uC12F
        \uACE0\uB9AC\uB97C \uC9C0\uB098\uAC00\uBA70 \uB0B4\uB294 \uC18C\uB9AC\uB2E4."
    - fromPlayer: 0
      text: "\uC778\uAC04\uC740 \uB300\uBD80\uBD84 \uC774 \uC18C\uB9AC\uB97C \uBABB
        \uB4E3\uB294\uB2E4. \uB108\uB294\u2026 \uC5B4\uB5A4\uAC00."
    choices:
    - label: "\uD76C\uBBF8\uD558\uAC8C \uB4E4\uB824."
      reply: "\u2026\uADF8\uB798. \uB4E4\uC73C\uB824\uB294 \uB9C8\uC74C\uC774 \uC788\uB2E4\uBA74
        \uB4E4\uB9B0\uB2E4. \uC81C\uBC95\uC774\uAD70."
      affinity: 5
    - label: "\uC544\uBB34 \uC18C\uB9AC\uB3C4 \uC548 \uB4E4\uB9AC\uB294\uB370?"
      reply: "\uC815\uC9C1\uD558\uAD70. \uAD1C\uCC2E\uB2E4. \uB2E4\uC74C\uC5D4 \uB208\uC744
        \uAC10\uACE0 \uB4E4\uC5B4 \uBD10\uB77C."
      affinity: 3
    afterLines:
    - fromPlayer: 0
      text: "\uC232\uC774 \uB108\uB97C \uAE30\uC5B5\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_erina_trust
    title: "\uADE0\uD615\uC744 \uC783\uC740 \uC911\uC7AC\uC790"
    requiredStage: 2
    locationId: loc_village_square
    fromHour: 15
    toHour: 18
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC608\uC804\uC5D0 \uC778\uAC04\uACFC \uC5D8\uD504 \uC0AC\uC774\uB97C
        \uC787\uB294 \uC911\uC7AC\uC790\uC600\uB2E4. \uC591\uCABD \uBAA8\uB450\uB97C
        \uC774\uD574\uD55C\uB2E4\uACE0 \uBBFF\uC5C8\uC9C0."
    - fromPlayer: 0
      text: "\uACB0\uAD6D \uC591\uCABD \uBAA8\uB450\uC5D0\uAC8C \uBC30\uC2E0\uC790\uB77C
        \uBD88\uB838\uB2E4. \u2026\uADF8 \uB4A4\uB85C \uB204\uAD6C\uC758 \uD3B8\uB3C4
        \uB4E4\uC9C0 \uC54A\uC558\uC5B4."
    choices:
    - label: "\uC774\uBC88\uC5D4 \uB0B4 \uD3B8 \uD574 \uC918."
      reply: "\u2026\uD3B8\uC774\uB77C. \uADF8 \uB9D0\uC774 \uC774\uB807\uAC8C \uAC00\uBCCD\uAC8C
        \uB4E4\uB9B4 \uC904\uC740 \uBAB0\uB790\uB2E4. \uC88B\uB2E4."
      affinity: 8
    - label: "\uB124 \uC798\uBABB\uC774 \uC544\uB2C8\uC5C8\uC5B4."
      reply: "\u2026\uADF8\uB807\uAC8C \uB9D0\uD574 \uC900 \uAC74 \uB124\uAC00 \uCC98\uC74C\uC774\uB2E4."
      affinity: 6
    afterLines:
    - fromPlayer: 0
      text: "\uAD11\uC7A5\uC758 \uC18C\uC74C\uB3C4 \uC624\uB298\uC740 \uC870\uAE08
        \uACAC\uB51C \uB9CC\uD558\uAD70."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_erina_affection
    title: "\uD568\uAED8 \uC3DC \uD654\uC0B4"
    requiredStage: 3
    locationId: loc_forest_edge
    fromHour: 11
    toHour: 15
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uD65C\uC744 \uC7A1\uC544 \uBD10\uB77C. \uC5B4\uAE68 \uD798\uC744 \uBE7C\uACE0,
        \uC228\uC744 \uBA48\uCD94\uACE0\u2026 \uC9C0\uAE08."
    - fromPlayer: 0
      text: "\u2026\uB9DE\uC558\uB2E4. \uCCAB \uD654\uC0B4\uCE58\uACE0\uB294 \uD6CC\uB96D\uD558\uAD70.
        \uAC00\uB974\uCE5C \uBCF4\uB78C\uC774 \uC788\uB2E4."
    choices:
    - label: "\uC5D0\uB9AC\uB098 \uB355\uBD84\uC774\uC57C."
      reply: "\u2026\uC774\uB7F0 \uAE30\uBD84\uC774\uAD70. \uB204\uAD70\uAC00\uC5D0\uAC8C
        \uBB34\uC5B8\uAC00\uB97C \uC804\uD55C\uB2E4\uB294 \uAC74."
      affinity: 10
    - label: "\uD55C \uBC88 \uB354 \uD574 \uBCFC\uB798!"
      reply: "\uC88B\uB2E4. \uD574\uAC00 \uC9C8 \uB54C\uAE4C\uC9C0\uB77C\uB3C4 \uBD10
        \uC8FC\uC9C0."
      affinity: 8
    afterLines:
    - fromPlayer: 0
      text: "\uB0B4 \uD654\uC0B4\uC774\uB2E4. \uB124 \uD65C\uD1B5\uC5D0 \uB123\uC5B4
        \uB46C\uB77C."
    rewardItem: {fileID: 11400000, guid: 1132e66db22cdae448d0dfb6dec7e8c1, type: 2}
    rewardItemAmount: 20
