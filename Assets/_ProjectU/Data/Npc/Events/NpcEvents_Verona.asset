  m_Script: {fileID: 11500000, guid: c705680e20332f5478f3a6911a134984, type: 3}
  m_Name: NpcEvents_Verona
  m_EditorClassIdentifier: Assembly-CSharp::NpcEventBook
  ownerId: char_verona
  events:
  - eventId: event_verona_curious
    title: "\uC0C8\uBCBD \uBC2D\uC758 \uAE30\uB3C4"
    requiredStage: 1
    locationId: loc_farm_fields
    fromHour: 6
    toHour: 12
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC27F. \uD759\uC774 \uC228 \uC26C\uB294 \uC18C\uB9AC\uB97C \uB4E3\uACE0
        \uC788\uC5C8\uB2E4."
    - fromPlayer: 0
      text: "\uB108\uB294 \uD759\uC744 \uB9CC\uC9C8 \uB54C \uBB34\uC5C7\uC744 \uC0DD\uAC01\uD558\uC9C0?"
    choices:
    - label: "\uC798 \uC790\uB77C \uB2EC\uB77C\uACE0 \uBE4C\uC5B4."
      reply: "\uC88B\uC740 \uB9C8\uC74C\uC774\uB2E4. \uB300\uC9C0\uB294 \uADF8 \uB9C8\uC74C\uC744
        \uAE30\uC5B5\uD558\uC9C0."
      affinity: 5
    - label: "\uC5BC\uB9C8\uC5D0 \uD314\uB9B4\uC9C0 \uC0DD\uAC01\uD574."
      reply: "\u2026\uC194\uC9C1\uD558\uAD70. \uADF8\uAC83\uB3C4 \uB098\uC058\uC9C4
        \uC54A\uC544."
      affinity: 1
    afterLines:
    - fromPlayer: 0
      text: "\uB2E4\uC74C\uC5D0 \uC528\uC557\uC744 \uC2EC\uC744 \uB54C, \uD55C \uBC88\uB9CC
        \uD759\uC5D0 \uC778\uC0AC\uD574 \uBD10."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_verona_trust
    title: "\uBB34\uB108\uC9C4 \uC2E0\uC804"
    requiredStage: 2
    locationId: loc_farm_fields
    fromHour: 13
    toHour: 18
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uB098\uB294 \uC6D0\uB798 \uB300\uC9C0\uC758 \uC2E0\uC804\uC744 \uC9C0\uD0A4\uB358
        \uC790\uC600\uB2E4."
    - fromPlayer: 0
      text: "\uC2E0\uC804\uC774 \uBB34\uB108\uC9C4 \uB0A0, \uB098\uB294 \uAE30\uB3C4\uD558\uB294
        \uBC95\uC744 \uC78A\uC5C8\uC9C0."
    choices:
    - label: "\uC774 \uBC2D\uC774 \uC0C8 \uC2E0\uC804\uC774\uC57C."
      reply: "\u2026\uBC2D\uC774 \uC2E0\uC804\uC774\uB77C. \uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uB2C8
        \uC190\uC774 \uB530\uB73B\uD574\uC9C0\uB294\uAD70."
      affinity: 8
    - label: "\uB2E4\uC2DC \uC9C0\uC73C\uBA74 \uB418\uC796\uC544."
      reply: "\uB3CC\uC740 \uB2E4\uC2DC \uC313\uC744 \uC218 \uC788\uC9C0. \uB9C8\uC74C\uC740\u2026
        \uCC9C\uCC9C\uD788 \uC313\uC544\uC57C \uD574."
      affinity: 3
    afterLines:
    - fromPlayer: 0
      text: "\uC624\uB298\uC740 \uC624\uB79C\uB9CC\uC5D0 \uAE30\uB3C4\uB97C \uD574
        \uBCFC\uAE4C \uD55C\uB2E4."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_verona_affection
    title: "\uC218\uD655\uC758 \uC57D\uC18D"
    requiredStage: 3
    locationId: loc_cafe
    fromHour: 18
    toHour: 20
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC624\uB298\uC740 \uB124\uAC8C \uD560 \uB9D0\uC774 \uC788\uC5B4\uC11C
        \uAE30\uB2E4\uB838\uB2E4."
    - fromPlayer: 0
      text: "\uB2E4\uC74C \uC218\uD655\uC81C\uC5D0\u2026 \uB0B4 \uC606\uC5D0 \uC11C
        \uC8FC\uACA0\uB098."
    choices:
    - label: "\uC601\uAD11\uC774\uC57C."
      reply: "\u2026\uACE0\uB9D9\uB2E4. \uB300\uC9C0\uB3C4 \uBD84\uBA85 \uAE30\uBED0\uD560
        \uAC70\uC57C."
      affinity: 10
    - label: "\uC0DD\uAC01\uD574 \uBCFC\uAC8C."
      reply: "\uC11C\uB450\uB974\uC9C0 \uC54A\uC544. \uC528\uC557\uCC98\uB7FC \uAE30\uB2E4\uB9AC\uC9C0."
      affinity: 2
    afterLines:
    - fromPlayer: 0
      text: "\uC774 \uC528\uC557\uC744 \uBC1B\uC544. \uC6B0\uB9AC \uB458\uC774 \uD0A4\uC6B4
        \uB538\uAE30\uB97C \uC218\uD655\uC81C\uC5D0 \uC62C\uB9AC\uC790."
    rewardItem: {fileID: 11400000, guid: aaca232007164504cbd41b9a9b8cbefb, type: 2}
    rewardItemAmount: 6
