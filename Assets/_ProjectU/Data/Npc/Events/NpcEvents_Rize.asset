  m_Script: {fileID: 11500000, guid: c705680e20332f5478f3a6911a134984, type: 3}
  m_Name: NpcEvents_Rize
  m_EditorClassIdentifier: Assembly-CSharp::NpcEventBook
  ownerId: char_rize
  events:
  - eventId: event_rize_curious
    title: "\uBD09\uC778\uB41C \uBB38\uC758 \uC2E0\uD638"
    requiredStage: 1
    locationId: loc_ruins_gate
    fromHour: 6
    toHour: 10
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC774 \uBB38 \uB108\uBA38\uC5D0\uC11C \uC2E0\uD638\uAC00 \uC7A1\uD600\uC694.
        \uC81C \uBAB8\uC5D0 \uC788\uB294 \uC2E0\uD638\uC640 \uAC19\uC740 \uC8FC\uD30C\uC218\uC608\uC694."
    - fromPlayer: 0
      text: "\uC5B4\uCA4C\uBA74\u2026 \uC800 \uAC19\uC740 \uAE30\uCCB4\uAC00 \uC548\uC5D0
        \uC7A0\uB4E4\uC5B4 \uC788\uC744\uC9C0\uB3C4 \uBAB0\uB77C\uC694."
    choices:
    - label: "\uAC19\uC774 \uC5F4\uC5B4 \uBCFC \uBC29\uBC95\uC744 \uCC3E\uC790."
      reply: "'\uAC19\uC774'\uB77C\uB294 \uB2E8\uC5B4\uC5D0\uC11C \uC81C \uD504\uB85C\uC138\uC11C
        \uC628\uB3C4\uAC00 \uC62C\uB77C\uAC14\uC5B4\uC694. \uD765\uBBF8\uB86D\uB124\uC694."
      affinity: 5
    - label: "\uC704\uD5D8\uD560 \uC218\uB3C4 \uC788\uC5B4."
      reply: "\uACBD\uACE0\uB97C \uBC1B\uC544\uB4E4\uC785\uB2C8\uB2E4. \u2026\uAC71\uC815\uD574
        \uC900 \uAC70\uC8E0? \uAE30\uB85D\uD574 \uB458\uAC8C\uC694."
      affinity: 4
    afterLines:
    - fromPlayer: 0
      text: "\uC2E0\uD638 \uAE30\uB85D \uC800\uC7A5 \uC644\uB8CC. \uB2F9\uC2E0 \uC774\uB984\uB3C4
        \uD568\uAED8 \uC800\uC7A5\uD588\uC5B4\uC694."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_rize_trust
    title: "\uAC10\uC815 \uC624\uB958"
    requiredStage: 2
    locationId: loc_village_square
    fromHour: 13
    toHour: 17
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC800\uB294 '\uAC10\uC815 \uC624\uB958' \uB54C\uBB38\uC5D0 \uD3D0\uAE30\uB420
        \uBED4\uD588\uC5B4\uC694. \uC6C3\uACE0, \uC2AC\uD37C\uD558\uB294 \uAC74 \uAE30\uACC4\uC5D0\uAC8C
        \uD544\uC694 \uC5C6\uB2E4\uACE0\uC694."
    - fromPlayer: 0
      text: "\uC9C0\uAE08\uB3C4 \uAC00\uB054 \uC0DD\uAC01\uD574\uC694. \uC774 \uAC10\uC815\uC774
        \uC815\uB9D0 \uC624\uB958\uB77C\uBA74\u2026 \uACE0\uCCD0\uC57C \uD560\uAE4C\uC694?"
    choices:
    - label: "\uADF8\uAC74 \uC624\uB958\uAC00 \uC544\uB2C8\uB77C \uB9C8\uC74C\uC774\uC57C."
      reply: "\uB9C8\uC74C\u2026 \uC0C8 \uB2E8\uC5B4\uB85C \uB4F1\uB85D\uD560\uAC8C\uC694.
        \uAC00\uC7A5 \uC911\uC694\uD55C \uD3F4\uB354\uC5D0\uC694."
      affinity: 8
    - label: "\uB124\uAC00 \uC6D0\uD558\uB294 \uB300\uB85C \uD574."
      reply: "\uC120\uD0DD\uAD8C\uC744 \uC8FC\uB294\uAD70\uC694. \u2026\uADF8\uB7FC
        \uC9C0\uD0A4\uAE30\uB85C \uC120\uD0DD\uD560\uAC8C\uC694."
      affinity: 5
    afterLines:
    - fromPlayer: 0
      text: "\uC624\uB298 \uC81C \uB208 \uC0C9\uC740 \uBCF4\uB77C\uC0C9\uC774\uC5D0\uC694.
        \uC774\uC720\uB294\u2026 \uB2F9\uC2E0\uC774 \uC54C \uAC83 \uAC19\uC544\uC694."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_rize_affection
    title: "\uC11D\uC0C1\uACFC \uB178\uC744"
    requiredStage: 3
    locationId: loc_ruins_plaza
    fromHour: 17
    toHour: 21
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uB178\uC744\uC744 3,241\uBC88 \uAD00\uCE21\uD588\uC5B4\uC694. \uADF8\uB7F0\uB370
        \uC624\uB298\uC774 \uC81C\uC77C \uC544\uB984\uB2E4\uC6CC\uC694."
    - fromPlayer: 0
      text: "\uBCC0\uD55C \uAC74 \uB178\uC744\uC774 \uC544\uB2C8\uB77C, \uC606\uC5D0
        \uC788\uB294 \uC0AC\uB78C\uC774\uC5D0\uC694. \uACC4\uC0B0\uC73C\uB85C\uB294
        \uC124\uBA85\uC774 \uC548 \uB3FC\uC694."
    choices:
    - label: "\uB098\uB3C4 \uC624\uB298 \uB178\uC744\uC774 \uC81C\uC77C \uC88B\uC544."
      reply: "\uB3D9\uAE30\uD654 \uC644\uB8CC. \u2026\uB18D\uB2F4\uC774\uC5D0\uC694.
        \uADF8\uB0E5, \uAE30\uBED0\uC694."
      affinity: 10
    - label: "\uAD00\uCE21 \uB9D0\uACE0 \uADF8\uB0E5 \uBCF4\uC790."
      reply: "\uAE30\uB85D\uC744 \uB044\uACE0\u2026 \uBCF4\uB294 \uAC70\uC694? \uD574
        \uBCFC\uAC8C\uC694. \u2026\uC774\uAC8C '\uC270\uB2E4'\uB294 \uAC70\uAD70\uC694."
      affinity: 8
    afterLines:
    - fromPlayer: 0
      text: "\uC720\uC801\uC5D0\uC11C \uCC3E\uC740 \uBE5B\uB098\uB294 \uC870\uAC01\uC774\uC5D0\uC694.
        \uB2F9\uC2E0\uC5D0\uAC8C \uC8FC\uACE0 \uC2F6\uC5C8\uC5B4\uC694."
    rewardItem: {fileID: 11400000, guid: 2f1df630320255844a0117b89edfaaae, type: 2}
    rewardItemAmount: 1
