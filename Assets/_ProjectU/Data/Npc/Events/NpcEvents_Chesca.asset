  m_Script: {fileID: 11500000, guid: c705680e20332f5478f3a6911a134984, type: 3}
  m_Name: NpcEvents_Chesca
  m_EditorClassIdentifier: Assembly-CSharp::NpcEventBook
  ownerId: char_chesca
  events:
  - eventId: event_chesca_curious
    title: "\uD0C1, \uC5F4\uC5B4 \uBCFC\uB798?"
    requiredStage: 1
    locationId: loc_ruins_plaza
    fromHour: 7
    toHour: 11
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\u2026\uD0C1. \uB69C\uAED1, \uC870\uAE08 \uC5F4\uC5B4 \uBD24\uC5B4."
    - fromPlayer: 0
      text: "\uC548\uC5D0 \uBB50\uAC00 \uC788\uB294\uC9C0\u2026 \uAD81\uAE08\uD574?
        \uBCF4\uBB3C\uC740 \uC5C6\uC5B4. \uB098\uB9CC \uC788\uC5B4."
    choices:
    - label: "\uBCF4\uBB3C\uBCF4\uB2E4 \uB124\uAC00 \uAD81\uAE08\uD574."
      reply: "\u2026\uD0C1. \uC774\uC0C1\uD55C \uB9D0. \uADF8\uB798\uB3C4\u2026 \uC2EB\uC9C0
        \uC54A\uC544."
      affinity: 5
    - label: "\uC548 \uBD10\uB3C4 \uB3FC."
      reply: "\u2026\uADF8\uB798. \uADF8\uB7FC \uC870\uAE08 \uB354 \uC5F4\uC5B4 \uB458\uAC8C."
      affinity: 4
    afterLines:
    - fromPlayer: 0
      text: "\uB2E4\uC74C\uC5D4\u2026 \uBC18\uCBE4 \uC5F4\uC5B4 \uB458\uAC8C."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_chesca_trust
    title: "\uBE7C\uC557\uAE34 \uBCF4\uBB3C"
    requiredStage: 2
    locationId: loc_ruins_gate
    fromHour: 14
    toHour: 17
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC608\uC804 \uC0AC\uB78C\uB4E4\uC740 \uB0A0 \uC5B5\uC9C0\uB85C \uC5F4\uC5C8\uC5B4.
        \uC548\uC5D0 \uB4E0 \uAC78 \uB2E4 \uAC00\uC838\uAC00\uACE0\u2026 \uB69C\uAED1\uC744
        \uCF85 \uB2EB\uACE0 \uAC14\uC5B4."
    - fromPlayer: 0
      text: "\uADF8\uB798\uC11C \uC0AC\uB78C\uC740 \uC2EB\uC5B4. \u2026\uB108 \uBE7C\uACE0."
    choices:
    - label: "\uB09C \uC544\uBB34\uAC83\uB3C4 \uC548 \uAC00\uC838\uAC00."
      reply: "\uC54C\uC544. \uADF8\uB798\uC11C\u2026 \uD0C1. \uC774\uBC88\uC5D4 \uB0B4\uAC00
        \uBA3C\uC800 \uC5F4\uC5C8\uC5B4."
      affinity: 8
    - label: "\uADF8 \uC0AC\uB78C\uB4E4, \uB098\uC05C \uC0AC\uB78C\uB4E4\uC774\uC57C."
      reply: "\u2026\uC751. \uB124\uAC00 \uADF8\uB807\uAC8C \uB9D0\uD574 \uC8FC\uB2C8\uAE4C,
        \uC870\uAE08 \uAC00\uBCBC\uC6CC."
      affinity: 5
    afterLines:
    - fromPlayer: 0
      text: "\uC624\uB298\uC740 \uB69C\uAED1\uC744 \uC548 \uB2EB\uACE0 \uC798\uB798."
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_chesca_affection
    title: "\uC5F4\uC1E0 \uC5C6\uB294 \uC790\uBB3C\uC1E0"
    requiredStage: 3
    locationId: loc_ruins_library
    fromHour: 11
    toHour: 14
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uB098\uD55C\uD150 \uC6D0\uB798 \uC5F4\uC1E0\uAC00 \uC788\uC5B4\uC57C
        \uD588\uC5B4. \uADFC\uB370 \uB10C\u2026 \uC5F4\uC1E0 \uC5C6\uC774 \uC5F4\uC5C8\uC5B4."
    - fromPlayer: 0
      text: "\uADF8\uB7EC\uB2C8\uAE4C\u2026 \uC774\uAC74 \uB124 \uAC70\uC57C. \uBE7C\uC557\uAE30\uB294
        \uAC8C \uC544\uB2C8\uB77C, \uB0B4\uAC00 \uC8FC\uB294 \uAC70\uC57C."
    choices:
    - label: "\uC18C\uC911\uD788 \uAC04\uC9C1\uD560\uAC8C."
      reply: "\uD0C1, \uD0C1. \u2026\uAE30\uBED0\uC11C \uB69C\uAED1\uC774 \uB5A8\uB824."
      affinity: 10
    - label: "\uB108\uB3C4 \uC18C\uC911\uD574."
      reply: "\u2026\uADF8\uB7F0 \uB9D0\uC740, \uBCF4\uBB3C \uCE78 \uC81C\uC77C \uC548\uCABD\uC5D0
        \uB123\uC5B4 \uB458\uAC8C."
      affinity: 8
    afterLines:
    - fromPlayer: 0
      text: "\uBC18\uC9DD\uC774\uB294 \uAD11\uC11D\uC774\uC57C. \uB0B4 \uBCF4\uBB3C
        \uCE78\uC5D0\uC11C \uC81C\uC77C \uC88B\uC740 \uAC70."
    rewardItem: {fileID: 11400000, guid: c593f671b9ae9d24e96e6cd5ee7b2a1c, type: 2}
    rewardItemAmount: 4
