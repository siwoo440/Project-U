  events:
  - eventId: event_milu_curious
    title: "\uBB3C\uC218\uC81C\uBE44"
    requiredStage: 1
    locationId: loc_pond_dock
    fromHour: 9
    toHour: 15
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uBBF8\uB8E8\uB3C4 \uBB3C\uC218\uC81C\uBE44 \uD558\uACE0 \uC2F6\uC5B4~
        \uADFC\uB370 \uB3CC\uC774 \uBAB8\uC5D0 \uC3D9 \uB4E4\uC5B4\uAC00~"
    - fromPlayer: 0
      text: "\uB108\uAC00 \uB358\uC9C0\uB294 \uAC70 \uBCF4\uC5EC \uC918~"
    choices:
    - label: "\uAC19\uC774 \uB358\uC838 \uBCF4\uC790."
      reply: "\uC640\uC544~ \uBBF8\uB8E8 \uB3CC\uC740 \uC138 \uBC88 \uD280\uC5C8\uC5B4~
        \uC544\uB2C8 \uBBF8\uB8E8\uAC00 \uD280\uC5C8\uC5B4~"
      affinity: 5
    - label: "\uBBF8\uB8E8\uAC00 \uB3CC\uBCF4\uB2E4 \uC798 \uD280\uACA0\uB2E4."
      reply: "\uD5E4\uD5E4~ \uBBF8\uB8E8 \uD1B5\uD1B5 \uD280\uB294 \uAC70 \uC88B\uC544\uD574~"
      affinity: 4
    afterLines:
    - fromPlayer: 0
      text: "\uB0B4\uC77C\uB3C4 \uBB3C\uC218\uC81C\uBE44 \uD558\uC790~ \uC57D\uC18D~"
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_milu_trust
    title: "\uB179\uC544 \uBC84\uB9B4\uAE4C \uBD10"
    requiredStage: 2
    locationId: loc_village_square
    fromHour: 15
    toHour: 17
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uD587\uBCD5\uC774 \uB108\uBB34 \uC138\uBA74~ \uBBF8\uB8E8\uAC00 \uC870\uAE08\uC529
        \uC791\uC544\uC838~"
    - fromPlayer: 0
      text: "\uADF8\uB798\uC11C \uAC00\uB054 \uBB34\uC11C\uC6CC~ \uBBF8\uB8E8\uAC00
        \uB2E4 \uC5C6\uC5B4\uC9C0\uBA74 \uC5B4\uB5A1\uD574~?"
    choices:
    - label: "\uB0B4\uAC00 \uADF8\uB298\uC774 \uB418\uC5B4 \uC904\uAC8C."
      reply: "\uADF8\uB298~? \uB108 \uC606\uC5D0 \uC788\uC73C\uBA74 \uBBF8\uB8E8
        \uC548 \uB179\uC544~"
      affinity: 8
    - label: "\uBB3C \uBFCC\uB824 \uC904\uAC8C."
      reply: "\uD5E4\uD5E4~ \uC2DC\uC6D0\uD574~ \uBBF8\uB8E8 \uB2E4\uC2DC \uD1B5\uD1B5\uD574\uC84C\uC5B4~"
      affinity: 5
    afterLines:
    - fromPlayer: 0
      text: "\uC774\uC81C \uD587\uBCD5 \uC548 \uBB34\uC11C\uC6CC~ \uB108 \uC788\uC73C\uB2C8\uAE4C~"
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_milu_affection
    title: "\uC774\uC2AC \uBAA9\uAC78\uC774"
    requiredStage: 3
    locationId: loc_swamp_boardwalk
    fromHour: 6
    toHour: 9
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uC544\uCE68 \uC774\uC2AC \uBAA8\uC544\uC11C~ \uBAA9\uAC78\uC774 \uB9CC\uB4E4\uC5C8\uC5B4~"
    - fromPlayer: 0
      text: "\uD587\uBCD5 \uBC1B\uC73C\uBA74 \uBC18\uC9DD\uBC18\uC9DD~ \uB108\uD55C\uD14C
        \uC8FC\uACE0 \uC2F6\uC5C8\uC5B4~"
    choices:
    - label: "\uACE0\uB9C8\uC6CC, \uB9E4\uC77C \uD560\uAC8C."
      reply: "\uB9E4\uC77C~? \uADF8\uB7FC \uBBF8\uB8E8\uB3C4 \uB9E4\uC77C \uB9CC\uB4E4\uB798~"
      affinity: 10
    - label: "\uBBF8\uB8E8\uAC00 \uB354 \uBC18\uC9DD\uC5EC."
      reply: "\uC5D0\uD5E4\uD5E4~ \uBBF8\uB8E8 \uC5BC\uAD74 \uBE68\uAC1C\uC84C\uC5B4~
        \uB538\uAE30 \uC824\uB9AC \uAC19\uC544~"
      affinity: 8
    afterLines:
    - fromPlayer: 0
      text: "\uC774\uAC74 \uBBF8\uB8E8\uAC00 \uB9CC\uB4E0 \uC824\uB9AC~ \uBAA9\uAC78\uC774\uB294
        \uB179\uC73C\uB2C8\uAE4C \uC774\uAC78\uB85C~"
