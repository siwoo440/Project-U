  m_Script: {fileID: 11500000, guid: c705680e20332f5478f3a6911a134984, type: 3}
  m_Name: NpcEvents_Harka
  m_EditorClassIdentifier: Assembly-CSharp::NpcEventBook
  ownerId: char_harka
  events:
  - eventId: event_harka_curious
    title: "\uC548\uAC1C \uC18D \uBC1C\uC790\uAD6D"
    requiredStage: 1
    locationId: loc_swamp_boardwalk
    fromHour: 6
    toHour: 9
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uD081\uD081\u2026 \uC774 \uBC1C\uC790\uAD6D, \uC218\uB2EC\uC774\uC57C!
        \uC548\uAC1C\uAC00 \uC9D9\uC5B4\uB3C4 \uB0C4\uC0C8\uB294 \uAC70\uC9D3\uB9D0
        \uC548 \uD574!"
    - fromPlayer: 0
      text: "\uB108\uB3C4 \uB9E1\uC544 \uBCFC\uB798? \u2026\uC544, \uC0AC\uB78C \uCF54\uB294
        \uC57D\uD558\uC9C0. \uBBF8\uC548, \uBA4D!"
    choices:
    - label: "\uD558\uB974\uCE74 \uCF54 \uCD5C\uACE0\uC57C."
      reply: "\uD5E4\uD5E4! \uAF2C\uB9AC\uAC00 \uBA48\uCD94\uC9C8 \uC54A\uC544! \uBA4D\uBA4D!"
      affinity: 5
    - label: "\uB098\uB3C4 \uC5F4\uC2EC\uD788 \uB9E1\uC544 \uBCFC\uAC8C."
      reply: "\uC88B\uC544! \uC624\uB298\uBD80\uD130 \uCD94\uC801 \uD6C8\uB828\uC0DD\uC774\uC57C!"
      affinity: 4
    afterLines:
    - fromPlayer: 0
      text: "\uB2E4\uC74C\uC5D4 \uB354 \uC5B4\uB824\uC6B4 \uBC1C\uC790\uAD6D \uCC3E\uC544
        \uC904\uAC8C!"
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_harka_trust
    title: "\uD574\uBCC0\uC5D0\uC11C \uCC3E\uC740 \uC0AC\uB78C"
    requiredStage: 2
    locationId: loc_village_square
    fromHour: 13
    toHour: 17
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uADF8\uB0A0 \uD574\uBCC0\uC5D0\uC11C \uC774\uC0C1\uD55C \uB0C4\uC0C8\uAC00
        \uB0AC\uC5B4. \uB530\uB77C\uAC00 \uBCF4\uB2C8\u2026 \uB124\uAC00 \uC4F0\uB7EC\uC838
        \uC788\uC5C8\uC9C0."
    - fromPlayer: 0
      text: "\uC608\uC804\uC5D0 \uB300\uC7A5\uC744 \uB05D\uAE4C\uC9C0 \uBABB \uCC3E\uC558\uAC70\uB4E0.
        \uADF8\uB798\uC11C \uB110 \uCC3E\uC558\uC744 \uB54C\u2026 \uC815\uB9D0 \uAE30\uBEE4\uC5B4."
    choices:
    - label: "\uCC3E\uC544 \uC918\uC11C \uACE0\uB9C8\uC6CC."
      reply: "\uD5E4\uD5E4\u2026 \uC774\uBC88\uC5D4 \uB193\uCE58\uC9C0 \uC54A\uC558\uC5B4.
        \uC55E\uC73C\uB85C\uB3C4 \uC808\uB300 \uC548 \uB193\uCCD0!"
      affinity: 8
    - label: "\uB300\uC7A5 \uC774\uC57C\uAE30, \uB354 \uB4E3\uACE0 \uC2F6\uC5B4."
      reply: "\u2026\uC751. \uC5B8\uC820\uAC00 \uB2E4 \uB9D0\uD574 \uC904\uAC8C.
        \uC9C0\uAE08\uC740 \uB124\uAC00 \uC788\uC73C\uB2C8\uAE4C \uAD1C\uCC2E\uC544."
      affinity: 6
    afterLines:
    - fromPlayer: 0
      text: "\uC624\uB298 \uC21C\uCC30 \uBCF4\uACE0\uC11C \uB9E8 \uC704\uC5D0 \uB124
        \uC774\uB984 \uC801\uC5C8\uC5B4!"
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
  - eventId: event_harka_affection
    title: "\uBB34\uB9AC\uC758 \uB9F9\uC138"
    requiredStage: 3
    locationId: loc_swamp_hut
    fromHour: 17
    toHour: 21
    weather: 0
    lines:
    - fromPlayer: 0
      text: "\uB124\uB9AC\uAC00 \uC624\uB298 \uBC24\uD558\uB298\uC774 \uB9D1\uB300!
        \uBCC4 \uBCF4\uBA74\uC11C \uB9F9\uC138\uD558\uAE30 \uB531 \uC88B\uC544!"
    - fromPlayer: 0
      text: "\uB098, \uD558\uB974\uCE74\uB294\u2026 \uB124 \uBB34\uB9AC\uB97C \uB05D\uAE4C\uC9C0
        \uC9C0\uD0AC \uAC70\uC57C. \uBA4D!"
    choices:
    - label: "\uB098\uB3C4 \uB110 \uC9C0\uD0AC\uAC8C."
      reply: "\uBA4D?! \u2026\uADF8, \uADF8\uB7F0 \uB9D0 \uD558\uBA74 \uAF2C\uB9AC\uAC00
        \uBA48\uCD94\uC9C8 \uC54A\uC796\uC544!"
      affinity: 10
    - label: "\uB9F9\uC138\uB294 \uB108\uBB34 \uAC70\uCC3D\uD574."
      reply: "\uAC70\uCC3D\uD55C \uAC8C \uC88B\uC544! \uC624\uB798 \uAE30\uC5B5\uB098\uB2C8\uAE4C!"
      affinity: 8
    afterLines:
    - fromPlayer: 0
      text: "\uD0D0\uD5D8 \uBAA8\uC790\uC57C! \uC6B0\uB9AC \uBB34\uB9AC \uD45C\uC2DC\uB85C
        \uC368 \uC918!"
    rewardItem: {fileID: 11400000, guid: 63a6ccd99ac6288459462be53a4919a5, type: 2}
    rewardItemAmount: 1
