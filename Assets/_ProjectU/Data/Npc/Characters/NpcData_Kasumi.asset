  m_Name: NpcData_Kasumi
  m_EditorClassIdentifier: Assembly-CSharp::NpcCharacterData
  characterId: char_kasumi
  displayName: "\uCE74\uC2A4\uBBF8"
  englishName: Kasumi
  isAlphaCast: 0
  isAvailable: 1
  profile:
    raceId: race_foxkin
    raceName: "\uC5EC\uC6B0\uC871 (Foxkin)"
    jobId: job_shrine_maiden
    jobName: "\uBB34\uB140"
    gender: "\uC5EC\uC131"
    age: "25\uC138"
    height: 166cm
    summary: "\uAC70\uC9D3\uC744 \uBB34\uAE30\uB85C \uC0BC\uC740 \uC5EC\uC6B0, \uC9C4\uC2EC\uC744
      \uCC3E\uC544 \uB098\uC120 \uC5EC\uC778. \uCE74\uC2A4\uBBF8\uB294 \uD658\uC220\uBCF4\uB2E4
      \uB354 \uC704\uD5D8\uD55C, \u2018\uC9C4\uC2E4\uD55C \uAC10\uC815\u2019\uC758
      \uC758\uBBF8\uB97C \uBC30\uC6CC\uAC04\uB2E4."
    symbolMotif: "\uC5EC\uC6B0\uBD88 / \uC548\uAC1C / \uBD89\uC740 \uBD80\uC801 (\uC9C4\uC2E4\uACFC
      \uD658\uC0C1\uC758 \uC0C1\uC9D5)"
    origin: "\uC548\uAC1C\uC0B0 \uB9C8\uC744 \u201C\uCE74\uAC00\uCE20\uB124 (Kagatsune)\u201D
      \u2013 \uC5EC\uC6B0\uC871\uC758 \uBE44\uBC00 \uAC70\uC8FC\uC9C0"
    affiliation: "\uD658\uC220\uC0AC \uC9D1\uB2E8 \u201C\uC740\uC548\uC758 \uC11C\uC6D0\u201D
      \uCD9C\uC2E0 / \uD604\uC7AC\uB294 \uB3C5\uB9BD \uC815\uBCF4\uC0C1"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uCC98\uC74C\uC5D4 \uC2DC\uD5D8\uD558\uB4EF
      \uC811\uADFC\uD558\uC9C0\uB9CC \uC810\uCC28 \uB9C8\uC74C\uC744 \uC5F0\uB2E4
      \u2022 \uBCA8\uB77C\uBAA8\uB974\uD0C0: \uC11C\uB85C\uC758 \uC720\uD639 \uBC29\uC2DD\uC744
      \uBE44\uAF2C\uBA70 \uACAC\uC81C\uD558\uB294 \uB77C\uC774\uBC8C \u2022 \uB9AC\uC81C:
      \uAC10\uC815 \uC5C6\uB294 \uAE30\uACC4\uB97C \uD765\uBBF8\uB86D\uAC8C \uC5EC\uAE40
      \u2022 \uB8E8\uB124\uD2B8: \uC21C\uC218\uD568\uC744 \uC7A5\uB09C\uC2A4\uB7FD\uAC8C
      \uB180\uB9AC\uC9C0\uB9CC \uB0B4\uC2EC \uBCF4\uD638\uD558\uB824 \uD568"
  appearance:
    hair: "\uBD89\uC740\uBE5B\uC774 \uAC10\uB3C4\uB294 \uC740\uAC08\uC0C9 \uB871\uD5E4\uC5B4,
      \uB05D\uC740 \uBD80\uB4DC\uB7EC\uC6B4 \uC6E8\uC774\uBE0C"
    eyes: "\uD638\uBC15\uBE5B \uAE08\uC548(\uF90A\u773C), \uB0A0\uCE74\uB86D\uC9C0\uB9CC
      \uB18D\uB2F4\uC774 \uC11E\uC778 \uC2DC\uC120"
    bodyImpression: "\uC720\uC5F0\uD558\uACE0 \uB9E4\uB048\uD55C \uCCB4\uD615, \uC5EC\uC6B0\uCC98\uB7FC
      \uB290\uAE0B\uD55C \uC6C0\uC9C1\uC784"
    outfit: "\uBD89\uC740 \uAE30\uBAA8\uB178\uD48D \uC804\uD22C\uBCF5, \uD5C8\uB9AC\uC5D4
      \uD770 \uB048\uACFC \uBD80\uC801 \uC8FC\uBA38\uB2C8"
    accessories: "\uBD80\uC801 \uD314\uCC0C, \uAF2C\uB9AC\uC5D0 \uBB36\uC778 \uBD89\uC740
      \uB9AC\uBCF8"
    features: "\uC5EC\uC6B0 \uADC0\uC640 \uD07C\uC9C1\uD55C \uBD89\uC740 \uAF2C\uB9AC
      1~2\uAC00\uB2E5, \uAC10\uC815\uC5D0 \uB530\uB77C \uAF2C\uB9AC\uAC00 \uC0B4\uC9DD
      \uD754\uB4E4\uB9BC"
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uC548\uAC1C
      \uB080 \uC232, \uBD89\uC740 \uBD80\uC801\uACFC \uC5EC\uC6B0\uBD88, \uB530\uB73B\uD55C
      \uC870\uBA85 \uD6A8\uACFC"
  themeColor: {r: 0.95686275, g: 0.7647059, b: 0.6313726, a: 1}
  accentColor: {r: 0.6431373, g: 0.1764706, b: 0.15294118, a: 1}
  personality:
    tags:
    - "\uAD50\uD65C"
    - "\uB9E4\uD639\uC801"
    - "\uC774\uC9C0\uC801"
    - "\uAD00\uCC30\uC790"
    - "\uC720\uBA38\uB7EC\uC2A4"
    speechStyle: "\uBD80\uB4DC\uB7FD\uC9C0\uB9CC \uC5B4\uB518\uAC00 \uB3C4\uBC1C\uC801.
      \uC6C3\uC744 \uB54C \uC190\uB05D\uC73C\uB85C \uC785\uC744 \uC0B4\uC9DD \uAC00\uB9BC"
    trauma: "\uC790\uC2E0\uC758 \uD658\uC220\uC774 \uD0C0\uC778\uC758 \uC2E0\uB8B0\uB97C
      \uBB34\uB108\uB728\uB9B0 \uACFC\uAC70. \u201C\uC9C4\uC2EC\uACFC \uAC70\uC9D3\u201D\uC758
      \uACBD\uACC4\uC5D0 \uD63C\uB780\uC744 \uB290\uB08C"
    desire: "\u2018\uC9C4\uC2E4\uD55C \uAD00\uACC4\u2019\uB97C \uC2A4\uC2A4\uB85C
      \uC99D\uBA85\uD558\uACE0\uC790 \uD568. \uD658\uC220\uC774 \uC544\uB2CC \uC9C4\uC2EC\uC73C\uB85C
      \uB204\uAD70\uAC00\uC5D0\uAC8C \uC778\uC815\uBC1B\uACE0 \uC2F6\uC5B4 \uD568"
    background: "\uACFC\uAC70 \uC655\uAD6D\uC758 \uCCA9\uBCF4 \uC784\uBB34 \uC911
      \uD658\uC220\uC774 \uC2E4\uD328\uD574 \uBB34\uACE0\uD55C \uC774\uB4E4\uC744
      \uD76C\uC0DD\uC2DC\uD0B4. \uADF8 \uC774\uD6C4 \uC790\uC2E0\uC758 \uB2A5\uB825\uC744
      \uACBD\uACC4\uD558\uBA70 \uC678\uBD80 \uC138\uACC4\uB97C \uB5A0\uB3CC\uACE0
      \uC788\uB2E4. \uC12C\uC5D0 \uC624\uAC8C \uB41C \uB4A4, \uD50C\uB808\uC774\uC5B4\uC758
      \uC874\uC7AC\uB97C \u201C\uAC70\uC9D3 \uC5C6\uB294 \uC2DC\uC120\u201D\uC73C\uB85C
      \uCC98\uC74C \uB290\uB07C\uAC8C \uB41C\uB2E4."
    voiceConcept: "\uB0AE\uACE0 \uBD80\uB4DC\uB7EC\uC6B4 \uC5EC\uC131 \uBCF4\uC774\uC2A4.
      \uC5EC\uC720 \uC788\uB294 \uB9D0\uD22C, \uAC04\uD5D0\uC801\uC778 \uC7A5\uB09C\uC2A4\uB7EC\uC6B4
      \uC6C3\uC74C"
