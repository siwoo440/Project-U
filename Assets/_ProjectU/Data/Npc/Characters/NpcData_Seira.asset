  profile:
    raceId: race_lamia
    raceName: "\uB77C\uBBF8\uC544 (Lamia, \uBC18\uC778\uBC18\uC0AC\uC871)"
    jobId: job_ruin_scholar
    jobName: "\uACE0\uB300 \uC720\uC801\uC758 \uC9C0\uC2DD \uAD00\uB9AC\uC790 / \uB3C5
      \uC5F0\uAD6C\uAC00"
    gender: "\uC5EC\uC131"
    age: "210\uC138 / \uC678\uD615 25\uC138"
    height: "\uC0C1\uBC18\uC2E0 \uAE30\uC900 172cm / \uC804\uCCB4 \uAE38\uC774 \uC57D
      5m"
    summary: "\uB0B4 \uB3C5\uC740 \uC800\uC8FC\uAC00 \uC544\uB2C8\uC57C. \uC138\uC774\uB77C\uB294
      \uAE08\uB2E8\uC758 \uC9C0\uC2DD\uC744 \uD488\uC740 \uB77C\uBBF8\uC544 \u2014
      \uC0AC\uB791\uC744 \uB3C5\uCC98\uB7FC \uB290\uB07C\uC9C0\uB9CC, \uADF8 \uB3C5\uC774\uC57C\uB9D0\uB85C
      \uC0DD\uBA85 \uADF8 \uC790\uCCB4\uB2E4."
    symbolMotif: "\uBC40 / \uB3C5 / \uC9C0\uC2DD / \uAE08\uB2E8\uC758 \uC5F4\uB9E4"
    origin: "\u201C\uC790\uB974\uB518\uC758 \uC720\uC801 (Ruins of Jardin)\u201D
      \u2013 \uACE0\uB300 \uC5F0\uAD6C\uC18C \uD3D0\uD5C8 \uC9C0\uD558"
    affiliation: "\uACE0\uB300 \uBB38\uBA85\uC758 \uC9C0\uC2DD \uAD00\uB9AC\uC790
      / \uB3C5\uC758 \uC5F0\uAE08\uC220\uC0AC"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uCD08\uBC18\uC5D4 \uC2E4\uD5D8\uCCB4\uB85C
      \uAD00\uCC30\uD558\uC9C0\uB9CC, \uC810\uCC28 \uC778\uAC04\uC131\uC5D0 \uB04C\uB9BC
      \u2022 \uB178\uD06C\uD2F0\uC544: \uACFC\uAC70 \uB3D9\uC2DC\uB300\uC758 \uC5F0\uAD6C\uC790\uC600\uB358
      \uC778\uC5F0 \u2022 \uBCA8\uB77C\uBAA8\uB974\uD0C0: \uC11C\uB85C\uC758 \uB3C5\uC744
      \uC5F0\uAD6C\uD55C \uC801\uC774 \uC788\uC74C"
  appearance:
    hair: "\uC5B4\uB450\uC6B4 \uBCF4\uB77C\uBE5B\uC758 \uC2E4\uD06C \uC2A4\uD2B8\uB808\uC774\uD2B8,
      \uB05D\uC774 \uBE44\uB298\uC0C9\uC73C\uB85C \uADF8\uB7EC\uB370\uC774\uC158\uB428"
    eyes: "\uC138\uB85C\uB85C \uAC08\uB77C\uC9C4 \uAE08\uBE5B \uB3D9\uACF5, \uBC40\uC758
      \uB208\uCC98\uB7FC \uBC18\uC9DD\uC784"
    bodyImpression: "\uC131\uC219\uD558\uACE0 \uC720\uB824\uD55C \uC778\uC0C1, \uC6B0\uC544\uD558\uC9C0\uB9CC
      \uC704\uD611\uC801\uC778 \uAE30\uD488"
    outfit: "\uC0C1\uCCB4\uB294 \uAC80\uC740 \uC2E4\uD06C \uB7A9\uD0D1\uACFC \uAE08\uC7A5
      \uC7A5\uC2DD, \uD558\uBC18\uC2E0\uC740 \uBE44\uB298\uC774 \uB9E4\uB044\uB7FD\uAC8C
      \uC774\uC5B4\uC9D0 \uD314\uBAA9\uC5D4 \uAE08\uC0C9 \uD314\uCC0C, \uB3C5\uC744
      \uBD09\uC778\uD55C \uD45C\uC2DD\uC774 \uC788\uC74C"
    accessories: "\uBC40 \uBB38\uC591\uC758 \uD314\uCC0C, \uB8E8\uBE44 \uBCF4\uC11D
      \uBAA9\uAC78\uC774, \uACE0\uB300 \uBB38\uC591\uC774 \uC0C8\uACA8\uC9C4 \uD314\uB760"
    features: "\uD558\uBC18\uC2E0\uC740 \uC5D0\uBA54\uB784\uB4DC\uBE5B \uBE44\uB298\uC774
      \uAC10\uC2FC \uAE34 \uBC40\uC758 \uBAB8. \uC6C0\uC9C1\uC77C \uB54C\uB9C8\uB2E4
      \uC740\uC740\uD55C \uAE08\uC18D\uC74C\uACFC \uD568\uAED8 \uD5A5\uAE30\uB85C\uC6B4
      \uB0C4\uC0C8\uAC00 \uB0A8. \uB9D0\uC744 \uD560 \uB54C \uD600\uB05D\uC774 \uC0B4\uC9DD
      \uAC08\uB77C\uC838 \uBC1C\uC74C\uC5D0 \uB3C5\uD2B9\uD55C \uB9AC\uB4EC\uC774
      \uC788\uC74C."
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uACE0\uB300
      \uC720\uC801 \uB0B4\uBD80, \uBC40\uC758 \uAF2C\uB9AC\uAC00 \uAC10\uAE34 \uC790\uC138,
      \uAE08\uBE5B \uB208\uACFC \uBCF4\uB78F\uBE5B \uC870\uBA85, \uBE44\uB298\uC758
      \uC9C8\uAC10 \uAC15\uC870, \uC740\uC740\uD55C \uC720\uD639 \uD3EC\uC988 \uCD94\uCC9C"
  portrait: {fileID: 21300000, guid: b83e6ceee6c7b2249b8149a549a4b1d9, type: 3}
  themeColor: {r: 0.36862746, g: 0.24313726, b: 0.46666667, a: 1}
  accentColor: {r: 0.7490196, g: 0.6313726, b: 0.27058825, a: 1}
  personality:
    tags:
    - "\uC9C0\uD61C"
    - "\uB0C9\uC815"
    - "\uC720\uD639"
    - "\uB3C5\uB9BD"
    - "\uAD00\uCC30\uC790\uC801 \uD0DC\uB3C4"
    speechStyle: "\uB290\uB9AC\uACE0 \uB9E4\uD639\uC801\uC778 \uB9D0\uD22C, \uB2E8\uC5B4
      \uC0AC\uC774\uC5D0 \uC228\uC744 \uACE0\uB974\uB294 \uB4EF\uD55C \uC5EC\uBC31\uC774
      \uC788\uC74C. \uC0C1\uB300\uC758 \uD45C\uC815\uC744 \uC0B4\uD53C\uBA70 \uBBF8\uC18C
      \uC9D3\uB294 \uBC84\uB987\uC774 \uC788\uC74C."
    trauma: "\uC778\uAC04 \uC2DC\uC808 \uBC30\uC2E0\uB2F9\uD574 \u2018\uB3C5\uC758
      \uC800\uC8FC\u2019\uB97C \uBC1B\uC74C. \uADF8 \uD6C4 \uB77C\uBBF8\uC544\uB85C
      \uBCC0\uD574\uBC84\uB838\uC73C\uBA70, \uBC30\uC2E0\uACFC \uC2E0\uB8B0\uC758
      \uACBD\uACC4\uC5D0\uC11C \uC0B4\uC544\uAC10."
    desire: "\u201C\uC9C4\uC2E4\uC744 \uB9D0\uD574\uB3C4 \uB3C5\uCC98\uB7FC \uBC1B\uC544\uB4E4\uC774\uC9C0
      \uC54A\uC744 \uC0AC\uB78C\u201D\uC744 \uCC3E\uACE0 \uC788\uC74C. \uC989, \uC790\uC2E0\uC758
      \uBCF8\uC131\uC744 \uC774\uD574\uBC1B\uB294 \uAC83."
    background: "\uC138\uC774\uB77C\uB294 \uC624\uB798\uC804 \uC778\uAC04 \uD559\uC790\uC600\uC9C0\uB9CC,
      \uAE08\uC9C0\uB41C \u2018\uBD88\uBA78\uC758 \uC5F0\uAD6C\u2019\uB97C \uC2DC\uB3C4\uD558\uB2E4
      \uB3D9\uB8CC\uC5D0\uAC8C \uBC30\uC2E0\uB2F9\uD574 \uC800\uC8FC\uB85C \uB77C\uBBF8\uC544\uAC00
      \uB428. \uC9C0\uD558 \uC720\uC801\uC5D0 \uC740\uAC70\uD558\uC5EC \uC9C0\uC2DD\uC744
      \uC9C0\uD0A4\uACE0 \uC788\uC73C\uBA70, \uC790\uC2E0\uC744 \uCC3E\uB294 \uC790\uB4E4\uC5D0\uAC8C
      \u201C\uC9C0\uC2DD\uC758 \uB300\uAC00\u201D\uB85C \uC704\uD5D8\uD55C \uC9C4\uC2E4\uC744
      \uC18D\uC0AD\uC778\uB2E4. \uD50C\uB808\uC774\uC5B4\uAC00 \uC720\uC801 \uD0D0\uC0AC
      \uC911 \uD568\uC815\uC5D0 \uBE60\uC84C\uC744 \uB54C \uADF8\uB140\uAC00 \uAD6C\uD574\uC8FC\uBA70
      \uB9CC\uB0A8\uC774 \uC2DC\uC791\uB428."
    voiceConcept: "\uB0AE\uACE0 \uB9E4\uD639\uC801\uC778 \uC5EC\uC131 \uBAA9\uC18C\uB9AC.
      \uBC1C\uC74C\uC774 \uB290\uB9AC\uACE0 \uBD80\uB4DC\uB7FD\uAC8C \uD750\uB984.
      \uC228\uC18C\uB9AC\uC640 \uD568\uAED8 \uAC10\uC815\uC774 \uC11E\uC774\uB294
      \uC2A4\uD0C0\uC77C."
