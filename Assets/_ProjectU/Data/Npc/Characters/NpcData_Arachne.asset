  profile:
    raceId: race_arachnia
    raceName: "\uC544\uB77C\uD06C\uB2C8\uC544 (Arachnia, \uBC18\uC778\uBC18\uAC70\uBBF8\uC871)"
    jobId: job_designer
    jobName: "\uB514\uC790\uC774\uB108"
    gender: "\uC5EC\uC131"
    age: "23\uC138"
    height: "\uC0C1\uBC18\uC2E0 \uAE30\uC900 170cm / \uC804\uCCB4 \uAE38\uC774 \uC57D
      230cm"
    summary: "\uAC70\uBBF8\uC758 \uC2E4\uC740 \uC0DD\uBA85\uC744 \uC774\uC5B4\uC8FC\uAE30\uB3C4,
      \uB04A\uC5B4\uBC84\uB9AC\uAE30\uB3C4 \uD55C\uB2E4. \uC544\uB77C\uD06C\uB124\uB294
      \uADF8 \uACBD\uACC4 \uC704\uC5D0\uC11C \u2018\uC544\uB984\uB2E4\uC6C0\uC758
      \uACF5\uD3EC\u2019\uB97C \uC9C1\uC870\uD558\uB294 \uC608\uC220\uAC00\uB2E4."
    symbolMotif: "\uC2E4 / \uADF8\uB9BC\uC790 / \uCC3D\uC870 (\uC0DD\uBA85\uACFC
      \uD30C\uAD34\uC758 \uC774\uC911\uC131 \uC0C1\uC9D5)"
    origin: "\uC9C0\uD558\uC758 \uB3C4\uC2DC \u201C\uB204\uC544\uB974 \uD558\uC774\uBE0C
      (Noir Hive)\u201D \u2013 \uAC70\uBBF8\uC871\uB4E4\uC774 \uBAA8\uC5EC \uC0AC\uB294
      \uC740\uD3D0\uB41C \uACF5\uAC04"
    affiliation: "\uC554\uC0B4\uC790 \uAE38\uB4DC \u201CSilken Veil\u201D \uC18C\uC18D.
      \uD604\uC7AC\uB294 \uB3C5\uB9BD \uD65C\uB3D9 \uC911"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uCC98\uC74C\uC5D4 \uACBD\uACC4\uD558\uC9C0\uB9CC,
      \uC790\uC2E0\uC744 \uB450\uB824\uC6CC\uD558\uC9C0 \uC54A\uB294 \uBAA8\uC2B5\uC5D0
      \uD638\uAC10\uC744 \uB290\uB08C \u2022 \uBCA8\uB77C\uBAA8\uB974\uD0C0: \uC11C\uB85C\uC758
      \uAE30\uC220\uC744 \uC874\uC911. \uB0C9\uC815\uD55C \uB300\uD654\uB97C \uC790\uC8FC
      \uB098\uB214 \u2022 \uB9AC\uC81C: \uAC10\uC815 \uC5C6\uB294 \uAE30\uACC4\uB77C
      \uC0DD\uAC01\uD558\uC9C0\uB9CC \uC810\uCC28 \u2018\uC21C\uC218\uD55C \uC774\uC131\u2019\uC5D0
      \uD765\uBBF8\uB97C \uB290\uB08C"
  appearance:
    hair: "\uAC80\uC740 \uC790\uC0C9\uC758 \uB871\uD5E4\uC5B4, \uC2E4\uCC98\uB7FC
      \uAC00\uB298\uACE0 \uC724\uAE30 \uC788\uC74C"
    eyes: "\uBD89\uC740 \uC640\uC778\uC0C9, \uC5B4\uB460 \uC18D\uC5D0\uC11C\uB3C4
      \uD76C\uBBF8\uD558\uAC8C \uBE5B\uB0A8"
    bodyImpression: "\uC720\uB824\uD558\uACE0 \uC6B0\uC544\uD55C \uC0C1\uBC18\uC2E0,
      \uB0A0\uB835\uD55C \uD314\uACFC \uC5B4\uAE68\uC120"
    outfit: "\uAC00\uC2B4\uACFC \uC5B4\uAE68\uB97C \uAC00\uBCCD\uAC8C \uB36E\uB294
      \uAC80\uC740 \uB808\uB354\uD0D1 + \uB9DD\uC0AC \uC7A5\uC2DD, \uD558\uBC18\uC2E0\uC740
      \uAC70\uBBF8 \uB2E4\uB9AC 8\uAC1C\uAC00 \uB9E4\uB044\uB7FD\uAC8C \uC5F0\uACB0"
    accessories: "\uAC70\uBBF8\uC904\uB85C \uC9E0 \uCD08\uCEE4, \uD5C8\uB9AC\uC5D0
      \uC791\uC0B4\uD615 \uB2E8\uAC80\uACFC \uBBF8\uC138\uD55C \uC2E4 \uC8FC\uBA38\uB2C8"
    features: "\uB4F1 \uB4A4\uC758 \uAC70\uBBF8 \uB2E4\uB9AC\uB294 \uC720\uC5F0\uD558\uAC8C
      \uC6C0\uC9C1\uC774\uBA70, \uADF8\uB140\uC758 \uAC10\uC815 \uC0C1\uD0DC\uC5D0
      \uB530\uB77C \uC18D\uB3C4\uC640 \uB5A8\uB9BC\uC774 \uB2EC\uB77C\uC9D0. \uAC70\uBBF8\uC904\uC740
      \uB9C8\uBC95\uC801 \uC131\uC9C8\uC744 \uAC00\uC9D0."
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uC5B4\uB450\uC6B4
      \uC9C0\uD558 \uBC30\uACBD, \uC740\uC740\uD55C \uBCF4\uB78F\uBE5B, \uC12C\uC138\uD55C
      \uAC70\uBBF8\uC904 \uBB18\uC0AC \uAC15\uC870"
  portrait: {fileID: 21300000, guid: a221a26d982999044adbd313a6759103, type: 3}
  themeColor: {r: 0.18039216, g: 0.12156863, b: 0.20784314, a: 1}
  accentColor: {r: 0.7176471, g: 0.6156863, b: 0.79607844, a: 1}
  personality:
    tags:
    - "\uCE68\uCC29"
    - "\uB0C9\uC815"
    - "\uC138\uBC00"
    - "\uB0B4\uC131\uC801 \uC644\uBCBD\uC8FC\uC758\uC790"
    speechStyle: "\uCC9C\uCC9C\uD788, \uADE0\uD615 \uC7A1\uD78C \uC5B4\uC870\uB85C
      \uB9D0\uD568. \uC190\uB05D\uC73C\uB85C \uC2E4\uC744 \uAC10\uAC70\uB098 \uB9E4\uB9CC\uC9C0\uB294
      \uBC84\uB987"
    trauma: "\u201C\uAD34\uBB3C\u201D\uC774\uB77C \uBD88\uB9AC\uBA70 \uBC30\uCC99\uB2F9\uD55C
      \uACFC\uAC70. \uD0C0\uC778\uC758 \uC2DC\uC120\uC744 \uB450\uB824\uC6CC\uD558\uBA74\uC11C\uB3C4
      \uC778\uC815\uBC1B\uACE0 \uC2F6\uC5B4 \uD568"
    desire: "\uC790\uC2E0\uC774 \uB9CC\uB4E0 \u2018\uC608\uC220\uC801 \uC2E4(\u7D72)\u2019\uB85C
      \uC138\uC0C1\uC5D0 \uC544\uB984\uB2E4\uC6C0\uC744 \uC99D\uBA85\uD558\uACE0
      \uC2F6\uC5B4 \uD568. \uB2E8, \uADF8 \uC2E4\uC740 \uB3D9\uC2DC\uC5D0 \uC8FD\uC74C\uC744
      \uAC00\uC838\uC624\uAE30\uB3C4 \uD568."
    background: "\uC544\uB77C\uD06C\uB124\uB294 \uC6D0\uB798 \uC655\uAD6D \uADC0\uC871\uC758
      \uD558\uB140\uC600\uC73C\uB098, \uC815\uAD50\uD55C \uC2E4 \uACF5\uC608\uB85C
      \uC774\uB984\uC744 \uC54C\uB838\uB2E4. \uADF8\uB7EC\uB098 \u2018\uAC70\uBBF8\uC871\u2019\uC774\uB77C\uB294
      \uC774\uC720\uB85C \uBC30\uCC99\uB2F9\uD558\uACE0, \uC9C0\uD558\uB85C \uCD94\uBC29\uB41C
      \uB4A4 \uC554\uC0B4\uC790 \uC9D1\uB2E8\uC5D0\uC11C \uC0DD\uC874\uBC95\uC744
      \uBC30\uC6E0\uB2E4. \uC774\uD6C4 \u2018\uBE5B\uC758 \uC138\uACC4\uC5D0\uC11C\uB3C4
      \uC2E4\uB85C \uC608\uC220\uC744 \uC9DC\uB294 \uC790\u2019\uB85C \uBD88\uB9AC\uBA70
      \uC740\uBC00\uD788 \uD65C\uB3D9 \uC911\uC774\uB2E4."
    voiceConcept: "\uB0AE\uACE0 \uBD80\uB4DC\uB7EC\uC6B4 \uC911\uC800\uC74C \uC5EC\uC131
      \uBCF4\uC774\uC2A4. \uCC28\uBD84\uD558\uACE0 \uB290\uB9B0 \uC5B4\uC870, \uAC10\uC815\uC774
      \uC801\uC9C0\uB9CC \uC5EC\uC6B4\uC774 \uAE38\uB2E4"
