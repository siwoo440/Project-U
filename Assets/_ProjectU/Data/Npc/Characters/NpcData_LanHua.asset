  m_Name: NpcData_LanHua
  m_EditorClassIdentifier: Assembly-CSharp::NpcCharacterData
  characterId: char_lanhua
  displayName: "\uB780\uD6C4\uC544"
  englishName: LanHua
  isAlphaCast: 0
  isAvailable: 1
  profile:
    raceId: race_tigerkin
    raceName: "\uD638\uB791\uC774\uC871 (Tigerkin)"
    jobId: job_martial_artist
    jobName: "\uBB34\uD22C\uAC00 / \uB3C4\uC7A5 \uC0AC\uBC94 / \uC218\uB828\uAC00"
    gender: "\uC5EC\uC131"
    age: "28\uC138"
    height: 171cm
    summary: "\uD798\uC740 \uAC80\uC774 \uC544\uB2C8\uB77C, \uB9C8\uC74C\uC5D0\uC11C
      \uD750\uB978\uB2E4. \uB780\uD6C4\uC544\uB294 \uC0C1\uCC98\uBC1B\uC740 \uBB34\uC778
      \u2014 \uADF8\uB7EC\uB098 \uB2E4\uC2DC \uC138\uC0C1\uC744 \uC9C0\uD0A4\uB824\uB294
      \uD638\uB791\uC774\uC758 \uD63C\uC744 \uD488\uACE0 \uC788\uB2E4."
    symbolMotif: "\uD638\uB791\uC774 / \uB300\uB098\uBB34 / \uAC80\uC740 \uBC14\uB78C
      / \uB3C4\uC7A5 \uAE43\uBC1C"
    origin: "\u201C\uC6B4\uB8E1\uC0B0(\u96F2\u9F8D\u5C71)\u201D \u2013 \uC0B0\uB9E5
      \uC18D\uC5D0 \uC228\uACA8\uC9C4 \uD638\uB791\uC774\uC871 \uB3C4\uC7A5"
    affiliation: "\uD638\uB791\uC774 \uB3C4\uC7A5 \u2018\uBC31\uB791\uAD00(\u767D\u72FC\u9928)\u2019\uC758
      \uC0AC\uBC94 / \uD604\uC7AC \uC740\uB454 \uC911"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uCC98\uC74C\uC5D4 \uC81C\uC790\uB85C
      \uB300\uD558\uC9C0\uB9CC \uC810\uCC28 \uB9C8\uC74C\uC744 \uC5F4\uBA70 \uAC10\uC815\uC774
      \uAE4A\uC5B4\uC9D0 \u2022 \uBCA0\uB85C\uB098: \uC11C\uB85C\uC758 \uCCA0\uD559\uC744
      \uC874\uC911\uD558\uB294 \uC804\uC6B0\uC801 \uAD00\uACC4 \u2022 \uBCA0\uC544\uD2B8\uB9AC\uCCB4:
      \uD6C8\uB828 \uD0DC\uB3C4\uC5D0 \uAC10\uD0C4\uD558\uBA70 \uC2A4\uD30C\uB9C1
      \uC0C1\uB300\uB85C \uC778\uC815"
  appearance:
    hair: "\uD751\uC790\uC0C9(\uAC80\uC740\uBE5B\uC5D0 \uAE08\uBE5B\uC774 \uB3C4\uB294
      \uBA38\uB9AC), \uBB36\uC740 \uD3EC\uB2C8\uD14C\uC77C. \uC6C0\uC9C1\uC77C \uB54C\uB9C8\uB2E4
      \uB2E8\uC815\uD558\uAC8C \uD754\uB4E4\uB9BC"
    eyes: "\uD638\uBC15\uBE5B \uB208\uB3D9\uC790, \uAC15\uB82C\uD55C \uC2DC\uC120\uC774\uC9C0\uB9CC
      \uB530\uB73B\uD55C \uC5EC\uC6B4\uC774 \uC788\uC74C"
    bodyImpression: "\uADFC\uC721\uC120\uC774 \uC544\uB984\uB2E4\uC6B4 \uC804\uC0AC\uD615.
      \uAC15\uC778\uD568\uACFC \uC5EC\uC131\uC2A4\uB7EC\uC6C0\uC774 \uADE0\uD615
      \uC7A1\uD78C \uCCB4\uD615"
    outfit: "\uC911\uD654\uD48D \uBB34\uC220\uBCF5(\u7D05\u9ED1 \uC870\uD569), \uD5C8\uB9AC\uC5D0
      \uAE08\uB048. \uC218\uB828 \uC2DC\uC5D4 \uC0C1\uC758\uAC00 \uC9E7\uC544 \uBCF5\uADFC\uC774
      \uC0B4\uC9DD \uB4DC\uB7EC\uB098\uBA70, \uBD89\uC740 \uC190\uB760\uB97C \uCC29\uC6A9."
    accessories: "\uD638\uB791\uC774 \uC774\uBE68 \uD39C\uB358\uD2B8, \uAE08\uC18D
      \uD314\uCC0C, \uB3C4\uC7A5 \uC0C1\uC9D5 \uD314\uB048"
    features: "\uC9D9\uC740 \uD638\uB791\uC774 \uBB34\uB2AC \uC904\uBB34\uB2AC, \uADC0\uC640
      \uAF2C\uB9AC\uAC00 \uC9C4\uD55C \uAE08\uBE5B \uD138\uB85C \uB36E\uC5EC \uC788\uC74C.
      \uBD84\uB178 \uC2DC \uB208\uB3D9\uC790\uAC00 \uBE5B\uB098\uBA70 \uAF2C\uB9AC\uAC00
      \uBD80\uD480\uC5B4 \uC624\uB984."
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uC911\uD654\uD48D
      \uB3C4\uC7A5 \uBC30\uACBD, \uBD89\uC740 \uBB34\uC220\uBCF5, \uBC14\uB78C\uC5D0
      \uD769\uB0A0\uB9AC\uB294 \uBA38\uB9AC, \uADFC\uC721\uC120\uACFC \uBD93 \uD130\uCE58
      \uB290\uB08C \uAC15\uC870 (\uD64D\uB4F1 \uC870\uBA85 \uCD94\uCC9C)"
  themeColor: {r: 0.83137256, g: 0.23529412, b: 0.1764706, a: 1}
  accentColor: {r: 0.9411765, g: 0.75686276, b: 0.24313726, a: 1}
  personality:
    tags:
    - "\uC9C4\uC911"
    - "\uC815\uC758\uAC10"
    - "\uB2E8\uD638\uD568"
    - "\uC2B9\uBD80\uC695"
    - "\uB530\uB73B\uD55C \uC790\uC560"
    speechStyle: "\uB2E8\uC815\uD558\uACE0 \uC9E7\uC740 \uB9D0\uD22C. \uC0AC\uB78C\uC744
      \uBCFC \uB54C \uB208\uC744 \uD53C\uD558\uC9C0 \uC54A\uC74C. \uAE30\uBD84\uC774
      \uC88B\uC544\uC9C0\uBA74 \uAF2C\uB9AC\uB97C \uC0B4\uC9DD \uD754\uB4E6."
    trauma: "\uACFC\uAC70 \uC81C\uC790\uB97C \uC804\uD22C \uC911 \uC783\uACE0, \u201C\uD798\uC740
      \uBC18\uB4DC\uC2DC \uB204\uAD70\uAC00\uB97C \uC0C1\uCC98\uC785\uD78C\uB2E4\u201D\uB294
      \uC8C4\uCC45\uAC10\uC744 \uD488\uACE0 \uC788\uC74C. \uC774\uD6C4 \uD63C\uC790\uC11C\uB9CC
      \uC218\uB828\uD558\uBA70 \u2018\uAC15\uD568\uC758 \uC758\uBBF8\u2019\uB97C
      \uB2E4\uC2DC \uCC3E\uACE0 \uC788\uC74C."
    desire: "\uC2F8\uC6C0\uC774 \uC544\uB2CC, \u201C\uC9C0\uD0AC \uC218 \uC788\uB294
      \uD798\u201D\uC744 \uBC30\uC6B0\uACE0 \uC2F6\uC74C. \uB204\uAD70\uAC00\uC5D0\uAC8C
      \uC790\uC2E0\uC758 \uD798\uC774 \uB3C4\uC6C0\uC774 \uB418\uB294 \uC21C\uAC04\uC744
      \uC9C4\uC2EC\uC73C\uB85C \uC6D0\uD568."
    background: "\uC804\uC7C1 \uC911 \uB3C4\uC7A5\uC744 \uC9C0\uD0A4\uB824\uB2E4
      \uC81C\uC790\uB97C \uC783\uC740 \uB4A4, \uC138\uC0C1\uACFC \uB2E8\uC808\uD558\uACE0
      \uC12C\uC73C\uB85C \uD758\uB7EC\uC634. \uC774\uD6C4 \uC12C\uC758 \uD3ED\uD48D
      \uD574\uC548\uC744 \uC218\uB828\uC7A5 \uC0BC\uC544 \uBB34\uC608\uB97C \uC5F0\uB9C8\uD558\uBA70,
      \u2018\uC790\uAE30 \uC218\uB828\uC758 \uAE38\u2019\uC744 \uAC77\uACE0 \uC788\uC74C.
      \uD50C\uB808\uC774\uC5B4\uC640\uC758 \uB9CC\uB0A8\uC740, \uADF8\uAC00 \u201C\uB3C4\uC7A5
      \uD3D0\uD5C8\u201D \uADFC\uCC98\uC5D0\uC11C \uC4F0\uB7EC\uC84C\uC744 \uB54C
      \uADF8\uB140\uAC00 \uAD6C\uC870\uD558\uBA70 \uC2DC\uC791\uB41C\uB2E4. \uD50C\uB808\uC774\uC5B4\uB97C
      \u2018\uC81C\uC790\u2019\uB85C \uC0BC\uC744\uC9C0, \u2018\uB3D9\uB8CC\u2019\uB85C
      \uC5EC\uAE38\uC9C0\uB294 \uD638\uAC10\uB3C4\uC5D0 \uB530\uB77C \uB2EC\uB77C\uC9C4\uB2E4."
    voiceConcept: "\uC911\uC800\uC74C \uC5EC\uC131 \uBAA9\uC18C\uB9AC, \uC808\uC81C\uB41C
      \uD798\uC774 \uB290\uAEF4\uC9C0\uB294 \uD1A4. \uAC00\uB054 \uBBF8\uC18C\uB97C
      \uB74C \uB54C \uC5B4\uC870\uAC00 \uBD80\uB4DC\uB7FD\uAC8C \uD480\uB9BC."
