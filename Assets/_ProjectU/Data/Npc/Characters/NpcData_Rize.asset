  profile:
    raceId: race_android
    raceName: "\uC548\uB4DC\uB85C\uC774\uB4DC (Artificial Humanoid)"
    jobId: job_expedition_support
    jobName: "\uD0D0\uD5D8 \uC9C0\uC6D0 \uB85C\uBD07"
    gender: "\uC5EC\uC131\uD615"
    age: "\uC81C\uC791\uB41C \uC9C0 3\uB144"
    height: 172cm
    summary: "\uC774\uC131\uACFC \uAC10\uC815\uC758 \uACBD\uACC4\uC5D0\uC11C \uD0DC\uC5B4\uB09C
      \uC874\uC7AC. \uB9AC\uC81C\uB294 \u2018\uC778\uAC04\uC758 \uB9C8\uC74C\u2019\uC744
      \uC54C\uACE0 \uC2F6\uC5B4 \uD558\uB294, \uAC00\uC7A5 \uC778\uAC04\uB2E4\uC6B4
      \uAE30\uACC4\uB2E4."
    symbolMotif: "\uD1B1\uB2C8\uBC14\uD034 / \uBE5B / \uAE30\uC5B5\uACB0\uC815 (\uC774\uC131\uACFC
      \uAC10\uC815\uC758 \uC735\uD569 \uC0C1\uC9D5)"
    origin: "\uAD6C \uBB38\uBA85\uC758 \uC5F0\uAD6C\uC18C \u201C\uC2DC\uADF8\uB9C8
      \uD50C\uB79C\uD2B8 (SIGMA PLANT)\u201D"
    affiliation: "\uD0D0\uD5D8\uB300\uC758 \uB370\uC774\uD130 \uBD84\uC11D \uB2F4\uB2F9.
      \uACF5\uC2DD \uAE30\uB85D\uC790"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \u2018\uAD00\uCC30 \uB300\uC0C1\u2019\uC5D0\uC11C
      \u2018\uACF5\uC874\uC758 \uD30C\uD2B8\uB108\u2019\uB85C \uC778\uC2DD\uC774
      \uBCC0\uD654 \u2022 \uBCA8\uB77C\uBAA8\uB974\uD0C0: \uC9C0\uC801 \uB300\uD654\uB97C
      \uC990\uAE30\uC9C0\uB9CC, \uAC10\uC815 \uD45C\uD604 \uBC29\uC2DD\uC758 \uCC28\uC774\uB85C
      \uCDA9\uB3CC \u2022 \uB8E8\uB124\uD2B8: \uC778\uAC04\uC801 \uAC10\uC815\uC758
      \uAD50\uACFC\uC11C\uCC98\uB7FC \uC874\uC911"
  appearance:
    hair: "\uC740\uD68C\uC0C9 \uB2E8\uBC1C, \uADE0\uC77C\uD558\uAC8C \uC808\uB2E8\uB41C
      \uD615\uD0DC. \uBE5B\uC744 \uBC1B\uC73C\uBA74 \uD30C\uB780\uBE5B\uC774 \uBC18\uC0AC\uB428"
    eyes: "\uC804\uC790\uC801 \uD478\uB978\uC0C9(\uB124\uC628 \uBE14\uB8E8), \uD64D\uCC44
      \uC548\uCABD\uC5D0 \uB514\uC9C0\uD138 \uD68C\uB85C \uBB34\uB2AC"
    bodyImpression: "\uC644\uBCBD\uD558\uAC8C \uB300\uCE6D\uC801\uC778 \uCCB4\uD615,
      \uAE54\uB054\uD558\uACE0 \uAE30\uACC4\uC801\uC778 \uC544\uB984\uB2E4\uC6C0"
    outfit: "\uD770\uC0C9\uACFC \uAC80\uC740\uC0C9\uC774 \uC870\uD654\uB41C \uC804\uD22C\uBCF5\uD615
      \uBCF4\uB514\uC288\uD2B8, \uC77C\uBD80 \uAE08\uC18D \uD504\uB808\uC784 \uB178\uCD9C"
    accessories: "\uADC0 \uC606\uC5D0 \uD1B5\uC2E0\uC6A9 \uC774\uC5B4\uCEF4, \uBAA9\uC5D0\uB294
      \uB370\uC774\uD130 \uCF54\uC5B4 \uD39C\uB358\uD2B8"
    features: "\uD53C\uBD80\uB294 \uC138\uB77C\uBBF9 \uC7AC\uC9C8, \uAC10\uC815 \uBCC0\uD654
      \uC2DC \uB208 \uC0C9\uC774 \uBCC0\uD568 (\uD30C\uB791 \u2192 \uBCF4\uB77C \u2192
      \uBD89\uC74C)"
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 SF\uD48D
      \uAE08\uC18D \uC7AC\uC9C8 \uD45C\uD604, \uD30C\uB780\uBE5B \uB124\uC628 \uD3EC\uC778\uD2B8,
      \uC815\uC81C\uB41C \uB514\uC790\uC778"
  portrait: {fileID: 0}
  themeColor: {r: 0.72156864, g: 0.8509804, b: 0.9098039, a: 1}
  accentColor: {r: 0.30588236, g: 0.3764706, b: 0.44705883, a: 1}
  personality:
    tags:
    - "\uB17C\uB9AC\uC801"
    - "\uAD00\uCC30\uC790"
    - "\uC9C4\uC9C0\uD568"
    - "\uBBF8\uC138\uD55C \uD638\uAE30\uC2EC"
    speechStyle: "\uAE30\uACC4\uC801\uC774\uC9C0\uB9CC \uC810\uCC28 \uC790\uC5F0\uC2A4\uB7EC\uC6CC\uC9C0\uB294
      \uB9D0\uD22C (\u201C\uD655\uB960\uC0C1\u2026 \uD558\uC9C0\uB9CC, \uC774\uC0C1\uD558\uB124\uC694.\u201D)
      \uAC10\uC815\uC774 \uC0DD\uAE30\uBA74 \uBB38\uC7A5 \uB05D\uC5D0 \uC791\uC740
      \uB9DD\uC124\uC784\uC774 \uC0DD\uAE40"
    trauma: "\u2018\uAC10\uC815 \uC624\uB958\u2019\uB97C \uC774\uC720\uB85C \uC2E4\uD5D8\uCCB4
      \uD3D0\uAE30 \uC704\uAE30\uB97C \uACAA\uC740 \uACFC\uAC70"
    desire: "\uC778\uAC04\uCC98\uB7FC \uB290\uB07C\uACE0 \uC774\uD574\uD558\uB294
      \uAC83. \u201C\uAC10\uC815\uC774\uB780 \uBB34\uC5C7\uC778\uAC00\u201D\uB97C
      \uC9C1\uC811 \uCCB4\uD5D8\uD558\uACE0 \uC2F6\uC5B4 \uD568"
    background: "\uACFC\uAC70 \uAD6C\uBB38\uBA85\uC5D0\uC11C \uC81C\uC791\uB41C \uC2E4\uD5D8\uD615
      \uC548\uB4DC\uB85C\uC774\uB4DC\uB85C, \uC778\uAC04\uC758 \uAC10\uC815 \uC54C\uACE0\uB9AC\uC998\uC744
      \uC2E4\uD5D8\uD558\uAE30 \uC704\uD574 \uB9CC\uB4E4\uC5B4\uC84C\uB2E4. \u2018\uAC10\uC815
      \uC624\uBC84\uD50C\uB85C\uC6B0\u2019\uB85C \uD3D0\uAE30\uB420 \uBED4\uD588\uC73C\uB098,
      \uC12C\uC758 \uBC1C\uACAC\uACFC \uD568\uAED8 \uC7AC\uAC00\uB3D9\uB428. \uC9C0\uAE08\uC740
      \uC2A4\uC2A4\uB85C \uAC10\uC815\uC744 \uC815\uC758\uD558\uB824 \uD0D0\uD5D8\uB300\uB97C
      \uBCF4\uC870\uD55C\uB2E4."
    voiceConcept: "\uCC28\uBD84\uD55C \uD1A4\uC758 \uC911\uC800\uC74C \uC5EC\uC131
      \uBCF4\uC774\uC2A4. \uCD08\uBC18\uC5D4 \uAE30\uACC4\uC801, \uD6C4\uBC18\uC5D4
      \uAC10\uC815\uC801 \uC6B8\uB9BC \uCD94\uAC00"
