  m_Name: NpcData_Verona
  m_EditorClassIdentifier: Assembly-CSharp::NpcCharacterData
  characterId: char_verona
  displayName: "\uBCA0\uB85C\uB098"
  englishName: Verona
  isAlphaCast: 1
  isAvailable: 1
  profile:
    raceId: race_bullkin
    raceName: "\uC18C\uC871 (Bullkin)"
    jobId: job_earth_guardian
    jobName: "\uB300\uC9C0\uC758 \uC218\uD638\uC790 / \uB18D\uC7A5 \uC5EC\uC2E0\uAD00"
    gender: "\uC5EC\uC131"
    age: "29\uC138"
    height: 176cm
    summary: "\uB300\uC9C0\uB294 \uBC30\uC2E0\uD558\uC9C0 \uC54A\uC544. \uBCA0\uB85C\uB098\uB294
      \uBBFF\uC74C\uC744 \uC783\uC740 \uC0AC\uC81C\uC774\uC790, \uB2E4\uC2DC \uC0DD\uBA85\uC744
      \uC77C\uC73C\uD0A4\uB294 \uB300\uC9C0\uC758 \uC5EC\uC2E0\uC774\uB2E4."
    symbolMotif: "\uD669\uC18C / \uB300\uC9C0 / \uC2E0\uC804 / \uD48D\uC694 (\uAC15\uC778\uD568\uACFC
      \uBBFF\uC74C\uC758 \uC0C1\uC9D5)"
    origin: "\u201C\uD14C\uB77C \uBC14\uC778(Terra Vine)\u201D \u2013 \uB300\uC9C0\uC758
      \uC2E0\uC744 \uBAA8\uC2DC\uB294 \uD669\uD1A0 \uACE0\uC6D0\uC9C0\uB300"
    affiliation: "\uACFC\uAC70 \uD669\uC18C\uC2E0\uC804\uC758 \uC218\uB140 / \uD604\uC7AC
      \uC12C\uC758 \uB300\uC9C0 \uC218\uD638\uC790"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uCC98\uC74C\uC5D4 \uC758\uC2EC\uD558\uC9C0\uB9CC,
      \uC9C4\uC2EC\uC744 \uBCF4\uACE0 \uC2E0\uB8B0\uC640 \uC720\uB300 \uD615\uC131
      \u2022 \uBC00\uD06C: \uC61B \uB3D9\uB8CC\uCC98\uB7FC \uB300\uD558\uBA70, \uCE74\uD398\uC5D0
      \uC7AC\uB8CC\uB97C \uACF5\uAE09 \u2022 \uB8E8\uB124\uD2B8: \uC57D\uCD08 \uAC70\uB798\uB85C
      \uC790\uC8FC \uB9CC\uB0A8 \u2022 \uB77C\uADF8: \u201C\uB300\uC9C0\uC758 \uC218\uD638\uC790\u201D\uB85C\uC11C
      \uC804\uC6B0 \uAC19\uC740 \uAD00\uACC4"
  appearance:
    hair: "\uBC24\uAC08\uC0C9\uC758 \uD48D\uC131\uD55C \uC6E8\uC774\uBE0C \uB871\uD5E4\uC5B4,
      \uB05D\uC774 \uBD89\uAC8C \uBE5B\uB0A8"
    eyes: "\uAD6C\uB9BF\uBE5B \uBE0C\uB77C\uC6B4, \uBD80\uB4DC\uB7FD\uACE0 \uAE4A\uC740
      \uC778\uC0C1"
    bodyImpression: "\uD0A4\uAC00 \uD06C\uACE0 \uACE1\uC120\uC774 \uAC15\uC870\uB41C
      \uCCB4\uD615, \uC6B0\uC544\uD558\uBA74\uC11C\uB3C4 \uB2F9\uB2F9\uD55C \uBD84\uC704\uAE30"
    outfit: "\uD759\uC0C9\uACFC \uAE08\uBE5B\uC774 \uC5B4\uC6B0\uB7EC\uC9C4 \uC81C\uC0AC\uBCF5
      + \uAC00\uC8FD\uB048\uC73C\uB85C \uBB36\uC740 \uD1A0\uAC00\uD48D \uC758\uC0C1
      \uC0C1\uBC18\uC2E0\uC740 \uB2E8\uB2E8\uD55C \uD749\uAC11, \uD558\uC758\uB294
      \uCC9C\uACFC \uC7A5\uC2DD\uBCA8\uD2B8\uB85C \uAD6C\uC131"
    accessories: "\uD669\uC18C\uBFD4 \uBAA8\uC591 \uBA38\uB9AC\uC7A5\uC2DD, \uBAA9\uC5D0\uB294
      \u2018\uB300\uC9C0\uC758 \uC9D5\uD45C\u2019\uC778 \uAE08\uBC18\uC9C0 \uBAA9\uAC78\uC774"
    features: "\uACAC\uACE0\uD55C \uC18C\uBFD4, \uAF2C\uB9AC\uB294 \uC9E7\uC9C0\uB9CC
      \uAD75\uC740 \uD615\uD0DC. \uAC78\uC744 \uB54C\uB9C8\uB2E4 \uBC1C\uAD7D\uC5D0\uC11C
      \uC740\uC740\uD55C \uC9C4\uB3D9\uC74C \uBC1C\uC0DD"
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uB300\uC9C0\uC640
      \uC2E0\uC804 \uBC30\uACBD, \uB530\uB73B\uD55C \uD669\uAE08\uBE5B \uC870\uBA85,
      \uADFC\uC721\uC120\uC774 \uC740\uC740\uD55C \uAC15\uC778\uD55C \uCCB4\uD615"
  portrait: {fileID: 21300000, guid: 7d9365d575b9fa74f95fb8b2ea562135, type: 3}
  themeColor: {r: 0.8039216, g: 0.654902, b: 0.4862745, a: 1}
  accentColor: {r: 0.9019608, g: 0.8352941, b: 0.63529414, a: 1}
  personality:
    tags:
    - "\uC778\uB0B4"
    - "\uC790\uC560"
    - "\uC2E0\uB150"
    - "\uAC15\uB2E8"
    - "\uCC9C\uCC9C\uD788 \uBD88\uD0C0\uC624\uB974\uB294 \uC5F4\uC815"
    speechStyle: "\uB290\uB9AC\uACE0 \uCE68\uCC29\uD55C \uB9D0\uD22C. \uC0DD\uAC01\uD560
      \uB54C\uB294 \uC190\uC744 \uAC00\uC2B4 \uC704\uC5D0 \uC5B9\uC74C. \uD654\uB098\uBA74
      \uC870\uC6A9\uD788 \uC228\uC744 \uB0B4\uC26C\uBA70, \uB2E8 \uD55C\uB9C8\uB514\uB85C
      \uC0C1\uB300\uB97C \uC81C\uC555."
    trauma: "\uD55C\uB54C \uC12C\uC758 \uB18D\uC7A5\uC744 \uC9C0\uD0A4\uB358 \u2018\uD669\uC18C\uC2E0\uC758
      \uC0AC\uC81C\u2019\uC600\uC73C\uB098, \uC778\uAC04\uB4E4\uC758 \uD0D0\uC695\uC73C\uB85C
      \uC2E0\uC804\uC774 \uD30C\uAD34\uB428. \uC790\uC2E0\uC758 \uC2E0\uB150\uC774
      \uBB34\uB108\uC9C4 \uB4A4, \u2018\uC2E0\uB3C4 \uB300\uC9C0\uB3C4 \uBBFF\uC744
      \uC218 \uC5C6\uB2E4\u2019\uB294 \uD68C\uC758\uAC10\uC5D0 \uBE60\uC84C\uC74C."
    desire: "\uB2E4\uC2DC \u2018\uBBFF\uC74C\u2019\uC744 \uB418\uCC3E\uB294 \uAC83.
      \uB204\uAD70\uAC00\uB97C \uC9C4\uC2EC\uC73C\uB85C \uC9C0\uD0A4\uBA70, \uB300\uC9C0\uC640
      \uD568\uAED8 \uC0B4\uC544\uAC00\uB294 \uAE38\uC744 \uCC3E\uACE0\uC790 \uD568."
    background: "\uB300\uC9C0\uC758 \uD798\uC744 \uB2E4\uB8E8\uB294 \uB2A5\uB825\uC73C\uB85C
      \uB18D\uACBD\uACFC \uD48D\uC694\uC758 \uC2E0\uC804\uC5D0\uC11C \uC2E0\uAD00\uC73C\uB85C
      \uBD09\uC9C1\uD588\uC73C\uB098, \uC12C\uC758 \uB9C8\uB825\uC774 \uBD88\uC548\uC815\uD574\uC9C0\uC790
      \uC2E0\uC804\uC774 \uBD95\uAD34\uB418\uACE0 \uB3D9\uB8CC\uB97C \uC783\uC74C.
      \uADF8\uB140\uB294 \uC774\uD6C4 \uB18D\uC7A5\uC744 \uD63C\uC790 \uC7AC\uAC74\uD558\uBA70,
      \uC790\uC5F0\uC758 \uC21C\uD658\uC744 \uB2E4\uC2DC \uC77C\uC73C\uD0A4\uB824
      \uD55C\uB2E4. \uD50C\uB808\uC774\uC5B4\uB97C \uB9CC\uB09C \uD6C4, \uADF8 \uC548\uC5D0\uC11C
      \u2018\uC783\uC5C8\uB358 \uC2E0\uB150\u2019\uC744 \uC870\uAE08\uC529 \uB418\uCC3E\uAE30
      \uC2DC\uC791\uD55C\uB2E4."
    voiceConcept: "\uC911\uC800\uC74C\uC758 \uC131\uC219\uD55C \uC5EC\uC131 \uBAA9\uC18C\uB9AC.
      \uBD80\uB4DC\uB7FD\uC9C0\uB9CC \uC2E0\uB150 \uC788\uB294 \uC5B4\uC870. \uAC10\uC815\uC774
      \uB4DC\uB7EC\uB0A0 \uB54C \uC6B8\uB9BC\uC774 \uAE4A\uACE0 \uB530\uB73B\uD568."
