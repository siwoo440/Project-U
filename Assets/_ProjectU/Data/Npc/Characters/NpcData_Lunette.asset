    speechStyle: "\uB9D0\uD560 \uB54C \uC5B4\uBBF8\uB97C \uC0B4\uC9DD \uB298\uB9BC
      (\u201C\uADF8\uAC8C\u2026 \uADF8\uB7EC\uB2C8\uAE4C\uC694\u2026\u201D) \uB180\uB77C\uBA74
      \uADC0\uAC00 \uC6C0\uCC14 \uC6C0\uC9C1\uC784"
    trauma: "\uC5B4\uB9B4 \uC801 \uBB34\uB9AC\uB97C \uC783\uC740 \uAE30\uC5B5\uC73C\uB85C
      \u201C\uC678\uB85C\uC6C0\u201D\uC5D0 \uBBFC\uAC10\uD568"
    desire: "\uC790\uC2E0\uC774 \uC758\uC9C0\uD560 \uC218 \uC788\uB294 \u2018\uAC00\uC871
      \uAC19\uC740 \uB3D9\uB8CC\u2019\uB97C \uCC3E\uB294 \uAC83"
    background: "\uC5B4\uB9B0 \uC2DC\uC808, \uAC00\uC871\uC744 \uC783\uACE0 \uD640\uB85C
      \uC0B4\uC544\uB0A8\uC740 \uD6C4 \uC57D\uCD08\uC0AC\uC5D0\uAC8C \uAC70\uB450\uC5B4\uC838
      \uCE58\uB8CC\uC220\uC744 \uBC30\uC6C0. \uC12C\uC758 \uC790\uC5F0\uC744 \uC0AC\uB791\uD558\uBA70
      \uB2E4\uB978 \uC885\uC871\uACFC \uD611\uB825\uD558\uB824 \uB178\uB825\uD568."
    voiceConcept: "\uC794\uC794\uD558\uACE0 \uB530\uB73B\uD55C \uC5EC\uC131\uC74C.
      \uBD80\uB044\uB7EC\uC6B8 \uB550 \uC5B4\uBBF8\uAC00 \uC791\uC544\uC9D0 (\u201C\u2026\uC694\u201D)"
