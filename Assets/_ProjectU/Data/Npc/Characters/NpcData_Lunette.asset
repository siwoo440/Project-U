  characterId: char_lunette
  displayName: "\uB8E8\uB124\uD2B8"
  englishName: Lunette
  isAlphaCast: 1
  isAvailable: 1
  profile:
    raceId: race_rabbitkin
    raceName: "\uD1A0\uB07C\uC871 (Rabbitkin)"
    jobId: job_herbalist
    jobName: "\uC57D\uCD08\uC0AC"
    gender: "\uC5EC\uC131"
    age: "16\uC138"
    height: 158cm
    summary: "\uC0C1\uCC98\uBC1B\uC740 \uB9C8\uC74C\uC744 \uD488\uC740 \uCE58\uC720\uC790.
      \uB0AF\uC120 \uC12C\uC5D0\uC11C \uD50C\uB808\uC774\uC5B4\uB97C \uB9CC\uB098,
      \uC2E0\uB8B0\uC640 \uB530\uB73B\uD568\uC73C\uB85C \uB9C8\uC74C\uC758 \uB465\uC9C0\uB97C
      \uCC3E\uC544\uAC00\uB294 \uC18C\uB140."
    symbolMotif: "\uD1A0\uB07C / \uBBFC\uB4E4\uB808 / \uC0C8\uBCBD\uC758 \uBE5B (\uD76C\uB9DD\uACFC
      \uC7AC\uC0DD\uC758 \uC0C1\uC9D5)"
    origin: "\uBCA8\uB9AC\uC548 \uCD08\uC6D0 \uB9C8\uC744 \u2013 \uD3C9\uD654\uB85C\uC6B4
      \uD1A0\uB07C\uC871\uC758 \uB9C8\uC744"
    affiliation: "\uB9C8\uC744\uC758 \uC57D\uCD08\uC0AC \uC870\uC218\uB85C \uC77C\uD568"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uC232\uC5D0\uC11C \uAD6C\uD574\uC900
      \uC778\uC5F0\uC73C\uB85C \uC2E0\uB8B0 \uD615\uC131 \u2022 \uC694\uC815\uC871:
      \uC57D\uCD08 \uC218\uC9D1 \uD30C\uD2B8\uB108 \u2022 \uB291\uB300\uC871: \uB450\uB824\uC6C0\uACFC
      \uB3D9\uACBD\uC758 \uB300\uC0C1"
  appearance:
    hair: "\uC740\uBC1C\uC5D0 \uAC00\uAE4C\uC6B4 \uC5F0\uD68C\uC0C9, \uBD80\uB4DC\uB7FD\uAC8C
      \uB9D0\uB9B0 \uB871\uD5E4\uC5B4"
    eyes: "\uC5F0\uD55C \uC5D0\uBA54\uB784\uB4DC\uBE5B, \uC5B8\uC81C\uB098 \uD638\uAE30\uC2EC
      \uC5B4\uB9B0 \uB208\uBE5B"
    bodyImpression: "\uC2AC\uB9BC\uD558\uC9C0\uB9CC \uB2E4\uB9AC\uC5D0 \uD0C4\uB825
      \uC788\uC74C. \uBBFC\uCCA9\uD558\uACE0 \uB530\uB73B\uD55C \uC778\uC0C1"
    outfit: "\uC57D\uCD08\uC0AC\uD48D \uC6D0\uD53C\uC2A4 + \uAC00\uC8FD \uD30C\uC6B0\uCE58
      + \uC9E7\uC740 \uBD80\uCE20"
    accessories: "\uD1A0\uB07C\uBC1C \uBAA8\uC591 \uD39C\uB358\uD2B8 (\uD589\uC6B4\uC758
      \uC0C1\uC9D5)"
    features: "\uAE34 \uB86D \uC774\uC5B4 \uD1A0\uB07C \uADC0, \uADC0 \uB05D\uC740
      \uC5F0\uD55C \uAC08\uC0C9. \uAC10\uC815\uC5D0 \uB530\uB77C \uADC0\uAC00 \uC6C0\uC9C1\uC784"
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D (\uD30C\uC2A4\uD154\uD1A4
      / \uC790\uC5F0\uAD11 \uC911\uC2EC, \uBD80\uB4DC\uB7EC\uC6B4 \uC0C9\uCC44 \uD45C\uD604)"
  themeColor: {r: 0.84705883, g: 0.9098039, b: 0.8784314, a: 1}
  accentColor: {r: 0.9098039, g: 0.8392157, b: 0.6901961, a: 1}
  personality:
    tags:
    - "\uC218\uC90D\uC74C"
    - "\uC0C1\uB0E5\uD568"
    - "\uD638\uAE30\uC2EC"
