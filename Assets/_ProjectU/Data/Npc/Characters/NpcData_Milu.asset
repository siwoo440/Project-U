  m_Name: NpcData_Milu
  m_EditorClassIdentifier: Assembly-CSharp::NpcCharacterData
  characterId: char_milu
  displayName: "\uBBF8\uB8E8"
  englishName: Milu
  isAlphaCast: 0
  isAvailable: 1
  profile:
    raceId: race_slimekin
    raceName: "\uC2AC\uB77C\uC784\uC871 (Slimekin)"
    jobId: job_potion_merchant
    jobName: 
    gender: "\uC5EC\uC131"
    age: "5\uC138 (\uC131\uCCB4 \uAE30\uC900)"
    height: "160cm (\uD615\uD0DC \uACE0\uC815 \uC2DC)"
    summary: "\uC2AC\uB77C\uC784\uC740 \uB2E8\uC9C0 \uBB3C\uC774 \uC544\uB2C8\uC57C.
      \uAC10\uC815\uC73C\uB85C \uC6C0\uC9C1\uC774\uB294 \u2018\uB9C8\uC74C\uC758
      \uD615\uCCB4\u2019\uC57C. \uBBF8\uB8E8\uB294 \uC21C\uC218\uD55C \uAC10\uC815\uC758
      \uD654\uC2E0 \u2014 \uC138\uC0C1\uC5D0\uC11C \uAC00\uC7A5 \uD22C\uBA85\uD55C
      \uC0DD\uBA85\uCCB4."
    symbolMotif: "\uBB3C\uBC29\uC6B8 / \uD22C\uBA85\uD55C \uACB0\uC815 / \uAC10\uC815\uC758
      \uD30C\uB3D9 (\uC21C\uC218\uD568\uACFC \uC874\uC7AC\uC758 \uC720\uB3D9\uC131
      \uC0C1\uC9D5)"
    origin: "\uD638\uC218 \uAE4A\uC740 \uACF3\uC758 \u201C\uB8E8\uBA58 \uC6F0 (Lumen
      Well)\u201D \u2014 \uC2AC\uB77C\uC784\uB4E4\uC774 \uD0DC\uC5B4\uB098\uB294
      \uB9C8\uB825\uC9C0\uB300"
    affiliation: "\uC5F0\uAE08 \uC7AC\uB8CC \uC0C1\uC810 \u201C\uC824 \uD3EC\uC158(Gel
      Potion)\u201D\uC758 \uC8FC\uC778"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uCC98\uC74C\uC5D4 \uD638\uAE30\uC2EC\uC73C\uB85C
      \uB2E4\uAC00\uC624\uC9C0\uB9CC, \uC9C4\uC2EC\uC73C\uB85C \uAC10\uC815 \uAD50\uB958\uB97C
      \uC2DC\uB3C4 \u2022 \uBCA8\uB77C\uBAA8\uB974\uD0C0: \uC5F0\uAE08\uC220 \uC7AC\uB8CC
      \uAC70\uB798 \uAD00\uACC4. \uBCA8\uB77C\uB294 \uADF8\uB140\uB97C \u2018\uC0B4\uC544\uC788\uB294
      \uC2E4\uD5D8\uCCB4\u2019\uB77C \uBD80\uB984 \u2022 \uB8E8\uB124\uD2B8: \u201C\uCD09\uAC10\uC774
      \uC88B\uB2E4\u201D\uBA70 \uC790\uC8FC \uC548\uAE40 \u2022 \uB9B4\uB9AC\uCE74:
      \uC790\uC2E0\uBCF4\uB2E4 \uB098\uC774 \uB9CE\uC9C0\uB9CC \uC678\uD615\uC740
      \uBE44\uC2B7\uD574, \uC790\uB9E4\uCC98\uB7FC \uC7A5\uB09C\uCE68"
  appearance:
    hair: "\uC2AC\uB77C\uC784\uC774 \uC790\uC5F0\uC2A4\uB7FD\uAC8C \uBA38\uB9AC \uBAA8\uC591\uC73C\uB85C
      \uD750\uB978 \uD615\uD0DC, \uC0C9\uC740 \uD478\uB978 \uD22C\uBA85\uBE5B"
    eyes: "\uBC14\uB2E4 \uC720\uB9AC\uCC98\uB7FC \uD22C\uBA85\uD55C \uCCAD\uB85D\uC0C9.
      \uAC10\uC815\uC5D0 \uB530\uB77C \uBE5B\uC758 \uB18D\uB3C4\uAC00 \uBCC0\uD568"
    bodyImpression: "\uB9E4\uB044\uB7FD\uACE0 \uC720\uB824\uD55C \uACE1\uC120, \uD53C\uBD80\uB294
      \uC824\uB9AC\uCC98\uB7FC \uBE5B \uBC18\uC0AC"
    outfit: "\uAC04\uB2E8\uD55C \uB9C8\uBC95\uC0AC\uD48D \uCC9C \uC870\uAC01\uC744
      \uBAB8 \uC77C\uBD80\uC5D0 \uAC10\uC740 \uD615\uD0DC. \uC637\uB3C4 \uC2AC\uB77C\uC784
      \uC77C\uBD80\uB85C \uBCC0\uD615 \uAC00\uB2A5"
    accessories: "\uC791\uC740 \uC720\uB9AC\uBCD1 \uBAA9\uAC78\uC774 (\uC790\uC2E0\uC758
      \uCF54\uC5B4 \uACB0\uC815 \uC77C\uBD80\uB97C \uBCF4\uAD00)"
    features: "\uC628\uBAB8\uC774 \uC810\uC561\uC9C8 \uD615\uD0DC\uB85C \uC774\uB8E8\uC5B4\uC838
      \uC788\uC74C. \uAC10\uC815\uC5D0 \uB530\uB77C \uC0C9\uC774 \uBC14\uB01C \u2014
      \uD30C\uB791(\uD3C9\uC628), \uBD84\uD64D(\uAE30\uC068), \uBCF4\uB77C(\uB2F9\uD669),
      \uBD89\uC74C(\uBD84\uB178), \uD22C\uBA85(\uC2AC\uD514)."
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uBC18\uD22C\uBA85
      \uC2AC\uB77C\uC784 \uC9C8\uAC10, \uBD80\uB4DC\uB7EC\uC6B4 \uC870\uBA85, \uC218\uBA74
      \uBC18\uC0AC \uD6A8\uACFC"
  portrait: {fileID: 0}
  themeColor: {r: 0.45882353, g: 0.84705883, b: 0.88235295, a: 1}
  accentColor: {r: 0.7490196, g: 0.9372549, b: 1, a: 1}
  personality:
    tags:
    - "\uC21C\uC218"
    - "\uAC10\uC815\uD45C\uD604\uC774 \uC194\uC9C1"
    - "\uC7A5\uB09C\uAFB8\uB7EC\uAE30"
    - "\uD638\uAE30\uC2EC"
    speechStyle: "\u201C\uB9D0 \uB05D\uC774 \uBB3C\uACB0\uCC98\uB7FC \uB298\uC5B4\uC9C0\uB294
      \uB9D0\uD22C\u201D (\u201C\uD5E4\uC5D0~?\u201D, \u201C\uC73C\uC73C\uC74C~\u201D)
      \uC0AC\uB78C\uC744 \uB9CC\uC9C0\uAC70\uB098 \uD765\uBBF8 \uC788\uC73C\uBA74
      \uC190\uAC00\uB77D(\uC810\uC561)\uC744 \uCC14\uB7EC\uBD04"
    trauma: "\u2018\uD615\uCCB4\uAC00 \uC5C6\uB294 \uC874\uC7AC\u2019\uB77C\uC11C
      \u2018\uC790\uC2E0\uC774 \uB204\uAD6C\uC778\uAC00\u2019\uB97C \uC790\uC8FC
      \uACE0\uBBFC\uD568. \uC0AC\uB78C\uB4E4\uC774 \uC790\uC2E0\uC744 \u201C\uBB3C\uAC74\u201D
      \uCDE8\uAE09\uD588\uB358 \uAE30\uC5B5\uC774 \uC788\uC74C"
    desire: "\uC790\uC2E0\uC774 \uC9C4\uC9DC \u201C\uC0DD\uBA85\u201D\uC784\uC744
      \uC99D\uBA85\uD558\uACE0 \uC2F6\uC74C. \uC989, \uAC10\uC815\uACFC \uAD00\uACC4\uB97C
      \uD1B5\uD574 \u201C\uC0B4\uC544\uC788\uC74C\u201D\uC744 \uB290\uB07C\uB824
      \uD568."
    background: "\uC2AC\uB77C\uC784\uC871 \uC911\uC5D0\uC11C\uB3C4 \uD76C\uADC0\uD55C
      \u2018\uC9C0\uC131\uD615 \uAC1C\uCCB4\u2019\uB85C, \uC778\uAC04\uC758 \uD615\uD0DC\uB97C
      \uC720\uC9C0\uD560 \uC218 \uC788\uB294 \uB2A5\uB825\uC744 \uAC00\uC9D0. \uACFC\uAC70\uC5D4
      \uC778\uAC04 \uC5F0\uAE08\uC220\uC0AC\uC5D0\uAC8C \uC2E4\uD5D8\uB2F9\uD588\uC9C0\uB9CC,
      \uC2A4\uC2A4\uB85C \uD0C8\uCD9C\uD574 \uC12C\uC73C\uB85C \uD758\uB7EC\uB4E4\uC5B4\uC654\uB2E4.
      \uC9C0\uAE08\uC740 \uC790\uC720\uB86D\uAC8C \uC0B4\uC544\uAC00\uBA70, \uB2E4\uB978
      \uC0DD\uBA85\uCCB4\uC640\uC758 \uAD50\uB958\uB97C \uD1B5\uD574 \u2018\uAC10\uC815\u2019\uC744
      \uBC30\uC6B0\uACE0 \uC788\uB2E4."
    voiceConcept: "\uC57D\uAC04 \uBB3C\uACB0\uCC98\uB7FC \uC6B8\uB9AC\uB294 \uC5EC\uC131
      \uC74C\uC131. \uC5B4\uB9B0 \uB4EF\uD558\uC9C0\uB9CC \uAC10\uC815 \uD45C\uD604\uC774
      \uD48D\uBD80\uD568 (\u201C\uB9D0\uB05D\uC744 \uAE38\uAC8C~\u201D)"
