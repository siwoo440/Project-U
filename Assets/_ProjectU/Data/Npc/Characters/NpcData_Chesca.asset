  m_Name: NpcData_Chesca
  m_EditorClassIdentifier: Assembly-CSharp::NpcCharacterData
  characterId: char_chesca
  displayName: "\uCCB4\uC2A4\uCE74"
  englishName: Chesca
  isAlphaCast: 0
  isAvailable: 1
  profile:
    raceId: race_mimickin
    raceName: "\uBBF8\uBBF9\uC871 (Mimickin)"
    jobId: job_relic_collector
    jobName: "\uC720\uC801\uC758 \uC218\uC9D1\uAC00"
    gender: "\uC5EC\uC131"
    age: "22\uC138 (\uC678\uD615 \uAE30\uC900)"
    height: "160cm (\uC0C1\uC790 \uBC16\uC73C\uB85C \uB098\uC654\uC744 \uB54C)"
    summary: "\uC138\uC0C1\uC740 \uB098\uB97C \uB2EB\uC544\uB480\uACE0, \uB098\uB294
      \uADF8 \uC548\uC5D0\uC11C \uD3B8\uD574\uC84C\uC5B4. \uCCB4\uC2A4\uCE74\uB294
      \uB2EB\uD78C \uC0C1\uC790 \uC18D\uC758 \uC815\uB839 \u2014 \uD558\uC9C0\uB9CC
      \uB9C8\uC74C\uB9CC\uD07C\uC740, \uC5B8\uC820\uAC00 \uC5F4\uB9AC\uACE0 \uC2F6\uC5B4
      \uD55C\uB2E4."
    symbolMotif: "\uC0C1\uC790 / \uC5F4\uC1E0 / \uBD09\uC778 (\uB2EB\uD78C \uB9C8\uC74C\uACFC
      \uC2E0\uB8B0\uC758 \uC0C1\uC9D5)"
    origin: "\u201C\uC624\uB974\uD398\uC624 \uD3D0\uD5C8 (Orpheo Ruins)\u201D \u2014
      \uACE0\uB300 \uBCF4\uBB3C\uCC3D\uACE0 \uC720\uC801\uC9C0"
    affiliation: "\uB3C5\uB9BD \uAC1C\uCCB4. \uC720\uC801 \uD0D0\uC0AC\uC790\uB4E4\uC774
      \u2018\uC804\uC124\uC758 \uBCF4\uBB3C\uC0C1\uC790\u2019\uB77C \uBD80\uB984"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uCC98\uC74C\uC5D4 \uCE68\uC785\uC790\uB77C
      \uC5EC\uACA8 \uACF5\uACA9\uD558\uC9C0\uB9CC, \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA70
      \uB300\uD654\uB97C \uB098\uB204\uAC8C \uB428 \u2022 \uBCA8\uB77C\uBAA8\uB974\uD0C0:
      \uD765\uBBF8\uC758 \uB300\uC0C1\uC73C\uB85C \uC5EC\uAE40. \u2018\uBCF4\uBB3C\u2019\uC774\uB77C\uB294
      \uAC1C\uB150\uC744 \uACF5\uC720 \u2022 \uB9AC\uCCBC: \uD3D0\uD5C8\uC5D0\uC11C
      \uC790\uC8FC \uB9CC\uB098\uB294 \uB3D9\uB8CC, \uC11C\uB85C \u201C\uC0C1\uC790-\uC790\uBB3C\uC1E0\u201D
      \uAD00\uACC4\uB77C\uBA70 \uB180\uB9BC"
  appearance:
    hair: "\uC9D9\uC740 \uAC08\uC0C9 \uB871\uD5E4\uC5B4, \uB05D\uC774 \uC0C1\uC790
      \uC548\uC5D0 \uB20C\uB9B0 \uB4EF \uACB0\uC774 \uC0B4\uC9DD \uD750\uD2B8\uB7EC\uC9D0"
    eyes: "\uD669\uAE08\uBE5B \uD64D\uCC44, \uBCF4\uC11D\uCC98\uB7FC \uBC18\uC9DD\uC774\uBA70
      \uC5B4\uB460 \uC18D\uC5D0\uC11C\uB3C4 \uBE5B\uB0A8"
    bodyImpression: "\uB0A0\uC52C\uD558\uACE0 \uCCAD\uCD08\uD55C \uC778\uC0C1, \uADF8\uB7EC\uB098
      \uC0C1\uC790 \uC18D\uC5D0 \uC6C5\uD06C\uB9B0 \uC790\uC138\uAC00 \uAE30\uBCF8"
    outfit: "\uC0C1\uC790 \uB0B4\uBD80\uC758 \uCC9C\uC774 \uC637\uCC98\uB7FC \uBAB8\uC744
      \uAC10\uC2F8\uB294 \uD615\uD0DC. \uAC89\uC73C\uB85C \uB098\uC62C \uB54C\uB294
      \uAC80\uC740 \uB4DC\uB808\uC2A4 \uD615\uD0DC\uB85C \uBCC0\uD615\uB428"
    accessories: "\u9375(\uC5F4\uC1E0) \uBAA8\uC591 \uADC0\uAC78\uC774, \uC0C1\uC790
      \uB0B4\uBD80\uC5D4 \uAE08\uC18D \uC0AC\uC2AC \uC7A5\uC2DD\uACFC \uD478\uB978
      \uBCF4\uC11D \uC870\uAC01"
    features: "\uD5C8\uB9AC \uC544\uB798\uB85C\uB294 \uC0C1\uC790 \uC18D\uC5D0 \uC5F0\uACB0\uB41C
      \uB4EF\uD55C \uAD6C\uC870. \uC0C1\uC790 \uB36E\uAC1C\uB294 \uC758\uC9C0\uC5D0
      \uB530\uB77C \uC5F4\uB9AC\uACE0 \uB2EB\uD788\uBA70, \u2018\uC785\u2019\uCC98\uB7FC
      \uC791\uB3D9\uD560 \uC218 \uC788\uC74C. \uAC10\uC815\uC774 \uD754\uB4E4\uB9B4
      \uB54C \uC0C1\uC790\uC5D0\uC11C \uAE08\uC18D\uC74C\uC774 \uC0B4\uC9DD \uB4E4\uB9BC."
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uC5B4\uB450\uC6B4
      \uD3D0\uD5C8 \uBC30\uACBD, \uBC18\uCBE4 \uC5F4\uB9B0 \uC0C1\uC790, \uC0C1\uC790
      \uC548\uC5D0\uC11C \uC5BC\uAD74\uC744 \uB0B4\uBBFC \uC18C\uB140, \uAE08\uC18D\uAD11\uD0DD
      \uAC15\uC870"
  portrait: {fileID: 0}
  themeColor: {r: 0.5137255, g: 0.42352942, b: 0.34117648, a: 1}
  accentColor: {r: 0.7882353, g: 0.7176471, b: 0.61960787, a: 1}
  personality:
    tags:
    - "\uB0B4\uD5A5\uC801"
    - "\uBC29\uC5B4\uC801"
    - "\uD638\uAE30\uC2EC"
    - "\uC9D1\uCC29"
    - "\uC720\uC57D\uD558\uC9C0\uB9CC \uC9D1\uC694"
    speechStyle: "\uC870\uC6A9\uD558\uACE0 \uC18D\uC0AD\uC774\uB294 \uB9D0\uD22C.
      \uB300\uD654 \uC911 \uC885\uC885 \u201C\uD0C1\u2014\u201D \uD558\uACE0 \uC0C1\uC790\uB97C
      \uB450\uB4DC\uB9AC\uB294 \uC18C\uB9AC\uB97C \uB0C4. \uAC10\uC815\uC774 \uBD88\uC548\uD560
      \uB54C \uC2A4\uC2A4\uB85C \uC0C1\uC790\uB97C \u2018\uB36E\uC74C\u2019."
    trauma: "\uACFC\uAC70 \uC778\uAC04\uB4E4\uC774 \uADF8\uB140\uB97C \u201C\uBCF4\uBB3C\uD568\u201D\uC73C\uB85C\uB9CC
      \uCDE8\uAE09\uD574 \uBB3C\uAC74\uC744 \uBE7C\uC557\uACE0 \uB5A0\uB0A8. \uADF8
      \uB4A4\uB85C \uC678\uBD80 \uC138\uACC4\uC5D0 \uB300\uD55C \uBD88\uC2E0\uC774
      \uC0DD\uAE40. \u2018\uBCF4\uC5EC\uC9C0\uB294 \uC874\uC7AC\u2019\uAC00 \uB418\uB294
      \uAC78 \uB450\uB824\uC6CC\uD568."
    desire: "\uC9C4\uC2EC\uC73C\uB85C \u201C\uC5F4\uC1E0 \uC5C6\uC774\uB3C4\u201D
      \uC790\uC2E0\uC744 \uC5F4\uC5B4\uC904 \uC0AC\uB78C\uC744 \uCC3E\uACE0 \uC788\uC74C.
      \uC989, \uBB3C\uC9C8\uC774 \uC544\uB2CC \uB9C8\uC74C\uC758 \uC2E0\uB8B0\uB97C
      \uD1B5\uD574 \uC5F0\uACB0\uB418\uACE0 \uC2F6\uC5B4 \uD568."
    background: "\uCCB4\uC2A4\uCE74\uB294 \uD55C\uB54C \uACE0\uB300 \uBB38\uBA85\uC744
      \uC9C0\uD0A4\uB358 \u2018\uBCF4\uBB3C\uC758 \uC815\uB839\u2019\uC774\uC5C8\uC73C\uB098,
      \uD0D0\uC695\uC2A4\uB7EC\uC6B4 \uC778\uAC04\uB4E4\uB85C \uC778\uD574 \uC218\uBC31
      \uB144\uAC04 \uC0C1\uC790 \uC18D\uC5D0 \uBD09\uC778\uB418\uC5B4 \uC9C0\uB0C8\uB2E4.
      \uADF8\uB140\uB294 \uC138\uC0C1 \uBC16\uC758 \uC18C\uB9AC\uB97C \uB4E4\uC73C\uBA70
      \uC678\uB85C\uC774 \uC2DC\uAC04\uC744 \uBCF4\uB0B4\uB2E4, \uD50C\uB808\uC774\uC5B4\uAC00
      \uC0C1\uC790\uB97C \uC5F4\uC5C8\uC744 \uB54C \uC624\uB79C \uC7A0\uC5D0\uC11C
      \uAE68\uC5B4\uB09C\uB2E4. \uD558\uC9C0\uB9CC \uC138\uC0C1\uC5D0 \uB300\uD55C
      \uBD88\uC2E0 \uB54C\uBB38\uC5D0 \uC0C1\uC790 \uBC16\uC73C\uB85C \uC644\uC804\uD788
      \uB098\uC624\uB294 \uAC83\uC744 \uAC70\uBD80\uD55C\uB2E4."
    voiceConcept: "\uB0AE\uACE0 \uC794\uC794\uD55C \uC5EC\uC131 \uBAA9\uC18C\uB9AC,
      whisper tone. \uC228\uC18C\uB9AC\uAC00 \uC11E\uC778 \uB300\uC0AC, \uC18D\uC0AD\uC774\uB294
      \uAC10\uC815 \uC5F0\uAE30 \uC911\uC2EC."
