  m_Name: NpcData_Beatrice
  m_EditorClassIdentifier: Assembly-CSharp::NpcCharacterData
  characterId: char_beatrice
  displayName: "\uBCA0\uC544\uD2B8\uB9AC\uCCB4"
  englishName: Beatrice
  isAlphaCast: 0
  isAvailable: 1
  profile:
    raceId: race_bee_kin
    raceName: "\uBC8C\uC871 (Bee-kin)"
    jobId: job_beekeeper
    jobName: "\uC591\uBD09\uC5C5\uC790"
    gender: "\uC5EC\uC131"
    age: "26\uC138"
    height: 166cm
    summary: "\uAFC0\uBC8C\uC740 \uD63C\uC790\uC120 \uC0B4 \uC218 \uC5C6\uC5B4. \uBCA0\uC544\uD2B8\uB9AC\uCCB4\uB294
      \uB2E4\uC2DC \uD55C\uBC88 \u2018\uD568\uAED8 \uB0A0 \uC218 \uC788\uB294 \uBB34\uB9AC\u2019\uB97C
      \uCC3E\uB294 \uC804\uC0AC\uB2E4."
    symbolMotif: "\uBC8C / \uBC8C\uC9D1 / \uD669\uAE08 \uAFC0 (\uC9C8\uC11C, \uC0DD\uBA85,
      \uD611\uB3D9\uC758 \uC0C1\uC9D5)"
    origin: "\u201C\uBA5C\uB9AC\uC624\uB77C \uBC8C\uD1B5 \uB3C4\uC2DC(Meliora Hive)\u201D
      \u2013 \uAC70\uB300\uD55C \uAFC0 \uC800\uC7A5\uC18C\uC640 \uB9C8\uB825 \uCC44\uC9D1
      \uC2DC\uC124\uC744 \uAC00\uC9C4 \uACF5\uC911 \uC815\uCC29\uC9C0"
    affiliation: "\uD0D0\uC0AC\uB300 \uC815\uCC30\uB300\uC7A5 / \uACFC\uAC70 \uC5EC\uC655\uC9C1\uC18D
      \uADFC\uC704\uBC8C \uCD9C\uC2E0"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uCD08\uBC18\uC5D4 \u2018\uBA85\uB839
      \uB530\uB974\uB294 \uB300\uC0C1\u2019\uC73C\uB85C\uB9CC \uBCF4\uC9C0\uB9CC,
      \uC810\uCC28 \u2018\uC2E0\uB8B0\uD560 \uB3D9\uB8CC\u2019\uB85C \uBCC0\uD654
      \u2022 \uD558\uB974\uCE74: \uD65C\uBC1C\uD568\uC744 \uBD80\uB7EC\uC6CC\uD568.
      \uC11C\uB85C\uB97C \uC778\uC815\uD558\uB294 \uC804\uC6B0 \uAD00\uACC4 \u2022
      \uB8E8\uB124\uD2B8: \uC57D\uCD08 \uAC70\uB798 \uD30C\uD2B8\uB108 \u2022 \uBCA8\uB77C\uBAA8\uB974\uD0C0:
      \uB9C8\uB825 \uC5D0\uB108\uC9C0 \uAC70\uB798 \uD611\uB825\uC790, \uC11C\uB85C
      \uC874\uC911\uD558\uC9C0\uB9CC \uAE34\uC7A5\uAC10 \uC874\uC7AC"
  appearance:
    hair: "\uAE08\uD751\uC0C9 \uC2A4\uD2B8\uB77C\uC774\uD504\uC758 \uD558\uC774\uD3EC\uB2C8\uD14C\uC77C.
      \uD587\uBE5B\uC744 \uBC1B\uC73C\uBA74 \uBC8C\uB0A0\uAC1C\uCC98\uB7FC \uBC18\uC9DD\uC784"
    eyes: "\uD638\uBC15\uC0C9, \uBC8C\uC758 \uBCF5\uD569\uC548 \uAD6C\uC870\uB97C
      \uC5F0\uC0C1\uC2DC\uD0A4\uB294 \uD328\uD134"
    bodyImpression: "\uB0A0\uB835\uD558\uACE0 \uADFC\uC721\uC120\uC774 \uC740\uC740\uD55C
      \uC804\uC0AC\uD615. \uBD80\uB4DC\uB7EC\uC6B4 \uC5BC\uAD74\uC120\uACFC \uB0C9\uC815\uD55C
      \uB208\uB9E4\uC758 \uC870\uD654"
    outfit: "\uAE08\uBE5B\uACFC \uD751\uC0C9\uC758 \uC804\uD22C\uBCF5. \uB0A0\uAC1C
      \uBCF4\uD638\uC6A9 \uAC00\uC8FD\uD310\uC774 \uB2EC\uB9B0 \uACBD\uC7A5\uBE44,
      \uD5C8\uB9AC\uC5D0 \uAFC0\uBCD1 \uD30C\uC6B0\uCE58 \uCC29\uC6A9"
    accessories: "\uBC8C\uCE68 \uBAA8\uC591\uC758 \uB2E8\uAC80, \uBAA9\uC5D0\uB294
      \uBC8C\uC9D1 \uBB38\uC591\uC758 \uD39C\uB358\uD2B8"
    features: "\uD22C\uBA85\uD55C \uB0A0\uAC1C 2\uC30D, \uB0A0\uAC2F\uC9D3 \uC2DC
      \uB0AE\uC740 \uC9C4\uB3D9\uC74C \uBC1C\uC0DD. \uBD84\uB178\uB098 \uAE34\uC7A5
      \uC2DC \uB208\uC774 \uBD89\uAC8C \uBE5B\uB0A8"
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uBC8C
      \uB0A0\uAC1C \uBC18\uD22C\uBA85 \uAD11\uD0DD, \uAE08\uBE5B \uD14C\uB9C8, \uC804\uD22C\uBCF5
      + \uB0A0\uAC1C \uC870\uD569, \uAC15\uB82C\uD55C \uD587\uBE5B \uC5F0\uCD9C"
  portrait: {fileID: 0}
  themeColor: {r: 0.9607843, g: 0.7882353, b: 0.30588236, a: 1}
  accentColor: {r: 0.23137255, g: 0.16862746, b: 0.09411765, a: 1}
  personality:
    tags:
    - "\uADFC\uBA74"
    - "\uB0C9\uC815"
    - "\uCC45\uC784\uAC10"
    - "\uD1B5\uC194\uB825"
    - "\uC228\uC740 \uB2E4\uC815\uD568"
    speechStyle: "\uC9E7\uACE0 \uB2E8\uC815\uD55C \uC5B4\uC870. \uC0DD\uAC01 \uC911\uC77C
      \uB550 \uC190\uB05D\uC73C\uB85C \uD5C8\uACF5\uC744 \u201C\uAFC0\uBC8C \uB9AC\uB4EC\u201D\uCC98\uB7FC
      \uB450\uB4DC\uB9BC"
    trauma: "\uAD70\uCCB4\uB97C \uC9C0\uD0A4\uB824\uB2E4 \u201C\uC5EC\uC655\uACFC
      \uB3D9\uB8CC\u201D\uB97C \uBAA8\uB450 \uC783\uC74C. \uADF8 \uD6C4 \u2018\uD63C\uC790\uC11C\uB3C4
      \uC77C\uD574\uC57C \uD55C\uB2E4\u2019\uB294 \uAC15\uBC15\uC774 \uC0DD\uAE40"
    desire: "\uB2E4\uC2DC \uB204\uAD70\uAC00\uB97C \uBBFF\uACE0, \uD568\uAED8 \uC77C\uD560
      \uC218 \uC788\uB294 \u201C\uC0C8\uB85C\uC6B4 \uAD70\uCCB4(\uAC00\uC871)\u201D\uB97C
      \uB9CC\uB4DC\uB294 \uAC83"
    background: "\uACFC\uAC70 \uC5EC\uC655\uBC8C\uC758 \uADFC\uC704\uB300\uC7A5\uC774\uC5C8\uC73C\uB098,
      \uB0B4\uBD80 \uBC18\uB780\uC73C\uB85C \uBC8C\uD1B5 \uB3C4\uC2DC\uAC00 \uBB34\uB108\uC9D0.
      \uADF8 \uD6C4 \uC0B4\uC544\uB0A8\uC740 \uC77C\uBD80 \uC77C\uBC8C\uB4E4\uACFC
      \uD568\uAED8 \uC12C\uC73C\uB85C \uB3C4\uB9DD\uCCD0 \u2018\uAFC0\uBC8C \uC815\uCC29\uC9C0\u2019\uB97C
      \uC138\uC6C0. \uD604\uC7AC\uB294 \uD0D0\uD5D8\uB300\uC758 \uC815\uCC30 \uC784\uBB34\uB97C
      \uB9E1\uC73C\uBA70, \uC12C\uC758 \uC790\uC6D0\uACFC \uC0DD\uD0DC\uACC4\uB97C
      \uC870\uC0AC \uC911. \uADF8\uB140\uB294 \uC5EC\uC804\uD788 \u201C\uAD70\uCCB4\uC758
      \uC774\uC0C1\u201D\uC744 \uAFC8\uAFB8\uBA70, \uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C
      \u2018\uC0C8\uB85C\uC6B4 \uB9AC\uB354\u2019\uC758 \uC790\uC9C8\uC744 \uBCF8\uB2E4."
    voiceConcept: "\uC911\uC800\uC74C\uC758 \uB0C9\uCCA0\uD55C \uC5EC\uC131 \uBCF4\uC774\uC2A4.
      \uC9C0\uD718\uAD00 \uD1A4\uC774\uC9C0\uB9CC, \uB4DC\uBB3C\uAC8C \uBD80\uB4DC\uB7EC\uC6CC\uC9C8
      \uB54C \uAC10\uC815\uD3ED\uC774 \uAE4A\uC74C"
