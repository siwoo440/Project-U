  displayName: "\uB9AC\uB9AC\uC5D8"
  englishName: Liriel
  isAlphaCast: 0
  isAvailable: 1
  profile:
    raceId: race_fairy
    raceName: "\uC694\uC815 (Fairy)"
    jobId: job_forest_guardian
    jobName: "\uC232\uC758 \uC218\uD638\uC790 / \uC815\uB839 \uB300\uD589\uC790"
    gender: "\uC5EC\uC131"
    age: "150\uC138 / \uC678\uD615 14\uC138"
    height: 142cm
    summary: "\uC232\uC758 \uBE5B\uACFC \uBC14\uB78C\uC744 \uD488\uC740 \uC791\uC740
      \uC815\uB839. \uB9AC\uB9AC\uC5D8\uC740 \uC0AC\uB77C\uC838\uAC00\uB294 Radiance\uB97C
      \uC9C0\uD0A4\uBA70, \uC778\uAC04\uC5D0\uAC8C\uB3C4 \uADF8 \uB530\uB73B\uD55C
      \uBE5B\uC744 \uB098\uB220\uC8FC\uB824 \uD55C\uB2E4."
    symbolMotif: "\uBE5B / \uAF43\uC78E / \uC218\uC815 (\uC0DD\uBA85, \uC21C\uC218,
      \uC7AC\uC0DD\uC758 \uC0C1\uC9D5)"
    origin: "\u2018\uC5D8\uB2E4\uC2A4\uC758 \uC232(Eldas Woods)\u2019 \u2013 \uC138\uACC4\uC218\uC758
      \uBFCC\uB9AC\uAC00 \uB2FF\uC544 \uC788\uB294 \uC2E0\uC131\uD55C \uC9C0\uC5ED"
    affiliation: "\uC232\uC758 \uC815\uB839 \uB300\uD45C, \u2018Radiance\uC758 \uD750\uB984\u2019\uC744
      \uAC10\uC9C0\uD558\uB294 \uAC10\uC2DC\uC790"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \u201C\uBE5B\uC744 \uAC00\uC9C4
      \uC778\uAC04\u201D\uC73C\uB85C \uC778\uC2DD\uD558\uBA70 \uD2B9\uBCC4\uD55C
      \uD638\uAC10\uC744 \uB290\uB08C \u2022 \uB8E8\uB124\uD2B8: \uC790\uC8FC \uD568\uAED8
      \uC57D\uCD08\uB97C \uB530\uBA70 \uCE5C\uBC00\uD568 \u2022 \uBCA8\uB77C\uBAA8\uB974\uD0C0:
      \uCC98\uC74C\uC5D4 \uACBD\uACC4\uD558\uC9C0\uB9CC, \uB098\uC911\uC5D4 \uADF8\uB140\uC758
      \uC9C0\uD61C\uB97C \uC778\uC815 \u2022 \uC5D0\uC774\uB9AC: \uB458 \uB2E4 \uD558\uB298\uC744
      \uC88B\uC544\uD574 \uC790\uC8FC \uB180\uB7EC \uAC10"
  appearance:
    hair: "\uC5F0\uD478\uB978 \uAE08\uBC1C, \uB05D\uC774 \uBE5B\uCC98\uB7FC \uD769\uC5B4\uC9C0\uB294
      \uC20F \uD2B8\uC708\uD14C\uC77C"
    eyes: "\uC605\uC740 \uAE08\uBE5B, \uBE5B\uC744 \uBC1B\uC744 \uB54C \uC218\uC815\uCC98\uB7FC
      \uBC18\uC9DD\uC784"
    bodyImpression: "\uC791\uACE0 \uAC00\uBCCD\uC9C0\uB9CC \uD65C\uBC1C\uD55C \uC6C0\uC9C1\uC784,
      \uC7A5\uB09C\uAE30 \uC5B4\uB9B0 \uD45C\uC815"
    outfit: "\uD558\uB298\uC0C9\uACFC \uD770\uC0C9\uC758 \uC694\uC815 \uBCF5\uC7A5.
      \uC78E\uC0AC\uADC0 \uD328\uD134\uACFC \uAF43\uC78E \uC7A5\uC2DD\uC774 \uC5B4\uC6B0\uB7EC\uC9C4
      \uACBD\uCF8C\uD55C \uB514\uC790\uC778"
    accessories: "\uC791\uC740 \uD06C\uB9AC\uC2A4\uD0C8 \uBE0C\uB85C\uCE58, \uD5C8\uB9AC\uC5D0
      \uC694\uC815\uC758 \uAC00\uB8E8\uAC00 \uB4E0 \uC720\uB9AC\uBCD1"
    features: "\uBC18\uD22C\uBA85\uD55C \uB0A0\uAC1C\uAC00 \uD587\uC0B4\uC5D0 \uB530\uB77C
      \uC0C9\uC744 \uBC14\uAFB8\uBA70, \uAC10\uC815\uC5D0 \uB530\uB77C \uC740\uC740\uD788
      \uBE5B\uB0A8"
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uBC1D\uC740
      \uC232 \uBC30\uACBD, \uBE5B\uC758 \uC785\uC790, \uD30C\uC2A4\uD154\uD1A4 \uCC44\uC0C9"
  portrait: {fileID: 0}
  themeColor: {r: 0.65882355, g: 0.9607843, b: 0.8156863, a: 1}
  accentColor: {r: 1, g: 0.95686275, b: 0.8235294, a: 1}
  personality:
    tags:
    - "\uBA85\uB791\uD568"
    - "\uC7A5\uB09C\uAE30"
    - "\uD638\uAE30\uC2EC"
    - "\uC21C\uC218"
    - "\uC9C1\uAC10\uC801"
    speechStyle: "\uBB38\uC7A5 \uB05D\uC5D0 \u201C~\uAC70\uC57C!\u201D, \u201C~\uD588\uC9C0!\u201D\uCC98\uB7FC
      \uAC00\uBCCD\uAC8C \uB9D0\uD568. \uB0A0\uAC1C\uB97C \uD30C\uB2E5\uC774\uBA70
      \uB9AC\uB4EC\uC744 \uD0C0\uB294 \uBC84\uB987"
    trauma: "\uC778\uAC04\uB4E4\uC774 \uC232\uC744 \uD6FC\uC190\uD558\uBA70 \uC694\uC815\uB4E4\uC774
      \uC0AC\uB77C\uC838\uAC00\uB294 \uAC78 \uBCF8 \uAE30\uC5B5. \u201C\uC783\uB294
      \uAC83\u201D\uC744 \uC2EB\uC5B4\uD568"
    desire: "\uC232\uACFC \uC0DD\uBA85, \uADF8\uB9AC\uACE0 \u2018\uBE5B\u2019\uC774
      \uC601\uC6D0\uD788 \uD750\uB97C \uC218 \uC788\uB3C4\uB85D \uC9C0\uD0A4\uACE0
      \uC2F6\uC5B4 \uD568"
    background: "\uC694\uC815\uB4E4\uC740 Radiance\uC758 \uC21C\uC218\uD55C \uC5D0\uB108\uC9C0\uB97C
      \uAD00\uB9AC\uD558\uB294 \uC874\uC7AC\uB85C, \uBE5B\uC758 \uADE0\uD615\uC744
      \uC720\uC9C0\uD55C\uB2E4. \uB9AC\uB9AC\uC5D8\uC740 \uADF8\uC911\uC5D0\uC11C\uB3C4
      \uAC10\uC815\uC5D0 \uBBFC\uAC10\uD55C \uAC1C\uCCB4\uB85C, Fade\uAC00 \uC2A4\uBA70\uB4DC\uB294
      \uC870\uC9D0\uC744 \uAC00\uC7A5 \uBA3C\uC800 \uB290\uB080\uB2E4. \uC138\uACC4\uB97C
      \uC5EC\uD589\uD558\uB294 \uC8FC\uC778\uACF5\uC744 \uB9CC\uB098\uBA74\uC11C
      \u2018\uBE5B\uACFC \uC778\uAC04\uC758 \uAC10\uC815\u2019\uC744 \uC5F0\uACB0\uC9D3\uAC8C
      \uB41C\uB2E4."
    voiceConcept: "\uBC1D\uACE0 \uBA85\uB791\uD55C \uD558\uC774\uD1A4 \uC5EC\uC131
      \uBAA9\uC18C\uB9AC. \uC6C3\uC74C \uC11E\uC778 \uB9D0\uD22C, \uC57D\uAC04 \uBE60\uB978
      \uD15C\uD3EC"
