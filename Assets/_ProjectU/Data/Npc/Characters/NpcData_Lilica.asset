  characterId: char_lilica
  displayName: "\uB9B4\uB9AC\uCE74"
  englishName: Lilica
  isAlphaCast: 0
  isAvailable: 1
  profile:
    raceId: race_vampire
    raceName: "\uBC40\uD30C\uC774\uC5B4 (Vampire)"
    jobId: job_noble
    jobName: "\uD761\uD608\uADC0 \uC601\uC560"
    gender: "\uC5EC\uC131"
    age: "250\uC138 / \uC678\uD615 10\uC138"
    height: 135cm
    summary: "\uC5B4\uB9B0\uC544\uC774\uC758 \uBAA8\uC2B5 \uC18D\uC5D0 \uC218\uBC31
      \uB144\uC758 \uADF8\uB9BC\uC790\uAC00 \uC228\uC5B4 \uC788\uB2E4. \uB9B4\uB9AC\uCE74\uB294
      \uBC24\uC758 \uC601\uC6D0\uD55C \uC8FC\uC778, \uADF8\uB7EC\uB098 \uB204\uAD6C\uBCF4\uB2E4
      \u2018\uD3C9\uBC94\uD55C \uD558\uB8E8\u2019\uB97C \uAFC8\uAFB8\uB294 \uC544\uC774."
    symbolMotif: "\uC7A5\uBBF8 / \uB2EC\uBE5B / \uD751\uC0C9 \uB9DD\uD1A0 (\uACE0\uB3C5\uACFC
      \uC601\uC6D0\uC758 \uC0C1\uC9D5)"
    origin: "\uACE0\uB515\uD48D \uC800\uD0DD \u201C\uBE14\uB7EC\uB4DC \uB85C\uC988
      \uC131(Blood Rose Castle)\u201D"
    affiliation: "\uACE0\uB300 \uADC0\uC871\uAC00\uC758 \uB9C8\uC9C0\uB9C9 \uD6C4\uC608
      / \uACE0\uB9BD\uB41C \uC12C\uC758 \u201C\uBC24\uC758 \uC8FC\uC778\u201D"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uCC98\uC74C\uC5D4 \uC7A5\uB09C\uC2A4\uB808
      \uB180\uB9AC\uC9C0\uB9CC, \uC810\uC810 \uC9C4\uC2EC \uC5B4\uB9B0 \uC2E0\uB8B0\uB97C
      \uD488\uC74C \u2022 \uBCA8\uB77C\uBAA8\uB974\uD0C0: \u2018\uC131\uC778 \uC5EC\uC131\u2019\uC758
      \uB9E4\uB825\uC744 \uBD80\uB7EC\uC6CC\uD558\uBA74\uC11C\uB3C4 \uACBD\uC7C1\uC2EC\uC744
      \uB290\uB08C \u2022 \uC138\uB808\uB098(\uC720\uB839): \uD568\uAED8 \uBC24\uC744
      \uBCF4\uB0B4\uB294 \uCE5C\uAD6C. \uC11C\uB85C\uB97C \u2018\uACE0\uB3C5\uD55C
      \uC874\uC7AC\u2019\uB85C \uC774\uD574\uD568"
  appearance:
    hair: "\uD751\uC790\uC0C9(\uAC80\uBCF4\uB77C)\uC758 \uD2B8\uC708\uD14C\uC77C,
      \uB05D\uBD80\uBD84\uC774 \uC0C8\uAE43\uCC98\uB7FC \uAC00\uB298\uAC8C \uD37C\uC9D0"
    eyes: "\uC120\uD64D\uBE5B \uB8E8\uBE44 \uC544\uC774, \uBE5B\uC744 \uBC1B\uC744
      \uB54C \uBD89\uAC8C \uBC18\uC9DD\uC784"
    bodyImpression: "\uC791\uACE0 \uC573\uB41C \uC5BC\uAD74, \uD558\uC9C0\uB9CC \uACE0\uD48D\uC2A4\uB7EC\uC6B4
      \uC790\uC138\uC640 \uD45C\uC815"
    outfit: "\uACE0\uB515\uD48D \uB4DC\uB808\uC2A4 + \uAC80\uC815\uC0C9 \uB9DD\uD1A0
      (\uC548\uAC10\uC740 \uBD89\uC740 \uC0C8\uD2F4), \uB808\uC774\uC2A4\uAC00 \uB2EC\uB9B0
      \uC18C\uB9E4"
    accessories: "\uBD89\uC740 \uC7A5\uBBF8 \uBE0C\uB85C\uCE58, \uC2ED\uC790 \uD39C\uB358\uD2B8,
      \uC559\uC99D\uB9DE\uC740 \uC190\uBD80\uCC44"
    features: "\uCC3D\uBC31\uD55C \uD53C\uBD80, \uC1A1\uACF3\uB2C8\uAC00 \uC0B4\uC9DD
      \uB4DC\uB7EC\uB0A8, \uB9DD\uD1A0\uB294 \uAC70\uC758 \u201C\uBCF4\uD638\uB9C9\u201D\uCC98\uB7FC
      \uC5EC\uAE40"
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uACE0\uB515\uD48D
      \uC800\uD0DD \uBC30\uACBD, \uAC80\uC815 \uB9DD\uD1A0, \uD2B8\uC708\uD14C\uC77C,
      \uBD80\uCC44, \uBC24\uC758 \uB2EC\uBE5B \uAC15\uC870"
  portrait: {fileID: 0}
  themeColor: {r: 0.22745098, g: 0.12156863, b: 0.2, a: 1}
  accentColor: {r: 0.7882353, g: 0.24705882, b: 0.34509805, a: 1}
  personality:
    tags:
    - "\uC624\uB9CC"
    - "\uCCA0\uC5C6\uB294 \uCC9C\uC7AC"
    - "\uAC10\uC815 \uAE30\uBCF5 \uC2EC\uD568"
    - "\uC678\uB85C\uC6C0 \uAC10\uCDA4"
    speechStyle: "\uADC0\uC871 \uB9D0\uD22C (\u201C\uD6C4\uD6D7, \uC774 \uB9B4\uB9AC\uCE74
      \uB2D8\uAED8 \uAC10\uD788\u2014?\u201D). \uAE30\uBD84\uC774 \uC88B\uC73C\uBA74
      \uBD80\uCC44\uB85C \uC785\uC744 \uAC00\uB9AC\uACE0 \uC6C3\uC74C"
    trauma: "\uC218\uBC31 \uB144\uC744 \uACE0\uB9BD\uB41C \uC131\uC5D0\uC11C \uC0B4\uC544\uC628
      \uC678\uB85C\uC6C0. \u201C\uBAA8\uB450\uAC00 \uB5A0\uB098\uC9C0\uB9CC, \uB098\uB294
      \uB299\uC9C0\uB3C4 \uC8FD\uC9C0\uB3C4 \uC54A\uB294\uB2E4.\u201D"
    desire: "\uC9C4\uC2EC\uC73C\uB85C \uC790\uC2E0\uC744 \u2018\uB450\uB824\uC6CC\uD558\uC9C0
      \uC54A\uB294\u2019 \uC874\uC7AC\uB97C \uCC3E\uACE0 \uC2F6\uC74C. \uC0AC\uB791\uBCF4\uB2E4
      \uBA3C\uC800, \u201C\uD3C9\uBC94\uD55C \uAD00\uACC4\u201D\uB97C \uC6D0\uD568."
    background: "\uB9B4\uB9AC\uCE74\uB294 \uACFC\uAC70 \uADC0\uC871 \uD608\uD1B5\uC758
      \uB9C8\uC9C0\uB9C9 \uD6C4\uC190\uC73C\uB85C, \uC218\uBC31 \uB144 \uB3D9\uC548
      \uC12C\uC758 \uBC24\uC744 \uC9C0\uCF1C\uC628 \uC874\uC7AC. \uD574\uAC00 \uC9C0\uBA74
      \uAE68\uC5B4\uB098 \uC800\uD0DD\uC744 \uB5A0\uB3CC\uBA70 \uACE0\uC11C\uC640
      \uC74C\uC545\uC744 \uC990\uAE34\uB2E4. \uD50C\uB808\uC774\uC5B4\uAC00 \uC12C\uC5D0
      \uB3C4\uCC29\uD588\uC744 \uB54C, \uD638\uAE30\uC2EC\uACFC \uACBD\uACC4\uC2EC
      \uC18D\uC5D0\uC11C \uADF8\uB97C \uC2DC\uD5D8\uD558\uBA70 \uB300\uD654\uB97C
      \uC2DC\uC791. \uAC89\uC73C\uB85C\uB294 \uC624\uB9CC\uD558\uC9C0\uB9CC, \uC810\uCC28
      \uADF8\uB97C \uD1B5\uD574 \u201C\uC78A\uD78C \uC2DC\uAC04 \uC18D\uC758 \uB530\uB73B\uD568\u201D\uC744
      \uB418\uCC3E\uB294\uB2E4."
    voiceConcept: "\uB192\uC740 \uC74C\uC5ED\uC758 \uC18C\uB140 \uBAA9\uC18C\uB9AC.
      \uADC0\uC871\uD48D \uB9D0\uD22C, \uC624\uB9CC\uD568 \uC18D\uC5D0 \uC678\uB85C\uC6C0\uC774
      \uC11E\uC778 \uAC10\uC815 \uD45C\uD604"
