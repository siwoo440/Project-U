  characterId: char_bellamorta
  displayName: "\uBCA8\uB77C\uBAA8\uB974\uD0C0"
  englishName: Bellamorta
  isAlphaCast: 0
  isAvailable: 1
  profile:
    raceId: race_succubus
    raceName: "\uC11C\uD050\uBC84\uC2A4 (Succubus)"
    jobId: job_alchemist
    jobName: "\uC5F0\uAE08\uC220\uC0AC"
    gender: "\uC5EC\uC131"
    age: "120\uC138 / \uC678\uD615 26\uC138"
    height: 170cm
    summary: "\uBBF8\uAE30\uC7AC"
    symbolMotif: "\uC7A5\uBBF8 / \uC720\uB9AC\uC794 / \uC2EC\uC5F0\uC758 \uBD88\uBE5B
      (\uC720\uD639\uACFC \uC9C4\uC2E4\uC758 \uC0C1\uC9D5)"
    origin: "\uB098\uC774\uD2B8\uD3F4 \uD3D0\uD5C8 \u2013 \uC5B4\uB460\uC758 \uBB38\uBA85\uC744
      \uACC4\uC2B9\uD55C \uACE0\uB300 \uB3C4\uC2DC"
    affiliation: "\uB3C5\uB9BD\uC801\uC778 \uC5F0\uAE08\uC220\uC0C1. \uBE44\uBC00\uACB0\uC0AC
      \u201C\uADF8\uB9BC\uC790 \uC11C\uACE0\u201D\uC640 \uAD50\uB958"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uCD08\uBC18\uC5D4 \u2018\uACC4\uC57D
      \uB300\uC0C1\u2019\uC73C\uB85C \uC811\uADFC\uD558\uC9C0\uB9CC \uC810\uCC28
      \uAC10\uC815\uC801\uC73C\uB85C \uD754\uB4E4\uB9BC \u2022 \uB8E8\uB124\uD2B8:
      \uC11C\uB85C \uC0C1\uADF9\uC774\uC9C0\uB9CC \uB9C8\uC74C\uC18D\uC73C\uB860
      \uC874\uC911 \u2022 \uC5D8\uD504\uC871 \uD559\uC790: \uACFC\uAC70 \uAC70\uB798
      \uC0C1\uB300"
  appearance:
    hair: "\uC790\uC90F\uBE5B \uC6E8\uC774\uBE0C \uB871\uD5E4\uC5B4. \uBE5B\uC5D0
      \uB530\uB77C \uBCF4\uB78F\uBE5B\uC774 \uBB3C\uACB0\uCE68"
    eyes: "\uBD89\uC740 \uB8E8\uBE44\uBE5B. \uC0C1\uB300\uC758 \uB9C8\uC74C\uC744
      \uAFF0\uB6AB\uB294 \uB4EF\uD55C \uB208\uBE5B"
    bodyImpression: "\uC720\uB824\uD55C \uC2E4\uB8E8\uC5E3. \uCE74\uB9AC\uC2A4\uB9C8\uC640
      \uAD00\uB2A5\uBBF8\uAC00 \uACF5\uC874"
    outfit: "\uAC80\uC740 \uC5F0\uAE08\uC220 \uCF54\uD2B8 \uC704\uC5D0 \uC587\uC740
      \uBD89\uC740 \uC2E4\uD06C \uB9AC\uBCF8, \uAE08 \uC7A5\uC2DD \uD5C8\uB9AC\uBCA8\uD2B8"
    accessories: "\uBD89\uC740 \uACB0\uC815 \uBAA9\uAC78\uC774 (\uACC4\uC57D\uC758
      \uC99D\uD45C), \uC190\uAC00\uB77D\uB9C8\uB2E4 \uBBF8\uC138\uD55C \uBB38\uC591
      \uBC18\uC9C0"
    features: "\uBFD4\uC740 \uC9E7\uACE0 \uB9E4\uB044\uB7FD\uAC8C \uB4A4\uB85C \uD718\uC5B4
      \uC788\uC74C, \uC587\uC740 \uAC00\uC8FD \uB0A0\uAC1C\uC640 \uAF2C\uB9AC \uC874\uC7AC.
      \uD5A5\uAE30\uCC98\uB7FC \uB0A8\uB294 \u2018\uB2EC\uCF64\uD55C \uB9C8\uB098
      \uC794\uD5A5\u2019"
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uACE0\uB515/\uC5F0\uAE08\uC220\uD48D
      \uC758\uC0C1, \uBD89\uC740\uBE5B \uAC15\uC870, \uBD80\uB4DC\uB7EC\uC6B4 \uBA85\uC554
      \uCC98\uB9AC"
  themeColor: {r: 0.3529412, g: 0.05882353, b: 0.23921569, a: 1}
  accentColor: {r: 0.88235295, g: 0.63529414, b: 0.77254903, a: 1}
  personality:
    tags:
    - "\uB9E4\uD639\uC801"
    - "\uC9C0\uC131\uC801"
    - "\uC7A5\uB09C\uAE30 \uB9CE\uC74C"
    - "\uD1B5\uCC30\uB825 \uB192\uC74C"
    speechStyle: "\uB290\uB9BF\uD55C \uC5B4\uC870\uB85C \uB9D0\uD558\uBA70 \uC0C1\uB300\uB97C
      \uAD00\uCC30\uD558\uB4EF \uC2DC\uC120\uC744 \uACE0\uC815\uD568. \uC9C4\uC2E4\uC744
      \uB9D0\uD558\uB418 \uC758\uB3C4\uB97C \uC228\uAE40"
    trauma: "\uACFC\uAC70 \uC778\uAC04\uACFC\uC758 \uACC4\uC57D \uC2E4\uD328\uB85C
      \u201C\uC0AC\uB791\uC740 \uD658\uC0C1\u201D\uC774\uB77C \uBBFF\uC74C. \uAC10\uC815\uC5D0
      \uC194\uC9C1\uD574\uC9C0\uB294 \uAC78 \uB450\uB824\uC6CC\uD568"
    desire: "\uD0C0\uC778\uC758 \uC695\uB9DD\uC744 \uC77D\uB294 \uB300\uC2E0, \uC9C4\uC2EC\uC73C\uB85C
      \uC790\uC2E0\uC744 \uC774\uD574\uD574\uC904 \uC0AC\uB78C\uC744 \uCC3E\uB294
      \uAC83"
    background: "\uACFC\uAC70 \uC778\uAC04\uACFC\uC758 \uACC4\uC57D\uC73C\uB85C \uC0DD\uBA85\uC744
      \uAD6C\uD588\uC73C\uB098, \uC778\uAC04\uC758 \uD0D0\uC695\uC5D0 \uC2E4\uB9DD\uD558\uC5EC
      \uACC4\uC57D \uC138\uACC4\uB97C \uB5A0\uB0A8. \uC9C0\uAE08\uC740 \uC12C \uACF3\uACF3\uC744
      \uB3CC\uC544\uB2E4\uB2C8\uBA70 \uAE08\uB2E8\uC758 \uB9C8\uBC95\uACFC \uC815\uBCF4\uB97C
      \uAC70\uB798\uD568."
    voiceConcept: "\uB0AE\uACE0 \uBD80\uB4DC\uB7EC\uC6B4 \uD1A4\uC758 \uC5EC\uC131
      \uBCF4\uC774\uC2A4. \uB290\uB9BF\uD55C \uBC1C\uC74C, \uC5EC\uC6B4 \uC788\uB294
      \uC6C3\uC74C"
