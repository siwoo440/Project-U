  m_Name: NpcData_Milky
  m_EditorClassIdentifier: Assembly-CSharp::NpcCharacterData
  characterId: char_milky
  displayName: "\uBC00\uD0A4"
  englishName: Milky
  isAlphaCast: 1
  isAvailable: 1
  profile:
    raceId: race_cowkin
    raceName: "\uC816\uC18C\uC871 (Cowkin)"
    jobId: job_barista
    jobName: "\uCE74\uD398 \uC8FC\uC778 / \uBC14\uB9AC\uC2A4\uD0C0"
    gender: "\uC5EC\uC131"
    age: "21\uC138"
    height: 167cm
    summary: "\uD55C \uC794\uC758 \uCEE4\uD53C\uB85C \uD558\uB8E8\uAC00 \uB2EC\uB77C\uC9C8
      \uC218 \uC788\uB2E4\uBA74, \uB098\uB294 \uC624\uB298\uB3C4 \uBBF8\uC18C\uB85C
      \uADF8 \uD55C \uC794\uC744 \uB0B4\uC5B4\uC904 \uAC70\uC608\uC694.\u201D \u2014
      \uC12C\uC758 \uB9C8\uC74C\uC744 \uAC10\uC2F8\uB294 \uCE74\uD398 \uC8FC\uC778,
      \uBC00\uD06C"
    symbolMotif: "\uC6B0\uC720 / \uCE74\uD398 / \uC885\uC18C\uB9AC (\uD3C9\uD654,
      \uD734\uC2DD, \uC5B4\uBA38\uB2C8\uC758 \uB530\uC2A4\uD568 \uC0C1\uC9D5)"
    origin: "\uB18D\uC7A5 \uB9C8\uC744 \u201C\uBB34\uB9AC\uC5D4(Moorien)\u201D \u2013
      \uC816\uC18C\uC871\uC774 \uB099\uB18D\uC744 \uC911\uC2EC\uC73C\uB85C \uC0AC\uB294
      \uACF3"
    affiliation: "\u201C\uC120\uC14B \uCE74\uD398(Sunset Caf\xE9)\u201D\uC758 \uC8FC\uC778
      \uACB8 \uBC14\uB9AC\uC2A4\uD0C0"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uCC98\uC74C\uC5D4 \uC190\uB2D8\uC73C\uB85C
      \uB300\uD558\uC9C0\uB9CC, \uC810\uCC28 \uC77C\uC0C1 \uC18D \uB300\uD654\uB97C
      \uB098\uB204\uB294 \uC0AC\uC774\uB85C \uBC1C\uC804 \u2022 \uB8E8\uB124\uD2B8:
      \uCE74\uD398 \uB2E8\uACE8\uC774\uC790 \uADC0\uC5EC\uC6B4 \uD6C4\uBC30\uCC98\uB7FC
      \uCC59\uAE40 \u2022 \uB77C\uADF8: \uC220 \uB300\uC2E0 \uB530\uB73B\uD55C \uC6B0\uC720\uB97C
      \uB0B4\uC8FC\uBA70 \uC794\uC18C\uB9AC\uD568 \u2022 \uBCA8\uB77C\uBAA8\uB974\uD0C0:
      \uCEE4\uD53C \uCDE8\uD5A5\uC744 \uB450\uACE0 \uC2E0\uACBD\uC804"
  appearance:
    hair: "\uC6B0\uC720\uBE5B\uC758 \uBC31\uAC08\uC0C9 \uB871\uD5E4\uC5B4, \uB05D\uC774
      \uC0B4\uC9DD \uB9D0\uB824 \uC788\uC74C"
    eyes: "\uCD08\uCF5C\uB9BF \uBE0C\uB77C\uC6B4, \uD56D\uC0C1 \uBD80\uB4DC\uB7FD\uAC8C
      \uBBF8\uC18C \uC9D3\uB294 \uB4EF\uD55C \uC778\uC0C1"
    bodyImpression: "\uD48D\uB9CC\uD558\uACE0 \uACE1\uC120\uC801\uC778 \uCCB4\uD615,
      \uC6C0\uC9C1\uC784\uC740 \uB290\uAE0B\uD558\uACE0 \uC6B0\uC544\uD568"
    outfit: "\uAC80\uC740 \uBA54\uC774\uB4DC\uD48D \uB4DC\uB808\uC2A4 + \uD770 \uC55E\uCE58\uB9C8
      + \uC18C\uB9E4\uC5D0 \uB808\uC774\uC2A4 \uC7A5\uC2DD. \uCE74\uD398 \uC6B4\uC601
      \uC2DC\uC5D4 \uC18C \uBFD4 \uBAA8\uC591\uC758 \uD5E4\uC5B4\uD540\uC744 \uCC29\uC6A9"
    accessories: "\uC6B0\uC720\uBCD1 \uBAA8\uC591\uC758 \uADC0\uAC78\uC774, \uAE08\uBE5B
      \uC774\uB984\uD45C, \uD5C8\uB9AC\uC5D4 \uC791\uC740 \uBCA8"
    features: "\uC791\uC740 \uC18C\uBFD4\uACFC \uC9E7\uC740 \uAF2C\uB9AC, \uADC0
      \uB4A4\uC5D0 \uAC80\uC740 \uBC18\uC810\uC774 \uC788\uC74C. \uB0C4\uC0C8\uB294
      \uB2EC\uCF64\uD55C \uC6B0\uC720\uD5A5"
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uCE74\uD398
      \uC778\uD14C\uB9AC\uC5B4, \uBD80\uB4DC\uB7EC\uC6B4 \uC870\uBA85, \uBA54\uC774\uB4DC\uD48D
      \uC758\uC0C1, \uB530\uB73B\uD55C \uCEEC\uB7EC\uD1A4"
  portrait: {fileID: 21300000, guid: 1261cb553c6cd854482f4cd29e9c29ff, type: 3}
  themeColor: {r: 0.9607843, g: 0.88235295, b: 0.7529412, a: 1}
  accentColor: {r: 0.60784316, g: 0.41960785, b: 0.27450982, a: 1}
  personality:
    tags:
    - "\uB290\uAE0B\uD568"
    - "\uB530\uB73B\uD568"
    - "\uCC45\uC784\uAC10"
    - "\uB2E4\uC815\uD55C \uC720\uBA38\uAC10\uAC01"
    speechStyle: "\uB9D0\uC774 \uB290\uB9AC\uACE0 \uBD80\uB4DC\uB7EC\uC6C0. \uC6C3\uC744
      \uB54C \u201C\uC74C~\u201D \uD558\uACE0 \uCF67\uB178\uB798\uB97C \uD765\uC5BC\uAC70\uB9BC"
    trauma: "\uACFC\uAC70 \uCE74\uD398\uB97C \uD63C\uC790 \uC9C0\uD0A4\uB824\uB2E4
      \uB3C4\uB451\uC758 \uC2B5\uACA9\uC744 \uBC1B\uC74C. \u2018\uB204\uAD70\uAC00\uC640
      \uD568\uAED8\uD558\uB294 \uC77C\uC0C1\u2019\uC5D0 \uB300\uD55C \uADF8\uB9AC\uC6C0\uC774
      \uC788\uC74C"
    desire: "\uBAA8\uB450\uAC00 \uC6C3\uC744 \uC218 \uC788\uB294 \u2018\uC791\uC740
      \uC548\uC2DD\uCC98\u2019\uB97C \uB9CC\uB4DC\uB294 \uAC83. \uC12C\uC758 \uAE34\uC7A5\uB41C
      \uBD84\uC704\uAE30 \uC18D\uC5D0\uC11C\uB3C4 \uD3C9\uD654\uB85C\uC6B4 \uACF5\uAC04\uC744
      \uC9C0\uD0A4\uB824 \uD568."
    background: "\uC12C\uC758 \uC911\uC2EC\uBD80\uC5D0 \uC704\uCE58\uD55C \uC791\uC740
      \uCE74\uD398\uB97C \uC6B4\uC601\uD558\uBA70, \uD0D0\uD5D8\uB300\uC640 \uBAAC\uBB34\uC2A4\uB4E4\uC758
      \uAD50\uB958 \uC911\uC2EC\uC9C0 \uC5ED\uD560\uC744 \uD568. \uCE74\uD398\uB294
      \uD50C\uB808\uC774\uC5B4\uAC00 \uC815\uBCF4\uB97C \uC218\uC9D1\uD558\uAC70\uB098
      \uD734\uC2DD\uD558\uB294 \uC7A5\uC18C\uB85C \uAE30\uB2A5. \uBC00\uD06C\uB294
      \uC190\uB2D8\uC744 \uAC00\uC871\uCC98\uB7FC \uB300\uD558\uBA70, \uBAA8\uB450\uC758
      \u201C\uB9C8\uC74C\uC758 \uC9D1\u201D\uC774 \uB418\uACE0\uC790 \uD55C\uB2E4."
    voiceConcept: "\uB0AE\uACE0 \uB530\uB73B\uD55C \uD1A4\uC758 \uC5EC\uC131 \uBCF4\uC774\uC2A4.
      \uB290\uB9BF\uD558\uACE0 \uB2E4\uC815\uD55C \uB9D0\uD22C, \uC57D\uAC04\uC758
      \uB18D\uB2F4 \uC11E\uC784"
