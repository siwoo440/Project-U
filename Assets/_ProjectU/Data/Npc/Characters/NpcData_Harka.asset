    raceName: "\uAC1C\uC871 (Dogkin)"
    jobId: job_tracker
    jobName: "\uD0D0\uC0AC\uB300 \uC218\uD638\uBCD1 / \uCD94\uC801\uC790 (Tracker)"
    gender: "\uC5EC\uC131"
    age: "23\uC138"
    height: 170cm
    summary: "\uD55C \uBC88 \uB9F9\uC138\uD558\uBA74 \uB05D\uAE4C\uC9C0 \uC9C0\uCF1C.
      \uD558\uB974\uCE74\uB294 \uD0DC\uC591\uCC98\uB7FC \uB530\uB73B\uD55C \u2018\uC218\uD638\uC790\u2019
      \u2014 \uC5B8\uC81C\uB098 \uB124 \uACC1\uC5D0 \uC11C \uC788\uC744 \uCDA9\uC9C1\uD55C
      \uD30C\uD2B8\uB108\uB2E4."
    symbolMotif: "\uD0DC\uC591 / \uBC29\uD328 / \uCDA9\uC131 (\uBE5B\uACFC \uBCF4\uD638\uC758
      \uC0C1\uC9D5)"
    origin: "\uAD6D\uACBD\uC9C0\uB300\uC758 \uC804\uD22C \uB9C8\uC744 \u201C\uBE0C\uB808\uC774\uD134\u201D
      \uCD9C\uC2E0"
    affiliation: "\uD0D0\uC0AC\uB300 \uC218\uD638\uBCD1 / \uC12C \uD0D0\uD5D8\uB300\uC758
      \uC120\uB450 \uCD94\uC801\uC790"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uCC98\uC74C\uC5D4 \uC0C1\uAD00\uCC98\uB7FC
      \uB300\uD558\uC9C0\uB9CC, \uC810\uCC28 \u201C\uC9C0\uD0A4\uACE0 \uC2F6\uC740
      \uC0AC\uB78C\u201D\uC774 \uB428 \u2022 \uB77C\uADF8(\uB291\uB300): \uC885\uC871\uC0C1
      \uB77C\uC774\uBC8C \uAD00\uACC4\uC9C0\uB9CC, \uC11C\uB85C\uC758 \uD798\uC744
      \uC874\uC911\uD568 \u2022 \uB8E8\uB124\uD2B8: \uBD80\uC0C1 \uCE58\uB8CC\uB97C
      \uC790\uC8FC \uB9E1\uAE30\uB294 \uC0AC\uC774 \u2022 \uBC00\uD06C: \uCE74\uD398\uC758
      \uB2E8\uACE8\uC774\uC790 \u201C\uAC04\uC2DD\uC758 \uBE5A\uC7C1\uC774\u201D"
  appearance:
    hair: "\uD669\uAC08\uC0C9 \uD3EC\uB2C8\uD14C\uC77C, \uACB0\uC774 \uBD80\uB4DC\uB7FD\uACE0
      \uADC0 \uB4A4\uB85C \uADC0\uC5FD\uAC8C \uBB36\uC5EC \uC788\uC74C"
    eyes: "\uD669\uAE08\uBE5B \uC570\uBC84 \uCEEC\uB7EC, \uB298 \uC0DD\uAE30 \uC788\uACE0
      \uBC18\uC9DD\uC784"
    bodyImpression: "\uAC74\uAC15\uD558\uACE0 \uD0C4\uD0C4\uD55C \uADFC\uC721\uC9C8
      \uBAB8\uB9E4, \uAC00\uC2B4\uACFC \uD5C8\uB9AC \uBE44\uC728\uC774 \uB69C\uB837\uD55C
      \uC2A4\uD3EC\uCE20\uD615"
    outfit: "\uD0D0\uD5D8\uC6A9 \uBC00\uB9AC\uD130\uB9AC \uD558\uD504\uD0D1 + \uC20F\uD32C\uCE20
      + \uD5C8\uB9AC \uAC00\uC8FD \uBCA8\uD2B8 + \uBD89\uC740 \uC2A4\uCE74\uD504
      \uD314\uC5D0\uB294 \uD1B5\uC2E0\uC6A9 \uB9C8\uBC95 \uC7A5\uBE44\uAC00 \uC7A5\uCC29\uB418\uC5B4
      \uC788\uC74C"
    accessories: "\uBAA9\uC5D0\uB294 \uC791\uC740 \uAC1C\uBF08 \uD39C\uB358\uD2B8,
      \uADC0\uC5D0\uB294 \uD0D0\uC9C0\uD615 \uC774\uC5B4\uB9C1"
    features: "\uD070 \uAC1C \uADC0\uC640 \uBD80\uB4DC\uB7EC\uC6B4 \uAF2C\uB9AC,
      \uB0C4\uC0C8 \uAC10\uC9C0 \uB2A5\uB825 \uD0C1\uC6D4. \uAE30\uBD84\uC774 \uC88B\uC73C\uBA74
      \uAF2C\uB9AC\uAC00 \uD754\uB4E4\uB9AC\uACE0, \uD654\uB098\uBA74 \uC0B4\uC9DD
      \uACE4\uB450\uC12C."
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uBAA8\uB798\uAE38
      \uBC30\uACBD, \uBD89\uC740 \uC2A4\uCE74\uD504, \uAC1C \uADC0\uC640 \uAF2C\uB9AC
      \uAC15\uC870, \uBC1D\uC740 \uD587\uBE5B \uC5F0\uCD9C"
  portrait: {fileID: 0}
  themeColor: {r: 0.9019608, g: 0.7607843, b: 0.47843137, a: 1}
  accentColor: {r: 0.9529412, g: 0.8784314, b: 0.63529414, a: 1}
  personality:
    tags:
    - "\uD65C\uBC1C"
    - "\uCDA9\uC131\uC2EC"
    - "\uC9C1\uAC10\uD615"
    - "\uC815\uC758\uAC10"
    - "\uC57D\uAC04\uC758 \uD5C8\uB2F9"
    speechStyle: "\uC790\uC2E0\uAC10 \uB118\uCE58\uC9C0\uB9CC \uAC00\uB054 \uC2E4\uC218.
      \u201C\uBA4D!\u201D \uAC19\uC740 \uCD94\uC784\uC0C8 \uBC84\uB987 \uC788\uC74C.
      \uC0C1\uB300\uC758 \uB0C4\uC0C8\uB97C \uB9E1\uAC70\uB098 \uC5B4\uAE68\uB97C
      \uD22D \uCE58\uB294 \uC2DD\uC758 \uCE5C\uADFC\uD55C \uC81C\uC2A4\uCC98 \uC790\uC8FC
      \uC0AC\uC6A9"
    trauma: "\uACFC\uAC70 \u2018\uC8FC\uC778\u2019\uC744 \uC783\uC740 \uAE30\uC5B5.
      \uADF8 \uC774\uD6C4 \uC2A4\uC2A4\uB85C\uB97C \u201C\uB204\uAD70\uAC00\uC758
      \uBCF4\uD638\uC790\u201D\uB85C \uC138\uC6B0\uB824 \uD568"
    desire: "\uC774\uBC88\uC5D4 \u2018\uC783\uC9C0 \uC54A\uB294 \uAD00\uACC4\u2019\uB97C
      \uB9CC\uB4E4\uACE0 \uC2F6\uC5B4 \uD568. \uC989, \u201C\uD568\uAED8 \uB05D\uAE4C\uC9C0
      \uC2F8\uC6B8 \uB3D9\uB8CC\u201D\uB97C \uC6D0\uD568."
    background: "\uD558\uB974\uCE74\uB294 \uC608\uC804\uC5D4 \uAD70\uACAC \uBD80\uB300\uC758
      \uC77C\uC6D0\uC73C\uB85C, \uC2E4\uC885\uB41C \uB300\uC7A5\uC744 \uB05D\uAE4C\uC9C0
      \uCC3E\uC73C\uB824\uB2E4 \uBD80\uB300\uB97C \uC783\uC5C8\uB2E4. \uC774\uD6C4
      \uBC29\uD669\uD558\uB358 \uC911, \uC12C\uC73C\uB85C \uD45C\uB958\uD574\uC628
      \uD50C\uB808\uC774\uC5B4\uB97C \uBC1C\uACAC\uD558\uACE0 \uAD6C\uD574\uC8FC\uBA70
      \uB3D9\uB8CC\uAC00 \uB428. \uADF8\uB140\uB294 \uC2A4\uC2A4\uB85C \u201C\uC9C0\uCF1C\uC57C
      \uD560 \uBB34\uB9AC\u201D\uB97C \uB9CC\uB4E4\uACE0\uC790 \uD558\uBA70, \uC12C\uC758
      \uC704\uD5D8 \uAD6C\uC5ED\uC744 \uB204\uAD6C\uBCF4\uB2E4 \uBA3C\uC800 \uD0D0\uC0C9\uD55C\uB2E4."
    voiceConcept: "\uD65C\uB2EC\uD558\uACE0 \uBA85\uB791\uD55C \uC5EC\uC131 \uC74C\uC131.
      \uAC1C\uAD6C\uC9C4 \uC5D0\uB108\uC9C0\uC640 \uAC10\uC815 \uAE30\uBCF5\uC774
      \uD48D\uBD80\uD568"
