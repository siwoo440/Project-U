    raceName: "\uC720\uB839 (Ghost / Spirit)"
    jobId: job_archive_researcher
    jobName: "\uACE0\uC11C \uC5F0\uAD6C\uAC00"
    gender: "\uC5EC\uC131"
    age: "\uC0AC\uD6C4 50\uB144 / \uC0DD\uC804 \uB098\uC774 23\uC138"
    height: 165cm
    summary: "\uC138\uC0C1\uC758 \uBAA8\uB4E0 \uAE30\uC5B5\uC740 \uC0AC\uB77C\uC838\uB3C4,
      \uD55C \uD3B8\uC758 \uC2DC(\u8A69)\uB294 \uB0A8\uB294\uB2E4. \uC138\uB808\uB098\uB294
      \uC78A\uD600\uC9C4 \uB3C4\uC11C\uAD00\uC758 \uB9C8\uC9C0\uB9C9 \uD398\uC774\uC9C0\uB97C
      \uC9C0\uD0A4\uB294 \uC601\uD63C\uC774\uB2E4."
    symbolMotif: "\uAE43\uD39C / \uC2DC\uC9D1 / \uCD1B\uBD88 (\uAE30\uC5B5, \uAE30\uB85D,
      \uC78A\uD798\uC758 \uC0C1\uC9D5)"
    origin: "\uC61B \uC655\uAD6D\uC758 \uC218\uB3C4\uC5D0 \uC788\uB358 \uB300\uB3C4\uC11C\uAD00
      (\uD604\uC7AC\uB294 \uD3D0\uD5C8)"
    affiliation: "\uC5C6\uC74C (\uC0AC\uD6C4\uC5D0 \uB3C4\uC11C\uAD00\uC758 \uC601\uD63C\uC73C\uB85C
      \uC874\uC7AC)"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uB3C4\uC11C\uAD00 \uD0D0\uD5D8
      \uC911 \uC870\uC6B0. \uCC98\uC74C\uC5D0\uB294 \uB9DD\uB839\uC73C\uB85C \uC624\uD574\uBC1B\uC73C\uB098
      \uC810\uCC28 \uB300\uD654\uD558\uAC8C \uB428. \u2022 \uB8E8\uB124\uD2B8: \uC870\uC6A9\uD55C
      \uBC24\uC5D0 \uD568\uAED8 \uCC45\uC744 \uC77D\uB294 \uC0AC\uC774. \u2022 \uBCA8\uB77C\uBAA8\uB974\uD0C0:
      \uC9C0\uC2DD \uAD50\uD658 \uAD00\uACC4. \uC11C\uB85C\uC758 \uC815\uBCF4\uB97C
      \uC874\uC911\uD568."
  appearance:
    hair: "\uC740\uBC31\uC0C9 \uB871\uD5E4\uC5B4, \uB05D\uC73C\uB85C \uAC08\uC218\uB85D
      \uD22C\uBA85\uD558\uAC8C \uD750\uB824\uC9D0"
    eyes: "\uC605\uC740 \uB77C\uBCA4\uB354\uBE5B, \uACE0\uC694\uD558\uACE0 \uC11C\uAE00\uD508
      \uC778\uC0C1"
    bodyImpression: "\uAC00\uB298\uACE0 \uC12C\uC138\uD55C \uCCB4\uD615. \uC6C0\uC9C1\uC784\uC774
      \uBB3C\uACB0\uCC98\uB7FC \uBD80\uB4DC\uB7FD\uB2E4"
    outfit: "\uACE0\uB515\uD48D \uAC80\uC740 \uB4DC\uB808\uC2A4, \uAE34 \uBAA8\uC5D0(\uBAA8\uC5D0\uAE30\uBAA8\uB178\uCC98\uB7FC
      \uB113\uC740 \uC18C\uB9E4). \uC637\uC790\uB77D\uC774 \uC548\uAC1C\uCC98\uB7FC
      \uD750\uB978\uB2E4"
    accessories: "\uB0A1\uC740 \uCC45\uAC08\uD53C \uBAA8\uC591\uC758 \uBE0C\uB85C\uCE58"
    features: "\uBC18\uD22C\uBA85\uD55C \uC2E0\uCCB4, \uC6C0\uC9C1\uC77C \uB54C\uB9C8\uB2E4
      \uC740\uBE5B \uC785\uC790\uAC00 \uD769\uB0A0\uB9BC. \uBE5B\uC5D0 \uB2FF\uC73C\uBA74
      \uD76C\uBBF8\uD558\uAC8C \uC0AC\uB77C\uC9C0\uB294 \uB4EF \uBCF4\uC784"
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uACE0\uB515\uD48D
      \uC2E4\uB0B4, \uB0A1\uC740 \uC11C\uC7AC \uBC30\uACBD, \uC740\uBE5B \uC548\uAC1C
      \uD6A8\uACFC"
  portrait: {fileID: 0}
  themeColor: {r: 0.78431374, g: 0.7764706, b: 0.84313726, a: 1}
  accentColor: {r: 0.24313726, g: 0.22745098, b: 0.26666668, a: 1}
  personality:
    tags:
    - "\uC870\uC6A9\uD568"
    - "\uC0AC\uC0C9\uC801"
    - "\uC628\uD654\uD568"
    - "\uB0B4\uC131\uC801"
    speechStyle: "\uB9D0\uC774 \uB290\uB9AC\uACE0 \uAC10\uC815\uC120\uC774 \uC794\uC794\uD568.
      \uCC45\uC744 \uC77D\uC744 \uB54C \uC785\uC220\uC744 \uB530\uB77C \uC6C0\uC9C1\uC784"
    trauma: "\uC0DD\uC804\uC758 \uAE30\uC5B5\uC744 \uC783\uC5B4\uAC00\uACE0 \uC788\uC73C\uBA70,
      \uC78A\uD600\uC9C0\uB294 \uAC83\uC5D0 \uB300\uD55C \uB450\uB824\uC6C0"
    desire: "\uC790\uC2E0\uC774 \uB0A8\uAE34 \u2018\uB9C8\uC9C0\uB9C9 \uC2DC(\u8A69)\u2019\uB97C
      \uC644\uC131\uD558\uC5EC \uC874\uC7AC\uC758 \uC758\uBBF8\uB97C \uB0A8\uAE30\uB294
      \uAC83"
    background: "\uC0DD\uC804\uC5D0\uB294 \uAD81\uC815 \uC2DC\uC778\uC774\uC790 \uAE30\uB85D\uAC00\uC600\uC9C0\uB9CC,
      \uC804\uC7C1 \uC911 \uB3C4\uC11C\uAD00\uACFC \uD568\uAED8 \uBD88\uD0C0 \uC0AC\uB77C\uC9D0.
      \uC8FD\uC740 \uD6C4\uC5D0\uB3C4 \uC9C0\uC2DD\uC744 \uC9C0\uD0A4\uB824\uB294
      \uC9D1\uCC29\uC73C\uB85C \uC720\uB839\uC774 \uB418\uC5B4 \uD3D0\uD5C8 \uC18D\uC744
      \uB5A0\uB3CC\uBA70 \uB3C5\uC11C\uC640 \uD544\uC0AC\uB97C \uBC18\uBCF5\uD568."
    voiceConcept: "\uB0AE\uACE0 \uC794\uC794\uD55C \uC5EC\uC131 \uBAA9\uC18C\uB9AC,
      \uC18D\uC0AD\uC774\uB4EF \uC5EC\uC6B4\uC774 \uAE34 \uBC1C\uC74C"
