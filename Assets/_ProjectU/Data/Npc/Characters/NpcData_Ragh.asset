  profile:
    raceId: race_wolfkin
    raceName: "\uB291\uB300\uC871 (Wolfkin)"
    jobId: job_mercenary
    jobName: "\uC6A9\uBCD1"
    gender: "\uC5EC\uC131"
    age: "27\uC138"
    height: 178cm
    summary: "\uC0C1\uCC98 \uC785\uC740 \uC218\uD638\uC790, \uADF8\uB9AC\uACE0 \uB9C8\uC9C0\uB9C9
      \uB291\uB300. \uB77C\uADF8\uB294 \uC783\uC5B4\uBC84\uB9B0 \uBB34\uB9AC\uB97C
      \uB300\uC2E0\uD574 \u2018\uC0C8\uB85C\uC6B4 \uC720\uB300\u2019\uB97C \uC9C0\uD0A4\uAE30
      \uC704\uD574 \uC2F8\uC6B4\uB2E4."
    symbolMotif: "\uB2EC / \uC6B8\uC74C / \uC1A1\uACF3\uB2C8 (\uCDA9\uC131, \uACE0\uB3C5,
      \uBCF4\uD638\uC758 \uC0C1\uC9D5)"
    origin: "\uC124\uC0B0\uC9C0\uB300 \u2018\uD504\uB9AC\uD558\uC784(Friheim)\u2019
      \u2013 \uB291\uB300\uC871\uC774 \uD639\uD55C \uC18D\uC5D0\uC11C \uC0B4\uC544\uAC00\uB294
      \uACE0\uC6D0"
    affiliation: "\uC804 \uB291\uB300\uC871 \uBC29\uC704\uB300\uC7A5 / \uD604\uC7AC\uB294
      \uB3C5\uB9BD \uC6A9\uBCD1"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uCC98\uC74C\uC5D4 \uACBD\uACC4\uD558\uC9C0\uB9CC,
      \uC810\uCC28 \uC2E0\uB8B0\uD558\uBA70 \u2018\uBCF4\uD638 \uB300\uC0C1\u2019\uC73C\uB85C
      \uC778\uC2DD \u2022 \uB8E8\uB124\uD2B8: \uBCF8\uB2A5\uC801\uC73C\uB85C \uC9C0\uCF1C\uC8FC\uB824
      \uD568 \u2022 \uBCA8\uB77C\uBAA8\uB974\uD0C0: \uC2E0\uB8B0\uC640 \uC720\uD639
      \uC0AC\uC774\uC5D0\uC11C \uACBD\uACC4 \u2022 \uBBF8\uC624: \uC790\uC720\uBD84\uBC29\uD568\uC5D0
      \uC9C8\uB9AC\uC9C0\uB9CC \uB0B4\uC2EC \uBD80\uB7EC\uC6CC\uD568"
  appearance:
    hair: "\uC740\uD68C\uC0C9 \uC20F\uCEF7, \uB05D\uBD80\uBD84\uC774 \uAC70\uCE60\uAC8C
      \uC798\uB9B0 \uB4EF \uC790\uC5F0\uC2A4\uB7EC\uC6C0"
    eyes: "\uD669\uAE08\uBE5B \uB208, \uC0AC\uB0E5\uAC10\uC774\uB77C\uB3C4 \uB193\uCE58\uC9C0
      \uC54A\uB294 \uAC15\uB82C\uD55C \uC2DC\uC120"
    bodyImpression: "\uD0C4\uD0C4\uD558\uACE0 \uAC15\uC778\uD55C \uCCB4\uD615, \uAD70\uB354\uB354\uAE30
      \uC5C6\uB294 \uC6C0\uC9C1\uC784"
    outfit: "\uC9D9\uC740 \uD68C\uC0C9 \uAC00\uC8FD \uAC11\uC637 + \uC5B4\uAE68\uC5D0
      \uB291\uB300 \uAC00\uC8FD \uB9DD\uD1A0. \uC2E4\uC804\uD615 \uBCF5\uC7A5"
    accessories: "\uC67C\uD314\uC5D4 \uC0C1\uCC98\uB97C \uAC00\uB9B0 \uAC00\uC8FD
      \uBC34\uB4DC, \uBAA9\uC5D0\uB294 \uC624\uB798\uB41C \uC1A1\uACF3\uB2C8 \uD39C\uB358\uD2B8"
    features: "\uB291\uB300 \uADC0\uC640 \uAF2C\uB9AC. \uD749\uD130\uAC00 \uC788\uB294
      \uC67C\uD314. \uC6C3\uC744 \uB54C \uC1A1\uACF3\uB2C8\uAC00 \uC0B4\uC9DD \uB4DC\uB7EC\uB0A8"
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uC124\uC0B0\xB7\uB2EC\uBE5B
      \uBC30\uACBD, \uC9D9\uC740 \uD68C\uC0C9 \uAC11\uC637, \uAC15\uC778\uD55C \uC2E4\uB8E8\uC5E3"
  themeColor: {r: 0.78039217, g: 0.78039217, b: 0.81960785, a: 1}
  accentColor: {r: 0.21176471, g: 0.22745098, b: 0.2784314, a: 1}
  personality:
    tags:
    - "\uAC15\uC778\uD568"
    - "\uCDA9\uC131\uC2EC"
    - "\uBB34\uB69D\uB69D"
    - "\uB530\uB73B\uD55C \uB0B4\uBA74"
    speechStyle: "\uAC04\uACB0\uD558\uACE0 \uC9C1\uC124\uC801. \uACE0\uAC1C\uB97C
      \uC0B4\uC9DD \uB4DC\uB294 \uBC84\uB987 (\u201C\u2026\uBB50\uB77C\uACE0?\u201D)"
    trauma: "\uACFC\uAC70 \uB3D9\uB8CC\uB97C \uC9C0\uD0A4\uC9C0 \uBABB\uD55C \uACBD\uD5D8.
      \u201C\uB9AC\uB354\uB85C\uC11C \uC2E4\uD328\uD55C \uAE30\uC5B5\u201D\uC774
      \uB0A8\uC544 \uC788\uC74C"
    desire: "\uB2E4\uC2DC\uB294 \uB3D9\uB8CC\uB97C \uC783\uC9C0 \uC54A\uB294 \uAC83.
      \u2018\uBB34\uB9AC\uB97C \uC9C0\uD0A4\uB294 \uC790\u2019\uB85C\uC11C \uC874\uC7AC
      \uC774\uC720\uB97C \uCC3E\uACE0\uC790 \uD568"
    background: "\uACFC\uAC70 \uC655\uAD6D\uC758 \uBCC0\uBC29\uC744 \uC9C0\uD0A4\uB358
      \uB291\uB300\uC871 \uBD80\uB300\uC758 \uB9AC\uB354\uC600\uC73C\uB098, \uC804\uC7C1
      \uC911 \uB3D9\uB8CC\uB4E4\uC744 \uC783\uACE0 \uD63C\uC790\uB9CC \uC0B4\uC544\uB0A8\uC74C.
      \uC774\uD6C4 \u2018\uD63C\uC790 \uB0A8\uC740 \uB291\uB300\u2019\uB85C \uBD88\uB9AC\uBA70
      \uAC01\uC9C0\uB97C \uB5A0\uB3CC\uB2E4, \uC8FC\uC778\uACF5\uC774 \uC18D\uD55C
      \uD0D0\uD5D8\uB300\uC758 \uD638\uC704\uB85C \uD569\uB958\uD558\uAC8C \uB41C\uB2E4."
    voiceConcept: "\uB0AE\uACE0 \uCE68\uCC29\uD55C \uC5EC\uC131 \uBCF4\uC774\uC2A4.
      \uBA85\uB839\uC870\uC640 \uB530\uB73B\uD55C \uD1A4\uC758 \uADE0\uD615. \uC804\uD22C
      \uC2DC\uC5D4 \uC9E7\uACE0 \uAC15\uD55C \uBC1C\uC131"
