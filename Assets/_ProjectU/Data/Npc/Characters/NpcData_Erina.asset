    raceName: "\uC5D8\uD504 (High Elf)"
    jobId: job_archer
    jobName: "\uAD81\uC218"
    gender: "\uC5EC\uC131"
    age: "120\uC138 / \uC678\uD615 25\uC138"
    height: 172cm
    summary: "\uBE5B\uACFC \uC5B4\uB460\uC758 \uACBD\uACC4\uC5D0\uC11C, \uADF8\uB140\uB294
      \uC870\uC6A9\uD788 \uD65C\uC2DC\uC704\uB97C \uB2F9\uAE34\uB2E4. \uC5D0\uB9AC\uB098\uB294
      \uADE0\uD615\uC744 \uC783\uC740 \uC138\uC0C1 \uC18D\uC5D0\uC11C \uB9C8\uC9C0\uB9C9
      \uC9C8\uC11C\uB97C \uC9C0\uD0A4\uB294 \uC218\uD638\uC790\uB2E4."
    symbolMotif: "\uD65C / \uB098\uBB47\uC78E / \uB2EC\uBE5B (\uADE0\uD615, \uD1B5\uCC30,
      \uC0DD\uBA85\uC758 \uC0C1\uC9D5)"
    origin: "\uC5D8\uD504\uC758 \uACE0\uB300\uB9BC \u201C\uC5D0\uC2A4\uD398\uB780
      \uC232(Esperan Forest)\u201D"
    affiliation: "\uC232\uC758 \uC218\uD638\uB2E8\uC7A5 / \u201C\uC138\uACC4\uC218\uC758
      \uC0AC\uC808\u201D\uB85C \uD30C\uACAC\uB41C \uAC10\uC2DC\uC790"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \u201C\uADE0\uD615\uC744 \uAE68\uB728\uB9AC\uB294
      \uC790\u201D\uB77C \uACBD\uACC4\uD558\uC9C0\uB9CC, \uC810\uCC28 \u201C\uC0C8\uB85C\uC6B4
      \uAC00\uB2A5\uC131\u201D\uC73C\uB85C \uC778\uC2DD \u2022 \uB9AC\uB9AC\uC5D8:
      \uAC19\uC740 \uC790\uC5F0\uC758 \uACC4\uD1B5\uC73C\uB85C, \uC790\uB9E4\uCC98\uB7FC
      \uC544\uB08C \u2022 \uB77C\uADF8: \uBB34\uAC81\uACE0 \uC9C4\uC9C0\uD55C \uB300\uD654
      \uC0C1\uB300. \uC11C\uB85C\uC758 \uCC45\uC784\uAC10\uC744 \uC774\uD574\uD568
      \u2022 \uBCA8\uB77C\uBAA8\uB974\uD0C0: \uBD88\uC2E0\uD558\uC9C0\uB9CC, \uADF8\uB140\uC758
      \uC9C0\uC2DD\uC740 \uC778\uC815\uD568"
  appearance:
    hair: "\uBC31\uAE08\uBE5B \uC2E4\uBC84\uBE14\uB860\uB4DC, \uC5D8\uD504\uC2DD
      \uC7A5\uC2DD\uC73C\uB85C \uBC18\uBB36\uC74C"
    eyes: "\uC5D0\uBA54\uB784\uB4DC \uADF8\uB9B0, \uCC28\uBD84\uD558\uC9C0\uB9CC
      \uAE4A\uC740 \uC0DD\uBA85\uB825\uC758 \uBE5B\uC744 \uBA38\uAE08\uC74C"
    bodyImpression: "\uADE0\uD615 \uC7A1\uD78C \uC7A5\uC2E0 \uCCB4\uD615, \uC6B0\uC544\uD558\uBA74\uC11C\uB3C4
      \uADFC\uC721\uC774 \uD0C4\uD0C4"
    outfit: "\uCD08\uB85D\uBE5B\uACFC \uAE08\uC0C9\uC774 \uC5B4\uC6B0\uB7EC\uC9C4
      \uC5D8\uD504\uC2DD \uC804\uD22C\uBCF5. \uC232\uC758 \uD328\uD134\uC774 \uC0C8\uACA8\uC9C4
      \uAC00\uC8FD \uD749\uAC11"
    accessories: "\uC5D8\uD504\uC758 \uBB38\uC591\uC774 \uC0C8\uACA8\uC9C4 \uD65C
      \u201C\uC138\uB9AC\uC544\uB974\u201D, \uADC0\uC5D0\uB294 \uC78E\uC0AC\uADC0
      \uBAA8\uC591 \uADC0\uAC78\uC774"
    features: "\uAE38\uACE0 \uBFB0\uC871\uD55C \uADC0, \uC804\uD22C \uC2DC \uB208\uBE5B\uC774
      \uBBF8\uBB18\uD558\uAC8C \uBE5B\uB0A8. \uC790\uC5F0\uC758 \uD750\uB984\uC744
      \uAC10\uC9C0\uD558\uB294 \uAC10\uAC01 \uBCF4\uC720"
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uC232\uC18D
      \uB2EC\uBE5B \uBC30\uACBD, \uAE08\uBE5B \uD65C, \uACE0\uC694\uD55C \uD45C\uC815\uC758
      \uC804\uC0AC\uD615 \uC2E4\uB8E8\uC5E3"
  portrait: {fileID: 0}
  themeColor: {r: 0.6509804, g: 0.81960785, b: 0.64705884, a: 1}
  accentColor: {r: 0.9607843, g: 0.9490196, b: 0.9137255, a: 1}
  personality:
    tags:
    - "\uB0C9\uC815"
    - "\uCE68\uCC29"
    - "\uACE0\uACB0"
    - "\uCC45\uC784\uAC10"
    - "\uB0B4\uBA74\uC758 \uB530\uB73B\uD568"
    speechStyle: "\uB9D0\uC774 \uAC04\uACB0\uD558\uACE0 \uB2E8\uD638\uD568. \uAC10\uC815\uC744
      \uC228\uAE30\uB824 \uD558\uC9C0\uB9CC \uD45C\uC815\uC5D0\uC11C \uBBF8\uBB18\uD788
      \uB4DC\uB7EC\uB0A8 (\u201C\u2026\uADF8\uAC74 \uB124\uAC00 \uC633\uC558\uC5B4.\u201D)"
    trauma: "\uC778\uAC04\uACFC \uC5D8\uD504\uC758 \uAC08\uB4F1 \uC18D\uC5D0\uC11C
      \u2018\uC911\uC7AC\uC790\u2019\uB85C\uC11C \uC2E4\uD328\uD55C \uACFC\uAC70.
      \u201C\uD3C9\uD654\uB97C \uC774\uB8E8\uB824\uB2E4 \uC591\uCABD \uBAA8\uB450\uB97C
      \uC783\uC740\u201D \uAE30\uC5B5"
    desire: "\uC885\uC871 \uAC04\uC758 \uC9C4\uC815\uD55C \uC774\uD574\uB97C \uC774\uB8E8\uB294
      \uAC83. \uC0DD\uBA85\uACFC \uC774\uC131\uC758 \uADE0\uD615\uC744 \uD68C\uBCF5\uC2DC\uD0A4\uB824
      \uD568"
    background: "\uC138\uACC4\uC218\uC758 \uBD84\uD654\uB97C \uAD00\uC7A5\uD558\uB294
      \uC5D8\uD504 \uC655\uAC00 \uCD9C\uC2E0. \uADF8\uB140\uB294 Radiance\uC758 \uADE0\uD615\uC774
      \uD754\uB4E4\uB9AC\uC790 \uC778\uAC04\uC758 \uB545\uC73C\uB85C \uB0B4\uB824\uC640
      \uC870\uC0AC\uC5D0 \uB098\uC130\uB2E4. \uD558\uC9C0\uB9CC \uC778\uAC04\uC758
      \uC695\uC2EC\uACFC \uC5D8\uD504\uC758 \uBC30\uD0C0\uC131 \uC0AC\uC774\uC5D0\uC11C
      \uADE0\uD615\uC744 \uC783\uACE0, \uC790\uC2E0\uC758 \uC774\uC0C1\uC774 \uBB34\uB108\uC9C0\uB294
      \uAC78 \uACBD\uD5D8\uD568. \uC774\uD6C4 \uC2A4\uC2A4\uB85C \u201C\uC911\uB9BD\uC758
      \uAC10\uC2DC\uC790\u201D\uB85C \uC0B4\uC544\uAC00\uBA70, \uC5B4\uB290 \uB0A0
      \uC12C\uC5D0 \uB09C\uC785\uD55C \uD50C\uB808\uC774\uC5B4\uC640 \uC870\uC6B0\uD55C\uB2E4."
    voiceConcept: "\uCC28\uBD84\uD558\uACE0 \uB0AE\uC740 \uD1A4\uC758 \uC131\uC219\uD55C
      \uC5EC\uC131 \uBCF4\uC774\uC2A4. \uAC10\uC815\uC744 \uC808\uC81C\uD558\uBA74\uC11C\uB3C4
      \uC5EC\uC6B4 \uC788\uB294 \uB9D0\uD22C"
