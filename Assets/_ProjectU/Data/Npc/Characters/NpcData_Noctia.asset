  m_Name: NpcData_Noctia
  m_EditorClassIdentifier: Assembly-CSharp::NpcCharacterData
  characterId: char_noctia
  displayName: "\uB178\uD06C\uD2F0\uC544"
  englishName: Noctia
  isAlphaCast: 0
  isAvailable: 1
  profile:
    raceId: race_witch
    raceName: "\uB9C8\uB140 (Witch)"
    jobId: job_witch
    jobName: "\uB9C8\uB140"
    gender: "\uC5EC\uC131"
    age: "130\uC138 / \uC678\uD615 27\uC138"
    height: 170cm
    summary: "\uAE4C\uB9C8\uADC0\uB294 \uC8FD\uC74C\uC744 \uC608\uC5B8\uD558\uC9C0\uB9CC,
      \uADF8 \uBAA9\uC18C\uB9AC\uC5D4 \uC0AC\uB791\uC774 \uB2F4\uACA8 \uC788\uC9C0\uC694.
      \uB178\uD06C\uD2F0\uC544\uB294 \uC6B4\uBA85\uC744 \uC77D\uB294 \uB9C8\uB140
      \u2014 \uC9C4\uC2E4\uC744 \uB9D0\uD558\uB294 \uB300\uAC00\uB85C \uACE0\uB3C5\uC744
      \uD0DD\uD55C, \uB2EC\uBE5B \uC544\uB798\uC758 \uAE4C\uB9C8\uADC0\uC785\uB2C8\uB2E4."
    symbolMotif: "\uAE4C\uB9C8\uADC0 / \uBC24 / \uC608\uC5B8 / \uB2EC \uADF8\uB9BC\uC790"
    origin: "\u201C\uC5D0\uB808\uBE0C \uC232 (Ereb Woods)\u201D \u2013 \uAE4C\uB9C8\uADC0\uB4E4\uC774
      \uBAA8\uC774\uB294 \uC548\uAC1C\uC232 \uAE4A\uC740 \uACF3"
    affiliation: "\uB3C5\uB9BD\uC801\uC778 \uB9C8\uB140 / \uC608\uC5B8\uC758 \uAE4C\uB9C8\uADC0
      \u2018\uC624\uB974\uD540(Orphyn)\u2019\uACFC \uACC4\uC57D"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uCC98\uC74C\uC5D4 \uC608\uC5B8\uC758
      \uB300\uC0C1\uC73C\uB85C \uAD00\uCC30\uD558\uC9C0\uB9CC, \uC810\uCC28 \u2018\uC6B4\uBA85\uC5D0
      \uD718\uB9D0\uB9B0 \uB3D9\uBC18\uC790\u2019\uB85C \uC778\uC2DD \u2022 \uC544\uD0A4\uCE20\uD558:
      \uC2E0\uC758 \uBAA9\uC18C\uB9AC\uB97C \uB4E3\uB294 \uC874\uC7AC\uB85C\uC11C
      \uC11C\uB85C \uC774\uD574\uD558\uBA70 \uD611\uB825 \u2022 \uBCA8\uB77C\uBAA8\uB974\uD0C0:
      \uC695\uB9DD\uC758 \uB9C8\uB140\uB85C \uACBD\uACC4\uD558\uC9C0\uB9CC, \uB0B4\uC2EC
      \uC778\uC815\uD568"
  appearance:
    hair: "\uC9D9\uC740 \uD751\uCCAD\uC0C9 \uC6E8\uC774\uBE0C \uB871\uD5E4\uC5B4,
      \uBE5B\uC744 \uBC1B\uC73C\uBA74 \uD478\uB978 \uC724\uAD11\uC774 \uB0A8"
    eyes: "\uC790\uC90F\uBE5B \uB208\uB3D9\uC790, \uC911\uC2EC\uBD80\uC5D0 \uBD89\uC740
      \uC810\uC774 \uB5A0 \uC788\uC74C (\uAE4C\uB9C8\uADC0 \uB208\uC744 \uC0C1\uC9D5)"
    bodyImpression: "\uB298\uC52C\uD558\uACE0 \uC12C\uC138\uD55C \uCCB4\uD615, \uC544\uB984\uB2F5\uC9C0\uB9CC
      \uC11C\uB298\uD55C \uBD84\uC704\uAE30"
    outfit: "\uAC80\uC740 \uB9C8\uB140\uBCF5 + \uD37C\uC9C4 \uB9DD\uD1A0, \uAE43\uD138
      \uC7A5\uC2DD\uC758 \uBAA8\uC790 \uB9DD\uD1A0 \uC548\uCABD\uC740 \uC790\uC0C9
      \uBB38\uC591, \uAE08\uC0C9 \uB9C8\uBC95\uC9C4 \uC790\uC218"
    accessories: "\uAC80\uC740 \uAE43\uD138 \uADC0\uAC78\uC774, \uC218\uC815 \uAD6C\uC2AC
      \uC9C0\uD321\uC774, \uAE4C\uB9C8\uADC0 \uAE43\uD138 \uBD80\uC801"
    features: "\uB4A4\uB85C \uD3BC\uCCD0\uC9C4 \uAE4C\uB9C8\uADC0 \uAE43 \uB0A0\uAC1C\uCC98\uB7FC
      \uC0DD\uAE34 \uB9DD\uD1A0, \uB9C8\uBC95 \uC0AC\uC6A9 \uC2DC \uAE4C\uB9C8\uADC0
      \uAE43\uD138\uC774 \uC8FC\uC704\uC5D0 \uD769\uB0A0\uB9BC. \uAC10\uC815\uC774
      \uC694\uB3D9\uCE60 \uB54C \uAE4C\uB9C8\uADC0 \uC6B8\uC74C\uC18C\uB9AC\uAC00
      \uD76C\uBBF8\uD558\uAC8C \uB4E4\uB9BC."
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uC5B4\uB461\uACE0
      \uD478\uB978 \uC232, \uAE4C\uB9C8\uADC0 \uAE43\uD138, \uC790\uC90F\uBE5B \uB9C8\uBC95\uC9C4,
      \uB2EC\uBE5B \uBC30\uACBD, \uB9DD\uD1A0\uAC00 \uB0A0\uAC1C\uCC98\uB7FC \uD3BC\uCCD0\uC9C4
      \uAD6C\uB3C4 \uCD94\uCC9C."
  themeColor: {r: 0.17254902, g: 0.17254902, b: 0.21960784, a: 1}
  accentColor: {r: 0.41960785, g: 0.30588236, b: 0.61960787, a: 1}
  personality:
    tags:
    - "\uB0C9\uC815"
    - "\uC9C0\uC801"
    - "\uC608\uB9AC\uD568"
    - "\uACE0\uB3C5"
    - "\uC560\uC794\uD568"
    speechStyle: "\uCC28\uBD84\uD558\uACE0 \uB0AE\uC740 \uC5B4\uC870. \uB9D0\uB05D\uC5D0
      \uC5EC\uC6B4\uC744 \uB0A8\uAE40. \uC0DD\uAC01 \uC911\uC77C \uB550 \uC190\uB05D\uC73C\uB85C
      \uBA38\uB9AC\uCE74\uB77D\uC744 \uAC10\uAC70\uB098, \uAE4C\uB9C8\uADC0\uC5D0\uAC8C
      \uC18D\uC0AD\uC784."
    trauma: "\uACFC\uAC70 \uC608\uC5B8\uC73C\uB85C \uB9C8\uC744\uC744 \uAD6C\uD588\uC9C0\uB9CC,
      \uADF8 \uC608\uC5B8\uC774 \uBD88\uD589\uC744 \uCD08\uB798\uD588\uB2E4\uACE0
      \uC624\uD574\uBC1B\uC544 \uCD94\uBC29\uB428. \uC774\uD6C4 \u201C\uC9C4\uC2E4\uC744
      \uB9D0\uD574\uB3C4 \uC678\uBA74\uBC1B\uB294 \uC790\u201D\uB85C \uC0B4\uC544\uAC00\uBA70,
      \u2018\uC6B4\uBA85\u2019\uACFC \u2018\uACE0\uB3C5\u2019\uC744 \uC219\uBA85\uCC98\uB7FC
      \uBC1B\uC544\uB4E4\uC784."
    desire: "\uC9C4\uC2E4\uC744 \uB450\uB824\uC6CC\uD558\uC9C0 \uC54A\uACE0 \uB4E4\uC5B4\uC904
      \uB2E8 \uD55C \uC0AC\uB78C\uC744 \uCC3E\uACE0 \uC788\uC74C. \uC989, \uC790\uC2E0\uC758
      \uC608\uC5B8\uC774 \u2018\uC800\uC8FC\u2019\uAC00 \uC544\uB2CC \u2018\uC774\uD574\u2019\uB85C
      \uBC1B\uC544\uB4E4\uC5EC\uC9C0\uAE38 \uC6D0\uD568."
    background: "\uB178\uD06C\uD2F0\uC544\uB294 \uAE4C\uB9C8\uADC0\uC758 \uC2E0\uD0C1\uC744
      \uB4E3\uB294 \u201C\uC5B4\uB460\uC758 \uC608\uC5B8\uC790\u201D\uB85C \uBD88\uB9AC\uBA70,
      \uC12C\uC758 \uC6B4\uBA85\uC744 \uAE30\uB85D\uD574\uC628 \uC874\uC7AC\uC774\uB2E4.
      \uADF8\uB7EC\uB098 \uD55C\uB54C \uADF8\uB140\uC758 \uC608\uC5B8\uC73C\uB85C
      \uB9C8\uC744\uC758 \uC655\uC774 \uC8FD\uC74C\uC744 \uB9DE\uC774\uD588\uACE0,
      \uADF8 \uC77C\uB85C \uC778\uD574 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C \u201C\uBD88\uAE38\uD55C
      \uB9C8\uB140\u201D\uB85C \uB099\uC778\uCC0D\uD614\uB2E4. \uADF8 \uD6C4 \uC232
      \uC18D\uC73C\uB85C \uC740\uB454\uD558\uC5EC, \uAE4C\uB9C8\uADC0\uB4E4\uACFC\uB9CC
      \uB300\uD654\uD558\uBA70 \uC0B4\uC544\uAC04\uB2E4. \uD50C\uB808\uC774\uC5B4\uAC00
      \uD3ED\uD48D \uC18D\uC744 \uD5E4\uB9E4\uB2E4 \uC232\uC73C\uB85C \uB4E4\uC5B4\uC624\uBA70,
      \uADF8\uB140\uC758 \uC624\uB79C \u2018\uCE68\uBB35\u2019\uC744 \uAE68\uC6B0\uB294
      \uC874\uC7AC\uAC00 \uB41C\uB2E4."
    voiceConcept: "\uB0AE\uACE0 \uBD80\uB4DC\uB7EC\uC6B4 \uC5EC\uC131 \uC74C\uC131,
      \uB290\uB9B0 \uB9D0\uD22C, \uC18D\uC0AD\uC774\uB4EF \uC5EC\uC6B4\uC744 \uB0A8\uAE40.
      \uB54C\uB85C\uB294 \uCC28\uAC11\uC9C0\uB9CC \uAC10\uC815\uC758 \uB5A8\uB9BC\uC774
      \uBD84\uBA85\uD55C \uD0C0\uC785."
