  characterId: char_mireille
  displayName: "\uBBF8\uB808\uC720"
  englishName: Mireille
  isAlphaCast: 1
  isAvailable: 1
  profile:
    raceId: race_sheepkin
    raceName: "\uC591\uC871 (Sheepkin)"
    jobId: job_shepherd
    jobName: "\uBAA9\uB3D9"
    gender: "\uC5EC\uC131"
    age: "18\uC138"
    height: 155cm
    summary: "\uC138\uC0C1\uC774 \uC0C1\uCC98\uD22C\uC131\uC774\uC5EC\uB3C4, \uBD80\uB4DC\uB7EC\uC6B4
      \uC190\uAE38 \uD558\uB098\uBA74 \uB2E4\uC2DC \uD53C\uC5B4\uB0A0 \uC218 \uC788\uC5B4\uC694.
      \uBBF8\uB808\uC720\uB294 \uD3C9\uD654\uC640 \uC628\uAE30\uC758 \uD654\uC2E0
      \u2014 \uBAA8\uB4E0 \uC0DD\uBA85\uC744 \uAC10\uC2F8 \uC548\uB294 \uC21C\uBC31\uC758
      \uC874\uC7AC\uB2E4."
    symbolMotif: "\uCD08\uC6D0 / \uC591\uBAA8 / \uC885\uC18C\uB9AC (\uD3C9\uD654\uC640
      \uD68C\uBCF5\uC758 \uC0C1\uC9D5)"
    origin: "\uD3C9\uD654\uB85C\uC6B4 \uCD08\uC6D0 \uB9C8\uC744 \u201C\uBCA8\uB9AC\uC548
      \uD544\uB4DC(Bellian Field)\u201D"
    affiliation: "\uB9C8\uC744\uC758 \uCE58\uC720\uC0AC \uACAC\uC2B5 / \uBAA9\uC591\uC778
      \uC9D1\uC548\uC758 \uB9C9\uB0B4\uB538"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uCC98\uC74C\uC5D4 \uACBD\uACC4\uD558\uC9C0\uB9CC,
      \uADF8\uB97C \uD1B5\uD574 \u201C\uD3C9\uD654\uB85C\uC6B4 \uC138\uC0C1\u201D\uC758
      \uD76C\uB9DD\uC744 \uBD04 \u2022 \uB8E8\uB124\uD2B8: \uC5B8\uB2C8\uCC98\uB7FC
      \uB530\uB984 \u2022 \uB77C\uADF8: \uCC98\uC74C\uC5D4 \uBB34\uC12D\uC9C0\uB9CC,
      \uB098\uC911\uC5D4 \uC2E0\uB8B0\uC640 \uC874\uACBD\uC758 \uAC10\uC815\uC73C\uB85C
      \uBCC0\uD568 \u2022 \uC138\uB808\uB098: \uC870\uC6A9\uD55C \uBC24\uC5D0 \uD568\uAED8
      \uBCC4\uC744 \uBC14\uB77C\uBCF4\uB294 \uCE5C\uAD6C"
  appearance:
    hair: "\uD06C\uB9BC\uC0C9 \uACF1\uC2AC \uB2E8\uBC1C, \uD3ED\uC2E0\uD55C \uC591\uD138
      \uAC19\uC740 \uC9C8\uAC10"
    eyes: "\uD558\uB298\uC0C9\uACFC \uAE08\uC0C9\uC774 \uC11E\uC778 \uD22C\uBA85\uD55C
      \uB208\uBE5B"
    bodyImpression: "\uC791\uACE0 \uB465\uADFC \uCCB4\uD615, \uCC9C\uC5F0\uC801\uC73C\uB85C
      \uD3EC\uADFC\uD55C \uC778\uC0C1"
    outfit: "\uBCA0\uC774\uC9C0\uBE5B \uC591\uBAA8 \uCF54\uD2B8\uC640 \uBAA9\uC7A5\uC6A9
      \uC6D0\uD53C\uC2A4. \uBAA9\uC5D4 \uC591\uD138 \uC2A4\uCE74\uD504"
    accessories: "\uC591\uBC29\uC6B8 \uC7A5\uC2DD \uBE0C\uB85C\uCE58, \uD5C8\uB9AC\uC5D0
      \uC791\uC740 \uBC29\uC6B8 \uC9C0\uAC11"
    features: "\uBA38\uB9AC \uC704\uC5D4 \uBD80\uB4DC\uB7EC\uC6B4 \uC591\uBFD4, \uAF2C\uB9AC\uB294
      \uC9E7\uACE0 \uB465\uADFC \uC19C\uD138. \uD5A5\uAE30\uB85C\uC6B4 \uD480\uB0B4\uC74C\uC774
      \uB0A8\uC74C"
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uCD08\uC6D0
      \uBC30\uACBD, \uBD80\uB4DC\uB7EC\uC6B4 \uD587\uC0B4, \uD30C\uC2A4\uD154\uD1A4
      \uC0C9\uAC10, \uC591\uD138 \uD14D\uC2A4\uCC98 \uAC15\uC870"
  themeColor: {r: 0.95686275, g: 0.91764706, b: 0.85490197, a: 1}
  accentColor: {r: 0.7647059, g: 0.89411765, b: 0.74509805, a: 1}
  personality:
    tags:
    - "\uC21C\uC218"
    - "\uC0C1\uB0E5"
    - "\uAC81\uC774 \uB9CE\uC74C"
    - "\uB2E4\uC815\uD568"
    - "\uC6A9\uC11C\uC2EC"
    speechStyle: "\uC870\uC6A9\uD558\uACE0 \uB290\uB9B0 \uB9D0\uD22C. \uBD80\uB044\uB7EC\uC6B0\uBA74
      \uC190\uC744 \uAF2D \uC960"
    trauma: "\uBAA9\uC7A5\uC744 \uC2B5\uACA9\uB2F9\uD574 \uAC00\uC871\uC744 \uC783\uC740
      \uAE30\uC5B5. \uADF8\uB798\uC11C \u201C\uC18C\uB780\u201D\uC774\uB098 \u201C\uBD84\uC7C1\u201D\uC744
      \uB450\uB824\uC6CC\uD568"
    desire: "\uC138\uC0C1\uC5D0 \uC0C1\uCC98\uBC1B\uC740 \uC0DD\uBA85\uB4E4\uC744
      \uB2E4\uC2DC \uD3C9\uD654\uB86D\uAC8C \uAC10\uC2F8\uC8FC\uB294 \uC874\uC7AC\uAC00
      \uB418\uACE0 \uC2F6\uC5B4 \uD568"
    background: "\uD3C9\uD654\uB85C\uC6B4 \uBAA9\uC7A5\uC5D0\uC11C \uC790\uB790\uC73C\uB098,
      \uC5B4\uB290 \uB0A0 \u201C\uD1F4\uC0C9\uC758 \uC7AC\uC559\u201D\uC774 \uCD08\uC6D0\uC744
      \uB36E\uCCD0 \uAC00\uC871\uACFC \uBAA9\uC7A5\uC744 \uC783\uC5C8\uB2E4. \uADF8\uB7EC\uB098
      \uADF8\uB140\uB294 \uC6D0\uB9DD \uB300\uC2E0 \uAE30\uB3C4\uB97C \uD0DD\uD588\uACE0,
      \uB0A8\uC740 \uC591\uB4E4\uACFC \uD568\uAED8 \uC870\uC6A9\uD788 \uC0DD\uBA85\uC744
      \uB3CC\uBCF4\uACE0 \uC788\uB2E4. \uD50C\uB808\uC774\uC5B4 \uC77C\uD589\uC744
      \uB9CC\uB098 \uC138\uC0C1\uC5D4 \uC5EC\uC804\uD788 \uB530\uB73B\uD55C \uBE5B\uC774
      \uC788\uB2E4\uB294 \uAC78 \uAE68\uB2EB\uB294\uB2E4."
    voiceConcept: "\uBD80\uB4DC\uB7FD\uACE0 \uB530\uB73B\uD55C \uBBF8\uC131. \uC57D\uAC04
      \uB5A8\uB9AC\uB294 \uB9D0\uD22C, \uD3EC\uADFC\uD55C \uAC10\uC815\uC120"
