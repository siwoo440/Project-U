  isAvailable: 1
  profile:
    raceId: race_catkin
    raceName: "\uACE0\uC591\uC774\uC871 (Catkin)"
    jobId: job_fisher
    jobName: "\uB09A\uC2DC\uAFBC"
    gender: "\uC5EC\uC131"
    age: "20\uC138"
    height: 160cm
    summary: "\uBC14\uB78C\uACFC \uD30C\uB3C4\uB97C \uBC97 \uC0BC\uB294 \uACE0\uC591\uC774
      \uB09A\uC2DC\uAFBC. \uBBF8\uC624\uB294 \uC778\uC0DD\uC744 \uB09A\uC2DC\uCC98\uB7FC
      \uC990\uAE30\uBA70, \uC138\uC0C1 \uC18D\uC5D0\uC11C \uAC00\uC7A5 \uC9C4\uC2E4\uD55C
      \uC21C\uAC04\uC744 \uAE30\uB2E4\uB9B0\uB2E4."
    symbolMotif: "\uD30C\uB3C4 / \uB09A\uC2EF\uBC14\uB298 / \uD574\uB3CB\uC774 (\uC790\uC720\uC640
      \uC0DD\uBA85\uC758 \uC21C\uD658 \uC0C1\uC9D5)"
    origin: "\uD574\uC548 \uB9C8\uC744 \u2018\uB124\uC774\uBE10 \uD3EC\uD2B8(Naven
      Port)\u2019 \u2013 \uACE0\uC591\uC774\uC871 \uC5B4\uBD80\uB4E4\uC774 \uC0AC\uB294
      \uD56D\uAD6C"
    affiliation: "\uC790\uC720 \uB09A\uC2DC\uAFBC. \uD0D0\uD5D8\uB300\uC640 \uB290\uC2A8\uD55C
      \uACC4\uC57D \uAD00\uACC4"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uCC98\uC74C\uC5D4 \uC7A5\uB09C\uC2A4\uB7FD\uAC8C
      \uB300\uD558\uC9C0\uB9CC \uC810\uCC28 \uC2E0\uB8B0 \u2022 \uC5D0\uC774\uB9AC:
      \uC11C\uB85C \uC790\uC720\uB97C \uC874\uC911\uD558\uBA70 \uCE5C\uAD6C\uCC98\uB7FC
      \uC9C0\uB0C4 \u2022 \uB8E8\uB124\uD2B8: \uD568\uAED8 \uBB3C\uAC00\uC5D0\uC11C
      \uC57D\uCD08\uB97C \uB530\uBA70 \uD734\uC2DD \u2022 \uBCA8\uB77C\uBAA8\uB974\uD0C0:
      \uC7A5\uB09C\uACFC \uD604\uC2E4 \uAC10\uAC01\uC758 \uCC28\uC774\uB85C \uC790\uC8FC
      \uD2F0\uACA9\uD0DC\uACA9"
  appearance:
    hair: "\uD751\uCCAD\uC0C9 \uC9E7\uC740 \uB2E8\uBC1C, \uB05D\uBD80\uBD84\uC774
      \uD587\uBE5B\uC5D0 \uBE44\uCCD0 \uB0A8\uC0C9\uBE5B\uC774 \uB3D4"
    eyes: "\uD669\uAE08\uBE5B \uB208\uB3D9\uC790, \uD0DC\uC591\uBE5B\uC744 \uBC18\uC0AC\uD558\uBA70
      \uBC18\uC9DD\uC784"
    bodyImpression: "\uC2AC\uB9BC\uD558\uC9C0\uB9CC \uD314\uACFC \uD5C8\uB9AC\uC5D0
      \uD0C4\uD0C4\uD55C \uADFC\uC721. \uAC74\uAC15\uD558\uACE0 \uC0DD\uAE30 \uC788\uB294
      \uC778\uC0C1"
    outfit: "\uBBFC\uC18C\uB9E4 \uD0D1 + \uB09A\uC2DC\uC6A9 \uBC18\uBC14\uC9C0 +
      \uD5C8\uB9AC\uC5D0 \uB3C4\uAD6C \uAC00\uBC29. \uBAA9\uC5D4 \uD589\uC6B4\uC758
      \uACE0\uC591\uC774 \uBC29\uC6B8"
    accessories: "\uB0A1\uC740 \uBC00\uC9DA\uBAA8\uC790, \uB09A\uC2EF\uB300, \uACE0\uAE30
      \uC7A1\uB294 \uD1B5\uAC00\uBC29"
    features: "\uACE0\uC591\uC774 \uADC0\uC640 \uAF2C\uB9AC, \uD587\uBE5B\uC5D0 \uADF8\uC744\uB9B0
      \uC0B4\uACB0. \uC885\uC885 \uBAA8\uC790\uB97C \uB20C\uB7EC\uC4F0\uBA70 \uC878\uB9B0
      \uB4EF \uD558\uD488\uD568"
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uD574\uC548
      \uBC30\uACBD, \uBC00\uC9DA\uBAA8\uC790, \uBC14\uB2F7\uBC14\uB78C\uC774 \uB290\uAEF4\uC9C0\uB294
      \uC0C9\uAC10"
  themeColor: {r: 0.8862745, g: 0.77254903, b: 0.62352943, a: 1}
  accentColor: {r: 0.5372549, g: 0.76862746, b: 0.84705883, a: 1}
  personality:
    tags:
    - "\uB290\uAE0B\uD568"
    - "\uC7A5\uB09C\uAE30"
    - "\uD604\uC2E4\uC801"
    - "\uB099\uCC9C\uC801"
    speechStyle: "\uB9D0 \uB05D\uC5D0 \"~\uB0D0\", \"~\uAD6C\uB0E5\"\uCC98\uB7FC
      \uACE0\uC591\uC774\uC2DD \uC5B4\uBBF8 \uC0AC\uC6A9. \uC0DD\uAC01\uBCF4\uB2E4
      \uB0A0\uCE74\uB85C\uC6B4 \uD1B5\uCC30\uC744 \uB358\uC9D0"
    trauma: "\uD55C\uB54C \uD568\uAED8 \uB09A\uC2DC\uD558\uB358 \uC2A4\uC2B9\uC774
      \uD3ED\uD48D\uC5D0 \uD729\uC4F8\uB824 \uC0AC\uB77C\uC9C4 \uAE30\uC5B5. \uBC14\uB2E4\uB97C
      \uC0AC\uB791\uD558\uC9C0\uB9CC \uB3D9\uC2DC\uC5D0 \uB450\uB824\uC6CC\uD568"
    desire: "\uC5B8\uC820\uAC00 \uC2A4\uC2B9\uC774 \uC0AC\uB77C\uC9C4 \uBC14\uB2E4\uC5D0\uC11C
      \u201C\uC804\uC124\uC758 \uD669\uAE08\uACE0\uAE30\u201D\uB97C \uB09A\uB294
      \uAC83"
    background: "\uBBF8\uC624\uB294 \uC5B4\uB9B4 \uB54C\uBD80\uD130 \uBC14\uB2F7\uAC00\uC5D0\uC11C
      \uC790\uB77C\uBA70 \uB09A\uC2DC\uB85C \uC0DD\uACC4\uB97C \uC774\uC5B4\uC654\uB2E4.
      \uBC14\uB78C\uACFC \uD30C\uB3C4\uB97C \uC77D\uB294 \uAC10\uAC01\uC740 \uB6F0\uC5B4\uB098\uC9C0\uB9CC,
      \uADDC\uCE59\uC774\uB098 \uBA85\uB839\uC5D0\uB294 \uC57D\uD568. \uC12C\uC758
      \uD638\uC218\uC5D0\uC11C \uC774\uC0C1\uD55C \uBE5B(\uAD11\uCC44)\uC744 \uBCF8
      \uB4A4, \uADF8\uAC83\uC744 \uB530\uB77C \uC5EC\uD589\uC5D0 \uD569\uB958\uD55C\uB2E4."
    voiceConcept: "\uBC1D\uACE0 \uB290\uAE0B\uD55C \uD1A4\uC758 \uC80A\uC740 \uC5EC\uC131
      \uBAA9\uC18C\uB9AC. \uB9D0\uB05D\uC5D0 \uC7A5\uB09C \uC11E\uC778 \uC5B4\uBBF8
      \uC0AC\uC6A9 (\u201C~\uB0E5\u201D)"
