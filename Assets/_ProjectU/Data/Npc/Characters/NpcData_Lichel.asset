  m_Name: NpcData_Lichel
  m_EditorClassIdentifier: Assembly-CSharp::NpcCharacterData
  characterId: char_lichel
  displayName: "\uB9AC\uCCBC"
  englishName: Lichel
  isAlphaCast: 1
  isAvailable: 1
  profile:
    raceId: race_ratkin
    raceName: "\uC950\uC871 (Ratkin)"
    jobId: job_explorer
    jobName: "\uD0D0\uD5D8\uAC00"
    gender: "\uC5EC\uC131"
    age: "19\uC138"
    height: 152cm
    summary: "\uB3C4\uB9DD\uCE58\uB294 \uAC8C \uC544\uB2C8\uB77C, \uC0B4\uC544\uB0A8\uB294
      \uAC70\uC57C. \uB9AC\uCCBC\uC740 \uADF8\uB9BC\uC790 \uC18D\uC5D0\uC11C \uC6C3\uB294
      \uC0DD\uC874\uC790 \u2014 \uC138\uC0C1\uC5D0 \uC18D\uC9C0 \uC54A\uC73C\uB824\uB294
      \uC791\uC740 \uC950\uB2E4."
    symbolMotif: "\uC5F4\uC1E0 / \uADF8\uB9BC\uC790 / \uC794\uBD88 (\uC790\uC720\uC640
      \uC0DD\uC874\uC758 \uC0C1\uC9D5)"
    origin: "\u201C\uADF8\uB9BC \uB9C8\uCF13(Glim Market)\u201D \u2013 \uC12C\uC758
      \uC5B4\uB450\uC6B4 \uC0C1\uC810 \uAC70\uB9AC"
    affiliation: "\uC815\uBCF4 \uBE0C\uB85C\uCEE4 / \uB3C4\uB451\uAE38\uB4DC \u2018\uB354\uC2A4\uD2B8
      \uD14C\uC77C\u2019 \uC18C\uC18D"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \u201C\uD638\uAE30\uC2EC \uB300\uC0C1
      \u2192 \uB3D9\uB8CC \u2192 \uC758\uC9C0 \uB300\uC0C1\u201D\uC73C\uB85C \uBC1C\uC804
      \u2022 \uBCA8\uB77C\uBAA8\uB974\uD0C0: \uAC70\uB798 \uAD00\uACC4, \uAC00\uB054
      \uC774\uC6A9\uB2F9\uD558\uC9C0\uB9CC \uC874\uACBD\uB3C4 \uD568 \u2022 \uBBF8\uB8E8(\uC2AC\uB77C\uC784):
      \uB3C4\uB451\uC9C8 \uB300\uC0C1\uC774\uC5C8\uC9C0\uB9CC, \uCE5C\uAD6C\uAC00
      \uB428 \u2022 \uD558\uB974\uCE74: \u2018\uB9D0\uB3C4 \uC548 \uB418\uB294 \uC815\uC758\uAC10\u2019\uC774\uB77C
      \uBD80\uB974\uBA70 \uB180\uB9AC\uC9C0\uB9CC \uC740\uADFC\uD788 \uC88B\uC544\uD568"
  appearance:
    hair: "\uD68C\uBC31\uC0C9 \uB2E8\uBC1C, \uADC0 \uB4A4\uB85C \uD769\uC5B4\uC9C0\uB294
      \uAC00\uB294 \uC794\uBA38\uB9AC"
    eyes: "\uD68C\uC0C9\uBE5B\uC5D0 \uBD84\uD64D\uC774 \uC11E\uC778 \uC0C9, \uB0A0\uCE74\uB86D\uC9C0\uB9CC
      \uADC0\uC5EC\uC6C0"
    bodyImpression: "\uC791\uACE0 \uB0A0\uB835\uD55C \uCCB4\uD615, \uC6C0\uC9C1\uC784\uC774
      \uBE60\uB974\uACE0 \uD45C\uC815 \uBCC0\uD654\uAC00 \uD48D\uBD80\uD568"
    outfit: "\uC9D9\uC740 \uD68C\uC0C9 \uB9DD\uD1A0 + \uAC00\uC8FD \uBE0C\uB77C\uD1B1
      + \uBC18\uBC14\uC9C0 + \uD5C8\uB9AC\uC5D4 \uC790\uBB3C\uC1E0\uC640 \uC5F4\uC1E0
      \uACE0\uB9AC \uB3C4\uB451\uD48D\uC774\uC9C0\uB9CC \uADC0\uC5FD\uAC8C \uAFB8\uBBFC
      \uB290\uB08C"
    accessories: "\uADC0\uAC78\uC774 \uB300\uC2E0 \uC5F4\uC1E0 \uBAA8\uC591 \uC7A5\uC2DD,
      \uAF2C\uB9AC \uB05D\uC5D4 \uC791\uC740 \uC885"
    features: "\uC791\uC740 \uB465\uADFC \uADC0, \uAE34 \uAF2C\uB9AC, \uC190\uB05D\uC774
      \uAE30\uBBFC\uD568. \uC6C0\uC9C1\uC77C \uB54C \uAC70\uC758 \uC18C\uB9AC\uAC00
      \uC5C6\uC74C. \uB0C4\uC0C8\uC5D0 \uBBFC\uAC10."
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uC5B4\uB450\uC6B4
      \uC2DC\uC7A5 \uAC70\uB9AC, \uD68C\uC0C9 \uB9DD\uD1A0, \uAF2C\uB9AC\uC640 \uC885,
      \uD45C\uC815 \uB2E4\uC591\uC131 \uAC15\uC870"
  themeColor: {r: 0.7019608, g: 0.7019608, b: 0.7019608, a: 1}
  accentColor: {r: 0.94509804, g: 0.7607843, b: 0.49019608, a: 1}
  personality:
    tags:
    - "\uC7AC\uCE58"
    - "\uC0DD\uC874\uB825"
    - "\uC7A5\uB09C"
    - "\uD604\uC2E4\uC8FC\uC758"
    - "\uC740\uADFC\uD55C \uC815"
    speechStyle: "\uBE60\uB978 \uB9D0\uD22C, \u201C\uD765~\u201D \uD558\uB294 \uCF67\uC18C\uB9AC
      \uC790\uC8FC \uB0C4. \uB300\uD654 \uC911 \uC0C1\uB300\uC758 \uBC18\uC751\uC744
      \uB208\uC73C\uB85C \uAD00\uCC30\uD568. \uAC00\uB054 \uB18D\uB2F4\uC73C\uB85C
      \uAE34\uC7A5\uC744 \uD480\uB824 \uD568."
    trauma: "\uC5B4\uB9B0 \uC2DC\uC808 \uBA39\uC744 \uAC78 \uD6D4\uCE58\uB2E4 \uC7A1\uD600\uC11C
      \uCD94\uBC29\uB2F9\uD568. \uADF8\uB54C\uBD80\uD130 \u201C\uBBFF\uC744 \uAC74
      \uB0B4 \uC190\uBFD0\u201D\uC774\uB77C \uC0DD\uAC01\uD558\uBA70 \uC0B4\uC544\uC654\uC74C."
    desire: "\uB3C8\uC774\uB098 \uBB3C\uAC74\uBCF4\uB2E4 \u2018\uBBFF\uC744 \uC218
      \uC788\uB294 \uC0AC\uB78C\u2019\uC744 \uAC16\uACE0 \uC2F6\uC5B4 \uD568. \uAC89\uC73C\uB860
      \uBD80\uC815\uD558\uC9C0\uB9CC, \uB0B4\uBA74\uC5D4 \uB530\uB73B\uD55C \uC720\uB300\uC5D0
      \uAD76\uC8FC\uB824 \uC788\uC74C."
    background: "\uC12C\uC758 \uD3D0\uD5C8 \uB3C4\uC2DC\uC5D0\uC11C \uC790\uB780
      \uACE0\uC544. \uBE60\uB978 \uC190\uB180\uB9BC\uACFC \uB208\uCE58\uB85C \uC0DD\uC874\uD558\uBA70,
      \uAE38\uB4DC\uC758 \uC815\uBCF4\uC6D0\uC744 \uACB8\uD558\uACE0 \uC788\uC74C.
      \uD50C\uB808\uC774\uC5B4\uB97C \uCC98\uC74C \uB9CC\uB0A0 \uB54C\uB294 \uC9C0\uAC11\uC744
      \uD6D4\uCE58\uB824\uB2E4 \uB4E4\uD0A4\uC9C0\uB9CC, \uADF8\uC758 \u201C\uC21C\uC9C4\uD55C
      \uBC18\uC751\u201D\uC5D0 \uD765\uBBF8\uB97C \uB290\uB07C\uACE0 \uB3D9\uD589\uD558\uAC8C
      \uB41C\uB2E4. \uC810\uC810 \uC2E0\uB8B0\uB97C \uBC30\uC6CC\uAC00\uBA70, \uC790\uC2E0\uC758
      \uC0B6\uC774 \u201C\uB3C4\uB451\uC9C8\u201D\uB9CC\uC740 \uC544\uB2C8\uC5C8\uC74C\uC744
      \uAE68\uB2EB\uAC8C \uB41C\uB2E4."
    voiceConcept: "\uBE60\uB974\uACE0 \uC7A5\uB09C\uAE30 \uB9CE\uC740 \uC5EC\uC131
      \uBAA9\uC18C\uB9AC. \uAC00\uBCBC\uC6B4 \uD1A4 \uC18D\uC5D0 \uAC10\uC815\uC774
      \uC11E\uC5EC \uC788\uC74C. \uC6C3\uC74C\uC18C\uB9AC\uAC00 \uC9E7\uACE0 \uB0A0\uCE74\uB85C\uC6B4
      \uD3B8."
