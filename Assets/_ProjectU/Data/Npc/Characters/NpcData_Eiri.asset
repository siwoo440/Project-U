    speechStyle: "\uAC10\uC815\uC774 \uBC14\uB85C \uBAA9\uC18C\uB9AC\uC5D0 \uB4DC\uB7EC\uB0A8.
      \uD765\uC5BC\uAC70\uB9AC\uB4EF \uB9D0\uD568 (\u201C\uD6C4\uD6D7, \uC624\uB298
      \uBC14\uB78C \uC88B\uC544~\u201D)"
    trauma: "\uACFC\uAC70 \uD55C\uCABD \uB0A0\uAC1C\uB97C \uB2E4\uCCD0 \uD558\uB298\uC744
      \uC783\uC744 \uBED4\uD55C \uACBD\uD5D8. \u2018\uC790\uC720\uB97C \uBE7C\uC557\uAE30\uB294
      \uAC83\u2019\uC5D0 \uADF9\uB3C4\uB85C \uC608\uBBFC\uD568"
    desire: "\uC138\uC0C1 \uBAA8\uB4E0 \uD558\uB298\uC744 \uB178\uB798\uB85C \uAE30\uB85D\uD558\uB294
      \uAC83. \uBC14\uB78C\uCC98\uB7FC \uC790\uC720\uB86D\uAC8C \uC0B4\uC544\uAC00\uAE38
      \uBC14\uB78C"
    background: "\uD558\uD53C\uC871\uC740 \uBC14\uB78C\uC758 \uC2E0\uC758 \uD6C4\uC608\uB77C
      \uBD88\uB9AC\uBA70, \uD558\uB298\uC744 \uAC00\uB85C\uC9C0\uB974\uBA70 \uB178\uB798\uB85C
      \uC138\uC0C1\uC744 \uAE30\uB85D\uD55C\uB2E4. \uC5D0\uC774\uB9AC\uB294 \uC80A\uC740
      \uB098\uC774\uC5D0 \uD558\uB298 \uBC16\uC758 \uC138\uACC4\uB97C \uBCF4\uACE0
      \uC2F6\uC5B4 \uB0B4\uB824\uC654\uACE0, \uADF8 \uACFC\uC815\uC5D0\uC11C \uC12C\uC5D0
      \uBA38\uBB3C\uAC8C \uB41C\uB2E4."
    voiceConcept: "\uBC1D\uACE0 \uCCAD\uB7C9\uD55C \uD1A4\uC758 \uC5EC\uC131 \uBCF4\uC774\uC2A4.
      \uBC14\uB78C \uC18C\uB9AC\uCC98\uB7FC \uC5EC\uC6B4\uC774 \uB0A8\uC74C"
