    jobId: job_bard
    jobName: "\uC74C\uC720\uC2DC\uC778"
    gender: "\uC5EC\uC131"
    age: "22\uC138"
    height: 168cm
    summary: "\uBC14\uB78C\uC758 \uB178\uB798\uB97C \uBD80\uB974\uB294 \uC790\uC720\uC758
      \uC74C\uC720\uC2DC\uC778. \uD558\uB298\uC744 \uC0AC\uB791\uD55C \uD558\uD53C,
      \uC5D0\uC774\uB9AC\uB294 \uC138\uC0C1 \uBAA8\uB4E0 \uD558\uB298\uC744 \uADF8\uB140\uC758
      \uBAA9\uC18C\uB9AC\uC5D0 \uB2F4\uB294\uB2E4."
    symbolMotif: "\uBC14\uB78C / \uD558\uD504 / \uAD6C\uB984 (\uC790\uC720, \uC5EC\uD589,
      \uD574\uBC29\uC758 \uC0C1\uC9D5)"
    origin: "\uAD6C\uB984 \uC704\uC758 \uB9C8\uC744 \u2018\uC2E4\uD53C\uB4DC \uB124\uC2A4\uD2B8(Sylphid
      Nest)\u2019 \u2013 \uD558\uD53C\uC871\uC758 \uACE0\uD5A5"
    affiliation: "\uBC29\uB791\uAC00\uC218 / \uC5EC\uD589 \uC608\uC220\uAC00"
    relationships: "\u2022 \uD50C\uB808\uC774\uC5B4: \uBC14\uB78C\uC758 \uBC29\uD5A5\uC744
      \uBB3B\uB4EF \uC790\uC720\uB86D\uAC8C \uB2E4\uAC00\uC634 \u2022 \uB8E8\uB124\uD2B8:
      \uADF8\uB140\uC758 \uCC28\uBD84\uD568\uC744 \uC88B\uC544\uD558\uBA70 \uC7A5\uB09C\uC744
      \uC790\uC8FC \uCE68 \u2022 \uC138\uB808\uB098: \uB178\uB798\uB85C \uADF8\uB140\uC758
      \uC2DC\uB97C \uC74A\uC5B4\uC8FC\uB294 \uCE5C\uAD6C"
  appearance:
    hair: "\uD558\uB298\uC0C9\uACFC \uC740\uBE5B\uC774 \uC11E\uC778 \uC9E7\uC740
      \uBBF8\uB514\uC5C4 \uD5E4\uC5B4, \uBC14\uB78C\uC5D0 \uD769\uB0A0\uB9AC\uB294
      \uB4EF\uD55C \uC9C8\uAC10"
    eyes: "\uC9D9\uC740 \uCCAD\uB85D\uBE5B, \uD587\uC0B4\uC5D0 \uBC18\uC0AC\uB418\uB294
      \uC0C8\uC758 \uB208\uCC98\uB7FC \uB9D1\uC74C"
    bodyImpression: "\uAC00\uBCCD\uACE0 \uADE0\uD615 \uC7A1\uD78C \uCCB4\uD615. \uC6C0\uC9C1\uC784\uC774
      \uD65C\uBC1C\uD558\uACE0 \uC2DC\uC6D0\uD55C \uC778\uC0C1"
    outfit: "\uD558\uB298\uC0C9 \uCC9C\uC73C\uB85C \uB41C \uAC00\uBCBC\uC6B4 \uBB34\uB3C4\uBCF5
      + \uAE43\uD138 \uC7A5\uC2DD\uC758 \uC204. \uBE44\uD589\uC5D0 \uBC29\uD574\uB418\uC9C0
      \uC54A\uAC8C \uB2E8\uC21C\uD55C \uB514\uC790\uC778"
    accessories: "\uAE43\uD138 \uADC0\uAC78\uC774, \uD5C8\uB9AC\uC5D0\uB294 \uC791\uC740
      \uD558\uD504(lyre) \uD615\uD0DC\uC758 \uC545\uAE30"
    features: "\uD314\uC5D0\uB294 \uD478\uB978 \uAE43\uD138\uC774 \uB098 \uC788\uACE0,
      \uB4F1 \uB4A4\uC5D0\uB294 \uC0C8\uD558\uC580 \uB0A0\uAC1C \uD55C \uC30D. \uC6C3\uC744
      \uB54C \uBC14\uB78C \uC18C\uB9AC\uAC00 \uD568\uAED8 \uC11E\uC5EC \uB4E4\uB9BC"
    illustrationStyle: "\uC77C\uBCF8 \uC560\uB2C8\uD48D \uACE0\uC815 \u2013 \uAD6C\uB984\uACFC
      \uD558\uB298 \uBC30\uACBD, \uBC1D\uC740 \uC870\uBA85, \uC5ED\uB3D9\uC801\uC778
      \uD3EC\uC988 \uAC15\uC870"
  portrait: {fileID: 0}
  themeColor: {r: 0.69803923, g: 0.8862745, b: 0.9490196, a: 1}
  accentColor: {r: 0.95686275, g: 0.9764706, b: 0.9843137, a: 1}
