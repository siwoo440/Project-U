  m_Script: {fileID: 11500000, guid: 28174b3c609d63345a2e46b8c1dd742a, type: 3}
  m_Name: NpcCompanionBook
  m_EditorClassIdentifier: Assembly-CSharp::NpcCompanionBook
  entries:
  - characterId: char_verona
    role: 0
    requiredStage: 2
    power: 18
    interval: 2
    lootItems: []
    joinLine: "\uC88B\uB2E4. \uB124 \uC55E\uAE38\uC740 \uB0B4\uAC00 \uC9C0\uCF1C
      \uC8FC\uC9C0."
    leaveLine: "\uC624\uB298\uC740 \uC5EC\uAE30\uAE4C\uC9C0. \uBAB8\uC870\uC2EC\uD574\uB77C."
    nightLine: "\uBC24\uC774 \uAE4A\uC5C8\uB2E4. \uC774\uB9CC \uB3CC\uC544\uAC00
      \uC26C\uC5B4\uB77C."
    refuseLine: "\u2026\uC544\uC9C1\uC740 \uB124 \uB4F1\uC744 \uB9E1\uAE38 \uC0AC\uC774\uAC00
      \uC544\uB2C8\uC57C."
    roleLine: "\uBB3C\uB7EC\uC11C\uB77C."
    idleLines:
    - "\uB545\uC774 \uB2E8\uB2E8\uD558\uAD70. \uC88B\uC740 \uAE38\uC774\uC57C."
    - "\uC11C\uB450\uB974\uC9C0 \uB9C8\uB77C. \uC12C\uC740 \uB3C4\uB9DD\uAC00\uC9C0
      \uC54A\uC544."
    - "\uBC14\uB78C\uC5D0\uC11C \uBE44 \uB0C4\uC0C8\uAC00 \uB09C\uB2E4."
  - characterId: char_chesca
    role: 0
    requiredStage: 2
    power: 9
    interval: 1.1
    lootItems: []
    joinLine: "\u2026\uAC19\uC774 \uAC00\uB3C4 \uB3FC? \uD0C1\u2014 \uB098, \uC4F8\uBAA8
      \uC788\uC744 \uAC70\uC57C."
    leaveLine: "\u2026\uC751. \uC624\uB298 \uBAA8\uC740 \uAE30\uC5B5, \uC0C1\uC790\uC5D0
      \uB123\uC5B4 \uB458\uAC8C."
    nightLine: "\u2026\uC5B4\uB450\uC6CC. \uC0C1\uC790 \uC548\uC774 \uC81C\uC77C
      \uC548\uC804\uD574. \uB3CC\uC544\uAC08\uAC8C."
    refuseLine: "\u2026\uC544\uC9C1\uC740, \uB69C\uAED1\uC744 \uC5F4 \uC218 \uC5C6\uC5B4."
    roleLine: "\uD0C1\u2014! \uAC00\uAE4C\uC774 \uC624\uC9C0 \uB9C8!"
    idleLines:
    - "\u2026\uC800 \uB3CC, \uBC18\uC9DD\uC774\uC9C0 \uC54A\uC544?"
    - "\uD0C1\u2014 \u2026\uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC57C."
    - "\u2026\uB108\uB791 \uAC78\uC73C\uBA74 \uC870\uAE08 \uB35C \uBB34\uC11C\uC6CC."
  - characterId: char_liriel
    role: 0
    requiredStage: 2
    power: 12
    interval: 1.5
    lootItems: []
    joinLine: "\uC88B\uC544, \uC232 \uC218\uD638\uC790 \uB9AC\uB9AC\uC5D8\uC774 \uD568\uAED8
      \uAC00 \uC904\uAC8C!"
    leaveLine: "\uC624\uB298 \uBAA8\uD5D8 \uB05D! \uC7AC\uBC0C\uC5C8\uC9C0!"
    nightLine: "\uC878\uB824\u2026 \uC232\uC73C\uB85C \uB3CC\uC544\uAC00\uC11C \uC798
      \uAC70\uC57C!"
    refuseLine: "\uC74C~ \uC544\uC9C1\uC740 \uB108\uB97C \uC798 \uBAA8\uB974\uACA0\uB294\uAC78?
      \uB354 \uCE5C\uD574\uC9C0\uBA74 \uAC08 \uAC70\uC57C!"
    roleLine: "\uBE5B\uC758 \uAC00\uC2DC\uB2E4! \uBC1B\uC544\uB78F!"
    idleLines:
    - "\uC800\uAE30 \uB098\uBE44 \uBD24\uC5B4? \uBD24\uC9C0!"
    - "\uC774 \uAE38 \uB05D\uC5D0 \uBB50\uAC00 \uC788\uC744\uAE4C? \uAC00 \uBCF4\uB294
      \uAC70\uC57C!"
    - "\uB098\uBB34\uB4E4\uC774 \uC778\uC0AC\uD558\uACE0 \uC788\uC5B4!"
  - characterId: char_mio
    role: 1
    requiredStage: 2
    power: 1
    interval: 50
    lootItems:
    - {fileID: 11400000, guid: bad80e6a70bf78a4a81937454f7a8f95, type: 2}
    - {fileID: 11400000, guid: eee016df450094545b4a90688d3bce9b, type: 2}
    - {fileID: 11400000, guid: 83e8c92974737c246a6f55d31325f68b, type: 2}
    - {fileID: 11400000, guid: f82cfee3161243747ad3a92e8c7418ba, type: 2}
    joinLine: "\uC88B\uB2E4\uB0E5, \uAC19\uC774 \uAC00 \uC8FC\uACA0\uB2E4\uB0E5.
      \uBB3C\uAC00 \uC788\uC73C\uBA74 \uC54C\uB824 \uB2EC\uB77C\uB0E5."
    leaveLine: "\uC624\uB298\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uB2E4\uB0E5. \uC0DD\uC120\uC740
      \uB098\uB220 \uBA39\uB294 \uAC70\uB2E4\uB0E5."
    nightLine: "\uD558\uC554\u2026 \uC878\uB824\uC11C \uBABB \uAC77\uACA0\uB2E4\uB0E5.
      \uC9D1\uC5D0 \uAC04\uB2E4\uB0E5."
    refuseLine: "\uC74C~ \uC544\uC9C1\uC740 \uADC0\uCC2E\uB2E4\uB0E5. \uC880 \uB354
      \uCE5C\uD574\uC9C0\uBA74 \uC0DD\uAC01\uD574 \uBCF4\uACA0\uB2E4\uB0E5."
    roleLine: "{item} \uCC3E\uC558\uB2E4\uB0E5! \uB108 \uC904\uAC8C\uB0E5."
    idleLines:
    - "\uC774 \uC12C \uBC14\uB78C, \uC0DD\uC120 \uB0C4\uC0C8\uAC00 \uB09C\uB2E4\uB0E5."
    - "\uB290\uAE0B\uD558\uAC8C \uAC00\uC790\uB0E5."
    - "\uC800\uCABD\uC5D0 \uBB3C\uACE0\uAE30 \uC228\uC5B4 \uC788\uC744 \uAC83 \uAC19\uB2E4\uB0E5."
  - characterId: char_neri
    role: 1
    requiredStage: 2
    power: 1
    interval: 45
    lootItems:
    - {fileID: 11400000, guid: ce6c806808c6dfb4ca5fb2217dce497c, type: 2}
    - {fileID: 11400000, guid: 3a8ea9dc329d35c4b8b4c84410a7f15d, type: 2}
    - {fileID: 11400000, guid: bc991e404803cba4292542d6a52ddd7a, type: 2}
    - {fileID: 11400000, guid: f82cfee3161243747ad3a92e8c7418ba, type: 2}
    joinLine: "\uAC1C\uAD74! \uAC19\uC774 \uAC00\uBA74 \uB0A0\uC528\uB294 \uB0B4\uAC00
      \uBD10 \uC904\uAC8C!"
    leaveLine: "\uC624\uB298 \uAD00\uCE21 \uB05D! \uAC1C\uAD74, \uACE0\uB9C8\uC6CC!"
    nightLine: "\uBC24\uACF5\uAE30\uAC00 \uCC28\uAC00\uC6CC\u2026 \uAC1C\uAD74, \uB3CC\uC544\uAC08\uB798."
    refuseLine: "\uAC1C, \uAC1C\uAD74\u2026 \uC544\uC9C1 \uC880 \uBB34\uC11C\uC6CC.
      \uC870\uAE08\uB9CC \uB354 \uCE5C\uD574\uC9C0\uC790!"
    roleLine: "\uAC1C\uAD74! \uC5EC\uAE30 {item} \uC788\uC5B4!"
    idleLines:
    - "\uAD6C\uB984 \uBAA8\uC591 \uBD10! \uB0B4\uC77C\uC740 \uB9D1\uC744 \uAC70\uC57C."
    - "\uC2B5\uD55C \uBC14\uB78C\uC774\uB2E4\u2026 \uAC1C\uAD74."
    - "\uBC1C\uBC11 \uC870\uC2EC\uD574! \uBBF8\uB044\uB7EC\uC6CC!"
  - characterId: char_lumina
    role: 1
    requiredStage: 2
    power: 1
    interval: 55
    lootItems:
    - {fileID: 11400000, guid: 3a8ea9dc329d35c4b8b4c84410a7f15d, type: 2}
    - {fileID: 11400000, guid: 95ca44aa8a27d41448c511db6fa0a55c, type: 2}
    - {fileID: 11400000, guid: eef1b375027259b42834d2262ce9dd96, type: 2}
    - {fileID: 11400000, guid: bc991e404803cba4292542d6a52ddd7a, type: 2}
    joinLine: "\u2026\uD568\uAED8\uB77C\uBA74, \uB354 \uB9CE\uC740 \uAF43\uC744 \uB9CC\uB0A0
      \uC218 \uC788\uACA0\uB124\uC694."
    leaveLine: "\u2026\uC624\uB298\uC758 \uAF43\uAC00\uB8E8, \uC798 \uAC04\uC9C1\uD560\uAC8C\uC694."
    nightLine: "\u2026\uB2EC\uBE5B\uC774 \uB0B4\uB824\uC640\uC694. \uC774\uC81C \uC26C\uB7EC
      \uAC08\uAC8C\uC694."
    refuseLine: "\u2026\uC870\uAE08\uB9CC \uB354, \uC11C\uB85C\uB97C \uC54C\uC544
      \uAC00\uC694."
    roleLine: "\u2026\uC5EC\uAE30, {item}. \uB2F9\uC2E0\uC5D0\uAC8C \uC904\uAC8C\uC694."
    idleLines:
    - "\u2026\uAF43\uD5A5\uAE30\uAC00 \uBC14\uB78C\uC744 \uD0C0\uACE0 \uC640\uC694."
    - "\u2026\uB0A0\uAC1C\uAC00 \uAC00\uBCBC\uC6B4 \uB0A0\uC774\uC5D0\uC694."
    - "\u2026\uC800 \uB4E4\uD310, \uBC18\uC9DD\uC774\uC9C0 \uC54A\uB098\uC694?"
  - characterId: char_lunette
    role: 2
    requiredStage: 2
    power: 22
    interval: 50
    lootItems: []
    joinLine: "\uADF8, \uADF8\uB7EC\uB2C8\uAE4C\uC694\u2026 \uC81C\uAC00 \uC606\uC5D0\uC11C
      \uC57D\uCD08 \uCC59\uACA8 \uB4DC\uB9B4\uAC8C\uC694."
    leaveLine: "\uC624\uB298\u2026 \uC990\uAC70\uC6E0\uC5B4\uC694. \uADF8\uB7EC\uB2C8\uAE4C\uC694,
      \uB610 \uBD88\uB7EC \uC8FC\uC138\uC694."
    nightLine: "\uBC24\uC774\uC5D0\uC694\u2026 \uC800, \uC774\uC81C \uB3CC\uC544\uAC00
      \uBCFC\uAC8C\uC694."
    refuseLine: "\uADF8\uAC8C\u2026 \uC544\uC9C1\uC740 \uC870\uAE08 \uBD80\uB044\uB7EC\uC6CC\uC11C\uC694\u2026"
    roleLine: "\uB2E4, \uB2E4\uCCE4\uC5B4\uC694? \uC774 \uC57D\uCD08 \uB4DC\uC138\uC694\u2026!"
    idleLines:
    - "\uC774 \uD480, \uC57D\uC73C\uB85C \uC4F8 \uC218 \uC788\uC5B4\uC694\u2026"
    - "\uADC0\uAC00 \uAC04\uC9C0\uB7EC\uC6CC\uC694, \uBC14\uB78C \uB54C\uBB38\uC778\uAC00
      \uBD10\uC694\u2026"
    - "\uCC9C\uCC9C\uD788 \uAC00\uC694. \uB118\uC5B4\uC9C0\uBA74 \uC548 \uB3FC\uC694\u2026"
  - characterId: char_aliune
    role: 2
    requiredStage: 2
    power: 32
    interval: 60
    lootItems: []
    joinLine: "\uC88B\uC544\uC694. \uB2F9\uC2E0\uC774 \uB2E4\uCE58\uC9C0 \uC54A\uAC8C,
      \uC81C\uAC00 \uACC1\uC5D0 \uC788\uC744\uAC8C\uC694."
    leaveLine: "\uB3CC\uC544\uAC00\uB3C4 \uAD1C\uCC2E\uC544\uC694. \uD558\uC9C0\uB9CC
      \uB108\uBB34 \uC624\uB798 \uB5A8\uC5B4\uC838 \uC788\uC9C4 \uB9D0\uC544\uC694."
    nightLine: "\uBC24\uC774 \uB410\uB124\uC694. \uC628\uC2E4\uB85C \uB3CC\uC544\uAC00
      \uC26C\uC5B4\uC57C\uACA0\uC5B4\uC694."
    refuseLine: "\uC870\uAE08 \uB354\u2026 \uB2F9\uC2E0\uC744 \uC54C\uC544\uC57C
      \uACC1\uC5D0 \uB458 \uC218 \uC788\uC5B4\uC694."
    roleLine: "\uAC00\uB9CC\uD788 \uC788\uC5B4\uC694. \uAE08\uBC29 \uB098\uC544\uC9C8
      \uAC70\uC608\uC694."
    idleLines:
    - "\uC78E\uC774 \uD587\uBE5B\uC744 \uC88B\uC544\uD558\uB124\uC694."
    - "\uB2F9\uC2E0 \uACC1\uC740 \uB530\uB73B\uD574\uC694."
    - "\uBB34\uB9AC\uD558\uC9C0 \uB9D0\uC544\uC694. \uC81C\uAC00 \uC788\uC796\uC544\uC694."
  - characterId: char_mireille
    role: 2
    requiredStage: 2
    power: 16
    interval: 40
    lootItems: []
    joinLine: "\uC800, \uC800\uB77C\uB3C4 \uAD1C\uCC2E\uB2E4\uBA74\u2026 \uAC19\uC774
      \uAC08\uAC8C\uC694."
    leaveLine: "\uC624\uB298 \uACE0\uB9C8\uC6E0\uC5B4\uC694\u2026 \uC870\uC2EC\uD788
      \uB4E4\uC5B4\uAC00\uC138\uC694."
    nightLine: "\uC591\uB4E4\uC774 \uAE30\uB2E4\uB824\uC694\u2026 \uC774\uC81C \uB3CC\uC544\uAC08\uAC8C\uC694."
    refuseLine: "\uC870, \uC870\uAE08\uB9CC \uB354 \uCE5C\uD574\uC9C0\uBA74\u2026
      \uADF8\uB54C \uAC19\uC774 \uAC00\uC694."
    roleLine: "\uAD1C\uCC2E\uC544\uC694\u2026? \uB530\uB73B\uD55C \uC6B0\uC720\uC608\uC694,
      \uB4DC\uC138\uC694."
    idleLines:
    - "\uD480 \uB0C4\uC0C8\uAC00 \uC88B\uC544\uC694\u2026"
    - "\uC800, \uAC81\uC774 \uB9CE\uC9C0\uB9CC\u2026 \uC624\uB298\uC740 \uAD1C\uCC2E\uC544\uC694."
    - "\uAD6C\uB984\uC774 \uC591\uCC98\uB7FC \uC0DD\uACBC\uC5B4\uC694."
  - characterId: char_ragh
    role: 0
    requiredStage: 2
    power: 16
    interval: 1.6
    lootItems: []
    joinLine: "\u2026\uC88B\uB2E4. \uB124 \uB4F1 \uB4A4\uB294 \uB0B4\uAC00 \uB9E1\uC9C0."
    leaveLine: "\uC624\uB298\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uB2E4. \uBB34\uC0AC\uD788
      \uB3CC\uC544\uAC00."
    nightLine: "\uBC24\uC774\uB2E4. \uC57C\uC601\uC9C0 \uBD88\uC744 \uC9C0\uCF1C\uC57C
      \uD574. \uB3CC\uC544\uAC04\uB2E4."
    refuseLine: "\u2026\uC544\uC9C1 \uB110 \uBB34\uB9AC\uB85C \uBC1B\uC544\uB4E4\uC774\uC9C0
      \uBABB\uD588\uC5B4."
    roleLine: "\uBB3C\uB7EC\uC11C, \uB0B4\uAC00 \uB9C9\uB294\uB2E4!"
    idleLines:
    - "\uBC14\uB78C\uC5D0 \uC9D0\uC2B9 \uB0C4\uC0C8\uAC00 \uC11E\uC600\uAD70."
    - "\uBC1C\uBC11 \uC870\uC2EC\uD574."
    - "\u2026\uD63C\uC790 \uAC77\uB294 \uAC83\uBCF4\uB2E4 \uB0AB\uAD70."
  - characterId: char_censia
    role: 1
    requiredStage: 2
    power: 1
    interval: 50
    lootItems:
    - {fileID: 11400000, guid: eef1b375027259b42834d2262ce9dd96, type: 2}
    - {fileID: 11400000, guid: a42d6efd666a1fc40809cbcbcd3362b4, type: 2}
    - {fileID: 11400000, guid: bc991e404803cba4292542d6a52ddd7a, type: 2}
    - {fileID: 11400000, guid: 233c5c7467d9daa41bab4b59439b9465, type: 2}
    joinLine: "\uC88B\uC544, \uC9D0\uC740 \uB0B4\uAC00 \uB4E4\uC9C0. \uAE38\uB9CC
      \uC815\uD574."
    leaveLine: "\uC6B4\uC1A1 \uB05D. \uB2E4\uC74C\uC5D0 \uB610 \uBD88\uB7EC."
    nightLine: "\uBC24\uAE38\uC740 \uC704\uD5D8\uD574. \uB9C8\uAD6C\uAC04\uC73C\uB85C
      \uB3CC\uC544\uAC04\uB2E4."
    refuseLine: "\uC544\uC9C1\uC740 \uB124 \uC9D0\uC744 \uB9E1\uC744 \uC0AC\uC774\uAC00
      \uC544\uB2C8\uC57C."
    roleLine: "{item}, \uB124 \uBAAB\uC774\uB2E4. \uCC59\uACA8."
    idleLines:
    - "\uC774 \uAE38\uC740 \uB3CC\uC774 \uB9CE\uAD70. \uD45C\uC2DC\uD574 \uB450\uC9C0."
    - "\uBC1C\uAD7D \uBC15\uC790\uAC00 \uC88B\uC544. \uC624\uB298\uC740 \uC798 \uD480\uB9AC\uACA0\uC5B4."
    - "\uC26C\uACE0 \uC2F6\uC73C\uBA74 \uB9D0\uD574. \uAE30\uB2E4\uB824 \uC904\uAC8C."
  - characterId: char_eiri
    role: 2
    requiredStage: 2
    power: 20
    interval: 45
    lootItems: []
    joinLine: "\uC88B\uC544~ \uAC19\uC774 \uAC00\uC790! \uAC00\uB294 \uAE38 \uB0B4\uB0B4
      \uB178\uB798 \uBD88\uB7EC \uC904\uAC8C!"
    leaveLine: "\uC624\uB298 \uC5EC\uD589\uB3C4 \uC88B\uC740 \uB178\uB798\uAC00 \uB410\uC5B4~
      \uB610 \uBCF4\uC790!"
    nightLine: "\uD558\uB298\uC774 \uC5B4\uB450\uC6CC\uC84C\uC5B4. \uB4F1\uB300\uB85C
      \uB3CC\uC544\uAC08\uAC8C~"
    refuseLine: "\uC74C~ \uC544\uC9C1\uC740 \uB108\uB97C \uC704\uD55C \uB178\uB798\uAC00
      \uC548 \uB5A0\uC62C\uB77C. \uC870\uAE08 \uB354 \uCE5C\uD574\uC9C0\uC790!"
    roleLine: "\uAD1C\uCC2E\uC544? \uBC14\uB78C\uC758 \uB178\uB798\uB85C \uB2EC\uB798
      \uC904\uAC8C~"
    idleLines:
    - "\uD6C4\uD6D7, \uC624\uB298 \uBC14\uB78C \uC88B\uC544~"
    - "\uC800 \uAD6C\uB984 \uBAA8\uC591, \uB178\uB798 \uC81C\uBAA9\uC73C\uB85C \uB531\uC774\uC57C!"
    - "\uB77C~ \uB77C\uB77C~ \uB784\uB77C~"
