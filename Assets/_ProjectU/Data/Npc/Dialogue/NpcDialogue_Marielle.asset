--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Marielle
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_marielle
  dailyTalkLimit: 1
  expressionTags:
  - "\uBBF8\uC18C"
  - "\uC218\uC90D\uC74C"
  - "\uD68C\uC0C1"
  - "\uD3C9\uC628"
  - "\uC560\uC815"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC74C~ \uD760~ \uC5B4\uBA38, \uC190\uB2D8\uC774\uB124\uC694. \uC800\uB294
      \uB9C8\uB9AC\uC5D8, \uBC14\uB2E4\uC5D0\uC11C \uC870\uAC1C\uB791 \uC9C4\uC8FC\uB97C
      \uCE90\uC694. \uD30C\uB3C4 \uC18C\uB9AC \uC88B\uC544\uD574\uC694?"
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC624\uB298 \uD30C\uB3C4\uB294 \uC794\uC794\uD574\uC694."
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0\uC774 \uC624\uBA74 \uCF67\uB178\uB798\uAC00 \uC800\uC808\uB85C
      \uB098\uC640\uC694. \uC74C~ \uD760~"
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC74C~ \uB610 \uC654\uB124\uC694. \uC624\uB298 \uBC14\uB2E4\uB294 \uC794\uC794\uD574\uC694."
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC608\uC804\uC5D4 \uC0B0\uD638 \uB9C8\uC744\uC5D0 \uC0B4\uC558\uC5B4\uC694.
      \uD3ED\uD48D\uC774 \uB2E4 \uAC00\uC838\uAC00 \uBC84\uB838\uC9C0\uB9CC\uC694."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAC2F\uBC14\uC704 \uC870\uAC1C\uB294 \uBB3C\uC774 \uBE60\uC9C8 \uB54C
      \uCE90\uC57C \uD574\uC694. \uBC14\uB2E4\uAC00 \uC7A0\uAE50 \uD5C8\uB77D\uD574
      \uC8FC\uB294 \uC2DC\uAC04\uC774\uC5D0\uC694."
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774 \uC12C\uC774\u2026 \uC0C8 \uC9D1\uC774 \uB418\uC5B4 \uC904\uAE4C\uC694.
      \uB2F9\uC2E0\uC774 \uC788\uC73C\uBA74, \uADF8\uB7F4 \uAC83 \uAC19\uC544\uC694."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBC14\uB2E4\uB294 \uBAA8\uB4E0 \uAC78 \uAE30\uC5B5\uD574\uC694."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uACC1\uC774 \uD3B8\uD574\uC84C\uC5B4."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uBC88 \uC77C\uC740 \uD568\uAED8\uD558\uC790."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC870\uAE08\uC740 \uD765\uBBF8\uB86D\uB124."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC544\uC9C1 \uB110 \uBBFF\uC9C4 \uC54A\uC544."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC81C \uB0B4 \uBAA9\uD45C\uC5D0\uB294 \uB124\uAC00 \uC788\uC5B4."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744 \uD30C\uB3C4\uB294 \uB192\uC544\uC694. \uC870\uAC1C\uB4E4\uC774
      \uBAA8\uB798 \uC18D\uC73C\uB85C \uC228\uC5B4 \uBC84\uB824\uC694."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04 \uBC14\uB2E4\uB294 \uC544\uC9C1 \uCC28\uAC00\uC6CC\uC694. \uADF8\uB798\uB3C4
      \uD574\uCD08\uAC00 \uC465\uC465 \uC790\uB77C\uC694."
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984\uC5D4 \uC9C4\uC8FC\uAC00 \uC81C\uC77C \uC608\uC058\uAC8C
      \uBE5B\uB098\uC694. \uC0C8\uBCBD\uC5D0 \uAC19\uC774 \uCE90\uB7EC \uAC08\uB798\uC694?"
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8 \uBC14\uB2E4\uB294 \uC870\uC6A9\uD574\uC694. \uBE44\uB298\uC774
      \uC870\uAE08 \uC2DC\uB824\uB3C4\u2026 \uC88B\uC544\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44\uAC00 \uC624\uBA74 \uBC14\uB2E4\uB791 \uD558\uB298\uC774 \uC774\uC5B4\uC838\uC694.
      \uC74C~ \uC88B\uC544\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uBC14\uB2E4\uC5D0 \uB208\uC774 \uB0B4\uB9AC\uBA74 \uC18C\uB9AC \uC5C6\uC774
      \uB179\uC544\uC694. \uC2E0\uAE30\uD558\uC8E0."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uD3ED\uD48D\uC740\u2026 \uC2EB\uC5B4\uC694. \uC624\uB298\uC740 \uB3D9\uAD74
      \uAE4A\uC774 \uC788\uC744\uAC8C\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uC9C0\uB801\uC774\uB294\u2026 \uBB3C\uC744 \uD0C1\uD558\uAC8C \uD574\uC694.
      \uBBF8\uC548\uD574\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uACE0\uB9C8\uC6CC\uC694. \uB3D9\uAD74 \uC120\uBC18\uC5D0 \uC62C\uB824
      \uB458\uAC8C\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uD669\uAE08 \uC789\uC5B4\u2026! \uC9C4\uC8FC\uBCF4\uB2E4 \uBC18\uC9DD\uC5EC\uC694.
      \uC815\uB9D0 \uACE0\uB9C8\uC6CC\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uC74C~ \uC88B\uC544\uC694. \uBC14\uB2E4 \uB0C4\uC0C8\uAC00 \uB098\uB294
      \uC120\uBB3C\uC774\uB124\uC694."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC81C \uC0DD\uC77C\uC744 \uAE30\uC5B5\uD588\uC5B4\uC694? \uC74C~ \uC624\uB298\uC740
      \uD30C\uB3C4\uB3C4 \uCD95\uD558\uD574 \uC8FC\uB294 \uAC83 \uAC19\uC544\uC694."
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0 \uB355\uBD84\uC5D0 \uC721\uC9C0\uAC00 \uC9D1\uCC98\uB7FC
      \uB290\uAEF4\uC838\uC694."
