%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Ragh
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_ragh
  dailyTalkLimit: 1
  expressionTags:
  - "\uBB34\uD45C\uC815"
  - "\uBBF8\uC18C"
  - "\uB3D9\uC694"
  - "\uBD84\uB178"
  - "\uACB0\uC758"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\u2026\uB204\uAD6C\uB0D0. \uC544, \uC12C\uC5D0 \uC0C8\uB85C \uC628 \uB140\uC11D\uC774\uAD70.
      \uB77C\uADF8\uB2E4. \uC774 \uC57C\uC601\uC9C0\uB294 \uB0B4\uAC00 \uC9C0\uD0A8\uB2E4.
      \uBCFC\uC77C \uC5C6\uC73C\uBA74 \uBD88 \uC606\uC5D0\uC11C \uBAB8\uC774\uB098
      \uB179\uC774\uACE0 \uAC00."
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC77C\uCC0D \uC77C\uC5B4\uB0AC\uAD70. \uC0AC\uB0E5\uD558\uAE30 \uC88B\uC740
      \uB0A0\uC774\uC57C."
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC654\uB098. \uBD88\uC740 \uD53C\uC6CC \uB480\uB2E4. \uC549\uC544."
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB610 \uC654\uAD70. \uC624\uB294 \uAE38\uC5D0 \uC774\uC0C1\uD55C \uAC74
      \uC5C6\uC5C8\uB098?"
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC608\uC804\uC5D4 \uBB34\uB9AC\uAC00 \uC788\uC5C8\uB2E4. \uC9C0\uAE08\uC740\u2026
      \uC774 \uBAA8\uB2E5\uBD88 \uD558\uB098\uAC00 \uC804\uBD80\uC57C."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB208 \uC704\uC5D0\uC120 \uBC1C\uC18C\uB9AC\uB97C \uC8FD\uC5EC. \uC9D0\uC2B9\uB4E4\uC740
      \uC18C\uB9AC\uBCF4\uB2E4 \uB0C4\uC0C8\uC5D0 \uBA3C\uC800 \uBC18\uC751\uD558\uC9C0\uB9CC."
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uB4F1 \uB4A4\uB294 \uB0B4\uAC00 \uBCF8\uB2E4. \uADF8\uB7EC\uB2C8
      \uC55E\uB9CC \uBD10."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD63C\uC790 \uC788\uB294 \uAC8C \uC775\uC219\uD558\uAE34 \uD55C\uB370\u2026
      \uC694\uC998\uC740 \uC870\uAE08 \uB2E4\uB974\uB2E4."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC0C1\uD558\uAC8C \uB124 \uACC1\uC5D0\uC120\u2026 \uC2F8\uC6C0\uBCF4\uB2E4
      \uC228\uC774 \uACE0\uB974\uB354\uAD70."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB10C \uB0B4 \uB4A4\uB97C \uBBFF\uC5B4\uB3C4 \uC88B\uC544. \uB0B4\uAC00
      \uBA3C\uC800 \uC4F0\uB7EC\uC9C0\uC9C4 \uC54A\uC73C\uB2C8\uAE4C."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB10C \uAC81\uC774 \uC5C6\uAD70. \uADF8\uAC8C \uC57D\uC810\uC77C \uC218\uB3C4
      \uC788\uC5B4."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uC8FC\uBCC0\uC5D0 \uD568\uBD80\uB85C \uB2E4\uAC00\uC624\uC9C0
      \uB9C8."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108 \uD558\uB098\uB9CC\uC740\u2026 \uC5B4\uB5A4 \uC801\uC774 \uC640\uB3C4
      \uC9C0\uCF1C\uB0B4\uACA0\uC5B4. \uADF8\uAC8C \uB098\uC57C."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744\uC5D4 \uACA8\uC6B8 \uC900\uBE44\uB2E4. \uC7A5\uC791, \uAC00\uC8FD,
      \uACE0\uAE30. \uAC8C\uC73C\uB974\uBA74 \uC5BC\uC5B4 \uC8FD\uB294\uB2E4."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB208\uC774 \uB179\uC73C\uBA74 \uAE38\uC774 \uBBF8\uB044\uB7EC\uC6CC\uC9C4\uB2E4.
      \uC0B0\uC5D0 \uC62C \uB550 \uC870\uC2EC\uD574."
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984 \uC0B0\uC5D4 \uC9D0\uC2B9\uC774 \uB9CE\uC544. \uC0AC\uB0E5\uD558\uAE30\uC5D4
      \uC88B\uC9C0."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8 \uC0B0\uC740 \uC815\uC9C1\uD558\uB2E4. \uC57D\uD55C \uAC74
      \uBC84\uD2F0\uC9C0 \uBABB\uD558\uC9C0. \u2026\uB108\uB294 \uBC84\uD168\uB77C."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44\uB294 \uB0C4\uC0C8\uB97C \uC9C0\uC6B4\uB2E4. \uC624\uB298 \uAC19\uC740
      \uB0A0\uC5D4 \uACBD\uACC4\uB97C \uB450 \uBC30\uB85C."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC774\uAD70. \uBC1C\uC790\uAD6D\uC774 \uC798 \uB0A8\uB294\uB2E4.
      \uC0AC\uB0E5\uD558\uAE30 \uC88B\uC740 \uB0A0\uC774\uC57C."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uD3ED\uD48D\uC5D4 \uCC9C\uB9C9 \uC904\uBD80\uD130 \uD655\uC778\uD574.
      \u2026\uB0B4 \uAC71\uC815\uC740 \uB9D0\uACE0."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uB2E8 \uAC74 \uC785\uC5D0 \uC548 \uB9DE\uB294\uB2E4. \uB2E4\uB978 \uB140\uC11D\uD55C\uD14C
      \uC918."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\u2026\uBB50, \uBC1B\uAE34 \uD558\uC9C0."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\u2026\uACE0\uAE30 \uC694\uB9AC\uB0D0. \uD760. \uACE0\uB9D9\uB2E4. \uC81C\uB300\uB85C
      \uBA39\uB294 \uAC74 \uC624\uB79C\uB9CC\uC774\uAD70."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uC4F8 \uB9CC\uD558\uAD70. \uBC1B\uC544 \uB450\uC9C0."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\u2026\uC0DD\uC77C? \uADF8\uB7F0 \uAC78 \uCC59\uAE34 \uAC8C \uBA87 \uB144
      \uB9CC\uC774\uC9C0. \u2026\uACE0\uB9D9\uB2E4. \uC9C4\uC2EC\uC774\uC57C."
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uADF8\uB0A0 \uC9C0\uD0A4\uC9C0 \uBABB\uD55C \uAC83\uB4E4\u2026 \uC774\uC81C\uB294
      \uB2E4\uC2DC\uB294 \uB193\uCE58\uC9C0 \uC54A\uC744 \uAC70\uC57C."
