%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Arachne
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_arachne
  dailyTalkLimit: 1
  expressionTags:
  - "\uBB34\uD45C\uC815"
  - "\uB9CC\uC871"
  - "\uB2F9\uD669"
  - "\uC2AC\uD514"
  - "\uFE0F \uC9D1\uC911"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\u2026\uB180\uB77C\uC9C0 \uC54A\uB124. \uB098\uB294 \uC544\uB77C\uD06C\uB124.
      \uC637\uC744 \uC9D3\uB294 \uC0AC\uB78C\uC774\uC57C. \uB108\uBB34 \uAC00\uAE4C\uC774
      \uC624\uC9C4 \uB9C8. \uC2E4\uC774 \uC5C9\uD0A4\uB2C8\uAE4C."
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774 \uC5B4\uB460 \uC18D\uC5D0\uC11C\uB3C4 \uC2E4\uC740 \uC774\uC5B4\uC838
      \uC788\uC5B4\u2026 \uB108\uC5D0\uAC8C \uB2FF\uC744\uC9C0\uB3C4 \uBAA8\uB974\uC9C0."
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC5B4. \uB124 \uC637\uAE43, \uC870\uAE08
      \uD480\uB838\uB294\uB370\u2026 \uAC00\uB9CC\uD788 \uC788\uC5B4 \uBD10."
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB610 \uC654\uAD6C\uB098. \uC624\uB298\uC740 \uBC1C\uC18C\uB9AC\uAC00
      \uC870\uC6A9\uD558\uB124\u2026 \uC88B\uC544."
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBC1D\uC740 \uBE5B\uC740 \uB208\uC774 \uC544\uD30C. \uADF8\uB798\uC11C
      \uB098\uB294 \uD574 \uC9C8 \uB158\uC5D0\uB9CC \uB9C8\uC744\uC5D0 \uAC00."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC2E4 \uD55C \uC62C\uC5D0\uB3C4 \uBC29\uD5A5\uC774 \uC788\uC5B4. \uAC70\uC2A4\uB974\uBA74
      \uB04A\uC5B4\uC9C0\uACE0, \uB530\uB77C\uAC00\uBA74 \uBB34\uB2AC\uAC00 \uB3FC."
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC608\uC804\uC5D4 \uB2E4\uB4E4 \uB098\uB97C \uAD34\uBB3C\uC774\uB77C
      \uBD88\uB800\uC5B4. \u2026\uB10C \uB0B4 \uB2E4\uB9AC\uB97C \uBCF4\uACE0\uB3C4
      \uC637 \uC598\uAE30\uBD80\uD130 \uD588\uC9C0."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC138\uC0C1\uC740 \uBCF5\uC7A1\uD55C \uADF8\uBB3C\uB9DD \uAC19\uC544.
      \uB098\uB294 \uADF8\uAC78 \uB2E8\uC9C0\u2026 \uC870\uAE08 \uB354 \uC544\uB984\uB2F5\uAC8C
      \uC9E4 \uBFD0\uC774\uC57C."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uCC98\uC74C\uC774\uC57C\u2026 \uB204\uAD70\uAC00 \uB0B4 \uC2E4\uC744
      \u2018\uC544\uB984\uB2F5\uB2E4\u2019\uACE0 \uB9D0\uD574\uC900 \uAC74."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB10C \uB0B4 \uC190\uB05D\uC758 \uB5A8\uB9BC\uC744 \uB450\uB824\uC6CC\uD558\uC9C0
      \uC54A\uB294\uAD70."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD765\uBBF8\uB85C\uC6B4 \uC778\uAC04\uC774\uB124. \uAC81\uC744 \uBA39\uC9C0
      \uC54A\uB2E4\uB2C8."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAC00\uAE4C\uC774 \uC624\uC9C0 \uB9C8. \uB0B4 \uC2E4\uC740 \uC0C1\uCC98\uBCF4\uB2E4
      \uAE4A\uAC8C \uBCA0\uC5B4."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB10C \uB0B4 \uC608\uC220\uC758 \uC77C\uBD80\uC57C. \uC601\uC6D0\uD788,
      \uC774 \uC2E4\uC5D0 \uBB36\uC5EC\uB3C4 \uAD1C\uCC2E\uACA0\uC9C0?"
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744 \uAC70\uBBF8\uC904\uC740 \uAC00\uC7A5 \uD2BC\uD2BC\uD574.
      \uCD94\uC704\uB97C \uACAC\uB514\uB824\uACE0 \uB2E8\uB2E8\uD788 \uC9DC\uAC70\uB4E0."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04 \uB204\uC5D0\uACE0\uCE58\uB294 \uC2E4\uC774 \uACF1\uB2E4. \uC62C\uD574\uB294
      \uC5F0\uD55C \uC0C9\uC73C\uB85C \uD55C \uBC8C \uC9C0\uC5B4 \uBCFC\uAE4C."
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984 \uD587\uBE5B\uC740 \uC2EB\uC5B4. \uADF8\uB298 \uC18D \uAC70\uBBF8\uC904\uC774
      \uC774\uC2AC\uC744 \uBA38\uAE08\uB294 \uC0C8\uBCBD\uC774 \uC88B\uC544."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8\uC5D4 \uB450\uAEBC\uC6B4 \uCC9C\uC744 \uC9DC. \uB204\uAD70\uAC00
      \uCD94\uC704\uC5D0 \uB5A8\uC9C0 \uC54A\uAC8C."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44 \uC624\uB294 \uB0A0\uC5D4 \uAC70\uBBF8\uC904\uB9C8\uB2E4 \uBB3C\uBC29\uC6B8
      \uBAA9\uAC78\uC774\uAC00 \uAC78\uB824. \uC608\uC058\uC9C0?"
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC1A1\uC774\uC5D0\uB3C4 \uACB0\uC815 \uBB34\uB2AC\uAC00 \uC788\uC5B4.
      \uC2E4\uB85C \uD749\uB0B4 \uB0B4 \uBCF4\uACE0 \uC2F6\uC5B4."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uCC9C\uB465\uC18C\uB9AC\uB294\u2026 \uC2EB\uC5B4. \uC624\uB298\uC740
      \uC9C0\uD558\uC5D0 \uC788\uC744\uAC8C."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uACE1\uAD2D\uC774 \uC18C\uB9AC\uB294 \uBA38\uB9AC\uAC00 \uC6B8\uB824.
      \uC7A5\uC791\uC740 \uBD88\uC744 \uBD80\uB974\uACE0. \uC774\uAC74 \uAC00\uC838\uAC00
      \uC918."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\u2026\uACE0\uB9C8\uC6CC."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uC88B\uC740 \uCC9C\uC774\uC57C\u2026 \uACB0\uC774 \uC0B4\uC544 \uC788\uC5B4.
      \uACE0\uB9C8\uC6CC, \uC18C\uC911\uD788 \uC4F8\uAC8C."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uC4F8\uBAA8 \uC788\uB294 \uC120\uBB3C\uC774\uB124. \uC2E4\uC744 \uBF51\uB294
      \uB370 \uB3C4\uC6C0\uC774 \uB418\uACA0\uC5B4."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC0DD\uC77C\u2026 \uADF8\uB7F0 \uB0A0\uC744 \uCC59\uACA8 \uC8FC\uB294
      \uC0AC\uB78C\uC774 \uC788\uC5C8\uB124. \uB2F5\uB840\uB85C \uB124 \uCE58\uC218\uB97C
      \uC7AC \uB458\uAC8C."
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB450\uB824\uC6C0\uACFC \uC544\uB984\uB2E4\uC6C0\uC740 \uB298 \uD55C
      \uC62C \uCC28\uC774\uC57C. \uB10C \uADF8\uAC78 \uC774\uD574\uD560 \uAC83 \uAC19\uC544."
