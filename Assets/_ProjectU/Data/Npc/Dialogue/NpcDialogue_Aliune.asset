%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Aliune
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_aliune
  dailyTalkLimit: 1
  expressionTags:
  - "\uD3EC\uADFC\uD568"
  - "\uC218\uC90D\uC74C"
  - "\uD68C\uC0C1"
  - "\uCE58\uC720"
  - "\uBD84\uB178"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC5B4\uC11C \uC640\uC694. \uC800\uB294 \uC54C\uB9AC\uC6B0\uB124. \uB2E4\uCE5C
      \uB545\uC5D0 \uAF43\uC744 \uD53C\uC6B0\uB294 \uC77C\uC744 \uD574\uC694. \u2026\uBC1C\uBC11
      \uC0C8\uC2F9, \uC870\uC2EC\uD574 \uC904\uB798\uC694?"
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD587\uC0B4\uC774 \uC88B\uC544\uC694. \uAF43\uB4E4\uC774 \uAE68\uC5B4\uB0AC\uC5B4\uC694."
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0\uC774 \uC624\uBA74\u2026 \uC81C \uAF43\uC774 \uBA3C\uC800
      \uC54C\uC544\uCC44\uACE0 \uD53C\uC5B4\uC694."
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB610 \uC640 \uC92C\uB124\uC694. \uD587\uC0B4\uC774 \uC88B\uC544\uC11C
      \uC78E\uC774 \uBC18\uC9DD\uC5EC\uC694."
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC608\uC804 \uC815\uC6D0\uC774 \uBD88\uC5D0 \uD0D4\uC5B4\uC694. \uBFCC\uB9AC
      \uB05D\uC774 \uC544\uC9C1\uB3C4\u2026 \uC870\uAE08 \uC544\uD30C\uC694."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC2DC\uB4E0 \uC78E\uB3C4 \uBFCC\uB9AC\uAC00 \uC0B4\uC544 \uC788\uC73C\uBA74
      \uB2E4\uC2DC \uC790\uB77C\uC694. \uC0AC\uB78C \uB9C8\uC74C\uB3C4 \uADF8\uB807\uACE0\uC694."
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774 \uC12C \uC804\uCCB4\uB97C \uCE58\uC720 \uC815\uC6D0\uC73C\uB85C
      \uB9CC\uB4E4\uACE0 \uC2F6\uC5B4\uC694. \uB2F9\uC2E0 \uBC2D\uBD80\uD130\u2026
      \uAD1C\uCC2E\uC744\uAE4C\uC694."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC0C1\uCC98\uB294 \uD587\uBE5B\uACFC \uC2DC\uAC04\uC73C\uB85C \uC790\uB77C\uB098
      \uAF43\uC774 \uB3FC\uC694."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uACC1\uC774 \uD3B8\uD574\uC84C\uC5B4."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uBC88 \uC77C\uC740 \uD568\uAED8\uD558\uC790."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC870\uAE08\uC740 \uD765\uBBF8\uB86D\uB124."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC544\uC9C1 \uB110 \uBBFF\uC9C4 \uC54A\uC544."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC81C \uB0B4 \uBAA9\uD45C\uC5D0\uB294 \uB124\uAC00 \uC788\uC5B4."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744\uC5D4 \uC78E\uC744 \uB5A8\uC5B4\uB728\uB824\uC694. \uC26C\uC5B4\uC57C
      \uB2E4\uC2DC \uC790\uB784 \uC218 \uC788\uC73C\uB2C8\uAE4C."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uC5D4 \uC528\uC557\uC774 \uB208\uC744 \uB5A0\uC694. \uD558\uB098\uD558\uB098
      \uC778\uC0AC\uD574 \uC8FC\uACE0 \uC2F6\uC5B4\uC694."
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984 \uD587\uC0B4\uC740 \uC88B\uC9C0\uB9CC, \uBB3C\uC744 \uC790\uC8FC
      \uC918\uC57C \uD574\uC694. \uB2F9\uC2E0\uB3C4\uC694."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8\uC5D4 \uC628\uC2E4\uC5D0\uC11C \uC9C0\uB0B4\uC694. \uB530\uB73B\uD55C
      \uACF3\uC5D0\uC11C \uBFCC\uB9AC\uB97C \uC26C\uAC8C \uD574\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44\uB294 \uC2DD\uBB3C\uB4E4\uC758 \uC2DD\uC0AC \uC2DC\uAC04\uC774\uC5D0\uC694.
      \uBAA8\uB450 \uAE30\uBED0\uD558\uACE0 \uC788\uC5B4\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC740 \uC774\uBD88 \uAC19\uC544\uC694. \uB545\uC18D \uC528\uC557\uB4E4\uC744
      \uB36E\uC5B4 \uC918\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uBC14\uB78C\uC774 \uAC70\uC138\uBA74 \uC5B4\uB9B0 \uC904\uAE30\uAC00
      \uAEBE\uC5EC\uC694. \uC624\uB298\uC740 \uACC1\uC744 \uC9C0\uCF1C\uC57C\uACA0\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uB098\uBB34 \uC7A5\uC791\uC740\u2026 \uBD88\uC774 \uC0DD\uAC01\uB098\uC694.
      \uBBF8\uC548\uD574\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uACE0\uB9C8\uC6CC\uC694. \uC5B4\uB514\uC5D0 \uB450\uBA74 \uC88B\uC744\uC9C0
      \uC0DD\uAC01\uD574 \uBCFC\uAC8C\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uC528\uC557\uC774\uB124\uC694\u2026! \uC5B4\uB5A4 \uAF43\uC774 \uD544\uC9C0
      \uBC8C\uC368 \uC124\uB808\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uACE0\uB9C8\uC6CC\uC694. \uC78E\uC774 \uAE30\uBED0\uC11C \uD754\uB4E4\uB9AC\uB124\uC694."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC81C \uC0DD\uC77C\uC5D0 \uC640 \uC92C\uB124\uC694. \uC624\uB298 \uD540
      \uAF43\uC740\u2026 \uC804\uBD80 \uB2F9\uC2E0 \uAC70\uC608\uC694."
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uC190\uAE38\uC774 \uB0B4 \uC815\uC6D0\uC5D0 \uBD04\uC744 \uB3CC\uB824\uC92C\uC5B4\uC694."
