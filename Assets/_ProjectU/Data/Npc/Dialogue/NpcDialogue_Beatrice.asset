%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Beatrice
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_beatrice
  dailyTalkLimit: 1
  expressionTags:
  - "\uB0C9\uC815"
  - "\uB2F9\uD669"
  - "\uBBF8\uC18C"
  - "\uACB0\uC758"
  - "\uC548\uB3C4"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uCC98\uC74C \uBCF4\uB294 \uC5BC\uAD74\uC774\uB124\uC694. \uC798 \uBD80\uD0C1\uD574\uC694."
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC784\uBB34 \uBCF4\uACE0\uD558\uB7EC \uC654\uC5B4\uC694. \u2026\uC544,
      \uADF8\uB0E5 \uC778\uC0AC\uC600\uB2E4\uACE0\uC694?"
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uB0A0\uAC1C\uB294 \uB2E8\uC21C\uD55C \uC7A5\uC2DD\uC774 \uC544\uB2C8\uC5D0\uC694.
      \uC774\uAC74 \uAD70\uCCB4\uC758 \uC790\uBD80\uC2EC\uC774\uC8E0."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBA85\uB839\uB9CC \uC788\uC73C\uBA74 \uB41C\uB2E4. \uAC10\uC815\uC740
      \uC77C\uC5D0 \uBC29\uD574\uC57C."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB10C \uC774\uC0C1\uD558\uAD70\u2026 \uD63C\uC790 \uC6C0\uC9C1\uC774\uC9C0
      \uC54A\uB124. \uAD70\uCCB4\uB3C4 \uC544\uB2CC\uB370."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC88B\uC544, \uC774\uBC88 \uC815\uCC30\uC740 \uB124 \uC9C0\uC2DC\uC5D0
      \uB530\uB97C\uAC8C."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC0C1\uD574\u2026 \uB110 \uBCF4\uBA74 \uB0B4 \uB0A0\uAC1C\uAC00
      \uC800\uC808\uB85C \uB5A8\uB824."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAFC0\uC740 \uB098\uB20C\uC218\uB85D \uB2EC\uCF64\uD574\uC9C4\uB300.
      \uB10C \uB0B4 \uB9C8\uC9C0\uB9C9 \uAFC0\uC774\uC57C."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uCD94\uC6CC\uC694. \uB530\uB73B\uD558\uAC8C \uC785\uACE0 \uB2E4\uB2C8\uC138\uC694."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uBC14\uB78C\uC774 \uC120\uC120\uD574\uC84C\uC5B4\uC694. \uC218\uD655\uC740
      \uC798 \uB418\uACE0 \uC788\uB098\uC694?"
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uD587\uBCD5\uC774 \uB728\uAC70\uC6CC\uC694. \uADF8\uB298\uC5D0\uC11C
      \uC26C\uC5B4 \uAC00\uC138\uC694."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uC774 \uC654\uB124\uC694. \uC12C\uC774 \uC870\uAE08\uC529 \uCD08\uB85D\uBE5B\uC73C\uB85C
      \uBC14\uB00C\uACE0 \uC788\uC5B4\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44\uAC00 \uC624\uB124\uC694. \uC624\uB298\uC740 \uC870\uAE08 \uC26C\uC5B4
      \uAC00\uB3C4 \uAD1C\uCC2E\uC544\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC774 \uC640\uC694. \uBC1C\uBC11 \uC870\uC2EC\uD558\uC138\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uD3ED\uD48D\uC774\uC5D0\uC694. \uC624\uB298\uC740 \uC548\uC5D0 \uC788\uB294
      \uAC8C \uC88B\uACA0\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uC774\uAC74 \uC815\uB9D0 \uC88B\uC544\uD558\uB294 \uAC70\uC608\uC694!
      \uACE0\uB9C8\uC6CC\uC694!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uACE0\uB9C8\uC6CC\uC694. \uC798 \uC4F8\uAC8C\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uACE0\uB9C8\uC6CC\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uC74C\u2026 \uC774\uAC74 \uC81C \uCDE8\uD5A5\uC740 \uC544\uB2C8\uC5D0\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC0DD\uC77C\uC744 \uAE30\uC5B5\uD574 \uC92C\uAD70\uC694. \uC815\uB9D0
      \uAE30\uBED0\uC694!"
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD63C\uC790\uC120 \uC544\uBB34\uAC83\uB3C4 \uBABB \uD574\uC694. \uD558\uC9C0\uB9CC\u2026
      \uB2F9\uC2E0\uC774 \uC788\uB2E4\uBA74, \uB2E4\uC2DC \uC2DC\uC791\uD560 \uC218
      \uC788\uC744\uC9C0\uB3C4."
