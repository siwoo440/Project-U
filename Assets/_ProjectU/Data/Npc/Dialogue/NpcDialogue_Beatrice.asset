%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Beatrice
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_beatrice
  dailyTalkLimit: 1
  expressionTags:
  - "\uB0C9\uC815"
  - "\uB2F9\uD669"
  - "\uBBF8\uC18C"
  - "\uACB0\uC758"
  - "\uC548\uB3C4"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC815\uCC30 \uBCF4\uACE0. \uC0C8 \uC778\uBB3C \uD655\uC778. \u2026\uBCA0\uC544\uD2B8\uB9AC\uCCB4\uB77C\uACE0
      \uD574\uC694. \uC774 \uC0AC\uB9C9 \uAFC0\uBC8C \uC815\uCC29\uC9C0\uB97C \uB9E1\uACE0
      \uC788\uC5B4\uC694."
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC784\uBB34 \uBCF4\uACE0\uD558\uB7EC \uC654\uC5B4\uC694. \u2026\uC544,
      \uADF8\uB0E5 \uC778\uC0AC\uC600\uB2E4\uACE0\uC694?"
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0\uC774 \uC624\uBA74 \uBC8C\uB4E4\uC774 \uC870\uC6A9\uD574\uC838\uC694.
      \uC88B\uC740 \uC2E0\uD638\uC608\uC694."
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC784\uBB34 \uBCF4\uACE0\uD558\uB7EC \uC628 \uAC74\uAC00\uC694? \u2026\uC544,
      \uADF8\uB0E5 \uC778\uC0AC\uC600\uAD70\uC694. \uBC18\uAC00\uC6CC\uC694."
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC608\uC804\uC5D4 \uC5EC\uC655\uBC8C \uADFC\uC704\uB300\uC7A5\uC774\uC5C8\uC5B4\uC694.
      \uBC18\uB780\uC774 \uC77C\uC5B4\uB0AC\uACE0\u2026 \uC9C0\uD0A4\uC9C0 \uBABB\uD588\uC8E0."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAFC0\uBC8C\uC740 \uD63C\uC790\uC120 \uC0B4 \uC218 \uC5C6\uC5B4\uC694.
      \uAD70\uCCB4\uAC00 \uACE7 \uAC00\uC871\uC774\uC8E0."
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC0C8 \uAD70\uCCB4\uB97C \uB9CC\uB4E4\uACE0 \uC2F6\uC5B4\uC694. \u2026\uB2F9\uC2E0\uB3C4
      \uADF8 \uC548\uC5D0 \uC788\uC5C8\uC73C\uBA74 \uD574\uC694."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uB0A0\uAC1C\uB294 \uB2E8\uC21C\uD55C \uC7A5\uC2DD\uC774 \uC544\uB2C8\uC5D0\uC694.
      \uC774\uAC74 \uAD70\uCCB4\uC758 \uC790\uBD80\uC2EC\uC774\uC8E0."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC0C1\uD574\u2026 \uB110 \uBCF4\uBA74 \uB0B4 \uB0A0\uAC1C\uAC00
      \uC800\uC808\uB85C \uB5A8\uB824."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC88B\uC544, \uC774\uBC88 \uC815\uCC30\uC740 \uB124 \uC9C0\uC2DC\uC5D0
      \uB530\uB97C\uAC8C."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB10C \uC774\uC0C1\uD558\uAD70\u2026 \uD63C\uC790 \uC6C0\uC9C1\uC774\uC9C0
      \uC54A\uB124. \uAD70\uCCB4\uB3C4 \uC544\uB2CC\uB370."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBA85\uB839\uB9CC \uC788\uC73C\uBA74 \uB41C\uB2E4. \uAC10\uC815\uC740
      \uC77C\uC5D0 \uBC29\uD574\uC57C."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAFC0\uC740 \uB098\uB20C\uC218\uB85D \uB2EC\uCF64\uD574\uC9C4\uB300.
      \uB10C \uB0B4 \uB9C8\uC9C0\uB9C9 \uAFC0\uC774\uC57C."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744\uC5D4 \uAFC0\uC744 \uAC70\uB450\uACE0 \uACA8\uC6B8 \uC900\uBE44\uB97C
      \uD574\uC694. \uACC4\uD68D\uB300\uB85C \uC9C4\uD589 \uC911\uC774\uC5D0\uC694."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uC740 \uAF43\uAC00\uB8E8 \uBAA8\uC73C\uB294 \uCCA0\uC774\uC5D0\uC694.
      \uAC00\uC7A5 \uBC14\uC05C \uACC4\uC808\uC774\uC8E0."
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984 \uC0AC\uB9C9\uC740 \uBC8C\uB4E4\uC5D0\uAC8C \uAC00\uD639\uD574\uC694.
      \uC624\uC544\uC2DC\uC2A4 \uBB3C\uC744 \uC790\uC8FC \uBA39\uC5EC\uC57C \uD574\uC694."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8\uC5D4 \uBC8C\uB4E4\uC774 \uBB49\uCCD0\uC11C \uC11C\uB85C\uB97C
      \uB370\uC6CC\uC694. \u2026\uC0AC\uB78C\uB3C4 \uADF8\uB798\uC57C \uD558\uB294\uB370."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44 \uC624\uB294 \uB0A0\uC740 \uBC8C\uB4E4\uC774 \uB098\uAC00\uC9C0
      \uC54A\uC544\uC694. \uC800\uB3C4 \uC624\uB298\uC740 \uBC8C\uD1B5 \uACC1\uC5D0
      \uC788\uC744\uAC8C\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC774\uB77C\uB2C8. \uBC8C\uD1B5 \uBCF4\uC628 \uC791\uC5C5\uC744
      \uC11C\uB458\uB7EC\uC57C\uACA0\uC5B4\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uD3ED\uD48D \uACBD\uBCF4. \uBAA8\uB4E0 \uBC8C\uD1B5 \uACE0\uC815. \u2026\uB2F9\uC2E0\uB3C4
      \uC870\uC2EC\uD574\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uACE1\uAD2D\uC774 \uC18C\uB9AC\uB294 \uBC8C\uB4E4\uC744 \uB180\uB77C\uAC8C
      \uD574\uC694. \uC0AC\uC591\uD560\uAC8C\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\u2026\uC4F8\uBAA8\uB97C \uC0DD\uAC01 \uC911\uC774\uC5D0\uC694. \uC5B4\uB518\uAC00
      \uC4F8 \uB370\uAC00 \uC788\uACA0\uC8E0."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uC5F4\uB9E4\uB124\uC694. \uAFC0 \uB300\uC2E0 \uBC8C\uB4E4 \uAC04\uC2DD\uC73C\uB85C
      \uB531\uC774\uC5D0\uC694. \uACE0\uB9C8\uC6CC\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uB2EC\uCF64\uD558\uB124\uC694. \uAD70\uCCB4 \uCC3D\uACE0\uC5D0 \uB123\uC5B4
      \uB458\uAC8C\uC694."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC0DD\uC77C\uC744\u2026 \uAE30\uC5B5\uD588\uAD70\uC694. \uAD70\uCCB4\uAC00
      \uBB34\uB108\uC9C4 \uB4A4\uB85C \uCC98\uC74C\uC774\uC5D0\uC694. \u2026\uACE0\uB9C8\uC6CC\uC694,
      \uC815\uB9D0\uB85C."
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD63C\uC790\uC120 \uC544\uBB34\uAC83\uB3C4 \uBABB \uD574\uC694. \uD558\uC9C0\uB9CC\u2026
      \uB2F9\uC2E0\uC774 \uC788\uB2E4\uBA74, \uB2E4\uC2DC \uC2DC\uC791\uD560 \uC218
      \uC788\uC744\uC9C0\uB3C4."
