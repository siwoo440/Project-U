%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Neri
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_neri
  dailyTalkLimit: 1
  expressionTags:
  - "\uD65C\uAE30"
  - "\uB180\uB78C"
  - "\uC218\uC90D\uC74C"
  - "\uC9D1\uC911"
  - "\uC548\uB3C4"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAC1C\uAD74! \uAE5C\uC9DD\uC774\uC57C! \uB098\uB294 \uB124\uB9AC, \uB0A0\uC528
      \uAD00\uCE21\uAC00\uC57C! \uB0B4\uC77C \uBE44 \uC62C\uC9C0 \uAD81\uAE08\uD574?
      \uBB3C\uC5B4\uBD10!"
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBE44 \uB0C4\uC0C8\uAC00 \uB098\uC694. \uACE7 \uC62C \uAC70\uC608\uC694."
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108 \uC624\uB294 \uAC70 \uBBF8\uB9AC \uC54C\uC558\uC5B4! \uACF5\uAE30\uAC00
      \uC0B4\uC9DD \uB5A8\uB838\uAC70\uB4E0!"
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC654\uB2E4! \uC624\uB298 \uC2B5\uB3C4\uB294 \uB531 \uC88B\uC544! \uAC1C\uAD74!"
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAC00\uBB44 \uB54C \uC2B5\uC9C0\uAC00 \uB9D0\uB77C\uC11C\u2026 \uAC00\uC871\uC774
      \uD769\uC5B4\uC84C\uC5B4. \uADF8\uB798\uC11C \uBE44\uAC00 \uC88B\uC544."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAD6C\uB984 \uBAA8\uC591 \uBCF4\uBA74 \uB0B4\uC77C \uB0A0\uC528\uAC00
      \uBCF4\uC5EC! \uC800\uAC74 \uBE44\uAD6C\uB984\uC774\uC57C! \u2026\uC544\uB9C8\uB3C4!"
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC2B5\uC9C0\uB97C \uB2E4\uC2DC \uCD09\uCD09\uD558\uAC8C \uB9CC\uB4E4
      \uAC70\uC57C! \uB108\uB3C4 \uB3C4\uC640\uC904 \uAC70\uC9C0? \uAC1C\uAD74!"
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAC1C\uAD6C\uB9AC \uC6B8\uC74C\uC740 \uBE44\uC758 \uD3B8\uC9C0\uC608\uC694."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uACC1\uC774 \uD3B8\uD574\uC84C\uC5B4."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uBC88 \uC77C\uC740 \uD568\uAED8\uD558\uC790."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC870\uAE08\uC740 \uD765\uBBF8\uB86D\uB124."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC544\uC9C1 \uB110 \uBBFF\uC9C4 \uC54A\uC544."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC81C \uB0B4 \uBAA9\uD45C\uC5D0\uB294 \uB124\uAC00 \uC788\uC5B4."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744\uC5D4 \uBC14\uB78C \uBC29\uD5A5\uC774 \uC790\uC8FC \uBC14\uB00C\uC5B4!
      \uAD00\uCE21\uD560 \uAC8C \uB9CE\uC544!"
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uBE44\uB294 \uBD80\uB4DC\uB7EC\uC6CC! \uD53C\uBD80\uAC00 \uCD09\uCD09\uD574\uC838!"
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984\uC740 \uB108\uBB34 \uB9D0\uB77C! \uAC1C\uAD74\u2026 \uBB3C\uAC00\uC5D0\uB9CC
      \uC788\uC744\uB798."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8\uC5D4 \uC878\uB824\u2026 \uAC1C\uAD74\u2026 \uACA8\uC6B8\uC7A0
      \uC790\uACE0 \uC2F6\uC5B4\u2026"
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44\uB2E4! \uBE44\uB2E4! \uAC1C\uAD74\uAC1C\uAD74! \uC624\uB298 \uCD5C\uACE0\uC758
      \uB0A0\uC774\uC57C!"
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC740 \uBE44\uAC00 \uC5BC\uC5B4 \uBC84\uB9B0 \uAC70\uC57C. \uBD88\uC30D\uD55C
      \uBE44!"
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uAC1C\uAD74?! \uCC9C\uB465\uC740 \uBB34\uC11C\uC6CC! \uAD00\uCE21\uC740\u2026
      \uCC3D\uBB38 \uC548\uC5D0\uC11C \uD560\uB798!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uBC14\uC2F9 \uB9C8\uB978 \uAC74 \uC2EB\uC5B4\u2026 \uD53C\uBD80\uAC00
      \uB530\uAC00\uC6CC."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC74C, \uC774\uAC74 \uAD00\uCE21 \uB3C4\uAD6C\uB85C \uC4F8 \uC218 \uC788\uC744\uAE4C?"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uC9C0\uB801\uC774\uB2E4! \uAC1C\uAD74! \uC774\uAC70 \uC9C4\uC9DC \uB9DB\uC788\uC5B4!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uC624, \uACE0\uB9C8\uC6CC! \uCD09\uCD09\uD55C \uC120\uBB3C \uC88B\uC544!"
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uC0DD\uC77C! \uAC1C\uAD74! \uC624\uB298 \uBE44 \uC624\uBA74 \uC644\uBCBD\uD55C\uB370!
      \u2026\uC548 \uC640\uB3C4 \uC88B\uC544, \uB124\uAC00 \uC654\uC73C\uB2C8\uAE4C!"
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124\uAC00 \uC2EC\uC740 \uC5F0\uC78E\uC774 \uB2E4\uC2DC \uD53C\uC5C8\uC5B4\uC694."
