%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Eiri
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_eiri
  dailyTalkLimit: 1
  expressionTags:
  - "\uC6C3\uC74C"
  - "\uC7A5\uB09C"
  - "\uD68C\uC0C1"
  - "\uBD84\uB178"
  - "\uC5EC\uC720"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD6C4\uD6D7, \uC0C8 \uC5BC\uAD74\uC774\uB2E4~! \uB098\uB294 \uC5D0\uC774\uB9AC,
      \uBC14\uB78C\uC744 \uB178\uB798\uD558\uB294 \uC74C\uC720\uC2DC\uC778\uC774\uC57C.
      \uB4F1\uB300 \uAF2D\uB300\uAE30\uAC00 \uB0B4 \uBB34\uB300\uC9C0!"
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD558\uB298 \uC704\uC758 \uAE30\uBD84, \uC54C\uACE0 \uC2F6\uC9C0 \uC54A\uC544?
      \uC624\uB298\uC740 \uBC14\uB78C\uC774 \uBA4B\uC838!"
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC654\uAD6C\uB098! \uC0C8 \uB178\uB798 \uB9CC\uB4E4\uC5C8\uC5B4. \uC81C\uBAA9\uC740\u2026
      \uC544\uC9C1 \uBE44\uBC00~"
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC548\uB155~! \uC624\uB298 \uBC14\uB78C \uB0C4\uC0C8 \uB9E1\uC558\uC5B4?
      \uB178\uB798\uAC00 \uC808\uB85C \uB098\uC640~"
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC608\uC804\uC5D0 \uB0A0\uAC1C\uB97C \uB2E4\uCCD0\uC11C \uBABB \uB0A0
      \uBED4\uD588\uC5B4. \uADF8\uB54C \uC54C\uC558\uC9C0, \uC790\uC720\uB294 \uB2F9\uC5F0\uD55C
      \uAC8C \uC544\uB2C8\uB77C\uB294 \uAC78."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD558\uB298\uC740 \uB9E4\uC77C \uB2E4\uB978 \uB178\uB798\uB97C \uBD88\uB7EC.
      \uB09C \uADF8\uAC78 \uBC1B\uC544 \uC801\uC744 \uBFD0\uC774\uC57C~"
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108\uB791 \uC788\uC73C\uBA74 \uBC14\uB78C\uC774 \uBD80\uB4DC\uB7EC\uC6CC\uC838.
      \uC774\uC0C1\uD558\uC9C0? \uD6C4\uD6D7."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC9C0\uC0C1\uC740 \uAC00\uB054 \uB2F5\uB2F5\uD558\uC9C0\uB9CC\u2026 \uC0AC\uB78C\uB4E4\uC758
      \uB208\uBE5B\uC740 \uD558\uB298\uBCF4\uB2E4 \uB530\uB73B\uD558\uB124."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2E4\uB978 \uD558\uB298\uB85C \uB0A0\uC544\uB3C4, \uB10C \uB0B4 \uAE30\uC5B5
      \uC18D\uC5D0 \uB0A8\uC744 \uAC70\uC57C."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108\uB791 \uC788\uC73C\uBA74\u2026 \uBC14\uB78C\uC774 \uBD80\uB4DC\uB7EC\uC6CC\uC9C0\uB294
      \uAE30\uBD84\uC774\uC57C."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108, \uB178\uB798 \uB4E4\uC5B4\uBCFC\uB798? \uD558\uB298 \uB0C4\uC0C8\uAC00
      \uB098\uB294 \uACE1\uC774\uC57C."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC9C0\uC0C1 \uC0AC\uB78C\uB4E4\uC740 \uB108\uBB34 \uB290\uB824~"
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC81C\uB294 \uBC14\uB78C\uBCF4\uB2E4 \uB124 \uACC1\uC774 \uB354
      \uAC00\uBCCD\uAC8C \uB290\uAEF4\uC838."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744\uBC14\uB78C\uC5D4 \uC4F8\uC4F8\uD55C \uAC00\uB77D\uC774 \uC5B4\uC6B8\uB824.
      \uD55C \uACE1 \uB4E4\uB824\uC904\uAE4C?"
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uBC14\uB78C\uC740 \uAC04\uC9C0\uB7EC\uC6CC~ \uAE43\uD138\uC774
      \uC800\uC808\uB85C \uBD80\uD480\uC5B4!"
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984 \uD558\uB298\uC740 \uB192\uACE0 \uD30C\uB798! \uAD6C\uB984
      \uC704\uAE4C\uC9C0 \uB178\uB798\uAC00 \uB2FF\uC744 \uAC83 \uAC19\uC544~"
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8\uBC14\uB78C\uC740 \uCC28\uAC11\uC9C0\uB9CC \uB9D1\uC544.
      \uBAA9\uC18C\uB9AC\uAC00 \uBA40\uB9AC\uBA40\uB9AC \uD37C\uC838~"
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44 \uC624\uBA74 \uAE43\uD138\uC774 \uC816\uC5B4\uC11C\u2026 \uC624\uB298\uC740
      \uB4F1\uB300 \uC548\uC5D0\uC11C \uB178\uB798 \uC5F0\uC2B5!"
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC1A1\uC774\uAC00 \uCDA4\uCDB0! \uD558\uB298\uC774 \uC870\uC6A9\uD55C
      \uB178\uB798\uB97C \uBD80\uB974\uB294 \uB0A0\uC774\uC57C~"
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uD3ED\uD48D \uBC14\uB78C\uC740 \uB108\uBB34 \uAC70\uCE60\uC5B4! \uB0A0\uAC1C
      \uAF2D \uC811\uACE0 \uC788\uC744\uB798\u2026"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uC73C\uC73C, \uBB34\uAC70\uC6CC\u2026 \uC774\uAC78 \uB4E4\uACE0\uB294
      \uBABB \uB0A0\uACA0\uC5B4."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC74C~ \uC774\uAC74 \uBB34\uC2A8 \uB178\uB798\uC5D0 \uC5B4\uC6B8\uB9B4\uAE4C?"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uB538\uAE30! \uD5A5\uAE0B\uD574~ \uC774\uAC78\uB85C \uC0C8 \uB178\uB798
      \uD558\uB098 \uB9CC\uB4E4 \uC218 \uC788\uACA0\uC5B4!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uB2EC\uCF64\uD558\uB2E4~ \uACE0\uB9C8\uC6CC! \uBAA9\uC18C\uB9AC\uAC00
      \uB354 \uB9D1\uC544\uC9C8 \uAC83 \uAC19\uC544."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uC0DD\uC77C\uC774\uC57C~! \uC624\uB298\uC740 \uB110 \uC704\uD55C
      \uB178\uB798\uB97C \uBD80\uB97C\uAC8C. \uD558\uB298\uAE4C\uC9C0 \uB2FF\uB3C4\uB85D!"
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uB178\uB798\uB294 \uD558\uB298\uC758 \uC77C\uAE30\uC57C. \uB124\uAC00
      \uADF8 \uD55C \uC904\uC774 \uB418\uC5B4\uC92C\uC73C\uBA74 \uC88B\uACA0\uC5B4."
