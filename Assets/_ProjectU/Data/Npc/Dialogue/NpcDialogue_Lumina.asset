--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Lumina
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_lumina
  dailyTalkLimit: 1
  expressionTags:
  - "\uBBF8\uC18C"
  - "\uC218\uC90D\uC74C"
  - "\uD68C\uC0C1"
  - "\uD669\uD640"
  - "\uD3C9\uC628"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\u2026\uC548\uB155\uD558\uC138\uC694. \uB8E8\uBBF8\uB098\uC608\uC694.
      \uB0A0\uAC1C \uAC00\uB8E8\uAC00 \uBB34\uC11C\uC6B0\uBA74\u2026 \uC870\uAE08
      \uB5A8\uC5B4\uC838 \uC788\uC744\uAC8C\uC694."
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC624\uB298 \uAF43\uAC00\uB8E8\uB294 \uB2EC\uBE5B\uCC98\uB7FC \uBE5B\uB098\uC694."
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0\uC774 \uC624\uBA74\u2026 \uB0A0\uAC1C\uAC00 \uC800\uC808\uB85C
      \uD3B4\uC838\uC694. \uC2E0\uAE30\uD558\uC8E0."
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2E4\uC2DC \uB9CC\uB0AC\uB124\uC694\u2026 \uC624\uB298 \uB0A0\uAC1C
      \uC0C9\uC774 \uC870\uAE08 \uBC1D\uC544\uC84C\uC5B4\uC694."
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC608\uC804 \uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC740 \uC81C \uB0A0\uAC1C
      \uAC00\uB8E8\uAC00 \uBCD1\uC744 \uC62E\uAE34\uB2E4\uACE0 \uD588\uC5B4\uC694.
      \u2026\uADF8\uB807\uC9C0 \uC54A\uC740\uB370."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAF43\uAC00\uB8E8\uB294 \uAF43\uB4E4\uC758 \uD3B8\uC9C0\uC608\uC694.
      \uC800\uB294 \uADF8 \uD3B8\uC9C0\uB97C \uB300\uC2E0 \uC804\uD574 \uC918\uC694."
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC81C \uB0A0\uAC1C\uB97C \uC608\uC058\uB2E4\uACE0 \uD574 \uC900 \uC0AC\uB78C\uC740\u2026
      \uB2F9\uC2E0\uC774 \uCC98\uC74C\uC774\uC5D0\uC694."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB098\uBE44\uB294 \uBCC0\uD654\uB97C \uB450\uB824\uC6CC\uD558\uC9C0 \uC54A\uC544\uC694."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uACC1\uC774 \uD3B8\uD574\uC84C\uC5B4."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uBC88 \uC77C\uC740 \uD568\uAED8\uD558\uC790."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC870\uAE08\uC740 \uD765\uBBF8\uB86D\uB124."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC544\uC9C1 \uB110 \uBBFF\uC9C4 \uC54A\uC544."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC81C \uB0B4 \uBAA9\uD45C\uC5D0\uB294 \uB124\uAC00 \uC788\uC5B4."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744\uC5D4 \uAF43\uC774 \uC9C0\uC9C0\uB9CC, \uC528\uC557\uC774
      \uB0A8\uC544\uC694. \uB05D\uC774 \uC544\uB2C8\uC5D0\uC694."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uC740 \uAF43\uAC00\uB8E8\uAC00 \uC81C\uC77C \uB9CE\uC740 \uACC4\uC808\uC774\uC5D0\uC694.
      \uB0A0\uAC1C\uAC00 \uBB34\uAC70\uC6B8 \uB9CC\uD07C\uC694."
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984\uBC24\uC5D4 \uB2EC\uBE5B \uAF43\uC774 \uD53C\uC5B4\uC694.
      \uAC19\uC774 \uAE30\uB2E4\uB824 \uC904\uB798\uC694?"
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8\uC5D4 \uACE0\uCE58 \uC548\uC5D0\uC11C \uC9C0\uB0B4\uC694.
      \u2026\uC870\uAE08 \uC678\uB85C\uC6CC\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44\uAC00 \uC624\uBA74 \uB0A0\uAC1C\uAC00 \uC816\uC5B4\uC11C\u2026
      \uB0A0 \uC218 \uC5C6\uC5B4\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC1A1\uC774\uAC00 \uB0A0\uAC1C\uC5D0 \uC549\uC73C\uBA74\u2026 \uAC04\uC9C0\uB7EC\uC6CC\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uBC14\uB78C\uC774 \uC138\uBA74 \uB0A0\uAC1C\uAC00 \uCC22\uC5B4\uC9C8\uAE4C
      \uBD10\u2026 \uACE0\uCE58 \uC548\uC5D0 \uC788\uC744\uAC8C\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uB098\uBB34 \uD0C0\uB294 \uC5F0\uAE30\uB294\u2026 \uB0A0\uAC1C\uAC00
      \uC544\uD30C\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uAC74\u2026 \uC5B4\uB5A4 \uAF43\uC774\uB791 \uC5B4\uC6B8\uB9B4\uAE4C\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uB538\uAE30\uAF43 \uD5A5\uAE30\uAC00 \uB098\uC694\u2026 \uC815\uB9D0
      \uACE0\uB9C8\uC6CC\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\u2026\uACE0\uB9C8\uC6CC\uC694. \uAF43\uBC2D\uC5D0 \uB450\uBA74 \uC88B\uACA0\uC5B4\uC694."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC0DD\uC77C\uC744\u2026 \uAE30\uC5B5\uD574 \uC92C\uB124\uC694. \uC624\uB298\uC740
      \uB0A0\uAC1C \uAC00\uB8E8\uAC00 \uBB34\uC9C0\uAC1C\uC0C9\uC774\uC5D0\uC694."
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uB0A0\uAC1C\uB97C \uC544\uB984\uB2F5\uB2E4\uACE0 \uB9D0\uD574\uC918\uC11C
      \uACE0\uB9C8\uC6CC\uC694."
