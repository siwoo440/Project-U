%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Lilica
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_lilica
  dailyTalkLimit: 1
  expressionTags:
  - "\uC624\uB9CC"
  - "\uB2F9\uD669"
  - "\uD22C\uC815"
  - "\uC678\uB85C\uC6C0"
  - "\uC878\uB9BC"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uCC98\uC74C \uBCF4\uB294 \uC5BC\uAD74\uC774\uB124\uC694. \uC798 \uBD80\uD0C1\uD574\uC694."
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBC24\uC774\uC57C\uB9D0\uB85C \uC9C4\uC9DC \uC138\uC0C1\uC774\uC9C0.
      \uBE5B\uC740\u2026 \uB108\uBB34 \uC194\uC9C1\uD574\uC11C \uC7AC\uBBF8\uC5C6\uAC70\uB4E0."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD765, \uB124\uAC00 \uAC10\uD788 \uC774 \uB9B4\uB9AC\uCE74 \uB2D8\uAED8
      \uCEE4\uD53C\uB97C \uB300\uC811\uD55C\uB2E4\uACE0? \uAD18\u2026 \uAD1C\uCC2E\uB124."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uB530\uC704\uAC00 \uC774 \uB9B4\uB9AC\uCE74 \uB2D8 \uC55E\uC5D0
      \uC11C\uB3C4 \uB418\uB294 \uAC70\uC57C?"
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108, \uB0AE\uC5D0\uB3C4 \uB3CC\uC544\uB2E4\uB2D0 \uC218 \uC788\uC9C0?
      \uD765\u2026 \uC870\uAE08 \uBD80\uB7FD\uB124."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108\uB77C\uBA74\u2026 \uB9DD\uD1A0 \uC548\uC73C\uB85C \uCD08\uB300\uD574\uC904
      \uC218\uB3C4 \uC788\uC744\uC9C0\uB3C4 \uBAB0\uB77C."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC73C\uC73C\u2026 \uB124\uAC00 \uC5C6\uC73C\uBA74, \uBC24\uC774 \uB108\uBB34
      \uC870\uC6A9\uD574\uC11C \uC2EB\uB2E8 \uB9D0\uC774\uC57C."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108\uC640 \uD568\uAED8\uB77C\uBA74\u2026 \uB0AE\uC5D0\uB3C4 \uB098\uAC00\uBCFC
      \uC218 \uC788\uC744 \uAC83 \uAC19\uC544. \uADF8\uB7EC\uB2C8\uAE4C\u2014\uC190,
      \uB0B4\uBC00\uC5B4\uBD10."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uCD94\uC6CC\uC694. \uB530\uB73B\uD558\uAC8C \uC785\uACE0 \uB2E4\uB2C8\uC138\uC694."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uBC14\uB78C\uC774 \uC120\uC120\uD574\uC84C\uC5B4\uC694. \uC218\uD655\uC740
      \uC798 \uB418\uACE0 \uC788\uB098\uC694?"
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uD587\uBCD5\uC774 \uB728\uAC70\uC6CC\uC694. \uADF8\uB298\uC5D0\uC11C
      \uC26C\uC5B4 \uAC00\uC138\uC694."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uC774 \uC654\uB124\uC694. \uC12C\uC774 \uC870\uAE08\uC529 \uCD08\uB85D\uBE5B\uC73C\uB85C
      \uBC14\uB00C\uACE0 \uC788\uC5B4\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44\uAC00 \uC624\uB124\uC694. \uC624\uB298\uC740 \uC870\uAE08 \uC26C\uC5B4
      \uAC00\uB3C4 \uAD1C\uCC2E\uC544\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC774 \uC640\uC694. \uBC1C\uBC11 \uC870\uC2EC\uD558\uC138\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uD3ED\uD48D\uC774\uC5D0\uC694. \uC624\uB298\uC740 \uC548\uC5D0 \uC788\uB294
      \uAC8C \uC88B\uACA0\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uC774\uAC74 \uC815\uB9D0 \uC88B\uC544\uD558\uB294 \uAC70\uC608\uC694!
      \uACE0\uB9C8\uC6CC\uC694!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uACE0\uB9C8\uC6CC\uC694. \uC798 \uC4F8\uAC8C\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uACE0\uB9C8\uC6CC\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uC74C\u2026 \uC774\uAC74 \uC81C \uCDE8\uD5A5\uC740 \uC544\uB2C8\uC5D0\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC0DD\uC77C\uC744 \uAE30\uC5B5\uD574 \uC92C\uAD70\uC694. \uC815\uB9D0
      \uAE30\uBED0\uC694!"
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4\uAC00 \uC774\uB807\uAC8C \uC6C3\uC740 \uAC8C \uC5B8\uC81C\uC600\uB354\uB77C\u2026
      \uC544\uB9C8, \uB124\uAC00 \uCC98\uC74C\uC77C\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC5B4."
