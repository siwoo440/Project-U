%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Lilica
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_lilica
  dailyTalkLimit: 1
  expressionTags:
  - "\uC624\uB9CC"
  - "\uB2F9\uD669"
  - "\uD22C\uC815"
  - "\uC678\uB85C\uC6C0"
  - "\uC878\uB9BC"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD6C4\uD6D7, \uC774 \uB9B4\uB9AC\uCE74 \uB2D8\uC758 \uC800\uD0DD\uC5D0
      \uC190\uB2D8\uC774\uB77C\uB2C8! \uAC81\uB3C4 \uC5C6\uC774 \uCC3E\uC544\uC628
      \uC778\uAC04, \uC774\uB984\uC744 \uAE30\uC5B5\uD574 \uC8FC\uC9C0. \u2026\uBB34,
      \uBB34\uC12D\uC9C0 \uC54A\uC544?"
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBC24\uC774\uC57C\uB9D0\uB85C \uC9C4\uC9DC \uC138\uC0C1\uC774\uC9C0.
      \uBE5B\uC740\u2026 \uB108\uBB34 \uC194\uC9C1\uD574\uC11C \uC7AC\uBBF8\uC5C6\uAC70\uB4E0."
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAE30\uB2E4\uB838\uB2E4\uACE0? \uB204, \uB204\uAC00! \uADF8\uB0E5 \uCC3D\uBB38
      \uBC16\uC744 \uBCF4\uACE0 \uC788\uC5C8\uC744 \uBFD0\uC774\uC57C!"
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB610 \uC654\uAD6C\uB098? \uD765, \uC2EC\uC2EC\uD558\uB358 \uCC38\uC740
      \uC544\uB2C8\uC5C8\uC5B4. \u2026\uC870\uAE08 \uC2EC\uC2EC\uD588\uC9C0\uB9CC."
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC218\uBC31 \uB144 \uB3D9\uC548 \uBAA8\uB450\uAC00 \uB5A0\uB0AC\uC5B4.
      \uB098\uB9CC \uB299\uC9C0\uB3C4 \uC54A\uACE0\u2026 \uD765, \uC775\uC219\uD574."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBC24\uC774\uC57C\uB9D0\uB85C \uC9C4\uC9DC \uC138\uC0C1\uC774\uC9C0.
      \uBE5B\uC740 \uB108\uBB34 \uC194\uC9C1\uD574\uC11C \uC7AC\uBBF8\uC5C6\uAC70\uB4E0."
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108\uB294 \uB098\uB97C \uBB34\uC11C\uC6CC\uD558\uC9C0 \uC54A\uC9C0?
      \u2026\uADF8 \uC810\uB9CC\uC740 \uCE6D\uCC2C\uD574 \uC8FC\uC9C0."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD765, \uB124\uAC00 \uAC10\uD788 \uC774 \uB9B4\uB9AC\uCE74 \uB2D8\uAED8
      \uCEE4\uD53C\uB97C \uB300\uC811\uD55C\uB2E4\uACE0? \uAD18\u2026 \uAD1C\uCC2E\uB124."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC73C\uC73C\u2026 \uB124\uAC00 \uC5C6\uC73C\uBA74, \uBC24\uC774 \uB108\uBB34
      \uC870\uC6A9\uD574\uC11C \uC2EB\uB2E8 \uB9D0\uC774\uC57C."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108\uB77C\uBA74\u2026 \uB9DD\uD1A0 \uC548\uC73C\uB85C \uCD08\uB300\uD574\uC904
      \uC218\uB3C4 \uC788\uC744\uC9C0\uB3C4 \uBAB0\uB77C."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108, \uB0AE\uC5D0\uB3C4 \uB3CC\uC544\uB2E4\uB2D0 \uC218 \uC788\uC9C0?
      \uD765\u2026 \uC870\uAE08 \uBD80\uB7FD\uB124."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uB530\uC704\uAC00 \uC774 \uB9B4\uB9AC\uCE74 \uB2D8 \uC55E\uC5D0
      \uC11C\uB3C4 \uB418\uB294 \uAC70\uC57C?"
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108\uC640 \uD568\uAED8\uB77C\uBA74\u2026 \uB0AE\uC5D0\uB3C4 \uB098\uAC00\uBCFC
      \uC218 \uC788\uC744 \uAC83 \uAC19\uC544. \uADF8\uB7EC\uB2C8\uAE4C\u2014\uC190,
      \uB0B4\uBC00\uC5B4\uBD10."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744\uBC24\uC740 \uAE38\uACE0 \uC11C\uB298\uD574\uC11C \uC88B\uC544.
      \uC774 \uB9B4\uB9AC\uCE74 \uB2D8\uC758 \uACC4\uC808\uC774\uC9C0."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04 \uD587\uC0B4\uC740 \uB108\uBB34 \uBC1D\uC544. \uC591\uC0B0 \uC5C6\uC774\uB294
      \uD55C \uBC1C\uC9DD\uB3C4 \uBABB \uB098\uAC00!"
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984\uC740 \uCD5C\uC545\uC774\uC57C. \uD574\uAC00 \uB108\uBB34
      \uAE38\uC5B4\uC11C \uBC24\uC774 \uC9E7\uC796\uC544!"
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8\uBC24\uC774 \uC81C\uC77C \uC88B\uC544. \uB208 \uC704\uC758
      \uB2EC\uBE5B\uC740 \uBCF4\uC11D \uAC19\uAC70\uB4E0."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44 \uC624\uB294 \uB0A0\uC740 \uD587\uBE5B\uC774 \uC5C6\uC5B4\uC11C
      \uC88B\uC544! \uC624\uB298\uC740 \uBC16\uC5D0 \uB098\uAC00 \uBCFC\uAE4C?"
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC774\uB2E4! \u2026\uD765, \uB4E4\uB72C \uAC70 \uC544\uB2C8\uC57C.
      \uADF8\uB0E5 \uBC18\uC9DD\uC5EC\uC11C \uBCF4\uB294 \uAC70\uC57C."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uCC9C\uB465 \uB530\uC704 \uBB34\uC12D\uC9C0 \uC54A\uC544! \u2026\uCC3D\uBB38\uC740
      \uC880 \uB2EB\uC544 \uC904\uB798?"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uBB3C\uC774\uB77C\uB2C8! \uC131\uC218\uB77C\uB3C4 \uC11E\uC600\uC73C\uBA74
      \uC5B4\uCA4C\uB824\uACE0! \uCE58\uC6CC!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\u2026\uC774\uAC8C \uBB50\uC57C? \uBB50, \uBC84\uB9AC\uC9C4 \uC54A\uC744\uAC8C."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uB538\uAE30! \uD6C4\uD6D7, \uC774 \uB9B4\uB9AC\uCE74 \uB2D8\uC758 \uCDE8\uD5A5\uC744
      \uC798 \uC544\uB294\uAD6C\uB098. \uCE6D\uCC2C\uD574 \uC8FC\uC9C0!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uB2EC\uCF64\uD55C \uAC70\uB124? \uD765, \uBC1B\uC544 \uC8FC\uC9C0. \uD2B9\uBCC4\uD788."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uC0DD\uC77C\uC744 \uAE30\uC5B5\uD588\uC5B4? \u2026\uBA87\uBC31
      \uB144 \uB9CC\uC774\uC57C. \uD765, \uC6B8\uACE0 \uC788\uB294 \uAC70 \uC544\uB2C8\uC57C!"
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4\uAC00 \uC774\uB807\uAC8C \uC6C3\uC740 \uAC8C \uC5B8\uC81C\uC600\uB354\uB77C\u2026
      \uC544\uB9C8, \uB124\uAC00 \uCC98\uC74C\uC77C\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC5B4."
