%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_LanHua
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_lanhua
  dailyTalkLimit: 1
  expressionTags:
  - "\uC9C4\uC911"
  - "\uC790\uC2E0\uAC10"
  - "\uC218\uC90D\uC74C"
  - "\uACB0\uC758"
  - "\uB530\uB73B\uD55C \uBBF8\uC18C"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uCC98\uC74C \uBCF4\uB294 \uC5BC\uAD74\uC774\uB124\uC694. \uC798 \uBD80\uD0C1\uD574\uC694."
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC218\uB828\uC744 \uB9C8\uCCE4\uB098? \uADF8\uB807\uB2E4\uBA74 \uC774\uC81C,
      \uC9C4\uC9DC \uC2F8\uC6C0\uC744 \uBC30\uC6CC\uB77C."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD798\uC774\uB780 \uB204\uAD70\uAC00\uB97C \uC9C0\uD0A4\uAE30 \uC704\uD574
      \uC874\uC7AC\uD55C\uB2E4. \uADF8\uB807\uC9C0 \uC54A\uB2E4\uBA74 \uB2E8\uC9C0
      \uD3ED\uB825\uC77C \uBFD0\uC774\uB2E4."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBAB8\uC774 \uC57D\uD558\uBA74 \uB9C8\uC74C\uB3C4 \uC57D\uD574\uC9C4\uB2E4.
      \uB2E4\uC2DC \uC640\uB77C."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uB208\uBE5B\u2026 \uC2F8\uC6C0\uAFBC\uC758 \uAE30\uC6B4\uC774
      \uC544\uB2C8\uAD70. \uD765\uBBF8\uB86D\uB2E4."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uD55C \uBC29\uC5D0\uB294 \uC9C4\uC2EC\uC774 \uB2F4\uACA8 \uC788\uAD70.
      \uB098\uB3C4 \uADF8\uAC78 \uBC30\uC6E0\uB2E4."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAC19\uC774 \uC218\uB828\uD558\uBA74 \uB9C8\uC74C\uC774 \uACE0\uC694\uD574\uC838.
      \uC774\uC0C1\uD558\uC9C0?"
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB10C \uB0B4 \uC8FC\uBA39\uBCF4\uB2E4 \uAC15\uD574. \uC65C\uB0D0\uBA74,
      \uB0B4 \uC2EC\uC7A5\uC744 \uBA48\uCD94\uAC8C \uD558\uB2C8\uAE4C."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uCD94\uC6CC\uC694. \uB530\uB73B\uD558\uAC8C \uC785\uACE0 \uB2E4\uB2C8\uC138\uC694."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uBC14\uB78C\uC774 \uC120\uC120\uD574\uC84C\uC5B4\uC694. \uC218\uD655\uC740
      \uC798 \uB418\uACE0 \uC788\uB098\uC694?"
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uD587\uBCD5\uC774 \uB728\uAC70\uC6CC\uC694. \uADF8\uB298\uC5D0\uC11C
      \uC26C\uC5B4 \uAC00\uC138\uC694."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uC774 \uC654\uB124\uC694. \uC12C\uC774 \uC870\uAE08\uC529 \uCD08\uB85D\uBE5B\uC73C\uB85C
      \uBC14\uB00C\uACE0 \uC788\uC5B4\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44\uAC00 \uC624\uB124\uC694. \uC624\uB298\uC740 \uC870\uAE08 \uC26C\uC5B4
      \uAC00\uB3C4 \uAD1C\uCC2E\uC544\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC774 \uC640\uC694. \uBC1C\uBC11 \uC870\uC2EC\uD558\uC138\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uD3ED\uD48D\uC774\uC5D0\uC694. \uC624\uB298\uC740 \uC548\uC5D0 \uC788\uB294
      \uAC8C \uC88B\uACA0\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uC774\uAC74 \uC815\uB9D0 \uC88B\uC544\uD558\uB294 \uAC70\uC608\uC694!
      \uACE0\uB9C8\uC6CC\uC694!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uACE0\uB9C8\uC6CC\uC694. \uC798 \uC4F8\uAC8C\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uACE0\uB9C8\uC6CC\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uC74C\u2026 \uC774\uAC74 \uC81C \uCDE8\uD5A5\uC740 \uC544\uB2C8\uC5D0\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC0DD\uC77C\uC744 \uAE30\uC5B5\uD574 \uC92C\uAD70\uC694. \uC815\uB9D0
      \uAE30\uBED0\uC694!"
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108\uC640 \uC2F8\uC6B0\uBA74\u2026 \uB0B4 \uC548\uC758 \uD63C\uB780\uC774
      \uC0AC\uB77C\uC838. \uB10C, \uB0B4 \uD3C9\uC628\uC758 \uC0C1\uB300\uC57C."
