%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Liriel
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_liriel
  dailyTalkLimit: 1
  expressionTags:
  - "\uC6C3\uC74C"
  - "\uB180\uB78C"
  - "\uC2AC\uD514"
  - "\uD22C\uC815"
  - "\u2728 \uAE30\uC068"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC640, \uC0AC\uB78C\uC774\uB2E4! \uB098\uB294 \uB9AC\uB9AC\uC5D8, \uC774
      \uC232\uC758 \uBE5B\uC744 \uC9C0\uD0A4\uB294 \uC694\uC815\uC774\uC57C! \uB098\uC05C
      \uC9D3 \uD558\uBA74 \uAC04\uC9C0\uB7FC \uD0DC\uC6B8 \uAC70\uC57C!"
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC548\uB155! \uC624\uB298\uC740 \uC232\uC758 \uD5A5\uAE30\uAC00 \uAE30\uBD84
      \uC88B\uB124~"
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124\uAC00 \uC624\uBA74 \uB0A0\uAC1C\uAC00 \uBC18\uC9DD\uBC18\uC9DD\uD574!
      \uBD10, \uC9C0\uAE08\uB3C4 \uADF8\uB807\uC9C0!"
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB610 \uC654\uC9C0! \uC624\uB298\uC740 \uC232\uC5D0\uC11C \uBB50 \uCC3E\uC558\uC5B4?"
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC608\uC804\uC5D4 \uC694\uC815\uC774 \uC5C4\uCCAD \uB9CE\uC558\uC5B4.
      \uC9C0\uAE08\uC740\u2026 \uB098\uB791 \uBC84\uC12F\uB4E4\uBFD0\uC774\uC57C."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBC84\uC12F \uACE0\uB9AC \uC548\uC5D0 \uB4E4\uC5B4\uAC00\uBA74 \uC548
      \uB3FC! \uC694\uC815\uB4E4 \uBB34\uB3C4\uD68C\uC7A5\uC774\uAC70\uB4E0!"
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC232\uC774 \uB2E4\uCE58\uBA74 \uB098\uB3C4 \uC544\uD30C. \uADF8\uB7EC\uB2C8\uAE4C
      \uB108\uB3C4 \uB098\uBB34 \uD568\uBD80\uB85C \uBCA0\uBA74 \uC548 \uB3FC, \uC57D\uC18D\uD55C
      \uAC70\uC57C!"
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC0AC\uB78C\uB4E4\uC740 \uAC00\uB054 \uBE5B\uC744 \uC78A\uC5B4\uBC84\uB824.
      \uADF8\uB798\uC11C \uB0B4\uAC00 \uB300\uC2E0 \uBC18\uC9DD\uAC70\uB824 \uC8FC\uB294
      \uAC70\uC57C."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC788\uC9C0, \uB124 \uACC1\uC740 \uD3EC\uADFC\uD574\uC11C \uC790\uAFB8
      \uBA38\uBB3C\uACE0 \uC2F6\uC5B4\uC838."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC81C \uBBFF\uC744 \uC218 \uC788\uACA0\uC5B4. \uB124 \uB355\uBD84\uC5D0
      \uC232\uC774 \uC6C3\uACE0 \uC788\uAC70\uB4E0."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108\uD55C\uD14C\uC11C \uC774\uC0C1\uD55C \uBE5B\uC774 \uBCF4\uC5EC!
      \uBC18\uC9DD\uBC18\uC9DD!"
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC778\uAC04? \uC232\uC5D0\uC120 \uC870\uC6A9\uD788 \uD574\uC57C \uD574!"
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124\uAC00 \uC6C3\uC744 \uB54C\uB9C8\uB2E4, \uB0B4 \uB0A0\uAC1C\uAC00
      \uC2A4\uC2A4\uB85C \uBE5B\uB098. \uC774\uAC74\u2026 \uC0AC\uB791\uC774\uC57C,
      \uB9DE\uC9C0?"
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744 \uB099\uC5FD\uC740 \uC694\uC815 \uCE68\uB300\uC57C! \uD3ED\uC2E0\uD3ED\uC2E0\uD558\uAC70\uB4E0!"
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uC774\uB2E4! \uAF43\uB4E4 \uAE68\uC6B0\uB290\uB77C \uC5C4\uCCAD
      \uBC14\uBE60! \uB108\uB3C4 \uB3C4\uC640\uC904 \uAC70\uC9C0!"
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984\uC5D4 \uBC18\uB527\uBD88\uC774\uB791 \uACBD\uC8FC\uD574!
      \uB0B4\uAC00 \uB298 \uC774\uACBC\uC9C0!"
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8\uC5D4 \uB0A0\uAC1C\uAC00 \uC5BC\uC5B4\u2026 \uBC84\uC12F
      \uC9D1\uC5D0\uC11C \uAF2D \uBD99\uC5B4 \uC788\uC744 \uAC70\uC57C."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE57\uBC29\uC6B8 \uD558\uB098\uD558\uB098\uC5D0 \uBE5B\uC774 \uB4E4\uC5B4
      \uC788\uC5B4! \uC138\uC5B4 \uBCF4\uC790!"
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC1A1\uC774 \uD0C0\uACE0 \uB0A0\uC544 \uBCFC\uB798! \u2026\uC548
      \uB418\uB294\uAD6C\uB098."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uCC9C\uB465 \uBB34\uC11C\uC6B4 \uAC70 \uC544\uB2C8\uC57C! \uADF8\uB0E5\u2026
      \uC870\uAE08 \uAC00\uAE4C\uC774 \uC788\uC744 \uAC70\uC57C!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uC1E0 \uB0C4\uC0C8\u2026 \uB098\uBB34\uB4E4\uC774 \uBB34\uC11C\uC6CC\uD574.
      \uCE58\uC6CC \uC918!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC74C, \uC774\uAC74 \uBB50\uC5D0 \uC4F0\uB294 \uAC70\uC57C? \uAD81\uAE08\uD574!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uC5F4\uB9E4\uB2E4! \uB2EC\uCF64\uD55C \uAC70 \uC81C\uC77C \uC88B\uC544!
      \uB108 \uCD5C\uACE0\uC57C!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uACE0\uB9C8\uC6CC! \uC232 \uCE5C\uAD6C\uB4E4\uC774\uB791 \uB098\uB220
      \uBA39\uC744 \uAC70\uC57C!"
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uC0DD\uC77C \uAE30\uC5B5\uD588\uC5B4?! \uC624\uB298\uC740 \uC232
      \uC804\uCCB4\uC5D0 \uBE5B \uCD95\uC81C \uC5F4 \uAC70\uC57C! \uB108\uB3C4 \uC640\uC57C
      \uD574!"
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124\uAC00 \uB0B4 \uACC1\uC5D0 \uC788\uC73C\uBA74, \uC232\uC758 \uC18C\uB9AC\uAC00
      \uB354 \uB9D1\uAC8C \uB4E4\uB824. \uC774\uC0C1\uD558\uC9C0?"
