%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Censia
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_censia
  dailyTalkLimit: 1
  expressionTags:
  - "\uC9C4\uC911"
  - "\uBBF8\uC18C"
  - "\uACB0\uC758"
  - "\uC9C8\uC8FC"
  - "\uC218\uC90D\uC74C"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uCF04\uC2DC\uC544\uB2E4. \uC774 \uC12C\uC758 \uC9D0\uACFC \uAE38\uC740
      \uB0B4\uAC00 \uB9E1\uACE0 \uC788\uC9C0. \uC62E\uAE38 \uAC8C \uC788\uC73C\uBA74
      \uB9D0\uD574. \uB2E8, \uC548\uC804\uD55C \uAE38\uB85C\uB9CC \uAC04\uB2E4."
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC9D0\uC740 \uB0B4\uAC00 \uC62E\uAE30\uC9C0. \uAE38\uB9CC \uC815\uD574."
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAE30\uB2E4\uB838\uB2E4. \uB124 \uBAAB\uC758 \uBB3C\uC740 \uB530\uB85C
      \uCC59\uACA8 \uB480\uC5B4."
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC654\uAD70. \uC624\uB298 \uC9D0\uC740 \uAC00\uBCCD\uB098? \uBC1C\uAC78\uC74C\uC774
      \uAC00\uBCBC\uC6CC \uBCF4\uC5EC."
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC608\uC804\uC5D0 \uC6B4\uC1A1 \uC911\uC5D0 \uB3D9\uB8CC\uB97C \uC783\uC5C8\uB2E4.
      \uADF8 \uB4A4\uB85C\uB294 \uAE38\uC744 \uBA3C\uC800 \uAC78\uC5B4 \uBCF4\uACE0
      \uC9D0\uC744 \uC2E3\uC9C0."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBE60\uB978 \uAE38\uBCF4\uB2E4 \uC548\uC804\uD55C \uAE38\uC774 \uC911\uC694\uD574.
      \uB2A6\uAC8C \uB3C4\uCC29\uD558\uB294 \uAC74 \uAD1C\uCC2E\uC9C0\uB9CC, \uBABB
      \uB3C4\uCC29\uD558\uB294 \uAC74 \uC548 \uB3FC."
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124\uAC00 \uAC00\uB294 \uAE38\uC774\uB77C\uBA74, \uB0B4\uAC00 \uBA3C\uC800
      \uBC1F\uC544 \uB450\uC9C0."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBE60\uB978 \uAE38\uBCF4\uB2E4 \uC548\uC804\uD55C \uAE38\uC774 \uC911\uC694\uD574."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uACC1\uC774 \uD3B8\uD574\uC84C\uC5B4."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uBC88 \uC77C\uC740 \uD568\uAED8\uD558\uC790."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC870\uAE08\uC740 \uD765\uBBF8\uB86D\uB124."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC544\uC9C1 \uB110 \uBBFF\uC9C4 \uC54A\uC544."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC81C \uB0B4 \uBAA9\uD45C\uC5D0\uB294 \uB124\uAC00 \uC788\uC5B4."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744\uC740 \uC218\uD655\uBB3C \uC6B4\uC1A1\uCCA0\uC774\uC57C.
      \uC81C\uC77C \uBC14\uC05C \uACC4\uC808\uC774\uC9C0."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uC5D0\uB294 \uD480\uC774 \uC88B\uC544. \uB098\uB3C4 \uAE30\uC6B4\uC774
      \uB09C\uB2E4."
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984 \uC0AC\uB9C9\uC740 \uB0AE\uC5D0 \uC6C0\uC9C1\uC774\uBA74
      \uC548 \uB3FC. \uC0C8\uBCBD\uACFC \uC800\uB141\uC774 \uC6B4\uC1A1 \uC2DC\uAC04\uC774\uB2E4."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8 \uAE38\uC740 \uC5BC\uC5B4 \uC788\uC5B4. \uBC1C\uAD7D\uC5D0
      \uD5DD\uAC8A\uC744 \uAC10\uACE0 \uB2E4\uB2CC\uB2E4."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44 \uC624\uBA74 \uBAA8\uB798\uAC00 \uBB34\uAC70\uC6CC\uC9C4\uB2E4.
      \uC9D0\uC744 \uBC18\uC73C\uB85C \uC904\uC5EC."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uC0AC\uB9C9\uC5D0 \uB208\uC774\uB77C\uB2C8\u2026 \uAE38 \uD45C\uC2DC\uBD80\uD130
      \uB2E4\uC2DC \uD574\uC57C\uACA0\uAD70."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uD3ED\uD48D\uC5D4 \uAE30\uB2E4\uB9AC\uB294 \uAC8C \uB2F5\uC774\uB2E4.
      \uB9C8\uAD6C\uAC04 \uC548\uC5D0\uC11C \uC26C\uC5B4."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uB3CC\uC740 \uC774\uBBF8 \uCDA9\uBD84\uD788 \uB098\uB974\uACE0 \uC788\uC5B4.
      \uC0AC\uC591\uD558\uC9C0."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC74C, \uBB34\uAC8C\uB294 \uC801\uB2F9\uD558\uB124."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uC0AC\uB8CC\uB85C\uAD70! \u2026\uACE1\uBB3C\uC740 \uC5B8\uC81C\uB098
      \uBC18\uAC00\uC6CC. \uACE0\uB9D9\uB2E4."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uC88B\uC740 \uC120\uBB3C\uC774\uC57C. \uC9D0\uC5D0 \uB123\uC5B4 \uB450\uC9C0."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC0DD\uC77C\uC744 \uCC59\uACA8 \uC8FC\uB2E4\uB2C8\u2026 \uBC1C\uAD7D\uC774
      \uC800\uC808\uB85C \uBC15\uC790\uB97C \uD0C0\uB294\uAD70. \uACE0\uB9D9\uB2E4."
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uBC88 \uAE38\uC758 \uB05D\uAE4C\uC9C0 \uD568\uAED8 \uAC00\uC790."
