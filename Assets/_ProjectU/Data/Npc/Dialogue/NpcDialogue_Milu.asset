%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Milu
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_milu
  dailyTalkLimit: 1
  expressionTags:
  - "\uBBF8\uC18C"
  - "\uD638\uAE30\uC2EC"
  - "\uB179\uB294 \uB208\uBB3C"
  - "\uC0AC\uB791"
  - "\uAC10\uC815 \uD3ED\uBC1C (\uC0C9 \uBCC0\uD654)"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD5E4\uC5D0~? \uCC98\uC74C \uBCF4\uB294 \uC0AC\uB78C\uC774\uB2E4~ \uB09C
      \uBBF8\uB8E8! \uC2AC\uB77C\uC784\uC774\uC57C~ \uB9CC\uC838 \uBD10\uB3C4 \uB3FC,
      \uC870\uAE08 \uCC28\uAC00\uC6CC~"
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBBF8\uB8E8\uC608\uC694~ \uC624\uB298\uB3C4 \uCD9C\uB801\uCD9C\uB801,
      \uAE30\uBD84 \uC88B\uC740 \uD558\uB8E8~!"
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108 \uC624\uBA74 \uBAB8\uC774 \uB9D0\uB791\uB9D0\uB791\uD574\uC838~
      \uC774\uC0C1\uD558\uC9C0~?"
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC654\uB2E4~! \uC624\uB298\uC740 \uBB34\uC2A8 \uB180\uC774 \uD560\uAE4C~?"
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC0AC\uB78C\uB4E4\uC740 \uC65C \uB9E4\uC77C \uAC19\uC740 \uBAA8\uC591\uC774\uC57C~?
      \uB09C \uAE30\uBD84 \uB530\uB77C \uBC14\uB00C\uB294\uB370~"
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC2B5\uC9C0 \uBB3C\uC740 \uBBF8\uB044\uB369\uD574\uC11C \uC88B\uC544~
      \uBAB8\uC774 \uCB49\uCB49 \uB298\uC5B4\uB098\uAC70\uB4E0~"
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC608\uC804\uC5D0 \uBCD1 \uC18D\uC5D0 \uAC07\uD600 \uC788\uC5C8\uC5B4\u2026
      \uADF8\uB54C \uC0DD\uAC01\uD558\uBA74 \uBAB8\uC774 \uD750\uB824\uC838~ \uADF8\uB798\uB3C4
      \uC9C0\uAE08\uC740 \uAD1C\uCC2E\uC544~"
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC751? \uB098 \uB9CC\uC9C0\uBA74 \uC190 \uC816\uC5B4\uC694~ \uADF8\uB798\uB3C4
      \uAD1C\uCC2E\uC544?"
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD639\uC2DC \uB098\uB3C4\u2026 \uB108\uCC98\uB7FC \uB9C8\uC74C\uC774\uB77C\uB294
      \uAC8C \uC0DD\uAE34 \uAC78\uAE4C?"
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108\uB791 \uC788\uC73C\uBA74 \uBAB8\uC774 \uB530\uB73B\uD574\uC838\u2026
      \uC774\uC0C1\uD574~"
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD5E4\uC5D0~ \uC778\uAC04 \uD53C\uBD80\uB294 \uC774\uB807\uAC8C \uB2E8\uB2E8\uD558\uAD6C\uB098~"
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108\uB294\u2026 \uC0AC\uB78C? \uC544\uB2C8\uBA74 \uC2E4\uD5D8\uAC00?"
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108\uB97C \uAC10\uC2F8\uB294 \uC774 \uB290\uB08C\uC774 \uC88B\uC544\u2026
      \uB0B4 \uC548\uC5D0 \uB4E4\uC5B4\uC62C\uB798?"
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744 \uC5F4\uB9E4\uB294 \uD0F1\uAE00\uD0F1\uAE00~ \uB098\uB791
      \uB2EE\uC558\uC5B4~"
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uBE44 \uB9DB\uC740 \uB2EC\uB2EC\uD574~ \uAF43\uC78E\uC774 \uB179\uC544
      \uC788\uC5B4\uC11C \uADF8\uB7F0\uAC00~?"
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uB354\uC6B0\uBA74 \uBAB8\uC774 \uC904\uC5B4\uB4E4\uC5B4~ \uC5F0\uBABB\uC5D0
      \uD48D\uB369 \uD558\uACE0 \uC2F6\uB2E4~"
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uCD94\uC6B0\uBA74 \uBAB8\uC774 \uAD73\uC5B4\uC11C \uB9D0\uC774 \uB290\uB824\uC838~~
      \uC73C\uC73C\uC74C~"
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44\uB2E4~! \uBE44\uAC00 \uC81C\uC77C \uC88B\uC544~ \uBAB8\uC774 \uCEE4\uC9C0\uB294
      \uAE30\uBD84\uC774\uC57C~"
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC740 \uCC28\uAC00\uC6B4\uB370 \uD3ED\uC2E0\uD574~ \uBA39\uC5B4
      \uBD10\uB3C4 \uB3FC~?"
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uBC88\uAC1C \uBB34\uC11C\uC6CC~ \uC6C5\uB369\uC774 \uC18D\uC5D0 \uC3D9
      \uC228\uC744\uB798~"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uC774\uAC74 \uB108\uBB34 \uBC14\uC0AD\uBC14\uC0AD\uD574~ \uBAB8\uC774
      \uB9D0\uB77C \uBC84\uB9B4 \uAC83 \uAC19\uC544~"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC73C\uC73C\uC74C~ \uC774\uAC74 \uBB50\uC5D0 \uC4F0\uB294 \uAC70\uC57C~?"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uC6B0\uC640\uC544~! \uC774\uAC70 \uB098 \uC8FC\uB294 \uAC70\uC57C~? \uBAB8\uC774
      \uBD84\uD64D\uC0C9\uC774 \uB410\uC5B4~ \uAE30\uBED0\uC11C \uADF8\uB798~"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uD5E4\uD5E4~ \uACE0\uB9C8\uC6CC~ \uBAB8\uC18D\uC5D0 \uB123\uC5B4 \uB458\uAC8C~"
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uC0DD\uC77C~? \uB09C \uC5B8\uC81C \uD0DC\uC5B4\uB0AC\uB294\uC9C0
      \uBAB0\uB790\uB294\uB370~ \uB124\uAC00 \uCC59\uACA8 \uC900 \uB0A0\uC774 \uB0B4
      \uC0DD\uC77C\uC774\uC57C~!"
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0\uC774 \uB0B4 \uC190\uC744 \uC7A1\uC558\uC744 \uB54C, \uCC98\uC74C\uC73C\uB85C
      \uC2EC\uC7A5\uC774 \uC0DD\uAE34 \uAC83 \uAC19\uC558\uC5B4."
