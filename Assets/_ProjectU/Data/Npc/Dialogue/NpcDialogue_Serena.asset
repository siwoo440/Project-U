%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Serena
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_serena
  dailyTalkLimit: 1
  expressionTags:
  - "\uD3C9\uC628"
  - "\uC218\uC90D\uC74C"
  - "\uD68C\uC0C1"
  - "\uACE0\uD1B5"
  - "\uFE0F \uC548\uB3C4"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\u2026\uC544, \uB180\uB77C\uAC8C \uD588\uB098\uC694. \uC800\uB294 \uC138\uB808\uB098.
      \uC774 \uB3C4\uC11C\uAD00\uC758 \uB9C8\uC9C0\uB9C9 \uD398\uC774\uC9C0\uB97C\u2026
      \uC9C0\uD0A4\uACE0 \uC788\uC5B4\uC694."
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC870\uC6A9\uD788\u2026 \uB4E4\uC5B4\uC624\uC138\uC694. \uC774\uACF3\uC740
      \uC544\uC9C1 \uC774\uC57C\uAE30\uAC00 \uC228 \uC26C\uACE0 \uC788\uB2F5\uB2C8\uB2E4."
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0 \uBC1C\uC18C\uB9AC\uB294\u2026 \uC774\uC81C \uC54C\uC544\uC694.
      \uCC45\uC7A5 \uC0AC\uC774\uB85C\uB3C4 \uB4E4\uB824\uC694."
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB610 \uC624\uC168\uB124\uC694. \uC624\uB298\uC740\u2026 \uC5B4\uB5A4
      \uC774\uC57C\uAE30\uB97C \uAC00\uC838\uC654\uB098\uC694."
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC81C \uBAB8\uC774 \uC870\uAE08\uC529 \uD750\uB824\uC838\uC694. \uADF8\uB798\uC11C
      \uC624\uB298 \uC77C\uC744\u2026 \uAF2D \uC801\uC5B4 \uB46C\uC694."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uCC45\uC740 \uC78A\uD600\uC838\uB3C4 \uBA3C\uC9C0\uB294 \uAE30\uC5B5\uD574\uC694.
      \uB204\uAC00 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uD3BC\uCCE4\uB294\uC9C0."
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB9C8\uC9C0\uB9C9 \uC2DC\uB97C \uC644\uC131\uD558\uACE0 \uC2F6\uC5B4\uC694.
      \uADF8 \uC2DC\uC5D0\u2026 \uB2F9\uC2E0 \uC774\uB984\uC774 \uB4E4\uC5B4\uAC00\uB3C4
      \uB420\uAE4C\uC694."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uCC45\uC774\uB780 \uAC74, \uB204\uAD70\uAC00\uC758 \uAE30\uC5B5\uC774\uC5D0\uC694.
      \uADF8\uB798\uC11C \uC800\uB294 \uADF8\uAC78 \uC78A\uC744 \uC218 \uC5C6\uC5B4\uC694."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC820 \uD63C\uC790 \uC77D\uC9C0 \uC54A\uC544\uB3C4 \uB418\uB124\uC694\u2026
      \uACE0\uB9C8\uC6CC\uC694."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0\uC774 \uC624\uB294 \uBC1C\uC18C\uB9AC, \uC774 \uB3C4\uC11C\uAD00\uC758
      \uACF5\uAE30\uC640 \uC5B4\uC6B8\uB824\uC694."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0\uC758 \uAE30\uC5B5\uC5D0\uB294 \uC5B4\uB5A4 \uC774\uC57C\uAE30\uAC00
      \uC788\uB098\uC694?"
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uCC45\uC744 \uB9DD\uAC00\uB728\uB9AC\uC9C0 \uB9C8\uC138\uC694\u2026 \uADF8\uAC74
      \uC81C \uC77C\uBD80\uC608\uC694."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0\uC774 \uB0B4 \uB9C8\uC9C0\uB9C9 \uC2DC\uC758 \uB9C8\uC9C0\uB9C9
      \uD589\uC774 \uB418\uC5B4\uC92C\uC73C\uBA74 \uD574\uC694."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uB099\uC5FD\uC740 \uB098\uBB34\uAC00 \uC4F4 \uD3B8\uC9C0 \uAC19\uC544\uC694.
      \uD55C \uC7A5\uC529\u2026 \uC77D\uC5B4 \uBCF4\uACE0 \uC2F6\uC5B4\uC694."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uBC14\uB78C\uC774 \uCC45\uC7A5\uC744 \uB118\uACA8\uC694. \uC81C\uAC00
      \uB118\uAE30\uC9C0 \uC54A\uC544\uB3C4."
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984 \uD587\uBE5B\uC740\u2026 \uC870\uAE08 \uBB34\uC11C\uC6CC\uC694.
      \uC800\uB97C \uC9C0\uC6CC \uBC84\uB9B4 \uAC83 \uAC19\uC544\uC11C."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8\uBC24\uC740 \uAE38\uC5B4\uC11C \uC88B\uC544\uC694. \uCD1B\uBD88
      \uD558\uB098\uB85C \uD55C \uAD8C\uC744 \uB2E4 \uC77D\uC744 \uC218 \uC788\uC5B4\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE57\uC18C\uB9AC\uB294\u2026 \uB204\uAD70\uAC00 \uC870\uC6A9\uD788 \uCC45\uC744
      \uC77D\uB294 \uC18C\uB9AC \uAC19\uC544\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC774 \uC624\uBA74 \uBC1C\uC790\uAD6D\uC774 \uB0A8\uC8E0. \uC800\uB294\u2026
      \uB0A8\uC9C0 \uC54A\uC9C0\uB9CC."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uD3ED\uD48D\uC774 \uCE58\uBA74 \uCC45\uC7A5\uC774 \uD754\uB4E4\uB824\uC694.
      \uC624\uB298\uC740\u2026 \uACC1\uC5D0 \uC788\uC5B4 \uC904\uB798\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uCFF5\uCFF5\uAC70\uB9AC\uB294 \uB3C4\uAD6C\uB294\u2026 \uCC45\uB4E4\uC774
      \uB180\uB77C\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\u2026\uACE0\uB9C8\uC6CC\uC694. \uC5B4\uB514\uC5D0 \uB458\uC9C0 \uCC9C\uCC9C\uD788
      \uC0DD\uAC01\uD574 \uBCFC\uAC8C\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uB530\uB73B\uD55C \uCC28\u2026 \uC190\uC5D0 \uC958 \uC218\uB294 \uC5C6\uC5B4\uB3C4,
      \uD5A5\uC740 \uB290\uAEF4\uC838\uC694. \uACE0\uB9C8\uC6CC\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uB2E4\uC815\uD55C \uC120\uBB3C\uC774\uB124\uC694. \uC624\uB298 \uC77C\uAE30\uC5D0
      \uC801\uC5B4 \uB458\uAC8C\uC694."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC0DD\uC77C\u2026 \uC800\uC5D0\uAC8C\uB3C4 \uC788\uC5C8\uAD70\uC694.
      \uAE30\uC5B5\uD574 \uC900 \uC0AC\uB78C\uC774 \uC788\uC73C\uB2C8, \uC624\uB298\uC740
      \uC870\uAE08 \uB354 \uC120\uBA85\uD574\uC9C8 \uAC83 \uAC19\uC544\uC694."
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC81C\uB294 \uC81C \uC774\uC57C\uAE30\uB97C \uB4E4\uC5B4\uC904
      \uC0AC\uB78C\uC774 \uC0DD\uACBC\uB124\uC694. \uC624\uB798\uB41C \uD398\uC774\uC9C0\uB3C4
      \uB2E4\uC2DC \uC0B4\uC544\uB098\uB294 \uAE30\uBD84\uC774\uC5D0\uC694."
