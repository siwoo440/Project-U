%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Noctia
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_noctia
  dailyTalkLimit: 1
  expressionTags:
  - "\uB0C9\uC815"
  - "\uACE0\uC694"
  - "\uC218\uC90D\uC74C"
  - "\uD68C\uC0C1"
  - "\uC608\uC5B8 \uC911"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\u2026\uAE4C\uB9C8\uADC0\uB4E4\uC774 \uC624\uB298 \uC190\uB2D8\uC774 \uC628\uB2E4\uACE0
      \uD558\uB354\uAD70\uC694. \uB098\uB294 \uB178\uD06C\uD2F0\uC544. \uC232\uC758
      \uB9C8\uB140\uB77C\uACE0 \uBD88\uB9AC\uC9C0\uC694. \uB450\uB835\uB2E4\uBA74,
      \uC9C0\uAE08 \uB3CC\uC544\uAC00\uB3C4 \uAD1C\uCC2E\uC544\uC694."
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBC24\uC0C8 \uAE4C\uB9C8\uADC0\uAC00 \uB2F9\uC2E0 \uC774\uC57C\uAE30\uB97C
      \uD558\uB354\uAD70\uC694. \uC624\uB298\uC740 \uC5B4\uB5A4 \uC6B4\uBA85\uC744
      \uB370\uB824\uC654\uB098\uC694?"
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC5B4\uC694\u2026 \uC544\uB2C8,
      \uAE4C\uB9C8\uADC0\uAC00\uC694. \uD6C4\uD6C4, \uADF8\uB807\uB2E4\uACE0 \uD574
      \uB450\uC8E0."
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB610 \uC654\uAD70\uC694. \uAE4C\uB9C8\uADC0\uB4E4\uC774 \uB2F9\uC2E0
      \uBC1C\uC18C\uB9AC\uB97C \uAE30\uC5B5\uD558\uAE30 \uC2DC\uC791\uD588\uC5B4\uC694."
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC608\uC804\uC5D0 \uD55C \uB9C8\uC744\uC774 \uB0B4 \uC608\uC5B8\uC744
      \uBBFF\uC9C0 \uC54A\uC558\uC5B4\uC694. \uADF8\uB9AC\uACE0\u2026 \uB098\uB97C
      \uD0D3\uD588\uC9C0\uC694."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC608\uC5B8\uC740 \uC800\uC8FC\uAC00 \uC544\uB2C8\uC5D0\uC694. \uB2E4\uAC00\uC62C
      \uBE44\uB97C \uBA3C\uC800 \uC54C\uB824 \uC8FC\uB294 \uAD6C\uB984 \uAC19\uC740
      \uAC70\uC9C0\uC694."
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0 \uC55E\uC5D0\uC11C\uB294 \uC6B4\uBA85\uC744 \uC77D\uC9C0
      \uC54A\uAE30\uB85C \uD588\uC5B4\uC694. \uBAA8\uB974\uB294 \uCC44\uB85C \uAC77\uB294
      \uAC83\uB3C4 \uB098\uC058\uC9C0 \uC54A\uB124\uC694."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAE4C\uB9C8\uADC0\uB294 \uC8FD\uC740 \uC790\uC758 \uB9D0\uC744 \uB300\uC2E0\uD574\uC694.
      \uADF8\uB7EC\uB2C8 \uADF8\uB4E4\uC758 \uC6B8\uC74C\uC740\u2026 \uAE30\uC5B5\uC774\uC5D0\uC694."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uC608\uC5B8\uC5D4 \uB298 \uBE44\uADF9\uC774 \uC788\uC5C8\uC9C0\uB9CC,
      \uB2F9\uC2E0\uC740 \uC608\uC678\uC77C\uC9C0\uB3C4 \uBAB0\uB77C\uC694."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0\uACFC \uC788\uC73C\uBA74\u2026 \uAE4C\uB9C8\uADC0\uB4E4\uC774
      \uC7A0\uC7A0\uD574\uC838\uC694. \uC2E0\uAE30\uD558\uC8E0?"
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB10C \uB2E4\uB974\uAD70. \uB0B4 \uB208\uC744 \uD53C\uD558\uC9C0 \uC54A\uC544."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC778\uAC04\uC740 \uB298 \uB2F5\uC744 \uC6D0\uD558\uC9C0\uB9CC, \uADF8
      \uB2F5\uC744 \uB4E4\uC744 \uC6A9\uAE30\uB294 \uC5C6\uC9C0."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC81C \uC6B4\uBA85\uC740 \uB450\uB835\uC9C0 \uC54A\uC544\uC694.
      \uB2F9\uC2E0\uC774 \uB0B4 \uACC1\uC5D0 \uC788\uC73C\uB2C8\uAE4C."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744 \uB099\uC5FD\uC740 \uC608\uC5B8\uC11C \uAC19\uC544\uC694.
      \uB5A8\uC5B4\uC9C0\uB294 \uBAA8\uC591\uB9C8\uB2E4 \uB73B\uC774 \uC788\uC9C0\uC694."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uC5D0\uB294 \uAE4C\uB9C8\uADC0\uB4E4\uC774 \uB465\uC9C0\uB97C \uD2C0\uC5B4\uC694.
      \uC774 \uACC4\uC808\uC5D4 \uB098\uB3C4 \uC870\uAE08 \uB9D0\uC774 \uB9CE\uC544\uC9C0\uC9C0\uC694."
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984\uBC24\uC740 \uC9E7\uC544\uC11C \uC544\uC26C\uC6CC\uC694.
      \uBCC4\uC744 \uC77D\uC744 \uC2DC\uAC04\uC774 \uBAA8\uC790\uB77C\uAC70\uB4E0\uC694."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8\uC740 \uB0B4 \uACC4\uC808\uC774\uC5D0\uC694. \uAE34 \uBC24,
      \uC870\uC6A9\uD55C \uC232\u2026 \uADF8\uB9AC\uACE0 \uB530\uB73B\uD55C \uC57D\uCD08\uCC28."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44 \uC624\uB294 \uB0A0\uC5D4 \uAE4C\uB9C8\uADC0\uB4E4\uC774 \uCC98\uB9C8
      \uC544\uB798 \uBAA8\uC5EC\uC694. \uB098\uB3C4 \uADF8 \uD2C8\uC5D0 \uB07C\uC5B4
      \uC788\uC9C0\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208 \uC704\uC758 \uBC1C\uC790\uAD6D\uC740 \uAC70\uC9D3\uB9D0\uC744
      \uBABB \uD574\uC694. \uC624\uB298 \uB204\uAC00 \uC232\uC5D0 \uC654\uB294\uC9C0
      \uB2E4 \uBCF4\uC774\uC9C0\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uCC9C\uB465\uC774 \uC6B8\uBA74 \uAE4C\uB9C8\uADC0\uB4E4\uC740 \uC785\uC744
      \uB2E4\uBB3C\uC5B4\uC694. \uD3ED\uD48D\uC740 \uC608\uC5B8\uC870\uCC28 \uC0BC\uD0A4\uB2C8\uAE4C\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\u2026\uC774\uAC74 \uBC1B\uC744 \uC218 \uC5C6\uC5B4\uC694. \uB0B4\uAC8C\uB294
      \uB108\uBB34 \uB9D1\uC740 \uBB3C\uAC74\uC774\uC5D0\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC74C\u2026 \uC774\uAC74 \uC5B4\uB514\uC5D0 \uC4F8\uC9C0 \uAE4C\uB9C8\uADC0\uC5D0\uAC8C
      \uBB3C\uC5B4\uBD10\uC57C\uACA0\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\u2026\uBC84\uC12F\uC774\uAD70\uC694. \uC232\uC758 \uAC00\uC7A5 \uC5B4\uB450\uC6B4
      \uACF3\uC5D0\uC11C \uC790\uB780 \uAC83. \uACE0\uB9C8\uC6CC\uC694, \uC815\uB9D0\uB85C."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uC88B\uC740 \uC120\uBB3C\uC774\uC5D0\uC694. \uAE4C\uB9C8\uADC0\uB4E4\uB3C4
      \uBD80\uB7EC\uC6CC\uD558\uACA0\uB124\uC694."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uC0DD\uC77C\uC744 \uAE30\uC5B5\uD588\uAD70\uC694\u2026 \uC608\uC5B8\uC5D0\uB3C4
      \uC5C6\uB358 \uC77C\uC774\uC5D0\uC694. \uC774\uB7F0 \uB180\uB77C\uC6C0\uC774\uB77C\uBA74,
      \uB098\uC058\uC9C0 \uC54A\uB124\uC694."
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0\uC774 \uB0A0 \uBBFF\uC5B4\uC900\uB2E4\uBA74, \uC774 \uC5B4\uB460\uB3C4\u2026
      \uC870\uAE08\uC740 \uB530\uB73B\uD574\uC9C8\uAE4C\uC694?"
