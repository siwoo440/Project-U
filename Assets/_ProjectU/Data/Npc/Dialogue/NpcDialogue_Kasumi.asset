%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Kasumi
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_kasumi
  dailyTalkLimit: 1
  expressionTags:
  - "\uBBF8\uC18C"
  - "\uB2F9\uD669"
  - "\uD68C\uC0C1"
  - "\uBD84\uB178"
  - "\uC5EC\uC720"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uCC98\uC74C \uBCF4\uB294 \uC5BC\uAD74\uC774\uB124\uC694. \uC798 \uBD80\uD0C1\uD574\uC694."
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC548\uAC1C\uAC00 \uC790\uC6B1\uD558\uB124. \uC774\uB7F0 \uB0A0\uC5D4,
      \uC9C4\uC2EC\uC774 \uB354 \uC798 \uBCF4\uC774\uC9C0."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC9C4\uC2E4\uC774\uB780 \uAC8C \uAF2D \uC120\uBA85\uD560 \uD544\uC694\uB294
      \uC5C6\uC5B4. \uD750\uB9BF\uD560\uC218\uB85D \uC0AC\uB78C \uB9C8\uC74C\uC774
      \uBCF4\uC774\uAC70\uB4E0."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB10C \uBB58 \uBBFF\uC5B4? \uB208\uC55E\uC758 \uC9C4\uC2E4\uC774 \uC804\uBD80\uB77C\uACE0
      \uC0DD\uAC01\uD574?"
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAC70\uC9D3\uC744 \uAFF0\uB6AB\uB294 \uB208\uC774 \uC788\uB124\u2026
      \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB098, \uC0AC\uC2E4 \uB124 \uC55E\uC5D0\uC120 \uD658\uC220\uC744 \uC4F0\uAE30
      \uC2EB\uC5B4. \uC774\uC720\uB294\u2026 \uBB3B\uC9C0 \uB9C8."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB110 \uC18D\uC774\uB294 \uAC8C \uB354 \uC5B4\uB824\uC6CC\uC84C\uC5B4.
      \uADF8\uAC74 \uC88B\uC740 \uC9D5\uC870\uACA0\uC9C0?"
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC81C\uB294 \uD658\uC0C1 \uB530\uC708 \uD544\uC694 \uC5C6\uC5B4.
      \uB108\uB9CC \uBCF4\uBA74 \uD604\uC2E4\uC774 \uCDA9\uBD84\uD558\uB2C8\uAE4C."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uCD94\uC6CC\uC694. \uB530\uB73B\uD558\uAC8C \uC785\uACE0 \uB2E4\uB2C8\uC138\uC694."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uBC14\uB78C\uC774 \uC120\uC120\uD574\uC84C\uC5B4\uC694. \uC218\uD655\uC740
      \uC798 \uB418\uACE0 \uC788\uB098\uC694?"
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uD587\uBCD5\uC774 \uB728\uAC70\uC6CC\uC694. \uADF8\uB298\uC5D0\uC11C
      \uC26C\uC5B4 \uAC00\uC138\uC694."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uC774 \uC654\uB124\uC694. \uC12C\uC774 \uC870\uAE08\uC529 \uCD08\uB85D\uBE5B\uC73C\uB85C
      \uBC14\uB00C\uACE0 \uC788\uC5B4\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44\uAC00 \uC624\uB124\uC694. \uC624\uB298\uC740 \uC870\uAE08 \uC26C\uC5B4
      \uAC00\uB3C4 \uAD1C\uCC2E\uC544\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC774 \uC640\uC694. \uBC1C\uBC11 \uC870\uC2EC\uD558\uC138\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uD3ED\uD48D\uC774\uC5D0\uC694. \uC624\uB298\uC740 \uC548\uC5D0 \uC788\uB294
      \uAC8C \uC88B\uACA0\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uC774\uAC74 \uC815\uB9D0 \uC88B\uC544\uD558\uB294 \uAC70\uC608\uC694!
      \uACE0\uB9C8\uC6CC\uC694!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uACE0\uB9C8\uC6CC\uC694. \uC798 \uC4F8\uAC8C\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uACE0\uB9C8\uC6CC\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uC74C\u2026 \uC774\uAC74 \uC81C \uCDE8\uD5A5\uC740 \uC544\uB2C8\uC5D0\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC0DD\uC77C\uC744 \uAE30\uC5B5\uD574 \uC92C\uAD70\uC694. \uC815\uB9D0
      \uAE30\uBED0\uC694!"
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD658\uC0C1\uC740 \uC0AC\uB77C\uC9C0\uC9C0\uB9CC, \uB124 \uB208\uBE5B\uC740
      \uAC70\uC9D3\uC774 \uC544\uB2C8\uC57C. \uADF8\uB798\uC11C\u2026 \uBBFF\uAC8C
      \uB3FC."
