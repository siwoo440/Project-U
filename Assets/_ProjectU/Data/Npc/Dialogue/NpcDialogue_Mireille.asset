%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Mireille
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_mireille
  dailyTalkLimit: 1
  expressionTags:
  - "\uBBF8\uC18C"
  - "\uC218\uC90D\uC74C"
  - "\uB208\uBB3C"
  - "\uD3C9\uC628"
  - "\uB450\uB824\uC6C0"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC544\u2026 \uC548\uB155\uD558\uC138\uC694. \uC800\uB294 \uBBF8\uB808\uC720\uC608\uC694.
      \uC774 \uC544\uC774\uB4E4\uC744 \uB3CC\uBCF4\uACE0 \uC788\uC5B4\uC694\u2026
      \uB180\uB77C\uAC8C \uD558\uC9C0 \uB9D0\uC544 \uC8FC\uC138\uC694."
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC624\uB298\uC740 \uBC14\uB78C\uC774 \uCC38 \uBD80\uB4DC\uB7FD\uB124\uC694\u2026
      \uC74C\uBA54~ \uD6C4\uD6D7."
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC640 \uC8FC\uC168\uB124\uC694\u2026 \uC74C\uBA54~ \uC544, \uC8C4\uC1A1\uD574\uC694.
      \uBC18\uAC00\uC6CC\uC11C \uADF8\uB9CC."
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC548\uB155\uD558\uC138\uC694\u2026 \uC624\uB298 \uBC14\uB78C\uC774 \uCC38
      \uBD80\uB4DC\uB7FD\uB124\uC694."
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB3D9\uBB3C\uB4E4\uB3C4 \uAE30\uC5B5\uD574\uC694. \uB9E4\uC77C \uC4F0\uB2E4\uB4EC\uC5B4
      \uC8FC\uBA74\u2026 \uB9C8\uC74C\uC744 \uC5F4\uC5B4 \uC904 \uAC70\uC608\uC694."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2ED\uB4E4\uC740 \uC544\uCE68\uC5D0 \uAE30\uBD84\uC774 \uC81C\uC77C
      \uC88B\uC544\uC694. \uBA39\uC774\uB97C \uC8FC\uBA74\uC11C \uB9D0\uC744 \uAC78\uC5B4
      \uC8FC\uC138\uC694."
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC608\uC804\uC5D4 \uD070 \uC18C\uB9AC\uB9CC \uB4E4\uC5B4\uB3C4 \uC228\uC5C8\uC5B4\uC694.
      \uC9C0\uAE08\uC740\u2026 \uB2F9\uC2E0\uC774 \uC788\uC73C\uB2C8\uAE4C \uAD1C\uCC2E\uC544\uC694."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC138\uC0C1\uC740 \uC794\uC778\uD560 \uB54C\uB3C4 \uC788\uC9C0\uB9CC\u2026
      \uADF8\uB798\uB3C4 \uC5EC\uC804\uD788 \uC544\uB984\uB2E4\uC6CC\uC694."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774 \uC138\uC0C1\uC774 \uC870\uAE08\uC740 \uB354 \uB530\uB73B\uD558\uB2E4\uACE0
      \uB290\uAEF4\uC694, \uB2F9\uC2E0 \uB355\uBD84\uC5D0\uC694."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0 \uC606\uC5D0 \uC788\uC73C\uBA74 \uC774\uC0C1\uD558\uAC8C
      \uB9C8\uC74C\uC774 \uD3B8\uD574\uC694."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0\uC740\u2026 \uB2E4\uCE58\uC9C0 \uC54A\uC558\uB098\uC694?
      \uC0C1\uCC98\uB294 \uBC14\uB85C \uCE58\uB8CC\uD574\uC57C \uD574\uC694."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "...\uC8C4\uC1A1\uD574\uC694, \uC800\uB294 \uADF8\uB0E5 \uC9C0\uB098\uAC00\uB358
      \uC0AC\uB78C\uC774\uC5D0\uC694."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0\uC774 \uD589\uBCF5\uD558\uB2E4\uBA74\u2026 \uADF8\uAC78\uB85C
      \uC804 \uCDA9\uBD84\uD574\uC694. \uADF8\uAC8C \uC81C\uAC00 \uBC14\uB77C\uB294
      \uC804\uBD80\uC608\uC694."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744 \uD480\uC740 \uC601\uC591\uC774 \uB9CE\uC544\uC694. \uC544\uC774\uB4E4\uC774
      \uC0B4\uC774 \uD1B5\uD1B5\uD558\uAC8C \uC62C\uB77C\uC694."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8\uC5D4 \uC6B0\uB9AC \uC548\uC744 \uB530\uB73B\uD558\uAC8C
      \uD574 \uC918\uC57C \uD574\uC694. \uC9DA\uC744 \uC870\uAE08 \uB354 \uAE54\uC544
      \uC904\uAE4C\uC694?"
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uB354\uC6B4 \uB0A0\uC5D4 \uAC00\uCD95\uB4E4\uC5D0\uAC8C \uBB3C\uC744
      \uC790\uC8FC \uC918\uC57C \uD574\uC694. \uC800\uB3C4\uC694\u2026 \uD6C4\uD6D7."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uC5D0\uB294 \uC0C8\uB07C\uB4E4\uC774 \uD0DC\uC5B4\uB098\uC694\u2026
      \uC138\uC0C1\uC774 \uB2E4\uC2DC \uC2DC\uC791\uB418\uB294 \uB290\uB08C\uC774\uC5D0\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44\uAC00 \uC624\uBA74 \uC544\uC774\uB4E4\uC774 \uBB34\uC11C\uC6CC\uD574\uC694\u2026
      \uC624\uB298\uC740 \uACC1\uC5D0 \uC788\uC5B4 \uC918\uC57C\uACA0\uC5B4\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC774 \uC640\uC694\u2026 \uC591\uD138\uCC98\uB7FC \uD558\uC597\uB124\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uCC9C\uB465\uC774\u2026 \uBB34\uC11C\uC6CC\uC694. \uC6B0\uB9AC \uBB38,
      \uAF2D \uB2EB\uC544 \uB450\uC168\uC8E0?"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uADF8, \uADF8\uAC74 \uCE58\uC6CC \uC8FC\uC138\uC694\u2026! \uB2E4\uCE58\uB294
      \uAC74 \uC2EB\uC5B4\uC694\u2026"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uB530\uB73B\uD55C \uC6B0\uC720\u2026 \uC81C\uAC00 \uC81C\uC77C \uC88B\uC544\uD558\uB294
      \uAC70\uC608\uC694. \uB9C8\uC74C\uAE4C\uC9C0 \uB530\uB73B\uD574\uC838\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uACE0\uB9C8\uC6CC\uC694\u2026 \uC18C\uC911\uD788 \uC4F8\uAC8C\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC544, \uAC10\uC0AC\uD569\uB2C8\uB2E4\u2026 \uB9C8\uC74C\uB9CC\uC73C\uB85C\uB3C4
      \uAE30\uBED0\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uC774\uAC74\u2026 \uC870\uAE08 \uBB34\uC11C\uC6CC\uC694. \uB2E4\uB978
      \uC0AC\uB78C\uD55C\uD14C \uC8FC\uC2DC\uBA74 \uC88B\uACA0\uC5B4\uC694."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC81C \uC0DD\uC77C\uC744\u2026 \uAE30\uC5B5\uD574 \uC8FC\uC168\uC5B4\uC694?
      \uC74C\uBA54~ \uB108\uBB34 \uAE30\uBED0\uC11C \uB208\uBB3C\uC774 \uB0A0 \uAC83
      \uAC19\uC544\uC694."
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC800\uB3C4 \uC5B8\uC820\uAC00\uB294 \uB204\uAD70\uAC00\uB97C \uC9C0\uD0AC
      \uC218 \uC788\uC744\uAE4C\uC694? \uB2F9\uC2E0\uCC98\uB7FC\uC694."
