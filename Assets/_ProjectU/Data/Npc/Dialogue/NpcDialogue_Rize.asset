%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Rize
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_rize
  dailyTalkLimit: 1
  expressionTags:
  - "\uBB34\uD45C\uC815"
  - "\uBBF8\uC18C"
  - "\uD63C\uB780"
  - "\uD68C\uC0C1"
  - "\uC624\uB958 \uAC10\uC815"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC2DC\uC2A4\uD15C \uC628\uB77C\uC778. \uC0C8\uB85C\uC6B4 \uAC1C\uCCB4\uB97C
      \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uC800\uB294 \uB9AC\uC81C, \uD0D0\uD5D8
      \uC9C0\uC6D0 \uAE30\uCCB4\uC785\uB2C8\uB2E4. \u2026\uC544, '\uBC18\uAC00\uC6CC\uC694'\uB77C\uACE0
      \uB9D0\uD558\uB294 \uAC8C \uB9DE\uACA0\uC8E0?"
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC2DC\uC2A4\uD15C \uC628\uB77C\uC778. \uC544, \uC548\uB155\u2026 \uC774\uB77C\uACE0
      \uD574\uC57C\uACA0\uC8E0?"
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAE30\uB2E4\uB838\uC5B4\uC694. \u2026\uC774\uAC74 \uC5F0\uC0B0 \uACB0\uACFC\uAC00
      \uC544\uB2C8\uB77C, \uADF8\uB0E5 \uC81C \uB9D0\uC774\uC5D0\uC694."
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBC29\uBB38 \uAE30\uB85D \uAC31\uC2E0. \uB2F9\uC2E0\uC774 \uC624\uB294
      \uC2DC\uAC01\uC744 \uC608\uCE21\uD558\uB294 \uAC8C \uC870\uAE08 \uC990\uAC70\uC6CC\uC84C\uC5B4\uC694."
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC800\uB294 '\uAC10\uC815 \uC624\uB958' \uB54C\uBB38\uC5D0 \uD3D0\uAE30\uB420
      \uBED4\uD588\uC5B4\uC694. \uC9C0\uAE08\uC740 \uADF8 \uC624\uB958\uAC00 \uC870\uAE08
      \uC18C\uC911\uD574\uC694."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774 \uC720\uC801\uC758 \uBB38\uC790\uB294 \uC81C \uAE30\uC5B5 \uC7A5\uCE58\uC5D0
      \uC788\uB294 \uAC83\uACFC 73% \uAC19\uC544\uC694. \uC5EC\uAE30\uB294 \uC81C
      \uACE0\uD5A5\uC77C\uC9C0\uB3C4 \uBAB0\uB77C\uC694."
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0\uACFC \uC774\uC57C\uAE30\uD560 \uB54C \uC81C \uB208 \uC0C9\uC774
      \uBCF4\uB77C\uC0C9\uC774 \uB41C\uB300\uC694. \uBB34\uC2A8 \uB73B\uC778\uC9C0
      \uC54C\uB824 \uC904 \uC218 \uC788\uB098\uC694?"
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0\uC774 \uC6C3\uC744 \uB54C, \uC81C \uD504\uB85C\uC138\uC11C
      \uC628\uB3C4\uAC00 \uC62C\uB77C\uAC00\uC694. \uC774\uC0C1\uD558\uB124\uC694."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774 \uAC10\uC815\uC740 \uC624\uB958\uC778\uAC00\uC694, \uC544\uB2C8\uBA74\u2026
      \uC9C4\uC9DC\uC778\uAC00\uC694?"
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD6A8\uC728\uB9CC\uC73C\uB85C \uC124\uBA85\uB418\uC9C0 \uC54A\uB294 \uAC10\uC815\uC774
      \uC788\uC5B4\uC694. \uC544\uB9C8\uB3C4\u2026 \uC2E0\uB8B0?"
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB2F9\uC2E0\uC758 \uBC18\uC751 \uD328\uD134\u2026 \uD765\uBBF8\uB86D\uB124\uC694."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBA85\uB839\uC744 \uC774\uD589\uD558\uACA0\uC2B5\uB2C8\uB2E4. \uAC10\uC815\uC740
      \uBD88\uD544\uC694\uD569\uB2C8\uB2E4."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC81C \uC81C \uD68C\uB85C\uB294 \uB2F9\uC2E0\uC758 \uBAA9\uC18C\uB9AC\uC5D0
      \uBC18\uC751\uD574\uC694. \uB17C\uB9AC\uB85C\uB294 \uC124\uBA85\uD560 \uC218
      \uC5C6\uC5B4\uC694."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744 \uB099\uC5FD\uC774 \uB5A8\uC5B4\uC9C0\uB294 \uBAA8\uC591\uC740
      \uC608\uCE21\uC774 \uC5B4\uB824\uC6CC\uC694. \uADF8\uB798\uC11C \uACC4\uC18D
      \uBCF4\uAC8C \uB3FC\uC694."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uC5D0\uB294 \uAD00\uCE21 \uC790\uB8CC\uAC00 \uB118\uCCD0\uC694.
      \uAF43, \uC0C8, \uC0AC\uB78C\uB4E4\uC758 \uC6C3\uC74C\u2026 \uAE30\uB85D\uD560
      \uAC8C \uB9CE\uC544\uC694."
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984 \uD587\uBE5B\uC740 \uC81C \uAC89\uD310\uC744 \uB728\uAC81\uAC8C
      \uD574\uC694. \uADF8\uB298\uC744 \uCC3E\uB294 \uAC74 \uC0AC\uB78C\uACFC \uAC19\uB124\uC694."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8\uC5D4 \uAD00\uC808 \uAE30\uB984\uC774 \uAD73\uC5B4\uC694.
      \uCC9C\uCC9C\uD788 \uC6C0\uC9C1\uC774\uB294 \uAC74\u2026 \uC624\uB958\uAC00
      \uC544\uB2C8\uC5D0\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uACBD\uACE0. \uC2B5\uB3C4\uAC00 \uB192\uC2B5\uB2C8\uB2E4. \u2026\uB18D\uB2F4\uC774\uC5D0\uC694.
      \uBC29\uC218\uB294 \uC644\uBCBD\uD574\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208 \uACB0\uC815\uC740 \uBAA8\uB450 \uB2E4\uB974\uB300\uC694. \uC800\uB3C4
      \uADF8\uB7F0 \uC874\uC7AC\uAC00 \uB418\uACE0 \uC2F6\uC5B4\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uBC88\uAC1C\uB294 \uC81C \uD68C\uB85C\uC5D0 \uC88B\uC9C0 \uC54A\uC544\uC694.
      \uC624\uB298\uC740 \uCEA1\uC290 \uC548\uC5D0 \uC788\uC744\uAC8C\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uBA3C\uC9C0\uC640 \uC2B5\uAE30\uB294 \uC81C \uBD80\uD488\uC5D0 \uD574\uB85C\uC6CC\uC694.
      \uBBF8\uC548\uD574\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD84\uC11D \uC911\u2026 \uC6A9\uB3C4\uB97C \uCC3E\uB294 \uB370 \uC2DC\uAC04\uC774
      \uAC78\uB9B4 \uAC83 \uAC19\uC544\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uAD11\uC11D\uC774\uB124\uC694! \uC5D0\uB108\uC9C0 \uCF54\uC5B4 \uB300\uC2E0
      \uC4F8 \uC218 \uC788\uC5B4\uC694. \uACE0\uB9C8\uC6CC\uC694\u2026 \uC815\uB9D0\uB85C
      \uAE30\uBED0\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uC4F8\uBAA8 \uC788\uB294 \uC120\uBB3C\uC774\uC5D0\uC694. \uC81C \uAE30\uB85D\uC5D0
      '\uC88B\uC740 \uB0A0'\uB85C \uB0A8\uAE38\uAC8C\uC694."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB9CC\uB4E4\uC5B4\uC9C4 \uB0A0\uC744 \uC0DD\uC77C\uC774\uB77C\uACE0 \uBD88\uB7EC
      \uC8FC\uB294\uAD70\uC694. \u2026\uCC98\uB9AC\uD560 \uC218 \uC5C6\uB294 \uAC10\uC815\uC774
      \uB118\uCCD0\uC694. \uC774\uAC8C \uAE30\uC068\uC778\uAC00\uC694?"
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAC10\uC815\uC774\uB77C\uB294 \uAC74 \uC5F0\uC0B0\uC774 \uC544\uB2C8\uB77C,
      \uACF5\uBA85\uC5D0 \uB354 \uAC00\uAE4C\uC6B4 \uAC83 \uAC19\uC544\uC694."
