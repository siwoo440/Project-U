%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Harka
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_harka
  dailyTalkLimit: 1
  expressionTags:
  - "\uD65C\uC9DD \uC6C3\uC74C"
  - "\uC218\uC90D\uC74C"
  - "\uACB0\uC758"
  - "\uAE30\uC068"
  - "\uC2AC\uD514"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD081\uD081\u2026 \uC5B4\uB77C, \uC774 \uB0C4\uC0C8! \uD574\uBCC0\uC5D0
      \uC4F0\uB7EC\uC838 \uC788\uB358 \uADF8 \uC0AC\uB78C\uC774\uC9C0? \uB098 \uD558\uB974\uCE74\uC57C!
      \uB110 \uCC98\uC74C \uCC3E\uC740 \uAC8C \uB098\uB77C\uACE0, \uBA4D!"
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC88B\uC740 \uC544\uCE68! \uC624\uB298\uB3C4 \uAF2C\uB9AC \uD754\uB4E4
      \uC900\uBE44 \uC644\uB8CC~!"
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC624\uB298\uC740 \uC5B4\uB514 \uAC08 \uAC70\uC57C? \uC55E\uC7A5\uC124\uAC8C!
      \uBA4D\uBA4D!"
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC654\uB2E4! \uB124 \uB0C4\uC0C8\uB294 \uBA40\uB9AC\uC11C\uB3C4 \uC54C\uC544.
      \uC624\uB298\uB3C4 \uD081\uD081 \uD569\uACA9!"
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC608\uC804\uC5D0 \uB300\uC7A5\uC744 \uB05D\uAE4C\uC9C0 \uBABB \uCC3E\uC558\uC5B4.
      \uADF8\uB798\uC11C \uC774\uBC88\uC5D4\u2026 \uB204\uAD6C\uB3C4 \uB193\uCE58\uC9C0
      \uC54A\uC744 \uAC70\uC57C."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC548\uAC1C \uC18D\uC5D0\uC11C\uB3C4 \uB0C4\uC0C8\uB294 \uAE38\uC744
      \uC54C\uB824 \uC918. \uCF54\uB9CC \uC788\uC73C\uBA74 \uC808\uB300 \uAE38\uC744
      \uC548 \uC783\uC5B4!"
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108\uB294 \uB0B4 \uBB34\uB9AC\uC57C. \uBB34\uB9AC\uB294 \uC11C\uB85C
      \uC9C0\uD0A4\uB294 \uAC70\uACE0! \uBA4D!"
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC74C~ \uB124 \uB0C4\uC0C8\uB294 \uC624\uB298\uB3C4 \uB611\uAC19\uC544.
      \uC660\uC9C0\u2026 \uC548\uC2EC\uB3FC."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108\uB791 \uC788\uC73C\uBA74 \uC774\uC0C1\uD558\uAC8C \uAF2C\uB9AC\uAC00
      \uBA48\uCD94\uC9C8 \uC54A\uC544."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC88B\uC544, \uC774\uBC88\uC5D4 \uB0B4\uAC00 \uB124 \uB4A4\uB97C \uB9E1\uC744\uAC8C.
      \uBA4D!"
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC74C~ \uB108 \uB0C4\uC0C8 \uC88B\uB124. \uB098\uC05C \uB140\uC11D \uAC19\uC9C4
      \uC54A\uC544."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB204\uAD70\uC9C0\uB3C4 \uBAA8\uB974\uB294 \uC0AC\uB78C \uB4A4\uB294
      \uBABB \uC9C0\uCF1C."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4\uAC00 \uBC14\uB77C\uB294 \uAC74 \uB2E8 \uD558\uB098\uC57C\u2026
      \uB124 \uACC1\uC5D0\uC11C \uC544\uCE68\uC744 \uB9DE\uC774\uD558\uB294 \uAC83."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744\uC5D4 \uBC1C\uC790\uAD6D \uCC3E\uAE30 \uC26C\uC6CC! \uB099\uC5FD\uC774
      \uBC14\uC2A4\uB77D\uAC70\uB9AC\uAC70\uB4E0."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04 \uB0C4\uC0C8 \uC88B\uC544! \uAF43, \uD759, \uC0C8\uC2F9\u2026 \uCF54\uAC00
      \uBC14\uBE60!"
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uB354\uC6CC\u2026 \uD600\uAC00 \uC808\uB85C \uB098\uC640. \uC2B5\uC9C0
      \uBB3C\uC5D0 \uBC1C \uB2F4\uADF8\uACE0 \uC2F6\uC5B4."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uB208\uBC2D \uB6F0\uAE30 \uCD5C\uACE0\uC57C! \uAF2C\uB9AC\uAC00 \uBA48\uCD94\uC9C8
      \uC54A\uC544!"
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44 \uC624\uBA74 \uB0C4\uC0C8\uAC00 \uD750\uB824\uC838\uC11C \uC2EB\uC5B4\u2026
      \uADF8\uB798\uB3C4 \uC21C\uCC30\uC740 \uD574\uC57C\uC9C0!"
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC774\uB2E4! \uBA4D\uBA4D! \uBC1C\uC790\uAD6D \uB530\uB77C\uAC00\uAE30
      \uB180\uC774 \uD560\uB798?"
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uCC9C\uB465 \uBB34\uC11C\uC6CC\u2026 \uC544, \uC544\uB2C8\uC57C! \uC548
      \uBB34\uC11C\uC6CC! \uC9C0\uD0AC \uAC70\uC57C!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uC73C\uC5D1, \uC369\uC740 \uB0C4\uC0C8\u2026 \uCF54\uAC00 \uC544\uD30C.
      \uBBF8\uC548, \uC774\uAC74 \uBABB \uBC1B\uACA0\uC5B4."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD081\uD081\u2026 \uC74C, \uB0C4\uC0C8\uB294 \uBCC4\uB85C \uC5C6\uB124.
      \uADF8\uB798\uB3C4 \uACE0\uB9C8\uC6CC!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uACE0\uAE30\uB2E4! \uBA4D! \uB108 \uCD5C\uACE0\uC57C! \uAF2C\uB9AC \uBD10,
      \uAF2C\uB9AC!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uC640, \uD0D0\uD5D8\uC5D0 \uC4F8 \uC218 \uC788\uACA0\uB2E4! \uACE0\uB9C8\uC6CC!"
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uC0DD\uC77C\uC774\uC57C?! \uBA4D\uBA4D\uBA4D! \uC624\uB298\uC740
      \uB124 \uC606\uC5D0\uC11C \uD558\uB8E8 \uC885\uC77C \uAF2C\uB9AC \uD754\uB4E4
      \uAC70\uC57C!"
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uBC88\uC5D4 \uC808\uB300 \uB193\uCE58\uC9C0 \uC54A\uC744 \uAC70\uC57C.
      \uB108\uB3C4, \uB098\uB3C4\u2026 \uB2E4\uC2DC \uD63C\uC790\uAC00 \uB418\uC9C0
      \uC54A\uAC8C."
