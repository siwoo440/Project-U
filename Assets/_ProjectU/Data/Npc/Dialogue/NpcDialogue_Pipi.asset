%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Pipi
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_pipi
  dailyTalkLimit: 1
  expressionTags:
  - "\uC7A5\uB09C"
  - "\uD765\uC815"
  - "\uB2F9\uD669"
  - "\uC9D1\uC911"
  - "\uC0C1\uCC98"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC624, \uC190\uB2D8\uC774\uB2E4! \uB09C \uD53C\uD53C, \uD3D0\uD488 \uAE30\uC220\uC790!
      \uBD80\uC11C\uC9C4 \uAC70 \uC788\uC73C\uBA74 \uAC00\uC838\uC640. \uC2F8\uAC8C
      \uACE0\uCCD0 \uC904\uAC8C. \uC544, \uACF5\uC9DC\uB294 \uC5C6\uC5B4!"
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC2F8\uACE0 \uC88B\uC740 \uBB3C\uAC74, \uC5EC\uAE30 \uB2E4 \uC788\uC5B4!"
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC654\uAD6C\uB098, \uB2E8\uACE8! \uB108\uD55C\uD150 \uD2B9\uBCC4\uD788
      \uACC4\uC0B0 \uC548 \uD560\uAC8C. \u2026\uC870\uAE08\uB9CC \uD560\uAC8C."
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB610 \uC654\uB124! \uC624\uB298\uC740 \uD314 \uAC70 \uC5C6\uC5B4? \uB179\uC2A8
      \uBABB \uD558\uB098\uB77C\uB3C4 \uC88B\uC544!"
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB3D9\uC804\uC740 \uC18C\uB9AC\uAC00 \uC88B\uC544. \uC9E4\uB791\uC9E4\uB791!
      \uADF8 \uC18C\uB9AC \uB4E4\uC73C\uBA74 \uD798\uC774 \uB098."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD1B1\uB2C8 \uD558\uB098 \uBE60\uC9C0\uBA74 \uAE30\uACC4\uB294 \uBA48\uCDB0.
      \uB9C8\uC744\uB3C4 \uB611\uAC19\uC544. \uB2E4\uB4E4 \uD1B1\uB2C8\uC57C!"
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC5B4\uB9B4 \uB54C \uAC00\uB09C\uD574\uC11C \uAC00\uC871\uC774 \uD769\uC5B4\uC84C\uC5B4.
      \uADF8\uB798\uC11C \uB09C \uBB50\uB4E0 \uC548 \uBC84\uB824. \u2026\uC0AC\uB78C\uB3C4."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBC84\uB824\uC9C4 \uAC74 \uC5C6\uC5B4. \uC4F8\uBAA8\uB97C \uBABB \uCC3E\uC558\uC744
      \uBFD0\uC774\uC57C."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uACC1\uC774 \uD3B8\uD574\uC84C\uC5B4."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uBC88 \uC77C\uC740 \uD568\uAED8\uD558\uC790."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC870\uAE08\uC740 \uD765\uBBF8\uB86D\uB124."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC544\uC9C1 \uB110 \uBBFF\uC9C4 \uC54A\uC544."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC81C \uB0B4 \uBAA9\uD45C\uC5D0\uB294 \uB124\uAC00 \uC788\uC5B4."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744\uBC14\uB78C \uBD88 \uB54C \uD48D\uCC28\uB97C \uB9CC\uB4E4\uC5B4
      \uBCFC\uAE4C? \uBC14\uB78C\uC740 \uACF5\uC9DC\uB2C8\uAE4C!"
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uC5D4 \uB2E4\uB4E4 \uB300\uCCAD\uC18C\uB97C \uD558\uC796\uC544?
      \uD3D0\uD488 \uC90D\uAE30 \uC81C\uC77C \uC88B\uC740 \uACC4\uC808!"
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uB354\uC6B0\uBA74 \uC1E0\uAC00 \uB728\uAC70\uC6CC\uC838\uC11C \uC190
      \uB370\uC5EC. \uADF8\uB798\uB3C4 \uC77C\uC740 \uD574\uC57C\uC9C0!"
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8\uC5D4 \uACE0\uCCA0\uC774 \uC5BC\uC5B4\uC11C \uC798 \uBD80\uB7EC\uC838.
      \uC870\uC2EC\uD574\uC11C \uB9CC\uC838\uC57C \uD574."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44 \uC624\uBA74 \uB179\uC2AC\uC5B4! \uBE68\uB9AC \uB36E\uAC1C \uB36E\uC5B4!"
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208 \uC624\uB294 \uB0A0\uC5D4 \uB09C\uB85C \uACE0\uCCD0 \uB2EC\uB77C\uB294
      \uC190\uB2D8\uC774 \uB9CE\uC544. \uB3C8 \uBC8C \uB0A0\uC774\uB2E4!"
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uD3ED\uD48D\uC774 \uC9C0\uB098\uAC00\uBA74 \uD574\uBCC0\uC5D0 \uC4F8
      \uB9CC\uD55C \uAC8C \uC794\uB729 \uBC00\uB824\uC640. \uB0B4\uC77C \uC0C8\uBCBD\uC5D0
      \uAC00 \uBD10\uC57C\uC9C0!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uC9C0\uB801\uC774\uB294 \uBD80\uD488\uC774 \uC548 \uB3FC\u2026 \uAFC8\uD2C0\uAC70\uB9AC\uC796\uC544."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC74C, \uC5B4\uB514 \uC4F8\uC9C0 \uACC4\uC0B0\uD574 \uBCFC\uAC8C."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uC774\uAC70 \uC9C4\uC9DC \uC88B\uC740 \uACF5\uAD6C\uC796\uC544! \uB098
      \uC918\uB3C4 \uB3FC? \uBB3C\uB9B4 \uC218 \uC5C6\uC5B4!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uC624, \uC7AC\uB8CC\uB2E4! \uB531 \uD544\uC694\uD588\uC5B4. \uACE0\uB9C8\uC6CC!"
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uC0DD\uC77C \uC120\uBB3C? \uACF5\uC9DC\uB85C? \u2026\uC5D0\uC774,
      \uADF8\uB7FC \uB098\uB3C4 \uB2E4\uC74C \uC218\uB9AC\uBE44 \uAE4E\uC544 \uC904\uAC8C!"
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774 \uBC1C\uBA85\uD488\uC758 \uCCAB \uC190\uB2D8\uC740 \uB108\uC57C."
