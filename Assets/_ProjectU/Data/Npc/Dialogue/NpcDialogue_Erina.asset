%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Erina
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_erina
  dailyTalkLimit: 1
  expressionTags:
  - "\uB0C9\uC815"
  - "\uC628\uD654"
  - "\uBD80\uB044\uB7EC\uC6C0"
  - "\uBD84\uB178"
  - "\uACB0\uC758"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\u2026\uC778\uAC04\uC774\uAD70. \uB098\uB294 \uC5D0\uB9AC\uB098. \uC774
      \uC232\uC758 \uADE0\uD615\uC744 \uC9C0\uCF1C\uBCF4\uB294 \uC790\uB2E4. \uB098\uBB34\uB97C
      \uD568\uBD80\uB85C \uBCA0\uC9C0\uB9CC \uC54A\uB294\uB2E4\uBA74, \uC801\uC774
      \uB420 \uC77C\uC740 \uC5C6\uC5B4."
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC790\uC5F0\uC740 \uC5B8\uC81C\uB098 \uB9D0\uC744 \uD55C\uB2E4. \uB2E4\uB9CC,
      \uB4E4\uC744 \uADC0\uAC00 \uC5C6\uB294 \uC790\uAC00 \uB9CE\uC744 \uBFD0\uC774\uC9C0."
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAE30\uB2E4\uB838\uB2E4\u2026 \uB294 \uAC74 \uC544\uB2C8\uB2E4. \uB2E4\uB9CC
      \uB124\uAC00 \uC624\uB294 \uC18C\uB9AC\uB294 \uC774\uC81C \uAD6C\uBCC4\uD560
      \uC218 \uC788\uC9C0."
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB610 \uC654\uAD70. \uC624\uB298\uC740 \uC232\uC774 \uC870\uC6A9\uD558\uB2E4.
      \uB124 \uBC1C\uAC78\uC74C\uB3C4 \uC81C\uBC95 \uC870\uC6A9\uD574\uC84C\uC5B4."
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC778\uAC04\uACFC \uC5D8\uD504 \uC0AC\uC774\uC5D0\uC11C \uC911\uC7AC\uD558\uB824
      \uD588\uB358 \uC801\uC774 \uC788\uB2E4. \u2026\uC591\uCABD \uBAA8\uB450\uB97C
      \uC783\uC5C8\uC9C0."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC232\uC740 \uC5B8\uC81C\uB098 \uB9D0\uC744 \uD55C\uB2E4. \uBC14\uB78C,
      \uC0C8, \uB098\uBB47\uC78E. \uB4E4\uC744 \uADC0\uAC00 \uC5C6\uB294 \uC790\uAC00
      \uB9CE\uC744 \uBFD0\uC774\uC9C0."
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108\uB97C \uBCF4\uBA74 \uC778\uAC04\uC744 \uB2E4\uC2DC \uBBFF\uC5B4
      \uBCF4\uACE0 \uC2F6\uC5B4\uC9C4\uB2E4. \u2026\uC774\uC0C1\uD55C \uC77C\uC774\uC9C0."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uADE0\uD615\uC774\uB780 \uAC74\u2026 \uADF8\uC800 \uC544\uBB34 \uC77C\uB3C4
      \uC5C6\uB2E4\uB294 \uB73B\uC774 \uC544\uB2C8\uC57C. \uC11C\uB85C\uC758 \uB2E4\uB984\uC744
      \uC774\uD574\uD558\uB294 \uAC83."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uB7F0 \uD3C9\uD654\uB97C \uB290\uB080 \uAC8C\u2026 \uBA87\uC2ED
      \uB144 \uB9CC\uC778\uC9C0 \uBAA8\uB974\uACA0\uAD70."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uD310\uB2E8\uC740 \uB54C\uB85C \uB0B4 \uC9C1\uAC10\uBCF4\uB2E4
      \uC633\uC544. \uD568\uAED8 \uC6C0\uC9C1\uC774\uC790."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uB208\uBE5B\u2026 \uAC70\uC9D3\uC774 \uC5C6\uC5B4. \uD765\uBBF8\uB86D\uAD70."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774 \uC232\uC740 \uB0AF\uC120 \uC790\uC5D0\uAC8C \uC790\uBE44\uB86D\uC9C0
      \uC54A\uB2E4."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108\uC640 \uD568\uAED8\uB77C\uBA74, \uADF8 \uC5B4\uB5A4 \uADE0\uD615\uC774\uB77C\uB3C4
      \uB2E4\uC2DC \uB9DE\uCD9C \uC218 \uC788\uC744 \uAC83 \uAC19\uC544."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744\uBC14\uB78C\uC740 \uD654\uC0B4\uC744 \uD754\uB4E0\uB2E4.
      \uADF8\uB798\uC11C \uC218\uB828\uD558\uAE30 \uC88B\uB2E4."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uC5D0\uB294 \uC0C8\uC2F9\uC744 \uBC1F\uC9C0 \uC54A\uB3C4\uB85D
      \uC870\uC2EC\uD574\uB77C. \uC232\uC758 \uC544\uC774\uB4E4\uC774\uB2E4."
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984 \uC232\uC740 \uC18C\uB9AC\uAC00 \uB9CE\uB2E4. \uD65C\uC744
      \uC3D8\uAE30\uC5D4 \uC88B\uC9C0 \uC54A\uC740 \uACC4\uC808\uC774\uC9C0."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8 \uC232\uC740 \uC7A0\uB4E4\uC5B4 \uC788\uB2E4. \uAE68\uC6B0\uC9C0
      \uC54A\uB3C4\uB85D \uC870\uC6A9\uD788 \uAC78\uC5B4\uB77C."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44\uAC00 \uC624\uBA74 \uC232\uC774 \uC228\uC744 \uC270\uB2E4. \uC624\uB298\uC740
      \uD65C\uC744 \uC26C\uAC8C \uD558\uC9C0."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208 \uC704\uC5D0\uC11C\uB294 \uBAA8\uB4E0 \uBC1C\uC790\uAD6D\uC774
      \uB4DC\uB7EC\uB09C\uB2E4. \uC0AC\uB0E5\uAFBC\uC5D0\uAC8C\uB3C4, \uC0AC\uB0E5\uAC10\uC5D0\uAC8C\uB3C4."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uD3ED\uD48D\uC740 \uADE0\uD615\uC744 \uAE68\uB728\uB9B0\uB2E4. \u2026\uC4F0\uB7EC\uC9C4
      \uB098\uBB34\uB4E4\uC744 \uC0B4\uD53C\uB7EC \uAC00\uC57C\uACA0\uAD70."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uACE1\uAD2D\uC774\uB294 \uC232\uC744 \uC2DC\uB044\uB7FD\uAC8C \uD55C\uB2E4.
      \uAC00\uC838\uAC00\uB77C."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC74C\u2026 \uC774\uAC74 \uC232\uC5D0\uC11C \uC4F8 \uACF3\uC744 \uCC3E\uC544\uBD10\uC57C\uACA0\uAD70."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\u2026\uD65C\uC774\uAD70. \uC88B\uC740 \uB098\uBB34\uB97C \uC37C\uC5B4.
      \uC18C\uC911\uD788 \uC4F0\uACA0\uB2E4. \uACE0\uB9D9\uB2E4."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uC4F8\uBAA8 \uC788\uB294 \uC120\uBB3C\uC774\uAD70. \uBC1B\uC544 \uB450\uC9C0."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\u2026\uC0DD\uC77C\uC744 \uAE30\uC5B5\uD588\uB098. \uBC31 \uB144 \uB118\uAC8C
      \uC544\uBB34\uB3C4 \uCC59\uAE30\uC9C0 \uC54A\uB358 \uB0A0\uC774\uB2E4. \u2026\uACE0\uB9D9\uB2E4."
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB098\uB294 \uC624\uB7AB\uB3D9\uC548 \uBE5B\uACFC \uC5B4\uB460 \uC0AC\uC774\uC5D0
      \uC11C \uC788\uC5C8\uC9C0. \uD558\uC9C0\uB9CC \uC9C0\uAE08\uC740 \uC54C\uACA0\uC5B4\u2014\uB108\uB294
      \uADF8 \uC0AC\uC774\uC758 \uC0C9\uC774\uC57C."
