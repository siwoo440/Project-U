%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Bellamorta
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_bellamorta
  dailyTalkLimit: 1
  expressionTags:
  - "\uC7A5\uB09C"
  - "\uC5EC\uC720"
  - "\uB3D9\uC694"
  - "\uBD84\uB178"
  - "\uC0C1\uCC98"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC5B4\uBA38, \uC0C8 \uC5BC\uAD74\uC774\uB124. \uB098\uB294 \uBCA8\uB77C\uBAA8\uB974\uD0C0.
      \uC774 \uC12C\uC758 \uBE44\uBC00\uC740 \uB300\uBD80\uBD84 \uB0B4 \uC190\uC744
      \uAC70\uCCD0 \uAC00\uC9C0\u2026 \uB108\uB3C4 \uC5B8\uC820\uAC00 \uBB54\uAC00\uB97C
      \uC0AC\uB7EC \uC624\uACA0\uC9C0?"
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB610 \uC654\uB124, \uC778\uAC04. \uC624\uB298\uC740 \uC5B4\uB5A4 \uBE44\uBC00\uC744
      \uC0AC\uACE0 \uC2F6\uC5B4?"
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC654\uAD6C\uB098. \uAE30\uB2E4\uB9B0 \uAC74 \uC544\uB2C8\uC57C. \u2026\uC870\uAE08\uC740
      \uAE30\uB2E4\uB838\uC744\uC9C0\uB3C4."
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uADF8 \uB208\uBE5B\u2026 \uC624\uB298\uC740 \uBB54\uAC00 \uC228\uAE30\uACE0
      \uC628 \uC5BC\uAD74\uC778\uB370?"
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC5F0\uAE08\uC220\uC758 \uCCAB \uBC88\uC9F8 \uADDC\uCE59? \uBB34\uC5B8\uAC00\uB97C
      \uC5BB\uC73C\uB824\uBA74 \uAC19\uC740 \uAC12\uC758 \uBB34\uC5B8\uAC00\uB97C
      \uB0B4\uB193\uC544\uC57C \uD574. \uACC4\uC57D\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uACE0."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD5A5\uAE30\uB85C \uC0AC\uB78C\uC744 \uC54C\uC544\uBCFC \uC218 \uC788\uC5B4.
      \uB10C\u2026 \uD759 \uB0C4\uC0C8\uC640 \uBAA8\uB2E5\uBD88 \uB0C4\uC0C8\uAC00
      \uB098."
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC608\uC804\uC5D0 \uD55C \uC778\uAC04\uACFC \uACC4\uC57D\uD588\uC5B4.
      \uBAA9\uC228\uC744 \uAD6C\uD574 \uC92C\uB354\uB2C8 \uB354 \uB9CE\uC740 \uAC78
      \uC6D0\uD558\uB354\uB77C. \u2026\uADF8 \uB4A4\uB85C \uACC4\uC57D\uC740 \uC548
      \uD574."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC0AC\uB78C\uC758 \uC695\uB9DD\uC740 \uD5A5\uAE30 \uAC19\uC544. \uC9C4\uD55C
      \uAC74 \uAE08\uC138 \uC0AC\uB77C\uC9C0\uACE0, \uB0A8\uB294 \uAC74 \uC794\uD5A5\uBFD0\uC774\uC9C0."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uB7F0 \uAC10\uC815\u2026 \uC624\uB79C\uB9CC\uC774\uC57C. \uC704\uD5D8\uD558\uB124."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB10C \uAC70\uB798 \uB300\uC0C1\uC774 \uC544\uB2C8\uB77C, \uB300\uD654
      \uC0C1\uB300\uC57C."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uB208\uB3D9\uC790\u2026 \uC9C4\uC2E4\uC744 \uC228\uAE30\uC9C0
      \uBABB\uD558\uB124."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD765\uBBF8\uB85C\uC6B4 \uC778\uAC04\uC774\uB124. \uC624\uB798 \uBC84\uD2F8\uAE4C?"
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uACC4\uC57D\uC774 \uC544\uB2CC \uB9C8\uC74C\uC73C\uB85C \uB124 \uACC1\uC5D0
      \uC788\uACE0 \uC2F6\uC5B4."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744\uC740 \uC7AC\uB8CC\uAC00 \uAC00\uC7A5 \uC5EC\uBB34\uB294
      \uACC4\uC808\uC774\uC57C. \uBC84\uC12F \uD558\uB098\uC5D0\uB3C4 \uBE44\uBC00\uC774
      \uB4E4\uC5B4 \uC788\uC9C0."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uCD94\uC6B4 \uBC24\uC5D4 \uAC00\uB9C8\uC1A5 \uBD88\uBE5B\uC774 \uC81C\uC77C
      \uB530\uB73B\uD574. \uAC00\uB054\uC740\u2026 \uB204\uAC00 \uC606\uC5D0 \uC788\uC73C\uBA74
      \uB354 \uC88B\uACA0\uACE0."
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uB354\uC6B4 \uB0A0\uC5D4 \uBB3C\uC57D\uC774 \uC27D\uAC8C \uC0C1\uD574.
      \uACF5\uBC29 \uADF8\uB298\uC5D0 \uC788\uB294 \uAC8C \uC88B\uC544."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uAF43 \uD5A5\uC740 \uB2EC\uCF64\uD558\uC9C0\uB9CC \uAE08\uBC29
      \uC0AC\uB77C\uC838. \uADF8\uB798\uC11C \uBCD1\uC5D0 \uB2F4\uC544 \uB450\uB294
      \uAC70\uC57C."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE57\uBB3C\uC740 \uBAA8\uB4E0 \uD5A5\uC744 \uC53B\uC5B4 \uB0B4. \uC624\uB298\uC740
      \uB204\uAD6C\uC758 \uC695\uB9DD\uB3C4 \uC77D\uAE30 \uC5B4\uB835\uB124."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC740 \uC18C\uB9AC\uB97C \uC0BC\uCF1C. \uBE44\uBC00 \uC598\uAE30\uD558\uAE30
      \uC88B\uC740 \uB0A0\uC774\uC9C0?"
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uD3ED\uD48D\uC774 \uCE58\uBA74 \uC624\uBCA8\uB9AC\uC2A4\uD06C\uC758 \uB8EC\uC774
      \uC6B8\uC5B4. \uC624\uB298\uC740 \uBC16\uC5D0 \uC624\uB798 \uC788\uC9C0 \uB9C8."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uC131\uC218 \uB0C4\uC0C8\uAC00 \uB098. \uB2F9\uC7A5
      \uCE58\uC6CC \uC918."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\u2026\uC774\uB7F0 \uAC78 \uB098\uD55C\uD14C? \uACC4\uC57D\uC11C\uB3C4
      \uC5C6\uC774? \uC774\uC0C1\uD55C \uC778\uAC04\uC774\uB124. \uACE0\uB9C8\uC6CC."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uC548\uBAA9\uC774 \uB098\uC058\uC9C0 \uC54A\uB124. \uBC1B\uC544 \uB458\uAC8C."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD750\uC751, \uACE0\uB9C8\uC6CC. \uC4F8 \uB370\uB97C \uCC3E\uC544\uBCFC\uAC8C."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uB9F9\uBB3C\uC740 \uC5F0\uAE08\uC220\uC5D0\uC11C \uC81C\uC77C \uC7AC\uBBF8\uC5C6\uB294
      \uC7AC\uB8CC\uC57C."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uC0DD\uC77C\uC744 \uC54C\uACE0 \uC788\uC5C8\uC5B4? \u2026\uB204\uAC00
      \uC54C\uB824 \uC900 \uAC70\uC57C? \uB410\uC5B4, \uC624\uB298\uB9CC\uC740 \uBB3B\uC9C0
      \uC54A\uC744\uAC8C."
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB10C \uC774\uC0C1\uD574. \uB098\uB97C \uACBD\uACC4\uD558\uC9C0 \uC54A\uB124.
      \uD639\uC2DC, \uB098\uBCF4\uB2E4 \uB354 \uC704\uD5D8\uD55C \uAC70\uC57C?"
