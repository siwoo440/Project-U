%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Akane
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_akane
  dailyTalkLimit: 1
  expressionTags:
  - "\uD638\uCF8C"
  - "\uC2B9\uBD80\uC695"
  - "\uC218\uC90D\uC74C"
  - "\uACB0\uC758"
  - "\uBBF8\uC18C"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC624\uC624! \uC0C8 \uC5BC\uAD74\uC774\uB2E4! \uB098\uB294 \uC544\uCE74\uB124,
      \uCD95\uC81C \uC218\uD638\uC790\uB2E4! \uD798\uC4F8 \uC77C \uC788\uC73C\uBA74
      \uC5B8\uC81C\uB4E0 \uBD88\uB7EC! \uD558\uD558\uD558!"
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC88B\uC740 \uC544\uCE68! \uC624\uB298\uB3C4 \uD798\uCC28\uAC8C \uAC00\uC790!"
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAE30\uB2E4\uB838\uC5B4! \uAC19\uC774 \uB5A1 \uAD6C\uC6CC \uBA39\uC744\uB798?
      \uB0B4\uAC00 \uC81C\uC77C \uC798 \uAD7D\uAC70\uB4E0!"
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC654\uAD6C\uB098! \uC624\uB298\uB3C4 \uD798\uCC28\uAC8C \uAC00\uC790!"
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC608\uC804\uC5D0 \uD798 \uC870\uC808\uC744 \uBABB \uD574\uC11C \uCE5C\uAD6C\uB97C
      \uB2E4\uCE58\uAC8C \uD588\uC5B4. \u2026\uADF8\uB798\uC11C \uC9C0\uAE08\uC740
      \uC870\uC2EC\uD558\uB294 \uC911\uC774\uC57C."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD798\uC740 \uCD95\uC81C\uCC98\uB7FC \uC990\uAC81\uAC8C \uC368\uC57C\uC9C0!
      \uADF8\uB798\uC57C \uBAA8\uB450\uAC00 \uC6C3\uC796\uC544!"
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108\uB791 \uC788\uC73C\uBA74 \uD798\uC744 \uBE7C\uB3C4 \uAD1C\uCC2E\uC740
      \uAE30\uBD84\uC774\uC57C. \uD558\uD558, \uC774\uC0C1\uD558\uC9C0?"
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD798\uC740 \uCD95\uC81C\uCC98\uB7FC \uC990\uAC81\uAC8C \uC368\uC57C\uC9C0!"
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uACC1\uC774 \uD3B8\uD574\uC84C\uC5B4."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uBC88 \uC77C\uC740 \uD568\uAED8\uD558\uC790."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC870\uAE08\uC740 \uD765\uBBF8\uB86D\uB124."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC544\uC9C1 \uB110 \uBBFF\uC9C4 \uC54A\uC544."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC81C \uB0B4 \uBAA9\uD45C\uC5D0\uB294 \uB124\uAC00 \uC788\uC5B4."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744\uC740 \uC218\uD655 \uCD95\uC81C! \uD638\uBC15 \uB4E4\uAE30
      \uC2DC\uD569 \uD560\uB798?"
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04 \uCD95\uC81C\uB2E4! \uBC9A\uAF43 \uB300\uC2E0 \uB538\uAE30\uAF43\uC774\uC9C0\uB9CC
      \uAD1C\uCC2E\uC544!"
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984\uBC24 \uBD88\uAF43\uB180\uC774! \uC774 \uC12C\uC5D0\uC11C\uB3C4
      \uD574 \uBCF4\uACE0 \uC2F6\uC5B4!"
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8\uC5D4 \uB530\uB73B\uD55C \uAD6D\uC774 \uCD5C\uACE0\uC57C!
      \uCD94\uC704 \uB530\uC704 \uB0A0\uB824 \uBC84\uB9AC\uC790!"
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44 \uC624\uB294 \uB0A0\uC5D4 \uCC98\uB9C8 \uBC11\uC5D0\uC11C \uB5A1
      \uAD7D\uAE30\uC9C0! \uD558\uD558!"
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC2F8\uC6C0 \uD558\uC790! \u2026\uC544, \uC0B4\uC0B4 \uB358\uC9C8\uAC8C!
      \uC57D\uC18D!"
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uD3ED\uD48D? \uC88B\uC544, \uC0AC\uB2F9\uC740 \uB0B4\uAC00 \uC9C0\uD0A8\uB2E4!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uCC28\uAC00\uC6B4 \uAC74 \uBCC4\uB85C\uC57C\u2026 \uC624\uB2C8\uB294
      \uB530\uB73B\uD55C \uAC8C \uC88B\uAC70\uB4E0."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC624, \uACE0\uB9C8\uC6CC! \uC5B4\uB514 \uC4F8\uC9C0\uB294 \uB098\uC911\uC5D0
      \uC0DD\uAC01\uD558\uC790!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uD638\uBC15 \uC218\uD504! \uB530\uB73B\uD574! \uB108 \uCD5C\uACE0\uB2E4!
      \uD558\uD558\uD558!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uB9DB\uC788\uC5B4 \uBCF4\uC778\uB2E4! \uC798 \uBA39\uC744\uAC8C!"
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uC0DD\uC77C?! \uD558\uD558\uD558! \uC624\uB298\uC740 \uC12C \uC804\uCCB4\uAC00
      \uCD95\uC81C\uB2E4! \uACE0\uB9C8\uC6CC!"
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124\uAC00 \uC6C3\uC73C\uBA74 \uB0B4 \uBD81\uC18C\uB9AC\uB3C4 \uCEE4\uC838!"
