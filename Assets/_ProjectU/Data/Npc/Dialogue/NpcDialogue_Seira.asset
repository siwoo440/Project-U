%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Seira
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_seira
  dailyTalkLimit: 1
  expressionTags:
  - "\uC720\uD639"
  - "\uC218\uC90D\uC74C"
  - "\uBD84\uB178"
  - "\uD68C\uC0C1"
  - "\uBB34\uD45C\uC815"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uCC98\uC74C \uBCF4\uB294 \uC5BC\uAD74\uC774\uB124\uC694. \uC798 \uBD80\uD0C1\uD574\uC694."
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774 \uC5B4\uB460 \uC18D\uC5D0 \uB4E4\uC5B4\uC628 \uAC74 \uC6A9\uAE30\uC77C\uAE4C,
      \uC5B4\uB9AC\uC11D\uC74C\uC77C\uAE4C\u2026"
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB3C5\uC774\uB780 \uB9C8\uC74C\uACFC \uB2EE\uC558\uC5B4. \uB108\uBB34
      \uC624\uB798 \uC228\uAE30\uBA74\u2026 \uACB0\uAD6D \uD130\uC9C0\uACE0 \uB9D0\uC9C0."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB10C \uB098\uC5D0\uAC8C \uD574\uB3C5\uC81C\uC77C\uAE4C, \uC544\uB2C8\uBA74
      \uB610 \uB2E4\uB978 \uB3C5\uC77C\uAE4C?"
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uB208\uBE5B\u2026 \uB450\uB824\uC6C0\uC774 \uC5C6\uB124. \uD765\uBBF8\uB85C\uC6CC."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uB3C5\uC740 \uB110 \uD574\uCE58\uC9C0 \uC54A\uC544. \uC774\uAC74,
      \uC120\uD0DD\uC774\uC57C."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB10C \uB0B4 \uBE44\uB298\uC5D0 \uB2FF\uC544\uB3C4\u2026 \uBB3C\uB7EC\uC11C\uC9C0
      \uC54A\uB294\uAD6C\uB098."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774 \uB3C5\uC740 \uC8FD\uC74C\uC774 \uC544\uB2C8\uB77C, \uB098\uC758
      \uC9C4\uC2EC\uC774\uC57C. \uB110 \uB0B4 \uC548\uC5D0 \uAC10\uC2F8\uACE0 \uC2F6\uC5B4."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uCD94\uC6CC\uC694. \uB530\uB73B\uD558\uAC8C \uC785\uACE0 \uB2E4\uB2C8\uC138\uC694."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uBC14\uB78C\uC774 \uC120\uC120\uD574\uC84C\uC5B4\uC694. \uC218\uD655\uC740
      \uC798 \uB418\uACE0 \uC788\uB098\uC694?"
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uD587\uBCD5\uC774 \uB728\uAC70\uC6CC\uC694. \uADF8\uB298\uC5D0\uC11C
      \uC26C\uC5B4 \uAC00\uC138\uC694."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uC774 \uC654\uB124\uC694. \uC12C\uC774 \uC870\uAE08\uC529 \uCD08\uB85D\uBE5B\uC73C\uB85C
      \uBC14\uB00C\uACE0 \uC788\uC5B4\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44\uAC00 \uC624\uB124\uC694. \uC624\uB298\uC740 \uC870\uAE08 \uC26C\uC5B4
      \uAC00\uB3C4 \uAD1C\uCC2E\uC544\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC774 \uC640\uC694. \uBC1C\uBC11 \uC870\uC2EC\uD558\uC138\uC694."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uD3ED\uD48D\uC774\uC5D0\uC694. \uC624\uB298\uC740 \uC548\uC5D0 \uC788\uB294
      \uAC8C \uC88B\uACA0\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uC774\uAC74 \uC815\uB9D0 \uC88B\uC544\uD558\uB294 \uAC70\uC608\uC694!
      \uACE0\uB9C8\uC6CC\uC694!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uACE0\uB9C8\uC6CC\uC694. \uC798 \uC4F8\uAC8C\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uACE0\uB9C8\uC6CC\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uC74C\u2026 \uC774\uAC74 \uC81C \uCDE8\uD5A5\uC740 \uC544\uB2C8\uC5D0\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC0DD\uC77C\uC744 \uAE30\uC5B5\uD574 \uC92C\uAD70\uC694. \uC815\uB9D0
      \uAE30\uBED0\uC694!"
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uBE44\uB298 \uC18D\uC5D0 \uC190\uC744 \uB123\uC744\uB798? \uB530\uB73B\uD558\uB2E8
      \uAC78\u2026 \uCC98\uC74C \uB290\uB084\uC9C0\uB3C4 \uBAB0\uB77C."
