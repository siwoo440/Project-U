%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Seira
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_seira
  dailyTalkLimit: 1
  expressionTags:
  - "\uC720\uD639"
  - "\uC218\uC90D\uC74C"
  - "\uBD84\uB178"
  - "\uD68C\uC0C1"
  - "\uBB34\uD45C\uC815"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\u2026\uBC1C\uC18C\uB9AC\uAC00 \uAC00\uBCCD\uB124. \uB098\uB294 \uC138\uC774\uB77C.
      \uC774 \uC720\uC801\uC758 \uAE30\uB85D\uC744 \uC9C0\uD0A4\uACE0 \uC788\uC5B4.
      \uBB34\uC11C\uC6B0\uBA74\u2026 \uB3CC\uC544\uAC00\uB3C4 \uAD1C\uCC2E\uC544."
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774 \uC5B4\uB460 \uC18D\uC5D0 \uB4E4\uC5B4\uC628 \uAC74 \uC6A9\uAE30\uC77C\uAE4C,
      \uC5B4\uB9AC\uC11D\uC74C\uC77C\uAE4C\u2026"
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAE30\uB2E4\uB838\uC5B4\u2026 \uC544\uB2C8, \uADF8\uB0E5 \uB124 \uBC1C\uC18C\uB9AC\uAC00
      \uBC18\uAC00\uC6E0\uC744 \uBFD0\uC774\uC57C."
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB610 \uC654\uAD6C\uB098\u2026 \uC774\uBC88\uC5D4 \uBB34\uC5C7\uC744
      \uC54C\uACE0 \uC2F6\uC5B4\uC11C?"
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774 \uCC45\uC7A5\uC5D4 \uCC9C \uB144 \uC804\uC758 \uB3C5 \uC870\uD569\uC774
      \uC801\uD600 \uC788\uC5B4. \uC77D\uACE0 \uC2F6\uC5B4? \uB300\uAC00\uB294\u2026
      \uB098\uC911\uC5D0 \uBC1B\uC744\uAC8C."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBC40\uC740 \uBAB8\uC774 \uCC28\uAC00\uC6CC\uC11C\u2026 \uD587\uBCD5\uC774
      \uC88B\uC740 \uB0A0\uC5D4 \uAD11\uC7A5 \uB3CC \uC704\uC5D0 \uB204\uC6CC \uC788\uACE4
      \uD574."
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB098\uB3C4 \uC608\uC804\uC5D4 \uC778\uAC04\uC774\uC5C8\uC5B4. \uBD88\uBA78\uC744
      \uC5F0\uAD6C\uD558\uB2E4\uAC00\u2026 \uCE5C\uAD6C\uC5D0\uAC8C \uBC30\uC2E0\uB2F9\uD588\uC9C0.
      \uC774 \uBE44\uB298\uC740 \uADF8 \uB300\uAC00\uC57C."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB3C5\uC774\uB780 \uB9C8\uC74C\uACFC \uB2EE\uC558\uC5B4. \uB108\uBB34
      \uC624\uB798 \uC228\uAE30\uBA74\u2026 \uACB0\uAD6D \uD130\uC9C0\uACE0 \uB9D0\uC9C0."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB10C \uB0B4 \uBE44\uB298\uC5D0 \uB2FF\uC544\uB3C4\u2026 \uBB3C\uB7EC\uC11C\uC9C0
      \uC54A\uB294\uAD6C\uB098."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uB3C5\uC740 \uB110 \uD574\uCE58\uC9C0 \uC54A\uC544. \uC774\uAC74,
      \uC120\uD0DD\uC774\uC57C."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uB208\uBE5B\u2026 \uB450\uB824\uC6C0\uC774 \uC5C6\uB124. \uD765\uBBF8\uB85C\uC6CC."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB10C \uB098\uC5D0\uAC8C \uD574\uB3C5\uC81C\uC77C\uAE4C, \uC544\uB2C8\uBA74
      \uB610 \uB2E4\uB978 \uB3C5\uC77C\uAE4C?"
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774 \uB3C5\uC740 \uC8FD\uC74C\uC774 \uC544\uB2C8\uB77C, \uB098\uC758
      \uC9C4\uC2EC\uC774\uC57C. \uB110 \uB0B4 \uC548\uC5D0 \uAC10\uC2F8\uACE0 \uC2F6\uC5B4."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744 \uBC84\uC12F\uC740 \uD5A5\uC774 \uAE4A\uC5B4. \uB3C5\uC778\uC9C0
      \uC57D\uC778\uC9C0\uB294\u2026 \uB9DB\uBCF4\uAE30 \uC804\uC5D4 \uBAB0\uB77C."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04 \uB3C5\uCD08\uB294 \uC0C8\uC2F9\uC77C \uB54C \uAC00\uC7A5 \uB3C5\uD574.
      \uC608\uC05C \uAC83\uC77C\uC218\uB85D \uC870\uC2EC\uD574\uC57C\uC9C0."
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984\uC740 \uC88B\uC544\u2026 \uBE44\uB298\uC774 \uBC18\uC9DD\uC774\uB294
      \uACC4\uC808\uC774\uB2C8\uAE4C."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uCD94\uC6CC\u2026 \uBAB8\uC774 \uB290\uB824\uC838. \uC624\uB298\uC740
      \uC870\uAE08 \uAC00\uAE4C\uC774 \uC788\uC5B4\uB3C4 \uB3FC."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE57\uBB3C\uC774 \uC720\uC801 \uD2C8\uC73C\uB85C \uC2A4\uBA70\uB4E4\uC5B4\u2026
      \uC624\uB798\uB41C \uC789\uD06C \uB0C4\uC0C8\uAC00 \uB098."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208 \uC624\uB294 \uB0A0\uC740\u2026 \uAF2C\uB9AC\uB97C \uB9D0\uACE0
      \uAC00\uB9CC\uD788 \uC788\uACE0 \uC2F6\uC5B4."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uD3ED\uD48D\uC774 \uCE58\uBA74 \uC9C0\uD558 \uC218\uB85C\uAC00 \uBD88\uC5B4\uB098.
      \uC624\uB298\uC740 \uB0B4\uB824\uC624\uC9C0 \uB9C8."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uACE1\uAD2D\uC774\uB85C \uC720\uC801\uC744 \uB450\uB4DC\uB9AC\uB294 \uC18C\uB9AC\u2026
      \uB5A0\uC62C\uB9AC\uAE30\uB3C4 \uC2EB\uC5B4."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\u2026\uBC1B\uC544 \uB458\uAC8C."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uC774 \uBC84\uC12F\u2026 \uD5A5\uC774 \uC644\uBCBD\uD574. \uB108, \uB098\uB97C
      \uAF64 \uC798 \uC54C\uACE0 \uC788\uAD6C\uB098."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uACE0\uB9C8\uC6CC\u2026 \uC720\uB9AC\uBCD1\uC5D0 \uB2F4\uC544 \uB458\uAC8C."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC0DD\uC77C\uC774\uB77C\uB2C8\u2026 \uBA87\uBC31 \uB144 \uB9CC\uC5D0
      \uB4E3\uB294 \uB9D0\uC774\uC57C. \u2026\uACE0\uB9C8\uC6CC. \uC9C4\uC2EC\uC774\uC57C."
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uBE44\uB298 \uC18D\uC5D0 \uC190\uC744 \uB123\uC744\uB798? \uB530\uB73B\uD558\uB2E8
      \uAC78\u2026 \uCC98\uC74C \uB290\uB084\uC9C0\uB3C4 \uBAB0\uB77C."
