%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Sharia
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_sharia
  dailyTalkLimit: 1
  expressionTags:
  - "\uC790\uC2E0\uAC10"
  - "\uACB0\uC758"
  - "\uB3D9\uC694"
  - "\uC804\uD22C"
  - "\uBBF8\uC18C"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC5B4\uC774, \uBB4D\uC0AC\uB78C! \uB09C \uC0E4\uB9AC\uC544, \uC774 \uBC14\uB2E4
      \uAD6C\uC870\uB300\uC57C. \uBB3C\uC5D0 \uBE60\uC9C0\uBA74 \uC18C\uB9AC \uC9C8\uB7EC.
      \uC5B4\uB514\uC11C\uB4E0 \uAC74\uC9C0\uB7EC \uAC08\uAC8C. \uD06C\uD558\uD558!"
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBC14\uB2E4\uB294 \uB0B4\uAC00 \uC9C0\uCF1C. \uAC71\uC815 \uB9C8."
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108 \uC624\uB294 \uAC70 \uB9DD\uB8E8\uC5D0\uC11C \uB2E4 \uBCF4\uC600\uC5B4.
      \uC190 \uD754\uB4DC\uB294 \uAC70 \uBD24\uC9C0?"
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB610 \uC654\uB124! \uC624\uB298 \uD30C\uB3C4\uB294 \uC58C\uC804\uD574.
      \uC218\uC601\uD558\uAE30 \uB531 \uC88B\uC544."
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC608\uC804\uC5D0 \uB09C\uD30C\uC120\uC5D0\uC11C \uD55C \uBA85\uC744
      \uBABB \uAD6C\uD588\uC5B4. \uADF8\uB798\uC11C \uB9E4\uC77C \uB9DD\uB8E8\uC5D0
      \uC62C\uB77C."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBC14\uB2E4\uC5D0\uC11C \uC81C\uC77C \uBB34\uC11C\uC6B4 \uAC74 \uC0C1\uC5B4\uAC00
      \uC544\uB2C8\uC57C. \uBC29\uC2EC\uC774\uC9C0. \u2026\uBB50, \uB09C \uC0C1\uC5B4\uC9C0\uB9CC."
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124\uAC00 \uD5E4\uC5C4\uCE58\uB294 \uAC70 \uBCF4\uBA74 \uBD88\uC548\uD574\uC11C
      \uBABB \uCC38\uACA0\uC5B4. \u2026\uADF8\uB7EC\uB2C8\uAE4C \uB0B4\uAC00 \uACC1\uC5D0
      \uC788\uC744\uAC8C."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAC81\uC774 \uB098\uB3C4 \uBB3C\uC5D0 \uB6F0\uC5B4\uB4DC\uB294 \uAC8C
      \uAD6C\uC870\uB300\uC57C."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uACC1\uC774 \uD3B8\uD574\uC84C\uC5B4."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uBC88 \uC77C\uC740 \uD568\uAED8\uD558\uC790."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC870\uAE08\uC740 \uD765\uBBF8\uB86D\uB124."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC544\uC9C1 \uB110 \uBBFF\uC9C4 \uC54A\uC544."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC81C \uB0B4 \uBAA9\uD45C\uC5D0\uB294 \uB124\uAC00 \uC788\uC5B4."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744\uC5D4 \uBB3C\uC0B4\uC774 \uC138\uC838. \uBD80\uB450 \uB05D\uC5D0\uB294
      \uAC00\uC9C0 \uB9C8."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04 \uBC14\uB2E4\uB294 \uC544\uC9C1 \uCC28\uAC00\uC6CC. \uC624\uB798
      \uB4E4\uC5B4\uAC00 \uC788\uC9C0 \uB9C8."
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984\uC774\uB2E4! \uBC14\uB2E4\uAC00 \uC81C\uC77C \uBC18\uC9DD\uC774\uB294
      \uACC4\uC808\uC774\uC9C0. \uAC19\uC774 \uD5E4\uC5C4\uCE60\uB798?"
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8 \uBC14\uB2E4\uB294 \uAC70\uCE60\uC5B4. \uADF8\uB798\uB3C4
      \uAD6C\uC870\uB300\uB294 \uC26C\uC9C0 \uC54A\uC544."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44 \uC624\uB294 \uBC14\uB2E4\uB294 \uC794\uC794\uD574 \uBCF4\uC5EC\uB3C4
      \uC18D\uC740 \uB2EC\uB77C. \uC870\uC2EC\uD574."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208 \uB0B4\uB9AC\uB294 \uBC14\uB2E4\uB77C\uB2C8, \uBA4B\uC9C0\uC9C0?
      \uBB3C\uC740 \uC5BC\uC74C\uC7A5\uC774\uC9C0\uB9CC."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uD3ED\uD48D\uC774\uB2E4! \uB2E4\uB4E4 \uBB3C\uAC00\uC5D0\uC11C \uB5A8\uC5B4\uC838!
      \u2026\uB09C \uB9DD\uB8E8\uB85C \uAC04\uB2E4!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uC5F4\uB9E4\uB294 \uBCC4\uB85C\uC57C. \uC774\uBE68 \uC0AC\uC774\uC5D0
      \uB07C\uAC70\uB4E0."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC74C, \uC774\uAC74\u2026 \uBB3C\uC5D0 \uB728\uB824\uB098?"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uC6B0\uC640, \uC0DD\uC120\uC774\uB2E4! \uD06C\uD558, \uC774\uB7F0 \uAC78
      \uC8FC\uBA74 \uBC18\uD558\uC796\uC544!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uC624, \uACE0\uB9C8\uC6CC! \uBC14\uB2E4 \uB0C4\uC0C8 \uB098\uB294 \uC120\uBB3C
      \uC88B\uC544."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uC0DD\uC77C \uAE30\uC5B5\uD55C \uAC70\uC57C? \uD06C\uD558\uD558!
      \uC624\uB298\uC740 \uBC14\uB2E4\uAC00 \uB0A0 \uC704\uD574 \uD30C\uB3C4\uB97C
      \uCE58\uB294 \uAC83 \uAC19\uB124!"
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB110 \uAD6C\uD55C \uAC8C \uC544\uB2C8\uB77C, \uB098\uB3C4 \uB124\uAC8C
      \uAD6C\uC6D0\uBC1B\uC558\uC5B4."
