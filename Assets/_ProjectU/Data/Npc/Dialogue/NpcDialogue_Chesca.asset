%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Chesca
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_chesca
  dailyTalkLimit: 1
  expressionTags:
  - "\uBB34\uD45C\uC815"
  - "\uC218\uC90D\uC74C"
  - "\uACE0\uBC31"
  - "\uBC29\uC5B4"
  - "\uC2E0\uB8B0"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\u2026\uD0C1. \uAC00\uAE4C\uC774 \uC624\uC9C0 \uB9C8. \uC544\uB2C8, \uC870\uAE08\uC740\u2026
      \uAD1C\uCC2E\uC544. \uCCB4\uC2A4\uCE74\uC57C. \uC0C1\uC790 \uC548\uC740 \uBCF4\uC9C0
      \uB9C8."
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB610 \uC654\uB124\u2026 \uC774\uBC88\uC5D4 \uBB34\uC2A8 \uC774\uC720\uB85C
      \uC0C1\uC790\uB97C \uC5F0 \uAC70\uC57C?"
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC654\uAD6C\uB098. \uB69C\uAED1\u2026 \uD65C\uC9DD \uC5F4\uC5B4 \uB458\uAC8C.
      \uB108\uB2C8\uAE4C."
  - kind: 1
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\u2026\uB610 \uC654\uB124. \uD0C1. \uC624\uB298\uC740 \uB69C\uAED1 \uC870\uAE08\uB9CC
      \uC5F4\uC5B4 \uB458\uAC8C."
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC608\uC804\uC5D0 \uC0AC\uB78C\uB4E4\uC774 \uB0A0 \uC5F4\uACE0 \uBCF4\uBB3C\uB9CC
      \uAC00\uC838\uAC14\uC5B4. \uD0C1. \u2026\uADF8 \uB4A4\uB85C \uB69C\uAED1\uC744
      \uC798 \uC548 \uC5F4\uC5B4."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC720\uBB3C\uC740 \uB9D0\uC744 \uC548 \uD574. \uADF8\uB798\uC11C \uC88B\uC544.
      \u2026\uC0AC\uB78C\uC740 \uB9D0\uC774 \uB108\uBB34 \uB9CE\uC544."
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC5F4\uC1E0 \uC5C6\uC774 \uB0A0 \uC5F0 \uC0AC\uB78C\uC740 \uB124\uAC00
      \uCC98\uC74C\uC774\uC57C. \u2026\uC774\uC0C1\uD55C \uAE30\uBD84\uC774\uC57C."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBC16\uC740 \uB108\uBB34 \uBC1D\uC544. \uB09C \uC774 \uC5B4\uB460\uC774
      \uC88B\uC544. \uC870\uC6A9\uD558\uB2C8\uAE4C."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4\uAC00 \uBB38\uC744 \uC5F4\uBA74, \uB10C \uB3C4\uB9DD\uCE58\uC9C0
      \uC54A\uC744 \uAC70\uC9C0?"
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC774\uC0C1\uD574\u2026 \uB110 \uBCFC \uB550 \uC0C1\uC790\uAC00 \uB35C
      \uB2F5\uB2F5\uD574."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB10C \uC65C \uB098\uB97C \uC5F4\uC5C8\uC9C0? \uADF8\uB0E5 \uBCF4\uBB3C\uC774
      \uAD81\uAE08\uD574\uC11C?"
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124\uAC00 \uAC00\uC9C4 \uC5F4\uC1E0\uB294\u2026 \uD0D0\uC695\uC758
      \uB0C4\uC0C8\uAC00 \uB098."
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uC190\uC73C\uB85C\uB9CC \uB0B4 \uB36E\uAC1C\uB97C \uC5F4\uAC8C
      \uD574\uC904\uAC8C. \uADF8\uAC74 \uB098\uD55C\uD14C\u2026 \u2018\uC0AC\uB791\u2019\uC774\uC57C."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744 \uB099\uC5FD \uBC11\uC5D0 \uBC18\uC9DD\uC774\uB294 \uAC8C
      \uB9CE\uC544. \uD0C1, \uD558\uB098 \uCC3E\uC558\uB2E4."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uC5D4 \uD759 \uC18D\uC5D0\uC11C \uC720\uBB3C\uC774 \uC62C\uB77C\uC640.
      \uB545\uC774 \uC228 \uC26C\uB2C8\uAE4C."
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uC5EC\uB984\uC5D4 \uC0C1\uC790 \uC548\uC774 \uB354\uC6CC. \u2026\uADF8\uB798\uB3C4
      \uC548 \uB098\uAC00."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uACA8\uC6B8\uC5D4 \uACBD\uCCA9\uC774 \uC5BC\uC5B4. \uC5F4\uB824\uB3C4
      \uC798 \uC548 \uB2EB\uD600. \u2026\uACE4\uB780\uD574."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44 \uC624\uBA74 \uB69C\uAED1 \uAF2D \uB2EB\uC544. \uB179\uC2AC\uBA74\u2026
      \uC544\uD30C."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208\uC774 \uC313\uC774\uBA74 \uB098\uB3C4 \uADF8\uB0E5 \uB3CC \uAC19\uC544
      \uBCF4\uC5EC. \uD3B8\uD574."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uCC9C\uB465\u2026 \uD0C1, \uD0C1. \uBB34\uC11C\uC6B4 \uAC70 \uC544\uB2C8\uC57C.
      \uB69C\uAED1\uC774 \uB5A8\uB9AC\uB294 \uAC70\uC57C."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uB9DD\uCE58 \uAC19\uC740 \uAC74 \uC2EB\uC5B4. \uC5B5\uC9C0\uB85C \uC5F4
      \uB54C \uC4F0\uB294 \uAC70\uC796\uC544."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uD0C1. \u2026\uC77C\uB2E8 \uB123\uC5B4 \uB458\uAC8C."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uC774\uAC74\u2026 \uBC1B\uAE30 \uC2EB\uC5B4\uC694."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uAD11\uC11D\u2026 \uBC18\uC9DD\uC5EC. \uC774\uAC74 \uB0B4 \uBCF4\uBB3C
      \uCE78 \uC81C\uC77C \uC548\uCABD\uC5D0 \uB123\uC744\uB798."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\u2026\uACE0\uB9C8\uC6CC. \uCC9C \uC870\uAC01\uC740 \uC548\uCABD\uC744
      \uD3ED\uC2E0\uD558\uAC8C \uD574 \uC918."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC0DD\uC77C \uC120\uBB3C\u2026? \uBC1B\uAE30\uB9CC \uD558\uACE0 \uBE7C\uC557\uAE30\uC9C0
      \uC54A\uB294 \uC120\uBB3C\uC740 \uCC98\uC74C\uC774\uC57C. \uD0C1\u2026 \uACE0\uB9C8\uC6CC."
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uCC98\uC74C\uC774\uC57C\u2026 \uB204\uAD70\uAC00\uAC00 \uB0B4 \uC548\uC744
      \uB4E4\uC5EC\uB2E4\uBD10\uB3C4 \uBB34\uC12D\uC9C0 \uC54A\uC740 \uAC74."
