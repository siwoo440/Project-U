%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3770e9c216b6ab74097703d430744396, type: 3}
  m_Name: NpcDialogue_Mio
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSet
  dialogueId: dlg_mio
  dailyTalkLimit: 1
  expressionTags:
  - "\uC6C3\uC74C"
  - "\uC7A5\uB09C"
  - "\uBD80\uB044\uB7EC\uC6C0"
  - "\uC2AC\uD514"
  - "\uB098\uB978\uD568"
  lines:
  - kind: 0
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC5B4\uB77C, \uC0C8 \uC5BC\uAD74\uC774\uB2E4\uB0E5? \uB09C \uBBF8\uC624.
      \uC800 \uC5F0\uBABB\uC740 \uB0B4 \uB2E8\uACE8 \uC790\uB9AC\uB2C8\uAE4C \uB108\uBB34
      \uC2DC\uB044\uB7FD\uAC8C \uD558\uC9C0 \uB9C8\uB0E5~"
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC88B\uC740 \uB0A0\uC528\uB124\uB0E5~ \uD30C\uB3C4\uB3C4 \uC794\uC794\uD558\uACE0,
      \uAE30\uBD84\uB3C4 \uC88B\uC544."
  - kind: 1
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uAE30\uB2E4\uB838\uB2E4\uB0E5. \uB124\uAC00 \uC624\uBA74 \uBB3C\uACE0\uAE30\uB3C4
      \uAE30\uBD84 \uC88B\uC544\uD558\uB294 \uAC83 \uAC19\uC544."
  - kind: 1
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC624, \uC654\uB0E5? \uC624\uB298\uC740 \uC785\uC9C8\uC774 \uC88B\uC744
      \uAC83 \uAC19\uAD6C\uB0E5."
  - kind: 2
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC9C0\uB801\uC774 \uBBF8\uB07C\uB97C \uC4F0\uBA74 \uBD95\uC5B4\uAC00
      \uC798 \uBB38\uB2E4\uB0E5. \uBE44\uC2FC \uBBF8\uB07C\uAC00 \uAF2D \uC88B\uC740
      \uAC74 \uC544\uB2C8\uAD6C\uB0E5."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uCC0C\uAC00 \uD754\uB4E4\uB9B0\uB2E4\uACE0 \uBC14\uB85C \uB2F9\uAE30\uBA74
      \uC548 \uB3FC\uB0E5. \uC465 \uB4E4\uC5B4\uAC08 \uB54C\uAE4C\uC9C0 \uAE30\uB2E4\uB9AC\uB294
      \uAC70\uC57C."
  - kind: 2
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC2A4\uC2B9\uB2D8\uC740 \uD3ED\uD48D \uCE58\uB294 \uB0A0 \uBC14\uB2E4\uB85C
      \uB098\uAC14\uB2E4\uAC00 \uC548 \uB3CC\uC544\uC654\uC5B4. \u2026\uADF8\uB798\uB3C4
      \uB09C \uBB3C\uC774 \uC88B\uC544\uB0E5."
  - kind: 2
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBB3C\uACE0\uAE30\uB4E4\uC740 \uC815\uC9C1\uD574. \uAC70\uC9D3\uB9D0
      \uC548 \uD558\uAC70\uB4E0. \uB300\uC2E0, \uAC00\uB9CC\uD788 \uAE30\uB2E4\uB824\uC57C
      \uB9CC\uB098."
  - kind: 3
    stage: 3
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB124 \uC6C3\uC74C\uC18C\uB9AC\u2026 \uD30C\uB3C4\uC18C\uB9AC\uBCF4\uB2E4
      \uC88B\uB124\uB0E5."
  - kind: 3
    stage: 2
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC624\uB298\uC740 \uB108\uB791 \uAC19\uC774 \uACE0\uAE30 \uC7A1\uC744\uB798.
      \uB458\uC774\uBA74 \uBC14\uB78C\uB3C4 \uB35C \uC2EC\uC2EC\uD558\uAC70\uB4E0."
  - kind: 3
    stage: 1
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB09A\uC2DC\uD574\uBCF8 \uC801 \uC788\uB0E5? \uACE0\uAE30\uB294 \uB9C8\uC74C\uC774
      \uAE09\uD55C \uC0AC\uB78C\uD55C\uD150 \uC548 \uC7A1\uD600."
  - kind: 3
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC5B4, \uB610 \uC0AC\uB78C? \uBC14\uB2E4 \uB0C4\uC0C8\uB3C4 \uC548 \uB098\uB294\uB370~"
  - kind: 3
    stage: 4
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBC14\uB2E4\uAC00 \uBB34\uC11C\uC6B8 \uB54C\uB3C4 \uC788\uC5B4. \uADF8\uB798\uB3C4
      \uB124\uAC00 \uC788\uC73C\uBA74 \uAD1C\uCC2E\uC744 \uAC83 \uAC19\uC544."
  - kind: 4
    stage: 0
    season: 2
    weather: 0
    giftPreference: 2
    text: "\uAC00\uC744 \uBA54\uAE30\uB294 \uC0B4\uC774 \uC62C\uB77C\uC11C \uB9DB\uC788\uB2E4\uB0E5.
      \uD798\uB3C4 \uC138\uB2C8\uAE4C \uC904 \uC870\uC2EC\uD574."
  - kind: 4
    stage: 0
    season: 3
    weather: 0
    giftPreference: 2
    text: "\uCD94\uC6CC\uB3C4 \uBE59\uC5B4\uB294 \uC798 \uC7A1\uD78C\uB2E4\uB0E5.
      \uC190\uC740 \uC5BC\uC5B4\uB3C4 \uB9C8\uC74C\uC740 \uB530\uB73B\uD558\uAD6C\uB0E5."
  - kind: 4
    stage: 0
    season: 1
    weather: 0
    giftPreference: 2
    text: "\uB354\uC6CC\uC11C \uD138\uC774 \uB179\uC744 \uAC83 \uAC19\uB2E4\uB0E5\u2026
      \uC800\uB141 \uB09A\uC2DC\uAC00 \uCD5C\uACE0\uAD6C\uB0E5."
  - kind: 4
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uBD04\uC5D4 \uC1A1\uC5B4\uAC00 \uCC28\uAC00\uC6B4 \uBB3C\uC5D0\uC11C
      \uC62C\uB77C\uC628\uB2E4\uB0E5. \uC544\uCE68 \uC77C\uCC0D\uC774 \uC81C\uC77C
      \uC88B\uC544."
  - kind: 5
    stage: 0
    season: 0
    weather: 2
    giftPreference: 2
    text: "\uBE44 \uC624\uB294 \uB0A0\uC5D4 \uBB3C\uACE0\uAE30\uAC00 \uC218\uBA74
      \uAC00\uAE4C\uC774 \uC62C\uB77C\uC628\uB2E4\uB0E5. \u2026\uADFC\uB370 \uB09C
      \uC816\uB294 \uAC74 \uC2EB\uC5B4."
  - kind: 5
    stage: 0
    season: 0
    weather: 3
    giftPreference: 2
    text: "\uB208 \uC624\uB294 \uC5F0\uBABB\uC740 \uC870\uC6A9\uD574\uC11C \uC88B\uB2E4\uB0E5.
      \uBB3C\uACE0\uAE30 \uC228\uC18C\uB9AC\uAE4C\uC9C0 \uB4E4\uB9B4 \uAC83 \uAC19\uC544."
  - kind: 5
    stage: 0
    season: 0
    weather: 4
    giftPreference: 2
    text: "\uC624, \uC624\uB298\uC740 \uC5F0\uBABB \uADFC\uCC98\uC5D0\uB3C4 \uAC00\uC9C0
      \uB9C8\uB0E5! \uD3ED\uD48D\uC740\u2026 \uC9C4\uC9DC \uC2EB\uC5B4."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 4
    text: "\uB9F9\uBB3C? \uC124\uB9C8 \uB098 \uC53B\uAE30\uB824\uB294 \uAC70\uB0E5?!
      \uC2EB\uC5B4\uC2EB\uC5B4!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 0
    text: "\uB0D0\uC557! \uC774\uAC70 \uC9C4\uC9DC \uB098 \uC8FC\uB294 \uAC70\uB0E5?
      \uC624\uB298\uC740 \uCD5C\uACE0\uC758 \uB0A0\uC774\uB2E4\uB0E5!"
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 1
    text: "\uC624, \uC0DD\uC120 \uB0C4\uC0C8~ \uACE0\uB9D9\uB2E4\uB0E5."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uC74C, \uACE0\uB9D9\uB2E4\uB0E5. \uC5B4\uB514 \uC4F8\uC9C0\uB294 \uB098\uC911\uC5D0
      \uC0DD\uAC01\uD560\uAC8C."
  - kind: 6
    stage: 0
    season: 0
    weather: 0
    giftPreference: 3
    text: "\uCC44\uC18C\uB294\u2026 \uACE0\uC591\uC774\uD55C\uD14C \uC548 \uB9DE\uB294\uB2E4\uB0E5."
  - kind: 7
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB0B4 \uC0DD\uC77C \uAE30\uC5B5\uD574 \uC900 \uAC70\uB0E5? \u2026\uD5E4\uD5E4,
      \uC624\uB298\uC740 \uB0B4\uAC00 \uC81C\uC77C \uD070 \uBB3C\uACE0\uAE30 \uC7A1\uC544
      \uC904\uAC8C."
  - kind: 8
    stage: 0
    season: 0
    weather: 0
    giftPreference: 2
    text: "\uB108\uB791 \uB09A\uC740 \uACE0\uAE30\uBA74 \uBB50\uB4E0 \uD2B9\uBCC4\uD574.
      \uADF8\uB7F0 \uAC8C \u2018\uC6B4\uBA85\u2019\uC774\uB77C \uBD80\uB974\uB098\uB0E5?"
