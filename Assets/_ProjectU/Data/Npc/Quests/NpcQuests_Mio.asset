    days: 3
    seasons: 0000000002000000
    requiredStage: 0
    requestLine: "\uC1A1\uC5B4\uB294 \uD798\uC774 \uC138\uC11C \uC7AC\uBC0C\uB2E4\uB0E5.
      \uB450 \uB9C8\uB9AC \uC7A1\uC544 \uC62C \uC218 \uC788\uC5B4?"
