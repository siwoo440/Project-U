    rewardItem: {fileID: 0}
    rewardItemAmount: 0
    days: 2
    seasons: 
    requiredStage: 0
    requestLine: "\uC5F4\uB9E4 \uC5EC\uB35F \uAC1C. \uC999\uC744 \uC9DC\uC11C \uC2E4\uC744
      \uBB3C\uB4E4\uC77C \uAC70\uC57C. \uBCF4\uB78F\uBE5B\uC774 \uC81C\uC77C \uC608\uC058\uAC70\uB4E0."
    thanksLine: "\uC0C9\uC774 \uACF1\uAC8C \uB098\uC624\uACA0\uC5B4. \uB108\uB3C4
