    rewardCoins: 30
    rewardAffinity: 3
    rewardItem: {fileID: 0}
    rewardItemAmount: 0
    days: 2
    seasons: 
    requiredStage: 0
    requestLine: "\uBB34\uB108\uC9C4 \uC131\uBB38 \uCD08\uC18C\uB97C \uBCF4\uC218\uD558\uB824
      \uD569\uB2C8\uB2E4. \uB3CC \uC5F4\uB2E4\uC12F \uAC1C\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4."
    thanksLine: "\uC131\uBCBD\uC774 \uD55C\uACB0 \uD2BC\uD2BC\uD574\uC84C\uC2B5\uB2C8\uB2E4.
      \uAC10\uC0AC\uD569\uB2C8\uB2E4."
    requiredEventId: 
  - questId: quest_ravenna_special
    title: "\uAE30\uC0AC\uB2E8\uC758 \uBB18\uBE44"
