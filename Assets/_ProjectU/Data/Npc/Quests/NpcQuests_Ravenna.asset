    rewardItemAmount: 2
    days: 5
    seasons: 
    requiredStage: 2
    requestLine: "\uD568\uAED8 \uC2F8\uC6E0\uB358 \uAE30\uC0AC\uB4E4\uC758 \uBB18\uBE44\uB97C
      \uC138\uC6B0\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4. \uB3CC \uC2A4\uBB3C, \uC774\uB984\uC744
      \uC0C8\uAE38 \uAD11\uC11D \uB2E4\uC12F, \uBC1B\uCE68 \uB098\uBB34 \uC5F4. \u2026\uC774\uC81C\uC57C
      \uADF8\uB4E4\uC744 \uBCF4\uB0BC \uC218 \uC788\uC744 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
    thanksLine: "\uBB18\uBE44\uAC00 \uC130\uC2B5\uB2C8\uB2E4. \uC624\uB298 \uBC24\uC740
      \uCC98\uC74C\uC73C\uB85C \uC21C\uCC30 \uC5C6\uC774 \uC7A0\uB4E4 \uC218 \uC788\uC744
      \uAC83 \uAC19\uC2B5\uB2C8\uB2E4. \uC774 \uBB3C\uC57D\uC740 \uAC10\uC0AC\uC758
      \uD45C\uC2DC\uC785\uB2C8\uB2E4."
    requiredEventId: event_ravenna_trust
