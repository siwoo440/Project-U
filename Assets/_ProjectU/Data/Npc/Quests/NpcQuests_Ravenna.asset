    rewardItemAmount: 0
    days: 3
    seasons: 
    requiredStage: 0
    requestLine: "\uAC11\uC637 \uC774\uC74C\uB9E4\uAC00 \uD5D0\uAC70\uC6CC\uC84C\uC2B5\uB2C8\uB2E4.
      \uAD11\uC11D \uC138 \uAC1C\uBA74 \uC218\uC120\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    thanksLine: "\uC218\uC120 \uC644\uB8CC. \uAE30\uC0AC\uC758 \uBAA8\uC2B5\uC744
