    requiredStage: 0
    requestLine: "\uC21C\uCC30\uC744 \uB9C8\uCE58\uBA74 \uCC28 \uD55C \uC794\uC774
      \uD544\uC694\uD569\uB2C8\uB2E4. \uB450 \uC794 \uBD80\uD0C1\uB4DC\uB824\uB3C4
      \uB418\uACA0\uC2B5\uB2C8\uAE4C?"
    thanksLine: "\uAC10\uC0AC\uD569\uB2C8\uB2E4. \uB530\uB73B\uD55C \uCC28\uB294
      \uAC11\uC637 \uC18D\uAE4C\uC9C0 \uB370\uC6CC \uC90D\uB2C8\uB2E4."
