    seasons: 
    requiredStage: 0
    requestLine: "\uC6B0\uC720 \uC138 \uBCD1. \uD64D\uCC28\uC5D0 \uB123\uC744 \uAC70\uC57C.
      \u2026\uD53C \uAC19\uC740 \uAC70 \uC548 \uB9C8\uC154! \uD3B8\uACAC\uC774\uC57C!"
