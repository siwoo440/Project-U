    rewardItemAmount: 0
    days: 2
    seasons: 
    requiredStage: 0
    requestLine: "\uC57D\uCD08\uCC28 \uB450 \uC794\uB9CC \uAD6C\uD574 \uC904\uB798\uC694?
      \uB2EC\uC774 \uB728\uB294 \uBC24\uC5D4 \uCC28\uAC00 \uC788\uC5B4\uC57C \uC608\uC5B8\uC11C\uAC00
      \uC798 \uC77D\uD600\uC694."
    thanksLine: "\uACE0\uB9C8\uC6CC\uC694. \uC624\uB298 \uBC24 \uC608\uC5B8\uC11C\uC5D4
