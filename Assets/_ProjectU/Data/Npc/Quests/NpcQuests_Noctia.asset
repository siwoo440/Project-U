    rewardItem: {fileID: 0}
    rewardItemAmount: 0
    days: 3
    seasons: 
    requiredStage: 0
    requestLine: "\uC218\uC815 \uAD6C\uC2AC\uC774 \uAE68\uC84C\uC5B4\uC694. \uB300\uC2E0
      \uBC18\uC9DD\uC774\uB294 \uAD11\uC11D \uB450 \uAC1C\uBA74\u2026 \uBCC4\uBE5B\uC744
      \uBE44\uCDB0 \uBCFC \uC218 \uC788\uC744 \uAC70\uC608\uC694."
    thanksLine: "\u2026\uAD11\uC11D \uC18D\uC5D0\uB3C4 \uC791\uC740 \uBCC4\uC774
