    days: 3
    seasons: 
    requiredStage: 0
    requestLine: "\uC232 \uADF8\uB298\uC5D0\uC11C \uC790\uB780 \uBC84\uC12F \uB124
      \uAC1C\uAC00 \uD544\uC694\uD574\uC694. \uAE4C\uB9C8\uADC0\uB4E4\uC774 \uC88B\uC544\uD558\uB294
      \uC218\uD504\uB97C \uB053\uC774\uB824\uACE0\uC694."
    thanksLine: "\u2026\uC88B\uC740 \uBC84\uC12F\uC774\uC5D0\uC694. \uAE4C\uB9C8\uADC0\uB4E4\uC774
      \uC624\uB298 \uBC24 \uC870\uC6A9\uD558\uACA0\uB124\uC694."
