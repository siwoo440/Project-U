    days: 5
    seasons: 
    requiredStage: 2
    requestLine: "\uC0C8 \uC608\uC5B8\uC11C\uB97C \uC5EE\uACE0 \uC2F6\uC5B4\uC694.
      \uBA39\uBB3C\uC744 \uB0BC \uBC84\uC12F \uC5EC\uC12F \uAC1C\uC640 \uCC45\uC744
